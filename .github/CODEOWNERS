# Package, host and CI review ownership are separate boundaries, currently owned
# by the same team. Keep this file self-owned and dismiss stale approvals on push.

# Independent packages.
/packages/ @aipoch/ci-maintainers

# Host application, entrypoints, integration tests, schema and resources.
/src/ @aipoch/ci-maintainers
/cli/ @aipoch/ci-maintainers
/e2e/ @aipoch/ci-maintainers
/test/ @aipoch/ci-maintainers
/prisma/ @aipoch/ci-maintainers
/resources/ @aipoch/ci-maintainers

# CI control plane. Keep specific tool-package ownership after the package default.
/packages/test-impact/ @aipoch/ci-maintainers
/.github/CODEOWNERS @aipoch/ci-maintainers
/CODEOWNERS @aipoch/ci-maintainers
/.github/workflows/ @aipoch/ci-maintainers
/.github/actions/ @aipoch/ci-maintainers
/.github/dependabot.yml @aipoch/ci-maintainers
/.github/labels.json @aipoch/ci-maintainers
/scripts/ci/ @aipoch/ci-maintainers

# Ordinary registration is checked as data by trusted-base CI Integrity.
# Last matching pattern wins; keep exceptions limited to validated JSON registration data.
/scripts/ci/module-impact.json
/scripts/ci/module-impact/*.json
