{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "playwright.config.ts",
    "e2e/**/*",
    "vite.web.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "test/config/electron.vite.config.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "types": [
      "electron-vite/node"
    ]
  },
  "exclude": [
    "e2e/browser/fixture"
  ]
}
