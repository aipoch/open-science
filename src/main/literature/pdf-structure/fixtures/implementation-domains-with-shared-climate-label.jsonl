[["page","lines",11],{"text":"(71%). Participants had worked in their current roles for","fontSize":9.8,"x":56.692901611,"y":580.138202369,"width":233.84465999625647,"height":9.799999999999955}]
[["page","lines",12],{"text":"an average of 6.5 years.","fontSize":9.8,"x":56.692901611,"y":592.133402369,"width":93.50081999625638,"height":9.800000000000068}]
