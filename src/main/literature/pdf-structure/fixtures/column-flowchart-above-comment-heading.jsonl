[["page","lines",41],{"text":"In the unadjusted-for-baseline analyses, similar ef-","fontSize":9.978,"x":79.00083200000003,"y":489.79420000000016,"width":215.59065480000007,"height":9.978000000000009}]
[["page","lines",42],{"text":"fects were observed with 2 exceptions: the intervention","fontSize":9.978,"x":67.02723200000003,"y":500.77000000000015,"width":227.56126140000003,"height":9.978000000000009}]
[["page","lines",43],{"text":"effects on number of servings of vegetables and on mam-","fontSize":9.978,"x":67.02723200000003,"y":511.74580000000014,"width":227.6380919999997,"height":9.978000000000065}]
[["page","lines",44],{"text":"mograms in women irrespective of age were nonsignifi-","fontSize":9.978,"x":67.02723200000003,"y":522.7216000000001,"width":227.55228119999992,"height":9.978000000000065}]
[["page","lines",45],{"text":"cant. In the unadjusted model, a significant HIV","fontSize":9.978,"x":67.02723200000003,"y":533.6974000000001,"width":227.49241319999965,"height":9.977999999999952}]
