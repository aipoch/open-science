[["page","lines",47],{"text":"in men 45 years or older, the health promotion inter-","fontSize":9.978,"x":67.02623420000003,"y":555.6490000000001,"width":227.48542859999992,"height":9.978000000000065}]
[["page","lines",48],{"text":"vention compared with the HIV/STD risk reduction in-","fontSize":9.978,"x":67.02623420000003,"y":566.6248,"width":227.54429879999986,"height":9.978000000000065}]
[["page","lines",49],{"text":"tervention caused a greater increase in prostate cancer","fontSize":9.978,"x":67.02623420000003,"y":577.6006000000001,"width":227.53432080000005,"height":9.977999999999952}]
[["page","lines",50],{"text":"screening in HIV-negative men than in HIV-positive men.","fontSize":9.978,"x":67.02623420000003,"y":588.5764000000001,"width":227.62611840000017,"height":9.977999999999952}]
