[["page","lines",54],{"text":"COMMENT","fontSize":8.9802,"x":157.8274,"y":650.6702,"width":45.901394280000034,"height":8.980199999999968}]
[["page","lines",55],{"text":"The present results demonstrated that a health promo-","fontSize":9.978,"x":67.028,"y":676.3464,"width":227.54629439999997,"height":9.977999999999952}]
[["page","lines",56],{"text":"tion intervention had significant effects on multiple health","fontSize":9.978,"x":67.028,"y":687.3222000000001,"width":227.63709419999964,"height":9.977999999999952}]
[["page","lines",57],{"text":"behaviors in African American HIV-positive and HIV-","fontSize":9.978,"x":67.028,"y":698.298,"width":227.488422,"height":9.978000000000065}]
[["page","lines",58],{"text":"negative individuals. Participants in the health promo-","fontSize":9.978,"x":67.028,"y":709.2738,"width":227.56425480000001,"height":9.977999999999952}]
[["page","lines",59],{"text":"tion intervention were more likely to report consuming","fontSize":9.978,"x":318.4736,"y":380.0227494,"width":227.55228119999987,"height":9.978000000000009}]
[["page","lines",60],{"text":"5 or more servings of fruits and vegetables daily and ad-","fontSize":9.978,"x":318.4736,"y":390.9985494,"width":227.53831199999996,"height":9.978000000000009}]
[["page","lines",61],{"text":"hering to physical activity guidelines compared with HIV/","fontSize":9.978,"x":318.4736,"y":401.9743494,"width":227.72789399999937,"height":9.978000000000009}]
[["page","lines",62],{"text":"STD intervention participants. In addition, in the health","fontSize":9.978,"x":318.4736,"y":412.9501494,"width":227.5662503999999,"height":9.978000000000009}]
[["page","lines",63],{"text":"promotion intervention compared with the HIV/STD in-","fontSize":9.978,"x":318.4736,"y":423.9259494,"width":227.58820199999974,"height":9.978000000000009}]
[["page","lines",64],{"text":"tervention, participants reported consuming fatty foods","fontSize":9.978,"x":318.4736,"y":434.90174939999997,"width":227.56824599999987,"height":9.978000000000009}]
[["page","lines",65],{"text":"less frequently, more men received prostate cancer screen-","fontSize":9.978,"x":318.4736,"y":445.87754939999996,"width":227.55228119999953,"height":9.978000000000009}]
[["page","lines",66],{"text":"ing, and more women received a breast cancer screen-","fontSize":9.978,"x":318.4736,"y":456.85334939999996,"width":227.52234720000007,"height":9.978000000000009}]
[["page","lines",67],{"text":"ing mammogram. Moreover, the efficacy of the health pro-","fontSize":9.978,"x":318.4736,"y":467.82914939999995,"width":227.5911954,"height":9.978000000000009}]
[["page","lines",68],{"text":"motion intervention did not differ statistically significantly","fontSize":9.978,"x":318.4736,"y":478.80494939999994,"width":227.66603040000047,"height":9.978000000000009}]
[["page","lines",69],{"text":"depending on participant sex or HIV serostatus.","fontSize":9.978,"x":318.4736,"y":489.78074939999993,"width":198.05132639999994,"height":9.978000000000009}]
[["page","lines",70],{"text":"The efficacy of the intervention may have been brought","fontSize":9.978,"x":330.44719999999995,"y":500.7565493999999,"width":215.6984172,"height":9.978000000000009}]
[["page","lines",71],{"text":"about by several factors. We drew on social cognitive","fontSize":9.978,"x":318.4736,"y":511.7323493999999,"width":227.4345408000002,"height":9.978000000000009}]
[["page","lines",72],{"text":"theory and integrated it with information from forma-","fontSize":9.978,"x":318.4736,"y":522.7081493999999,"width":227.56225919999991,"height":9.978000000000065}]
[["page","lines",73],{"text":"tive research with the population. Thus, the interven-","fontSize":9.978,"x":318.4736,"y":533.6839493999998,"width":227.44651439999922,"height":9.978000000000065}]
[["page","lines",74],{"text":"tion included activities designed to address the specific","fontSize":9.978,"x":318.4736,"y":544.6597493999999,"width":227.5622591999998,"height":9.977999999999952}]
[["page","lines",75],{"text":"outcome expectancies and efficacy beliefs of the popu-","fontSize":9.978,"x":318.4736,"y":555.6355494,"width":227.54230320000016,"height":9.977999999999952}]
[["page","lines",76],{"text":"lation, which helped to make the intervention contex-","fontSize":9.978,"x":318.4736,"y":566.6113493999999,"width":227.55327899999992,"height":9.978000000000065}]
[["page","lines",77],{"text":"tually appropriate. The approach of strengthening favor-","fontSize":9.978,"x":318.4736,"y":577.5871493999998,"width":227.6141447999999,"height":9.978000000000065}]
[["page","lines",78],{"text":"able outcome expectancies, reducing unfavorable outcome","fontSize":9.978,"x":318.4736,"y":588.5629493999999,"width":227.68598640000033,"height":9.977999999999952}]
[["page","lines",79],{"text":"expectancies, and buttressing skills and self-efficacy to","fontSize":9.978,"x":318.4736,"y":599.5387493999999,"width":227.5662503999999,"height":9.977999999999952}]
[["page","lines",80],{"text":"engage in the specific behaviors may account for the ef-","fontSize":9.978,"x":318.4736,"y":610.5145493999999,"width":227.54030760000006,"height":9.978000000000065}]
[["page","lines",81],{"text":"fects of the intervention. It is also possible that targeting","fontSize":9.978,"x":318.4736,"y":621.4903493999998,"width":227.5572702,"height":9.978000000000065}]
[["page","lines",82],{"text":"couples enhanced efficacy. Research suggests that health","fontSize":9.978,"x":318.4736,"y":632.4661493999998,"width":227.64407880000095,"height":9.977999999999952}]
[["page","lines",83],{"text":"promotion strategies that incorporate family members and","fontSize":9.978,"x":318.4736,"y":643.4419493999999,"width":227.61115139999885,"height":9.977999999999952}]
[["page","lines",84],{"text":"support networks are more effective than individual-","fontSize":9.978,"x":318.4736,"y":654.4177493999998,"width":227.45150340000015,"height":9.978000000000065}]
[["page","lines",85],{"text":"focused strategies","fontSize":9.978,"x":318.4736,"y":665.3935493999999,"width":72.46821840000001,"height":9.977999999999952}]
[["page","lines",86],{"text":"40-42","fontSize":5.9868,"x":390.9366,"y":665.8923,"width":14.424595920000002,"height":5.9868000000000166}]
[["page","lines",87],{"text":"and may be especially appropriate","fontSize":9.978,"x":407.4441,"y":665.3933,"width":138.56648160000003,"height":9.978000000000065}]
[["page","lines",88],{"text":"for African Americans.","fontSize":9.978,"x":318.4722696,"y":676.3691,"width":93.96681720000004,"height":9.977999999999952}]
[["page","lines",89],{"text":"41","fontSize":5.9868,"x":412.4344,"y":676.8679999999999,"width":6.214897080000014,"height":5.9868000000000166}]
