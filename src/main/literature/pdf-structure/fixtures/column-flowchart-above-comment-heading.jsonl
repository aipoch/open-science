[["page","lines",38],{"text":"STD risk reduction, an effect also evident in the sub-","fontSize":9.978,"x":67.02723200000003,"y":456.8668000000002,"width":227.5083780000001,"height":9.978000000000009}]
[["page","lines",39],{"text":"sample 45 years or older. There was no significant in-","fontSize":9.978,"x":67.02723200000003,"y":467.8426000000002,"width":227.54729219999996,"height":9.978000000000009}]
