[["page"],{"pageNumber":1,"width":595.276,"height":793.701,"lines":[{"text":"high-dose SCOP increased latency more than low-dose","fontSize":9.9626,"x":28.8,"y":527.5432000000001,"width":248.06176618,"height":9.962599999999952},{"text":"SCOP. For travel distance in the platform hidden blocks,","fontSize":9.9626,"x":28.8,"y":538.48512358,"width":248.08567642000003,"height":9.962599999999952},{"text":"there was trend towards a TMX treatment by SCOP dose","fontSize":9.9626,"x":28.8,"y":549.42704716,"width":248.00796813999995,"height":9.962600000000066},{"text":"reduced latency to find the hidden platform on blocks","fontSize":9.9626,"x":294.79843121999994,"y":527.5481813000001,"width":248.07471756,"height":9.962599999999952},{"text":"2 (t(41) = 2.11, p = 0.04) and 3 (t(41) = 2.16, p<0.04). There","fontSize":9.9626,"x":294.79843121999994,"y":538.4901048800001,"width":248.07571381999986,"height":9.962599999999952},{"text":"was also a APOE4 genotype by TMX treatment interaction","fontSize":9.9626,"x":294.7984312199999,"y":549.4320284600001,"width":248.01992325999993,"height":9.962600000000066},{"text":"Numbers represent least squared means (standard errors) for difference scores (challenge drug minus placebo). See text for challenge drug effects. Cognitive tasks are","fontSize":7.9702,"x":28.7975051599999,"y":468.5350058400001,"width":514.1010135799991,"height":7.970199999999977},{"text":"choice reaction time (CRT) test, digit span (DS), fluency test (FT), Buschke selective reminding test (SRT), virtual Morris water maze (MWM).","fontSize":7.9702,"x":28.7975051599999,"y":478.0028064200001,"width":449.96003205999966,"height":7.970199999999977}]}]
