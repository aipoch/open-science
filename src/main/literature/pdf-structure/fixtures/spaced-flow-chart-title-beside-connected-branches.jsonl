[["page","lines",3],{"text":"RESULTS","fontSize":11,"x":42,"y":437.4999,"width":43.39500000000001,"height":11}]
[["page","lines",4],{"text":"One hundred eighty-seven women were screened for","fontSize":10,"x":42,"y":451.9999,"width":228.03000000000003,"height":10}]
[["page","lines",5],{"text":"this trial, of whom 89 did not meet eligibility criteria","fontSize":10,"x":42,"y":463.9999,"width":228.05900000000003,"height":10}]
[["page","lines",6],{"text":"or refused to participate. In total, 98 participants were","fontSize":10,"x":42,"y":475.9999,"width":228.036,"height":10}]
[["page","lines",7],{"text":"randomly assigned to the pH-balanced gel (n=44) or","fontSize":10,"x":42,"y":487.9999,"width":228.03500000000003,"height":10}]
[["page","lines",8],{"text":"placebo group (n=42) between November 2007 and","fontSize":10,"x":41.998999999999995,"y":499.9999,"width":228.045,"height":10}]
[["page","lines",9],{"text":"November 2008 and were followed until April 2009.","fontSize":10,"x":41.99900000000001,"y":511.9999,"width":228.05100000000004,"height":10}]
[["page","lines",10],{"text":"The flow of participants is presented in the Consoli-","fontSize":10,"x":41.99900000000001,"y":523.9999,"width":228.04000000000002,"height":10}]
[["page","lines",11],{"text":"dated Standards of Reporting Trials diagram in Fig-","fontSize":10,"x":41.99900000000001,"y":535.9999,"width":228.02900000000005,"height":10}]
[["page","lines",12],{"text":"ure 1. About 12% of the participants were lost to","fontSize":10,"x":41.99900000000001,"y":547.9999,"width":228.04500000000002,"height":10}]
[["page","lines",13],{"text":"follow-up (n=12); five and seven participants had","fontSize":10,"x":41.99900000000001,"y":559.9999,"width":228.048,"height":10}]
[["page","lines",14],{"text":"been allocated to the pH-balanced gel and placebo","fontSize":10,"x":41.99800000000002,"y":571.9999,"width":228.03799999999993,"height":10}]
[["page","lines",15],{"text":"groups, respectively. Among them, three and two","fontSize":10,"x":41.99800000000002,"y":583.9999,"width":228.02200000000002,"height":10}]
[["page","lines",16],{"text":"women complained of vaginal irritation, two and two","fontSize":10,"x":41.99800000000002,"y":595.9999,"width":228.04600000000008,"height":10}]
[["page","lines",17],{"text":"women did not complete the application schedule,","fontSize":10,"x":41.99800000000002,"y":607.9999,"width":228.04,"height":10}]
[["page","lines",18],{"text":"and 0 and three women refused further treatment","fontSize":10,"x":41.99800000000002,"y":619.9999,"width":228.02300000000005,"height":10}]
[["page","lines",19],{"text":"because of inconvenience in the pH-balanced gel and","fontSize":10,"x":41.99800000000002,"y":631.9999,"width":228.032,"height":10}]
[["page","lines",20],{"text":"placebo groups, respectively. All adverse events were","fontSize":10,"x":41.99800000000002,"y":643.9999,"width":228.03800000000004,"height":10}]
[["page","lines",21],{"text":"considered to be mild in severity and self-limited. The","fontSize":10,"x":41.99800000000002,"y":655.9999,"width":228.04400000000012,"height":10}]
[["page","lines",22],{"text":"characteristics of all participants are described in","fontSize":10,"x":41.99800000000002,"y":667.9999,"width":228.04400000000007,"height":10}]
