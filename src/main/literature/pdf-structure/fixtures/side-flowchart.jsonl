[["lines",0],{"text":"1537Journal of Cancer Survivorship (2023) 17:1533–1545","fontSize":8.5,"x":51.02280426249996,"y":30.710970704000033,"width":493.22949065849997,"height":8.5}]
[["lines",1],{"text":"1 3","fontSize":15,"x":503.659912109,"y":730.1677999999999,"width":16.875000000000057,"height":15}]
[["lines",2],{"text":"for waist circumference than controls (Supplementary Mate-","fontSize":10,"x":51.023601531,"y":491.78280908299996,"width":238.2009999923701,"height":10}]
[["lines",3],{"text":"rial 2). Baseline QOL subscales revealed EMPOWER-SMS","fontSize":10,"x":51.023601531,"y":504.28280908299996,"width":238.20600000762994,"height":10}]
[["lines",4],{"text":"participants had significantly lower scores for body image","fontSize":10,"x":51.023601531,"y":516.782809083,"width":238.1139999999998,"height":10}]
[["lines",5],{"text":"and higher sexual enjoyment than controls (Supplementary","fontSize":10,"x":51.023601531,"y":529.282809083,"width":238.13000000000034,"height":10}]
[["lines",6],{"text":"Material 3).","fontSize":10,"x":51.023601531,"y":541.782809083,"width":47.82499999999999,"height":10}]
[["lines",7],{"text":"Effectiveness of the intervention","fontSize":11,"x":51.023601531,"y":565.782702271,"width":148.17879999579793,"height":11}]
[["lines",8],{"text":"Self-efficacy data were available for 138/158 (87.3%) ran-","fontSize":10,"x":51.023601531,"y":591.782702271,"width":238.11899999999991,"height":10}]
[["lines",9],{"text":"domised participants (66/78 [84.6%] EMPOWER-SMS;","fontSize":10,"x":51.023601531,"y":604.282702271,"width":237.98100001144013,"height":10}]
[["lines",10],{"text":"72/78 [92.3%] control). There were no significant differ-","fontSize":10,"x":51.023601531,"y":616.782702271,"width":238.10999999999996,"height":10}]
[["lines",11],{"text":"ences in self-efficacy at 6 months between EMPOWER-","fontSize":10,"x":51.023601531,"y":629.282702271,"width":237.96000001143994,"height":10}]
[["lines",12],{"text":"SMS and control groups (7.6 [95% CI 7.3, 7.9] and 7.6","fontSize":10,"x":51.023601531,"y":641.782702271,"width":238.11999999999983,"height":10}]
[["lines",13],{"text":"[7.3, 7.9], respectively, Adjusted mean difference 0 [95%","fontSize":10,"x":51.023601531,"y":654.282702271,"width":238.11399998856996,"height":10}]
[["lines",14],{"text":"CI − 0.4, 0.4], p = 0.924). A sensitivity analysis using com-","fontSize":10,"x":51.023601531,"y":666.782702271,"width":238.0910000038199,"height":10}]
[["lines",15],{"text":"plete case analysis was conducted to confirm the results,","fontSize":10,"x":51.023601531,"y":679.282702271,"width":238.0750000171701,"height":10}]
[["lines",16],{"text":"as there was more than 5% missing (completely-at-ran-","fontSize":10,"x":51.023601531,"y":691.782702271,"width":238.08900001527996,"height":10}]
[["lines",17],{"text":"dom) data and revealed no significant differences between","fontSize":10,"x":51.023601531,"y":704.282702271,"width":238.1370000038201,"height":10}]
[["lines",18],{"text":"EMPOWER-SMS and control groups (7.6 [95% CI 7.3,","fontSize":10,"x":306.143592831,"y":491.78270227099995,"width":238.03700001526067,"height":10}]
[["lines",19],{"text":"7.9] and 7.6 [95% CI 7.3, 7.9], respectively, p = 0.925).","fontSize":10,"x":306.143592831,"y":504.28270227099995,"width":238.17500001526014,"height":10}]
[["lines",20],{"text":"Overall, few participants missed ≥ 1 doses of endocrine","fontSize":10,"x":306.143592831,"y":516.782702271,"width":238.1899999885502,"height":10}]
[["lines",21],{"text":"therapy medication. However, there was a significant dif-","fontSize":10,"x":306.143592831,"y":529.282702271,"width":238.21000002860944,"height":10}]
[["lines",22],{"text":"ference between groups, with EMPOWER-SMS partici-","fontSize":10,"x":306.143592831,"y":541.782702271,"width":238.1500000228807,"height":10}]
[["lines",23],{"text":"pants missing less doses than control (I: 3/42 [7.1%], C:","fontSize":10,"x":306.143592831,"y":554.282702271,"width":238.0799999999998,"height":10}]
[["lines",24],{"text":"8/47 [17.0%], Adjusted RR 0.13 [95% CI 0.02, 0.91], p =","fontSize":10,"x":306.143592831,"y":566.782702271,"width":238.11,"height":10}]
[["lines",25],{"text":"0.040). There were no other significant differences between","fontSize":10,"x":306.143592831,"y":579.282702271,"width":237.95600000191075,"height":10}]
[["lines",26],{"text":"groups (Table 2; Supplementary Material 3). The proportion","fontSize":10,"x":306.143592831,"y":591.782702271,"width":237.98499997901956,"height":10}]
[["lines",27],{"text":"of participants meeting guideline recommendations was low","fontSize":10,"x":306.13359444099996,"y":604.282702271,"width":238.0830000076407,"height":10}]
[["lines",28],{"text":"and there were no significant differences between groups","fontSize":10,"x":306.13359444099996,"y":616.782702271,"width":238.2350000076404,"height":10}]
[["lines",29],{"text":"(Supplementary Material 2). Only 5/78 (6.4%) participants","fontSize":10,"x":306.13359444099996,"y":629.282702271,"width":238.09899999618,"height":10}]
[["lines",30],{"text":"in the EMPOWER-SMS group and 3/78 (3.8%) in the con-","fontSize":10,"x":306.13359444099996,"y":641.782702271,"width":238.12999999999994,"height":10}]
[["lines",31],{"text":"trol group were ‘current smokers’ at follow-up.","fontSize":10,"x":306.13359444099996,"y":654.282702271,"width":189.4279999961804,"height":10}]
[["lines",32],{"text":"Accelerometer data were available for 26/32 (81.2%)","fontSize":10,"x":317.47359444099993,"y":666.782702271,"width":226.83900001143934,"height":10}]
[["lines",33],{"text":"participants at baseline (14/16; 87.5% EMPOWER-SMS,","fontSize":10,"x":306.13359444099996,"y":679.282702271,"width":238.1000000000003,"height":10}]
[["lines",34],{"text":"12/16; 75.0% control) and 20/32 (62.5%) participants at","fontSize":10,"x":306.13359444099996,"y":691.782702271,"width":238.1259999999998,"height":10}]
