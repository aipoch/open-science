[[],{"page":{"pageNumber":2,"width":584.957,"height":782.986,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":2,"constructPath":10},"captionStarts":[{"text":"Fig 1. Example of Paxman Scalp Cooling System cap (courtesy of","fontSize":7.9702,"x":309.4298,"y":453.6238,"width":238.63496118,"height":7.970199999999977}],"headingCandidates":[],"lines":[],"graphicsBounds":[],"invalidGraphicsBounds":0},"captions":[{"page":2,"lines":["Fig 1. Example of Paxman Scalp Cooling System cap (courtesy of"],"rect":[309.4298,453.6238,548.06476118,461.594]}],"tables":[]}]
[["page","lines",0],{"text":"METHODS OF SCALP COOLING","fontSize":10.959,"x":36.9638,"y":93.01610000000005,"width":142.598508,"height":10.958999999999946}]
[["page","lines",1],{"text":"Scalp cooling has been used for prevention of chemotherapy-","fontSize":10.959,"x":36.9638,"y":106.96252340000001,"width":246.57750000000004,"height":10.958999999999946}]
[["page","lines",2],{"text":"induced alopecia since the 1970s, with early adoption in Europe","fontSize":10.959,"x":36.9638,"y":120.90894679999997,"width":246.57640409999988,"height":10.958999999999946}]
[["page","lines",3],{"text":"but slow uptake in the United States. Scalp cooling can be","fontSize":10.959,"x":36.9638,"y":134.85537019999992,"width":246.6629802000001,"height":10.958999999999946}]
[["page","lines",4],{"text":"accomplished using either manual cold caps, which consist of","fontSize":10.959,"x":36.9638,"y":148.80179359999988,"width":246.65530890000014,"height":10.958999999999946}]
[["page","lines",5],{"text":"shower cap–like head coverings that require chilling/freezing","fontSize":10.959,"x":36.9638,"y":162.74821699999984,"width":246.6816105000001,"height":10.958999999999946}]
[["page","lines",6],{"text":"and frequent changes throughout therapy to maintain scalp","fontSize":10.959,"x":36.9627041,"y":176.6946403999998,"width":246.6629802000001,"height":10.958999999999946}]
[["page","lines",7],{"text":"hypothermia, or automatic, machine-based cooling systems,","fontSize":10.959,"x":36.9627041,"y":190.64106379999976,"width":246.5709246,"height":10.958999999999946}]
[["page","lines",8],{"text":"which consistent of a tightly fitted cap connected to a device","fontSize":10.959,"x":36.9627041,"y":204.5874871999997,"width":246.54352709999995,"height":10.958999999999946}]
[["page","lines",9],{"text":"that circulates coolant through the cap and thus gradually cools","fontSize":10.959,"x":36.9627041,"y":218.53391059999967,"width":246.5753082,"height":10.958999999999946}]
[["page","lines",10],{"text":"the scalp to maintain a set temperature throughout treatment.","fontSize":10.959,"x":36.9627041,"y":232.48033399999963,"width":246.56325329999999,"height":10.958999999999946}]
[["page","lines",11],{"text":"Examples of manual cold cap systems include Penguin Cold","fontSize":10.959,"x":36.9627041,"y":246.4267573999996,"width":246.59613029999974,"height":10.958999999999946}]
[["page","lines",12],{"text":"Caps (Penguin Cold Caps, London, UK), Arctic Cold Caps","fontSize":10.959,"x":36.9627041,"y":260.37318079999955,"width":246.56873279999962,"height":10.959000000000003}]
[["page","lines",13],{"text":"(Arctic Cold Caps, Cherry Hill, NJ), Chemo Cold Caps (Che-","fontSize":10.959,"x":36.9627041,"y":274.31960419999956,"width":246.6366785999997,"height":10.959000000000003}]
[["page","lines",14],{"text":"motherapy Cold Caps, Dallas, TX), Wishcaps (Wishcaps,","fontSize":10.959,"x":36.9627041,"y":288.2660275999996,"width":246.52708859999973,"height":10.959000000000003}]
[["page","lines",15],{"text":"Cypress, TX), and Warrior Caps (Warrior Caps, Fort Worth,","fontSize":10.959,"x":36.9627041,"y":302.2124509999996,"width":246.52818449999967,"height":10.959000000000003}]
[["page","lines",16],{"text":"TX). The two machine-based systems are Dignicap (Dignitana,","fontSize":10.959,"x":36.9627041,"y":316.1588743999996,"width":246.54352709999972,"height":10.959000000000003}]
[["page","lines",17],{"text":"Dallas, TX) and Paxman Scalp Cooling System (Paxman Coolers","fontSize":10.959,"x":36.9627041,"y":330.1052977999996,"width":246.58188360000014,"height":10.959000000000003}]
[["page","lines",18],{"text":"Limited, Huddersfield, UK). An example of the Paxman Scalp","fontSize":10.959,"x":36.9627041,"y":344.05172119999963,"width":246.58955489999994,"height":10.959000000000003}]
[["page","lines",19],{"text":"Cooling System cap is shown in Figure 1. Scalp cooling is hy-","fontSize":10.959,"x":36.9627041,"y":357.99814459999965,"width":246.5818835999999,"height":10.959000000000003}]
[["page","lines",20],{"text":"pothesized to prevent chemotherapy-induced alopecia by lim-","fontSize":10.959,"x":36.9616082,"y":371.94456799999966,"width":246.61256880000008,"height":10.959000000000003}]
[["page","lines",21],{"text":"iting blood flow to hair follicles during treatment, thus decreasing","fontSize":10.959,"x":36.9616082,"y":385.9479781999997,"width":246.55119839999963,"height":10.959000000000003}]
[["page","lines",22],{"text":"exposure to chemotherapy but also decreasing metabolic rate","fontSize":10.959,"x":36.9616082,"y":399.8944015999997,"width":246.54243120000012,"height":10.959000000000003}]
[["page","lines",23],{"text":"of hair follicles, which may reduce their susceptibility to the","fontSize":10.959,"x":36.9616082,"y":413.8408249999997,"width":246.58517129999984,"height":10.959000000000003}]
[["page","lines",24],{"text":"damaging effects of chemotherapy.","fontSize":10.959,"x":36.9616082,"y":427.7872483999997,"width":137.82476760000011,"height":10.959000000000003}]
[["page","lines",25],{"text":"7,9","fontSize":7.3052,"x":174.6141,"y":426.5659,"width":8.66293139999999,"height":7.3052000000000135}]
[["page","lines",26],{"text":"Early data on scalp cooling were largely retrospective in","fontSize":10.959,"x":50.9102,"y":441.7342,"width":232.68148799999986,"height":10.959000000000003}]
[["page","lines",27],{"text":"nature; however, recent prospective trials have added to our","fontSize":10.959,"x":36.9637766,"y":455.6806234,"width":246.56982869999973,"height":10.959000000000003}]
[["page","lines",28],{"text":"understanding of scalp-cooling techniques and outcomes. Many","fontSize":10.959,"x":36.9637766,"y":469.6270468,"width":246.5807876999997,"height":10.959000000000003}]
[["page","lines",29],{"text":"of the data on scalp cooling come from the breast cancer liter-","fontSize":10.959,"x":36.9637766,"y":483.57347020000003,"width":246.59613029999997,"height":10.959000000000003}]
[["page","lines",30],{"text":"ature, although the chemotherapeutic agents used in this setting","fontSize":10.959,"x":36.9637766,"y":497.51989360000005,"width":246.5643492000001,"height":10.959000000000003}]
[["page","lines",31],{"text":"are commonly used in the treatment of a wide range of malig-","fontSize":10.959,"x":36.9637766,"y":511.46631700000006,"width":246.60489750000005,"height":10.959000000000003}]
[["page","lines",32],{"text":"nancies. It should be noted that scalp-cooling studies gener-","fontSize":10.959,"x":36.9637766,"y":525.4127404000001,"width":246.57750000000016,"height":10.958999999999946}]
[["page","lines",33],{"text":"ally exclude patients with hematologic malignancies because of","fontSize":10.959,"x":36.9637766,"y":539.3591638,"width":246.55558199999962,"height":10.95900000000006}]
[["page","lines",34],{"text":"concerns about reducing efficacy of therapy by decreasing","fontSize":10.959,"x":36.9637766,"y":553.3055872,"width":246.56654099999986,"height":10.95900000000006}]
[["page","lines",35],{"text":"chemotherapy delivered to malignant cells circulating in the field","fontSize":10.959,"x":36.9637766,"y":567.2520106,"width":246.5511983999997,"height":10.95900000000006}]
[["page","lines",36],{"text":"ofcooling.","fontSize":10.959,"x":36.9637766,"y":581.198434,"width":39.80527980000001,"height":10.958999999999946}]
[["page","lines",37],{"text":"10","fontSize":7.3052,"x":76.5921,"y":579.9769,"width":7.132534979999988,"height":7.3052000000000135}]
[["page","lines",38],{"text":"Scalp cooling should also be avoided in patients with","fontSize":10.959,"x":85.1527,"y":581.1986999999999,"width":198.4214622,"height":10.95900000000006}]
[["page","lines",39],{"text":"history of cold agglutinin disease, cryoglobulinemia, and cold-","fontSize":10.959,"x":36.9637852,"y":595.1451234,"width":246.5851713000005,"height":10.958999999999946}]
[["page","lines",40],{"text":"induced migraines, because of the potential for exacerbation of","fontSize":10.959,"x":36.9637852,"y":609.0915468,"width":246.58626719999992,"height":10.958999999999946}]
[["page","lines",41],{"text":"these conditions with prolonged exposure to cold temperatures.","fontSize":10.959,"x":36.9637852,"y":623.0379701999999,"width":246.57311639999992,"height":10.95900000000006}]
[["page","lines",42],{"text":"SCALP-COOLING STUDIES","fontSize":10.959,"x":36.9637852,"y":650.9308169999999,"width":120.47995830000002,"height":10.95900000000006}]
[["page","lines",43],{"text":"The Dutch Scalp Cooling Registry consists of . 1,400 patients","fontSize":10.959,"x":36.9637852,"y":664.8772403999999,"width":246.64873350000002,"height":10.95900000000006}]
[["page","lines",44],{"text":"treated with chemotherapy and scalp cooling.","fontSize":10.959,"x":36.96378519999999,"y":678.8236638,"width":188.51671799999997,"height":10.958999999999946}]
[["page","lines",45],{"text":"11","fontSize":7.3052,"x":225.3543,"y":677.6021,"width":7.347875399999992,"height":7.3052000000000135}]
[["page","lines",46],{"text":"Patients re-","fontSize":10.959,"x":236.5228,"y":678.8239,"width":47.09630250000001,"height":10.958999999999946}]
[["page","lines",47],{"text":"ceiving chemotherapy and scalp cooling (using the Paxman","fontSize":10.959,"x":36.9637936,"y":692.7703233999999,"width":246.67941870000007,"height":10.95900000000006}]
[["page","lines",48],{"text":"PSC1 or PSC2 systems) from 28 hospitals in the Netherlands,","fontSize":10.959,"x":36.9637936,"y":706.7167468,"width":246.64215809999988,"height":10.958999999999946}]
[["page","lines",49],{"text":"including community and academic sites, were asked by nurses","fontSize":10.959,"x":36.9637936,"y":720.6631702,"width":246.65202120000012,"height":10.95900000000006}]
[["page","lines",50],{"text":"to participate in the registry study at the time of treatment","fontSize":10.959,"x":301.4921356,"y":483.4599988,"width":246.66955559999997,"height":10.959000000000003}]
[["page","lines",51],{"text":"initiation. Basic demographic information, treatment regimen,","fontSize":10.959,"x":301.4921356,"y":497.4064222,"width":246.6607883999999,"height":10.959000000000003}]
[["page","lines",52],{"text":"hair characteristics, cooling time parameters, and reasons for","fontSize":10.959,"x":301.4921356,"y":511.3528456,"width":246.5764041,"height":10.958999999999946}]
[["page","lines",53],{"text":"discontinuing scalp cooling were recorded. Scalp-cooling","fontSize":10.959,"x":301.4921356,"y":525.2992690000001,"width":246.52489680000008,"height":10.958999999999946}]
[["page","lines",54],{"text":"treatment was deemed successful if a patient reported not","fontSize":10.959,"x":301.4921356,"y":539.2456924,"width":246.58407539999985,"height":10.958999999999946}]
[["page","lines",55],{"text":"wearing a head cover during their final scalp-cooling session.","fontSize":10.959,"x":301.4921356,"y":553.1921158,"width":246.5501025000001,"height":10.958999999999946}]
[["page","lines",56],{"text":"This was considered a key metric of success of cooling therapy,","fontSize":10.959,"x":301.4921356,"y":567.1385392,"width":246.58078769999997,"height":10.95900000000006}]
[["page","lines",57],{"text":"because it represents patient perception of successful hair","fontSize":10.959,"x":301.4921356,"y":581.0849625999999,"width":246.61147290000076,"height":10.95900000000006}]
[["page","lines",58],{"text":"preservation rather than objective measurement of hair re-","fontSize":10.959,"x":301.4921356,"y":595.0313859999999,"width":246.56654100000003,"height":10.95900000000006}]
[["page","lines",59],{"text":"tention. Severity of hair loss on the standardized WHO scale","fontSize":10.959,"x":301.4921356,"y":608.9778094,"width":246.5457189,"height":10.958999999999946}]
[["page","lines",60],{"text":"(0 for no hair loss, 1 for minimal hair loss, 2 for severe hair loss,","fontSize":10.959,"x":301.4921356,"y":622.9242327999999,"width":246.53147220000005,"height":10.958999999999946}]
[["page","lines",61],{"text":"and 3 for total alopecia) per patient report was also documented.","fontSize":10.959,"x":301.4921356,"y":636.8706561999999,"width":246.56982869999945,"height":10.95900000000006}]
[["page","lines",62],{"text":"The vast majority of patients in this study were women who","fontSize":10.959,"x":315.438559,"y":650.8170795999999,"width":232.6003914000002,"height":10.958999999999946}]
[["page","lines",63],{"text":"were receiving adjuvant therapy for breast cancer; however, 4%","fontSize":10.959,"x":301.4921356,"y":664.7635029999999,"width":246.52599269999928,"height":10.95900000000006}]
[["page","lines",64],{"text":"of patients included were men and 14% of patients had ma-","fontSize":10.959,"x":301.4921356,"y":678.7099263999999,"width":246.63010319999944,"height":10.95900000000006}]
[["page","lines",65],{"text":"lignancies other than breast cancer. As is typical of many scalp-","fontSize":10.959,"x":301.4921356,"y":692.7133365999999,"width":246.5183214000009,"height":10.958999999999946}]
[["page","lines",66],{"text":"cooling protocols, the median duration of cooling before","fontSize":10.959,"x":301.4921356,"y":706.6597599999999,"width":246.4887320999992,"height":10.95900000000006}]
[["page","lines",67],{"text":"chemotherapy infusion was 38 minutes, and the median","fontSize":10.959,"x":301.4921356,"y":720.6061834,"width":246.48873209999908,"height":10.958999999999946}]
[["page","lines",68],{"text":"Fig 1. Example of Paxman Scalp Cooling System cap (courtesy of","fontSize":7.9702,"x":309.4298,"y":453.6238,"width":238.63496118,"height":7.970199999999977}]
[["page","lines",69],{"text":"Cleveland Clinic).","fontSize":7.9702,"x":301.49307484,"y":464.56529056,"width":54.464361699999984,"height":7.970199999999977}]
[["page","lines",70],{"text":"150","fontSize":10.959,"x":36.9638,"y":749.1231,"width":14.586429000000003,"height":10.958999999999946}]
