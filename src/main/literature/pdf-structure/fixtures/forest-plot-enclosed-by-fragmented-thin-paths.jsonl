[["page","lines",0],{"text":"Authors et al.Oncology","fontSize":9.5,"x":138.189,"y":723.8240000000001,"width":320.345,"height":9.5}]
[["page","lines",1],{"text":"DOI: 10.0000/example","fontSize":8.25,"x":138.189,"y":733.664875,"width":82.80525000000003,"height":8.25}]
[["page","lines",2],{"text":"4","fontSize":9.5,"x":51.0236,"y":723.8240000000001,"width":4.468800000000002,"height":9.5}]
[["page","lines",3],{"text":"Questionnaire Response Rate","fontSize":11,"x":63.7795,"y":430.892,"width":125.80700000000003,"height":11}]
[["page","lines",4],{"text":"We calculated the proportions of those who were on","fontSize":11,"x":63.7795,"y":443.642,"width":235.98751,"height":11}]
[["page","lines",5],{"text":"first-line treatment and responded to the questionnaire.","fontSize":11,"x":51.024109,"y":456.39209999999997,"width":248.73734600000006,"height":11}]
[["page","lines",6],{"text":"The response rates at each response time point were","fontSize":11,"x":51.024109,"y":469.14219999999995,"width":248.74179000000004,"height":11}]
[["page","lines",7],{"text":"100% (386/386) at the start of follow-up (by the defini-","fontSize":11,"x":51.024109,"y":481.8922999999999,"width":248.73734599999995,"height":11}]
[["page","lines",8],{"text":"tion of our PRO analysis population), 90.9% (279/307)","fontSize":11,"x":51.024109,"y":494.6423999999999,"width":248.73956799999996,"height":11}]
[["page","lines",9],{"text":"at 3 months, 87.0% (180/207) at 6 months, and 86.9%","fontSize":11,"x":51.024109,"y":507.39249999999987,"width":248.74623400000002,"height":11.000000000000057}]
[["page","lines",10],{"text":"(86/99) at 12 months after the start of protocol treatment.","fontSize":11,"x":51.024109,"y":520.1425999999999,"width":248.74512299999998,"height":11}]
[["page","lines",11],{"text":"The questionnaire response rate in the S-1 group was","fontSize":11,"x":51.024109,"y":532.8926999999999,"width":248.73512400000004,"height":11}]
[["page","lines",12],{"text":"higher (90.3%) than in the taxane group (81.1%) at 12","fontSize":11,"x":51.024109,"y":545.6427999999999,"width":248.73956800000008,"height":11}]
[["page","lines",13],{"text":"months.","fontSize":11,"x":51.024109,"y":558.3928999999998,"width":36.77410000000001,"height":11}]
[["page","lines",14],{"text":"EORTC QLQ-C30","fontSize":11,"x":63.7795,"y":583.8921,"width":79.266,"height":11}]
[["page","lines",15],{"text":"Figures 1 and 2 show the results of the time-to-deteri-","fontSize":11,"x":63.7795,"y":596.6422,"width":235.98850000000004,"height":11}]
[["page","lines",16],{"text":"oration and the time-to-improvement analysis, respec-","fontSize":11,"x":51.0239,"y":609.3923,"width":248.73750000000015,"height":11}]
[["page","lines",17],{"text":"tively. It was shown that S-1 had a clinically better effect","fontSize":11,"x":51.0239,"y":622.1424000000001,"width":248.732,"height":11}]
[["page","lines",18],{"text":"on 6 scales: the scores on physical, role, and social func-","fontSize":11,"x":51.0239,"y":634.8925,"width":248.74299999999997,"height":11}]
[["page","lines",19],{"text":"tioning, as well as financial difficulties, had deteriorated","fontSize":11,"x":51.0239,"y":647.6426,"width":248.73309999999995,"height":11}]
[["page","lines",20],{"text":"more slowly in the S-1 group than in the taxane group","fontSize":11,"x":51.0239,"y":660.3927000000001,"width":248.74300000000008,"height":11}]
[["page","lines",21],{"text":"( Fig. 1 ), and global health status/QoL and the symptom","fontSize":11,"x":51.0239,"y":673.1428000000001,"width":248.74629999999993,"height":11}]
[["page","lines",22],{"text":"of constipation had improved more rapidly in the S-1","fontSize":11,"x":51.0239,"y":685.8929,"width":248.73200000000006,"height":11}]
[["page","lines",23],{"text":"group than in the taxane group (Fig. 2 ). The subgroup","fontSize":11,"x":312.5203,"y":430.89310000000006,"width":248.73529999999994,"height":11}]
[["page","lines",24],{"text":"analysis among patients with triple-negative breast can-","fontSize":11,"x":312.5203,"y":443.64320000000004,"width":248.7342,"height":11}]
[["page","lines",25],{"text":"cer showed a significant delay in deterioration of nausea","fontSize":11,"x":312.5203,"y":456.3933,"width":248.73199999999997,"height":11}]
[["page","lines",26],{"text":"and vomiting in the taxane group compared with the S-1","fontSize":11,"x":312.5203,"y":469.1434,"width":248.7419,"height":11}]
[["page","lines",27],{"text":"group (hazard ratio = 2.3, p < 0.01). In the other scales,","fontSize":11,"x":312.5203,"y":481.89349999999996,"width":248.7385999999999,"height":11}]
[["page","lines",28],{"text":"there were no significant differences between the treat-","fontSize":11,"x":312.5203,"y":494.64359999999994,"width":248.73419999999987,"height":11}]
[["page","lines",29],{"text":"ment groups in this subgroup analysis (p > 0.1).","fontSize":11,"x":312.5203,"y":507.3936999999999,"width":209.73260000000005,"height":10.999999999999943}]
[["page","lines",30],{"text":"Figure 3 shows the CDF plots of global health status/","fontSize":11,"x":325.27590000000004,"y":520.1437999999998,"width":235.9829999999999,"height":11}]
[["page","lines",31],{"text":"QoL and the QLQ-C30 summary score 6 months after the","fontSize":11,"x":312.5203,"y":532.8938999999999,"width":248.73969999999974,"height":11}]
[["page","lines",32],{"text":"start of protocol treatment. The appearance of the CDF","fontSize":11,"x":312.5203,"y":545.6439999999999,"width":248.7385999999999,"height":11}]
[["page","lines",33],{"text":"plots does not change substantially at 3 or 12 months,","fontSize":11,"x":312.5203,"y":558.3940999999999,"width":248.7364,"height":11}]
[["page","lines",34],{"text":"which is why we decided to focus on the CDF plots at 6","fontSize":11,"x":312.5203,"y":571.1442,"width":248.72979999999984,"height":11}]
[["page","lines",35],{"text":"months only. Note that it is preferable that the CDF plot","fontSize":11,"x":312.5203,"y":583.8942999999999,"width":248.73199999999997,"height":11}]
[["page","lines",36],{"text":"trend to the right for global health status/QoL and the","fontSize":11,"x":312.5203,"y":596.6443999999999,"width":248.74080000000015,"height":11}]
[["page","lines",37],{"text":"QLQ-C30 summary score. The CDF plots of global health","fontSize":11,"x":312.5203,"y":609.3944999999999,"width":248.74299999999982,"height":11}]
[["page","lines",38],{"text":"status/QoL overlap in the area where the change from","fontSize":11,"x":312.5203,"y":622.1445999999999,"width":248.73200000000008,"height":11}]
[["page","lines",39],{"text":"baseline is negative, while they are apart from each other","fontSize":11,"x":312.5203,"y":634.8947,"width":248.7440999999999,"height":11}]
[["page","lines",40],{"text":"in the area where the change from baseline is positive.","fontSize":11,"x":312.5203,"y":647.6447999999999,"width":248.7397000000003,"height":11}]
[["page","lines",41],{"text":"This suggests that S-1 tends to improve the global health","fontSize":11,"x":312.5203,"y":660.3948999999999,"width":248.7275999999997,"height":11}]
[["page","lines",42],{"text":"status/QoL, but the degree of deterioration is similar with","fontSize":11,"x":312.5203,"y":673.145,"width":248.7452000000003,"height":11}]
[["page","lines",43],{"text":"S-1 and taxane. Therefore, the CDF plot of global health","fontSize":11,"x":312.5203,"y":685.8951,"width":248.73640000000012,"height":11}]
[["page","lines",44],{"text":"Fig. 1. Results of the responder (time-to-deterioration) analysis of the European Organisation for the Research","fontSize":9.5,"x":138.189,"y":353.56800000000004,"width":423.0829,"height":9.5}]
[["page","lines",45],{"text":"and Treatment of Cancer Quality of Life Questionnaire Core 30, showing estimated hazard ratios with the taxane","fontSize":9.5,"x":138.1894,"y":364.17855000000003,"width":423.0559000000002,"height":9.5}]
[["page","lines",46],{"text":"group as the reference group. A hazard ratio <1 means that there was slower deterioration in the S-1 group than","fontSize":9.5,"x":138.1894,"y":374.7891,"width":423.08250000000044,"height":9.5}]
[["page","lines",47],{"text":"in the taxane group. QoL, quality of life; HR, hazard ratio; CI, confidence interval.","fontSize":9.5,"x":138.1894,"y":385.39965,"width":311.068,"height":9.5}]
