[["pages",0,"lines",0],{"text":"yoga poses and psychoeducational themes used in the study. Table 1","fontSize":7.9702,"x":51.0236,"y":402.0332,"width":235.27791293999996,"height":7.970199999999977}]
[["pages",0,"lines",1],{"text":"presents the list of poses.","fontSize":7.9702,"x":51.0236,"y":412.97469000000007,"width":88.43973025999996,"height":7.970199999999977}]
[["pages",0,"lines",2],{"text":"Measurements","fontSize":9.4646,"x":51.0236,"y":451.33570000000003,"width":60.9709532,"height":9.464600000000019}]
[["pages",0,"lines",3],{"text":"The measurements were taken at baseline, 8 weeks, and 16 weeks.","fontSize":7.9702,"x":51.0236,"y":476.75450000000006,"width":235.30660565999983,"height":7.970199999999977}]
[["pages",0,"lines",4],{"text":"The outcomes were measured on the same time schedule for both","fontSize":7.9702,"x":51.0236,"y":487.69599000000005,"width":235.2986354599999,"height":7.970199999999977}]
[["pages",0,"lines",5],{"text":"groups, except at 16 weeks, which was used to measure the WL","fontSize":7.9702,"x":51.0236,"y":498.63748000000004,"width":235.26197254000004,"height":7.970199999999977}]
[["pages",0,"lines",6],{"text":"control group exclusively. Medical and demographic information","fontSize":7.9702,"x":51.0236,"y":509.63636,"width":235.320155,"height":7.97019999999992}]
[["pages",0,"lines",7],{"text":"was obtained by nurses and the research assistant using medical","fontSize":7.9702,"x":51.0236,"y":520.5778500000001,"width":235.34884771999992,"height":7.970199999999977}]
[["pages",0,"lines",8],{"text":"records and study-specific forms. Participants in the BYP-BC group","fontSize":7.9702,"x":51.0236,"y":531.51934,"width":235.32095202,"height":7.970199999999977}]
[["pages",0,"lines",9],{"text":"were asked to record their home yoga practice in a diary, while the","fontSize":7.9702,"x":51.0236,"y":542.46083,"width":235.30341757999997,"height":7.970199999999977}]
[["pages",0,"lines",10],{"text":"WL control group kept a daily diary of their activities during the","fontSize":7.9702,"x":51.0236,"y":553.4597,"width":235.30341757999992,"height":7.970200000000091}]
[["pages",0,"lines",11],{"text":"waiting period and then during the yoga training.","fontSize":7.9702,"x":51.0236,"y":564.4012,"width":173.77267655999992,"height":7.970199999999977}]
[["pages",0,"lines",12],{"text":"Depression symptoms were measured using the Beck Depression","fontSize":7.9702,"x":59.01771,"y":575.34269,"width":227.3730685799999,"height":7.970200000000091}]
[["pages",0,"lines",13],{"text":"Inventory II (BDI-II), which is a 21-item self-rated inventory asses-","fontSize":7.9702,"x":51.0236,"y":586.3415600000001,"width":235.32414010000002,"height":7.970199999999977}]
[["pages",0,"lines",14],{"text":"sing the presence and severity of depression symptoms in the past","fontSize":7.9702,"x":51.0236,"y":597.28305,"width":235.30182353999993,"height":7.970199999999977}]
[["pages",0,"lines",15],{"text":"2 weeks based on DSM-IV criteria. The lowest possible score is 0 and","fontSize":7.9702,"x":51.0236,"y":608.22454,"width":235.27631889999986,"height":7.970199999999977}]
[["pages",0,"lines",16],{"text":"the highest possible score is 63. The scores are to be interpreted as","fontSize":7.9702,"x":51.0236,"y":619.22342,"width":235.30979373999992,"height":7.970199999999977}]
[["pages",0,"lines",17],{"text":"follows: 0–10 (minimal ups and downs are considered normal);","fontSize":7.9702,"x":51.0236,"y":630.16491,"width":235.31297935999993,"height":7.970200000000091}]
[["pages",0,"lines",18],{"text":"11–16 (mild mood disturbance); 17–20 (borderline clinical depres-","fontSize":7.9702,"x":51.0244,"y":641.1064,"width":235.35043971999994,"height":7.970199999999977}]
[["pages",0,"lines",19],{"text":"sion); 21–30 (moderate depression); 31–40 (severe depression); over","fontSize":7.9702,"x":51.02519,"y":652.04789,"width":235.33290734000002,"height":7.970199999999977}]
[["pages",0,"lines",20],{"text":"40 (extreme depression). Internal consistency is 0.90 and test re-test","fontSize":7.9702,"x":51.02519,"y":663.04677,"width":235.32812519999993,"height":7.970199999999977}]
[["pages",0,"lines",21],{"text":"reliability is 0.62 [33].","fontSize":7.9702,"x":51.02519,"y":673.98826,"width":75.11355585999999,"height":7.970200000000091}]
[["pages",0,"lines",22],{"text":"Anxiety was measured using the State-Trait Anxiety Inventory","fontSize":7.9702,"x":59.0193,"y":684.92975,"width":227.3093069800001,"height":7.970199999999977}]
[["pages",0,"lines",23],{"text":"(STAI-Y), which is a self-rated inventory assessing state and trait","fontSize":7.9702,"x":51.02519,"y":695.92862,"width":235.26755168000005,"height":7.970199999999977}]
[["pages",0,"lines",24],{"text":"anxiety on a four-point scale (from 1 = Almost Never to 4 = Almost","fontSize":7.9702,"x":51.02519,"y":706.8701100000001,"width":235.21415133999983,"height":7.970199999999977}]
[["pages",0,"lines",25],{"text":"Always). Only the 20-item state anxiety inventory was used in this","fontSize":7.9702,"x":297.63992,"y":67.99562000000003,"width":235.30341758000003,"height":7.970199999999977}]
[["pages",0,"lines",26],{"text":"study. The lowest possible score is 20 and the highest possible","fontSize":7.9702,"x":297.63992,"y":78.99369999999999,"width":235.29465035999993,"height":7.970199999999977}]
[["pages",0,"lines",27],{"text":"score is 80. Higher scores indicate greater anxiety. Mean score for","fontSize":7.9702,"x":297.63992,"y":89.93519000000003,"width":235.26197253999993,"height":7.970199999999977}]
[["pages",0,"lines",28],{"text":"healthy adult women is 32.20 (SD = 8.67) while the mean score for","fontSize":7.9702,"x":297.63992,"y":100.87668000000008,"width":235.26197253999993,"height":7.970199999999977}]
[["pages",0,"lines",29],{"text":"general and medical surgical women is 42.38 (SD = 13.7). The","fontSize":7.9702,"x":297.63992,"y":111.87556000000006,"width":235.2978384399998,"height":7.970199999999977}]
[["pages",0,"lines",30],{"text":"Internal consistency is 0.90 and test–retest reliability ranges from","fontSize":7.9702,"x":297.63992,"y":122.81705,"width":235.30899968,"height":7.970199999999977}]
[["pages",0,"lines",31],{"text":"0.43 to 0.89 [34].","fontSize":7.9702,"x":297.63992,"y":133.75854000000004,"width":60.359918639999876,"height":7.970199999999977}]
[["pages",0,"lines",32],{"text":"Stressful life events were measured using the Life Events Stress","fontSize":7.9702,"x":305.63403,"y":144.75741000000005,"width":227.31408909999976,"height":7.970199999999977}]
[["pages",0,"lines",33],{"text":"Scale, French version. It includes 10 statements about stressful","fontSize":7.9702,"x":297.63992,"y":155.6989000000001,"width":235.34008049999994,"height":7.970199999999977}]
[["pages",0,"lines",34],{"text":"events. For each event, the participant had to indicate the presence,","fontSize":7.9702,"x":297.63992,"y":166.64039000000002,"width":235.3560208999998,"height":7.970199999999977}]
[["pages",0,"lines",35],{"text":"absence, and intensity of stress in the last 6 months. Internal con-","fontSize":7.9702,"x":297.63992,"y":177.63927,"width":235.28588313999995,"height":7.970199999999977}]
[["pages",0,"lines",36],{"text":"sistency is 0.87 [35].","fontSize":7.9702,"x":297.63992,"y":188.58076000000005,"width":69.94886625999999,"height":7.970199999999977}]
[["pages",0,"lines",37],{"text":"Social support was measured using the Social Support Survey","fontSize":7.9702,"x":305.63403,"y":199.5222500000001,"width":227.3180741999999,"height":7.970199999999977}]
[["pages",0,"lines",38],{"text":"(MOS), French version. It is an eight-item survey assessing the","fontSize":7.9702,"x":297.63992,"y":210.46374000000003,"width":235.30341758000003,"height":7.970199999999977}]
[["pages",0,"lines",39],{"text":"frequency of available social support (from Never to Always).","fontSize":7.9702,"x":297.63992,"y":221.46182,"width":235.34247155999998,"height":7.970199999999977}]
[["pages",0,"lines",40],{"text":"Internal consistency is 0.88 [36].","fontSize":7.9702,"x":297.63992,"y":232.40331000000003,"width":113.09155886000019,"height":7.970199999999977}]
[["pages",0,"lines",41],{"text":"The usefulness of the BYP-BC intervention was measured using a","fontSize":7.9702,"x":305.63403,"y":243.34480000000008,"width":227.25750067999996,"height":7.970199999999977}]
[["pages",0,"lines",42],{"text":"questionnaire designed specifically for the study. It was an eight-","fontSize":7.9702,"x":297.63992,"y":254.34288000000004,"width":235.2739278400001,"height":7.970199999999977}]
[["pages",0,"lines",43],{"text":"item survey assessing the extent to which each component of the","fontSize":7.9702,"x":297.63992,"y":265.2843700000001,"width":235.30421459999985,"height":7.970199999999977}]
[["pages",0,"lines",44],{"text":"yoga intervention was useful (0 = Not at all, 4 = Extremely).","fontSize":7.9702,"x":297.63992,"y":276.22586,"width":205.47414706,"height":7.970200000000034}]
[["pages",0,"lines",45],{"text":"Analysis","fontSize":9.4646,"x":297.6377,"y":309.6034,"width":34.971697000000006,"height":9.464600000000019}]
[["pages",0,"lines",46],{"text":"An intention-to-treat analysis using multiple imputations was","fontSize":7.9702,"x":297.6377,"y":335.02220000000005,"width":235.34087751999925,"height":7.970199999999977}]
[["pages",0,"lines",47],{"text":"employed in order to handle missing data and include every ran-","fontSize":7.9702,"x":297.6377,"y":345.96369000000004,"width":235.26755168000022,"height":7.970199999999977}]
[["pages",0,"lines",48],{"text":"domized participant [37]. Multiple imputation consists in filling","fontSize":7.9702,"x":297.6377,"y":356.96257,"width":235.27950697999984,"height":7.970199999999977}]
[["pages",0,"lines",49],{"text":"missing data by estimating their values including the standard","fontSize":7.9702,"x":297.6377,"y":367.9040600000001,"width":235.28668016000006,"height":7.970199999999977}]
[["pages",0,"lines",50],{"text":"error for each imputation. As suggested by Bodner [38], the number","fontSize":7.9702,"x":297.6377,"y":378.84555000000006,"width":235.22451260000003,"height":7.970199999999977}]
[["pages",0,"lines",51],{"text":"of imputations should match the percentage of missing data. After","fontSize":7.9702,"x":297.6377,"y":389.84363,"width":235.22451260000014,"height":7.970199999999977}]
[["pages",0,"lines",52],{"text":"analyzing the percentage of missing data and concluding it was","fontSize":7.9702,"x":297.6377,"y":400.78512000000006,"width":235.27950698000018,"height":7.970199999999977}]
[["pages",0,"lines",53],{"text":"missing at random, 21 imputations were carried out.","fontSize":7.9702,"x":297.6377,"y":411.72661000000005,"width":185.68732854000075,"height":7.970199999999977}]
[["pages",0,"lines",54],{"text":"Participants’ clinical and sociodemographic characteristics were","fontSize":7.9702,"x":305.63181,"y":422.66810000000004,"width":227.2949612199999,"height":7.970199999999977}]
[["pages",0,"lines",55],{"text":"analyzed using univariate analyses for continuous variables and χ","fontSize":7.9702,"x":297.6377,"y":433.66618000000005,"width":232.65651360000004,"height":7.970199999999977}]
[["pages",0,"lines",56],{"text":"2","fontSize":5.3127,"x":530.3054,"y":432.75370000000004,"width":2.6121237999999494,"height":5.312700000000007}]
[["pages",0,"lines",57],{"text":"tests for categorical variables to determine between group differ-","fontSize":7.9702,"x":297.6377,"y":444.60960000000006,"width":235.2803039999999,"height":7.970199999999977}]
[["pages",0,"lines",58],{"text":"ences and potential covariate variables.","fontSize":7.9702,"x":297.6377,"y":455.55109000000004,"width":137.97611730000006,"height":7.970199999999977}]
[["pages",0,"lines",59],{"text":"The primary goal was to evaluate the effects of the BYP-BC inter-","fontSize":7.9702,"x":305.63181,"y":466.54997000000003,"width":227.31887122,"height":7.970199999999977}]
[["pages",0,"lines",60],{"text":"vention on depression and anxiety symptoms. Repeated measures","fontSize":7.9702,"x":297.6377,"y":477.49146,"width":235.3368924199999,"height":7.970199999999977}]
[["pages",0,"lines",61],{"text":"ANOVA were conducted using symptom scale scores as outcome","fontSize":7.9702,"x":297.6377,"y":488.43295000000006,"width":235.3185609599998,"height":7.970199999999977}]
[["pages",0,"lines",62],{"text":"variables and the BYP-BC intervention as the independent variable.","fontSize":7.9702,"x":297.6377,"y":499.43103,"width":235.31218479999995,"height":7.970199999999977}]
[["pages",0,"lines",63],{"text":"Upon significant interactions, independent t-tests were conducted","fontSize":7.9702,"x":297.6377,"y":510.37252000000007,"width":235.26755168,"height":7.970200000000034}]
[["pages",0,"lines",64],{"text":"within each group to assess symptom changes, and posttreatment","fontSize":7.9702,"x":297.6377,"y":521.31401,"width":235.25878446000002,"height":7.970199999999977}]
[["pages",0,"lines",65],{"text":"ANCOVA were also carried out with the baseline score as a covariate","fontSize":7.9702,"x":297.6377,"y":532.31209,"width":235.3384864599999,"height":7.970199999999977}]
[["pages",0,"lines",66],{"text":"variable. Lastly, a repeated measures analysis was conducted for the","fontSize":7.9702,"x":297.6377,"y":543.25358,"width":235.30182354,"height":7.970199999999977}]
[["pages",0,"lines",67],{"text":"WL control group at 16 weeks to determine the BYP-BC interven-","fontSize":7.9702,"x":297.6377,"y":554.19507,"width":235.31457585999988,"height":7.970199999999977}]
[["pages",0,"lines",68],{"text":"tion’s effects in the later stages of cancer trajectory. Alpha level was","fontSize":7.9702,"x":297.6377,"y":565.13656,"width":235.30262233999997,"height":7.970199999999977}]
[["pages",0,"lines",69],{"text":"set at 0.05 and effect sizes (root square of eta coefficient) were also","fontSize":7.9702,"x":297.6377,"y":576.13464,"width":235.28508611999985,"height":7.970199999999977}]
[["pages",0,"lines",70],{"text":"reported.","fontSize":7.9702,"x":297.6377,"y":587.07613,"width":31.107690600000012,"height":7.970199999999977}]
[["pages",0,"lines",71],{"text":"A secondary analysis was performed to identify which aspect","fontSize":7.9702,"x":305.63181,"y":598.0176200000001,"width":227.28778743999987,"height":7.970199999999977}]
[["pages",0,"lines",72],{"text":"of the BYP-BC intervention participants found most useful. The","fontSize":7.9702,"x":297.6377,"y":609.0157,"width":235.30501161999985,"height":7.970199999999977}]
[["pages",0,"lines",73],{"text":"following components were compared using a repeated measure","fontSize":7.9702,"x":297.6377,"y":619.9571900000001,"width":235.29385561999993,"height":7.970199999999977}]
[["pages",0,"lines",74],{"text":"non-parametric analysis (Friedman): explanation of each ses-","fontSize":7.9702,"x":297.6377,"y":630.89868,"width":235.35123877999933,"height":7.970199999999977}]
[["pages",0,"lines",75],{"text":"sion’s theme, guided relaxation, poses/breathing techniques,","fontSize":7.9702,"x":297.6377,"y":641.8967600000001,"width":235.2587417660202,"height":7.970199999999977}]
[["pages",0,"lines",76],{"text":"meditation while listening to the OM chant, meeting fellow par-","fontSize":7.9702,"x":297.6377,"y":652.83825,"width":235.28189550000025,"height":7.970199999999977}]
[["pages",0,"lines",77],{"text":"ticipants on a weekly basis, weekly practice with the yoga","fontSize":7.9702,"x":297.6377,"y":663.7797400000001,"width":235.26515763999987,"height":7.970199999999977}]
[["pages",0,"lines",78],{"text":"instructor, and social and emotional support from fellow partici-","fontSize":7.9702,"x":297.6377,"y":674.77782,"width":235.27233530000046,"height":7.970199999999977}]
[["pages",0,"lines",79],{"text":"pants. To simplify the analysis, questions specific to yoga were","fontSize":7.9702,"x":297.6377,"y":685.7193100000001,"width":235.29704068,"height":7.970199999999977}]
[["pages",0,"lines",80],{"text":"combined, as were those relative to social support. Cronbach’s","fontSize":7.9702,"x":297.6377,"y":696.6608,"width":235.27870540000004,"height":7.970200000000091}]
[["pages",0,"lines",81],{"text":"alpha was calculated for these two factors, and a non-parametric","fontSize":7.9702,"x":297.6385,"y":707.60229,"width":235.2818980399993,"height":7.970199999999977}]
