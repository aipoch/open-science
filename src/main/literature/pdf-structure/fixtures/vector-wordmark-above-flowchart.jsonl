[["pages",1,"lines",0],{"text":"t-test (Wilcoxon) for repeated measures was performed on these","fontSize":7.9702,"x":62.3622,"y":67.9987000000001,"width":235.3010276799997,"height":7.970199999999977}]
[["pages",1,"lines",1],{"text":"factors. All analyses, including tests for distribution normalcy,","fontSize":7.9702,"x":62.3622,"y":78.99678000000006,"width":235.25639093999982,"height":7.970199999999977}]
[["pages",1,"lines",2],{"text":"were conducted using the statistical package for the Social","fontSize":7.9702,"x":62.3622,"y":89.93826999999999,"width":235.34964474000034,"height":7.970199999999977}]
