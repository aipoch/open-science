[["page","lines",0],{"text":"Page 7 of 10Nodehi et al. BMC Pharmacology and Toxicology (2022) 23:57","fontSize":8,"x":56.692901611,"y":31.332613769999966,"width":481.89060107399996,"height":8.516967773000033}]
[["page","lines",1],{"text":"which trastuzumab was added to neoadjuvant chemo-","fontSize":9.8,"x":56.692901611,"y":648.061697022,"width":233.85841030299994,"height":9.800000000000068}]
[["page","lines",2],{"text":"therapy for patients with operable or locally advanced","fontSize":9.8,"x":56.692901611,"y":660.061697022,"width":233.83485999251278,"height":9.800000000000068}]
[["page","lines",3],{"text":"HER2-positive breast cancer. This treatment resulted in","fontSize":9.8,"x":56.692901611,"y":672.0568970219999,"width":233.86131998876934,"height":9.800000000000068}]
[["page","lines",4],{"text":"a 31.7% pCR rate, which was 16% higher than that in the","fontSize":9.8,"x":56.692901611,"y":684.052097022,"width":233.8260399962564,"height":9.799999999999955}]
[["page","lines",5],{"text":"chemotherapy alone group [26]. Similarly, in a NOAH","fontSize":9.8,"x":56.692901611,"y":696.047297022,"width":233.88483999625655,"height":9.800000000000068}]
[["page","lines",6],{"text":"study, patients receiving trastuzumab plus chemotherapy","fontSize":9.8,"x":56.692901611,"y":708.042497022,"width":233.84563999625644,"height":9.799999999999955}]
[["page","lines",7],{"text":"achieved a pCR rate of 39% [27]. In another study con-","fontSize":9.8,"x":304.72110161100005,"y":322.75551048719996,"width":233.86170444299995,"height":9.800000000000011}]
[["page","lines",8],{"text":"ducted by Untch et al. receiving trastuzumab with","fontSize":9.8,"x":304.724395751,"y":334.77278710999997,"width":233.8387799289502,"height":9.800000000000011}]
[["page","lines",9],{"text":"chemotherapy for the neoadjuvant treatment of HER2-","fontSize":9.8,"x":304.724395751,"y":346.76798711,"width":233.84662000000003,"height":9.800000000000011}]
[["page","lines",10],{"text":"positive breast cancer patients resulted in 39% pCR [8].","fontSize":9.8,"x":304.724395751,"y":358.76318711,"width":233.87699999999995,"height":9.800000000000011}]
[["page","lines",11],{"text":"In addition, the study of neoadjuvant PF-05280014, an","fontSize":9.8,"x":304.724395751,"y":370.75838711,"width":233.88386000000003,"height":9.800000000000011}]
[["page","lines",12],{"text":"FDA-approved biosimilar trastuzumab, with docetaxel","fontSize":9.8,"x":304.724395751,"y":382.75358711,"width":233.84367998876928,"height":9.800000000000011}]
[["page","lines",13],{"text":"and carboplatin by Lammers et al., for operable HER2-","fontSize":9.8,"x":304.724395751,"y":394.74878711,"width":233.86425993643718,"height":9.800000000000011}]
[["page","lines",14],{"text":"positive breast cancer patients, showed 47.0% pCR [28].","fontSize":9.8,"x":304.724395751,"y":406.74398711000003,"width":233.8358400000003,"height":9.800000000000011}]
[["page","lines",15],{"text":"In the LILIAC study, receiving ABP 980, as another tras-","fontSize":9.8,"x":304.724395751,"y":418.73918711000005,"width":233.85828823299983,"height":9.800000000000011}]
[["page","lines",16],{"text":"tuzumab biosimilar, in patients with HER2-positive early","fontSize":9.8,"x":304.724395751,"y":430.77278710999997,"width":233.85837999251294,"height":9.800000000000011}]
[["page","lines",17],{"text":"breast cancer, resulted in 48% pCR [29].","fontSize":9.8,"x":304.724395751,"y":442.76798711,"width":161.79505998876914,"height":9.800000000000011}]
[["page","lines",18],{"text":"Clinical trials comparing the safety and efficacy of tras-","fontSize":9.8,"x":312.721195751,"y":454.76318711,"width":225.86148823300005,"height":9.800000000000011}]
[["page","lines",19],{"text":"tuzumab biosimilars and evaluating pCR and ORR in","fontSize":9.8,"x":304.724395751,"y":466.77278710999997,"width":233.84465999251302,"height":9.800000000000011}]
[["page","lines",20],{"text":"patients with early and metastatic breast cancer are ongo-","fontSize":9.8,"x":304.724395751,"y":478.76798711,"width":233.85828823299994,"height":9.800000000000011}]
[["page","lines",21],{"text":"ing [30]. In a study from pivot et al. ERBB2-positive early","fontSize":9.8,"x":304.724395751,"y":653.6034984749999,"width":233.8289799887791,"height":9.800000000000068}]
[["page","lines",22],{"text":"breast cancer patients received HD201 (Trastuzumab","fontSize":9.8,"x":304.724395751,"y":665.598698475,"width":233.8544599962563,"height":9.799999999999955}]
[["page","lines",23],{"text":"biosimilar) and Referent Trastuzumab in a neoadjuvant","fontSize":9.8,"x":304.724395751,"y":677.593898475,"width":233.85739999999987,"height":9.800000000000068}]
[["page","lines",24],{"text":"setting for 8 cycles concurrently with chemotherapy, and","fontSize":9.8,"x":304.724395751,"y":689.589098475,"width":233.84563999625652,"height":9.799999999999955}]
[["page","lines",25],{"text":"tpCR rates were 45% for HD201 and 48.7% for referent","fontSize":9.8,"x":304.724395751,"y":701.584298475,"width":233.88581999999985,"height":9.799999999999955}]
[["page","lines",26],{"text":"trastuzumab [31]. In another study of Pivot et al., breast","fontSize":9.8,"x":304.724395751,"y":713.579498475,"width":233.86230000000023,"height":9.799999999999955}]
[["page","lines",27],{"text":"Fig. 2 Forest plot for pCR result of PP and ITT analysis","fontSize":8,"x":62.817901611,"y":279.92749291999996,"width":170.55040001220013,"height":8}]
