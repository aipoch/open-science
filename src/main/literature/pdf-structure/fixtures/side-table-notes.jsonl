[["page","lines",0],{"text":"Journal of Behavioral Medicine (2024) 47:1002–1011","fontSize":8.5,"x":51.023601531,"y":31.890597168,"width":172.96650000000005,"height":8.5}]
[["page","lines",1],{"text":"Discussion","fontSize":12,"x":306.141693115,"y":558.499895875,"width":56.964,"height":12}]
[["page","lines",2],{"text":"Effective and efficient physical activity interventions are","fontSize":10,"x":306.141693115,"y":585.499895875,"width":238.11400009152982,"height":10}]
[["page","lines",3],{"text":"critical to ensure successful implementation of programs","fontSize":10,"x":306.141693115,"y":597.999895875,"width":238.12100000000004,"height":10}]
[["page","lines",4],{"text":"for breast cancer survivors. The current study evaluated the","fontSize":10,"x":306.141693115,"y":610.499895875,"width":238.1180000076301,"height":10}]
[["page","lines",5],{"text":"efficacy of four evidence-based intervention components","fontSize":10,"x":306.141693115,"y":622.999895875,"width":238.11499978634987,"height":10}]
[["page","lines",6],{"text":"to improve physical activity in breast cancer survivors.","fontSize":10,"x":306.141693115,"y":635.499895875,"width":238.1169999999999,"height":10}]
[["page","lines",7],{"text":"Results from our study indicate that while all participants","fontSize":10,"x":306.141693115,"y":647.999895875,"width":238.12799999999976,"height":10}]
[["page","lines",8],{"text":"on average increased physical activity over a 6-month","fontSize":10,"x":306.141693115,"y":660.499903504,"width":238.11999999998005,"height":10}]
[["page","lines",9],{"text":"period, supervised exercise sessions delivered over the first","fontSize":10,"x":306.141693115,"y":672.999903504,"width":238.10799997709972,"height":10}]
[["page","lines",10],{"text":"6-weeks resulted in significantly greater increases in MVPA","fontSize":10,"x":306.141693115,"y":685.499903504,"width":238.6599999694899,"height":10}]
[["page","lines",11],{"text":"and LPA. However, we note that in the imputed analysis","fontSize":10,"x":306.141693115,"y":697.999903504,"width":238.10899975582998,"height":10}]
[["page","lines",12],{"text":"week. No significant intervention component effects were","fontSize":10,"x":51.023601531,"y":510.499911133,"width":238.10999992369995,"height":10.000000000000057}]
[["page","lines",13],{"text":"observed for sedentary time.","fontSize":10,"x":51.023601531,"y":522.9999111330001,"width":113.86000000000004,"height":10}]
[["page","lines",14],{"text":"Imputation analysis","fontSize":11,"x":51.023601531,"y":546.999895875,"width":90.44089999999997,"height":11}]
[["page","lines",15],{"text":"Results of the imputation analysis are presented in Table 4.","fontSize":10,"x":51.023601531,"y":572.999895875,"width":238.11030960099998,"height":10}]
[["page","lines",16],{"text":"These models indicate no significant intervention compo-","fontSize":10,"x":51.023601531,"y":585.499895875,"width":238.110200959,"height":10}]
[["page","lines",17],{"text":"nent effects in MVPA and sedentary time. There was a sig-","fontSize":10,"x":51.023601531,"y":597.999895875,"width":238.110200959,"height":10}]
[["page","lines",18],{"text":"nificant Facility Access x ALED interaction effect (t = 3.2,","fontSize":10,"x":51.023601531,"y":610.499895875,"width":238.11030960099998,"height":10}]
[["page","lines",19],{"text":"p = 0.002), which indicated exclusion of Facility Access and","fontSize":10,"x":51.023601531,"y":622.999895875,"width":238.11389701926998,"height":10}]
[["page","lines",20],{"text":"ALED produced the highest level of LPA as was seen with","fontSize":10,"x":51.023601531,"y":635.499895875,"width":238.10199996949,"height":10}]
[["page","lines",21],{"text":"the non-imputed analysis.","fontSize":10,"x":51.023601531,"y":647.999895875,"width":103.05000000000001,"height":10}]
