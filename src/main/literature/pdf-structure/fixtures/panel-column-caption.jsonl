[["lines",28],{"text":"Fig. 3 Resilience and three dimensions (tenacity, adamancy and opti-","fontSize":8.5,"x":51.023601531,"y":520.085696045,"width":238.11305,"height":8.5}]
[["lines",29],{"text":"mism) comparison between NCG and BCS. Note: A. Tenacity com-","fontSize":8.5,"x":51.023601531,"y":530.081696045,"width":238.08500000000004,"height":8.5}]
[["lines",30],{"text":"parison between NCG and BCS; B. Adamancy comparison between","fontSize":8.5,"x":51.023601531,"y":540.077696045,"width":238.13684999999998,"height":8.5}]
[["lines",31],{"text":"NCG and BCS; C. Optimism comparison between NCG and BCS; D.","fontSize":8.5,"x":306.14260153099997,"y":520.0771960449999,"width":238.1445000000001,"height":8.5}]
[["lines",32],{"text":"Resilience comparison between NCG and BCS (***: p < 0. 001, **:","fontSize":8.5,"x":306.14260153099997,"y":530.073196045,"width":238.11049830000013,"height":8.5}]
[["lines",33],{"text":"p < 0. 01, *: p < 0. 05)","fontSize":8.5,"x":306.1426060615,"y":540.069196045,"width":74.21350000000001,"height":8.5}]
