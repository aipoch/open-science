[["captionStarts",1],{"text":"Fig. 3 Resilience and three dimensions (tenacity, adamancy and opti-","fontSize":8.5,"x":51.023601531,"y":520.085696045,"width":238.11305,"height":8.5}]
[["headingCandidates"],[]]
[["lines"],[]]
[["lines",0],{"text":"18012 Journal of Cancer Research and Clinical Oncology (2023) 149:18005–18021","fontSize":8.5,"x":51.023601531,"y":30.711092774000008,"width":493.2294981810001,"height":8.5}]
[["lines",1],{"text":"1 3","fontSize":15,"x":52.4976,"y":730.1677999999999,"width":16.875000000000007,"height":15}]
[["lines",2],{"text":"Data analysis","fontSize":11,"x":51.023601531,"y":566.7838009039999,"width":60.36689999999999,"height":11}]
[["lines",3],{"text":"Statistical analysis was conducted using IBM SPSS Statistics","fontSize":10,"x":51.023601531,"y":592.7838009039999,"width":238.0760000114604,"height":10}]
[["lines",4],{"text":"23.0 software, and all data were presented as mean ± stand-","fontSize":10,"x":51.023601531,"y":605.2838009039999,"width":238.11,"height":10}]
[["lines",5],{"text":"ard deviation. The independent samples t-test and Mann‒","fontSize":10,"x":51.02360153099997,"y":617.7838009039999,"width":238.14699999999985,"height":10}]
[["lines",6],{"text":"Whitney U test were used to compare the resilience of BCSs","fontSize":10,"x":51.02360153099997,"y":630.2838009039999,"width":238.05200001144985,"height":10}]
[["lines",7],{"text":"and NCGs at baseline. The primary outcome was the change","fontSize":10,"x":51.02360153099997,"y":642.7838009039999,"width":238.0660000114601,"height":10}]
[["lines",8],{"text":"in the CD-RISC score and its three-dimensional score from","fontSize":10,"x":51.02360153099997,"y":655.2838009039999,"width":238.10900000000035,"height":10}]
[["lines",9],{"text":"baseline to 12 weeks after the start of the intervention. Sec-","fontSize":10,"x":51.02360153099997,"y":667.7838009039999,"width":238.27900001335055,"height":10}]
[["lines",10],{"text":"ondary outcomes were changes in CD-RISC scores at 6","fontSize":10,"x":51.02360153099997,"y":680.2838009039999,"width":237.98199999236996,"height":10}]
[["lines",11],{"text":"and 24 weeks and HADS, FACT-B, and PSS-14 scores at","fontSize":10,"x":51.02360153099997,"y":692.7838009039999,"width":237.9809999923701,"height":10}]
[["lines",12],{"text":"6, 12, and 24 weeks. Pearson's correlation test was used to","fontSize":10,"x":51.02360153099997,"y":705.2838009039999,"width":238.14700000000036,"height":10}]
[["lines",13],{"text":"analyze the correlation between resilience and QOL scores.","fontSize":10,"x":306.143592831,"y":566.993800904,"width":238.04100001336053,"height":10}]
[["lines",14],{"text":"A matched samples t-test was used to compare the changes","fontSize":10,"x":306.143592831,"y":579.493800904,"width":238.14600000382006,"height":10}]
[["lines",15],{"text":"in each score at different time points. In addition, scores","fontSize":10,"x":306.143592831,"y":591.993800904,"width":237.9620000019106,"height":10}]
[["lines",16],{"text":"at 6, 12, and 24 weeks. A repeated measures ANOVA was","fontSize":10,"x":306.143592831,"y":604.493800904,"width":238.04400000193016,"height":10}]
[["lines",17],{"text":"used to compare the scores of the IG group with those from","fontSize":10,"x":306.143592831,"y":616.993800904,"width":238.28099999618019,"height":10}]
[["lines",18],{"text":"the CG group. The interaction effect of time after treatment","fontSize":10,"x":306.143592831,"y":629.493800904,"width":238.1199999961799,"height":10}]
[["lines",19],{"text":"initiation (6, 12, and 24 weeks) with subgroups (IG and CG","fontSize":10,"x":306.143592831,"y":641.993800904,"width":238.0850000038207,"height":10}]
[["lines",20],{"text":"groups) was analyzed using repeated measures ANOVA.","fontSize":10,"x":306.143592831,"y":654.493800904,"width":238.23799998666004,"height":10}]
[["lines",21],{"text":"All repeated-measures ANOVA results were adjusted for","fontSize":10,"x":306.143592831,"y":666.993800904,"width":237.97900003052064,"height":10}]
[["lines",22],{"text":"the F-ratio degrees of freedom according to the Greenhouse","fontSize":10,"x":306.143592831,"y":679.493800904,"width":238.1259999999993,"height":10}]
[["lines",23],{"text":"Geisser method. All analysis results were considered statisti-","fontSize":10,"x":306.143592831,"y":691.993800904,"width":237.89599999617963,"height":10}]
[["lines",24],{"text":"cally significant at P < 0.05.","fontSize":10,"x":306.143592831,"y":704.493800904,"width":111.57999839000007,"height":10}]
[["lines",25],{"text":"Table 2 (continued)","fontSize":8.5,"x":51.023601531,"y":55.630770507999955,"width":68.67150000000001,"height":8.5}]
[["lines",26],{"text":"Characteristics Total (n = 124) Intervention group (n = 62) Control group (n = 62) Statistics P value","fontSize":8.5,"x":51.023601531,"y":71.88931543000001,"width":482.28149682099996,"height":8.5}]
