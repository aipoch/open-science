[["page","lines",58],{"text":"chromosomal genomic instability","fontSize":9.3000002,"x":303.6369147052,"y":630.5561980955999,"width":125.39934269415602,"height":9.3000002}]
[["page","lines",59],{"text":"3","fontSize":5.4218998,"x":429.04260253,"y":631.3658989,"width":2.6025119039999822,"height":5.421899799999892}]
[["page","lines",60],{"text":". We hypothesized that if, as has","fontSize":9.3000002,"x":431.64511108,"y":630.55679876,"width":121.09530260420001,"height":9.3000002}]
[["page","lines",61],{"text":"been widely speculated, there was a shared, profound BRCAness","fontSize":9.3000002,"x":303.63990897819997,"y":641.0564984278,"width":249.0884153551591,"height":9.3000002}]
[["page","lines",62],{"text":"phenotype, sporadic basal-like cancers might have very high plati-","fontSize":9.3000002,"x":303.63990897819997,"y":651.5561980955999,"width":249.11620359300002,"height":9.3000002}]
[["page","lines",63],{"text":"num sensitivity. We found no evidence that basal-like biomark-","fontSize":9.3000002,"x":303.63778686,"y":662.05679876,"width":249.11832571119987,"height":9.3000002}]
[["page","lines",64],{"text":"ers predicted higher response to platinum than to docetaxel, with","fontSize":9.3000002,"x":303.63778686,"y":672.55679876,"width":249.151655358193,"height":9.3000002}]
[["page","lines",65],{"text":"the drugs showing similar activity. A significant interaction was","fontSize":9.3000002,"x":303.63778686,"y":683.0564984278,"width":249.1172453502919,"height":9.3000002}]
[["page","lines",66],{"text":"detected between treatment and the Prosigna–PAM50-identified","fontSize":9.3000002,"x":303.63778686,"y":693.5561980955999,"width":249.12003535556005,"height":9.3000002}]
[["page","lines",67],{"text":"subtypes that was driven by significantly increased response to","fontSize":9.3000002,"x":303.63778686,"y":704.0558977633999,"width":249.10794535901982,"height":9.3000002}]
[["page","lines",68],{"text":"docetaxel relative to poor platinum response in nonbasal forms of","fontSize":9.3000002,"x":303.63778686,"y":714.5555974311999,"width":249.08748535588302,"height":9.300000200000113}]
[["page","lines",69],{"text":"TNBC. This suggests an absence of targetable BRCAness in non-","fontSize":9.3000002,"x":303.63778686,"y":725.055297099,"width":249.1183257112,"height":9.3000002}]
