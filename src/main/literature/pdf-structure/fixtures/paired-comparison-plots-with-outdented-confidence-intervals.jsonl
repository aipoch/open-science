[["page","lines",1],{"text":"Example Journal","fontSize":12,"x":42.06470108,"y":24.92581445999997,"width":102.47999999999999,"height":12}]
[["page","lines",2],{"text":"toxicity as a signal but found none (Supplementary Table 9).","fontSize":9.3000002,"x":42.5196991,"y":462.556814,"width":249.11910535535415,"height":9.3000002}]
[["page","lines",3],{"text":"Although there was a small difference in nonhematological toxicity,","fontSize":9.3000002,"x":42.5196991,"y":473.05651366779995,"width":249.13491536053002,"height":9.3000002}]
[["page","lines",4],{"text":"this was not significant, and small numbers preclude firm conclu-","fontSize":9.3000002,"x":42.5196991,"y":483.5562133355999,"width":249.11818837119998,"height":9.3000002}]
[["page","lines",5],{"text":"sions from these analyses.","fontSize":9.3000002,"x":42.5196991,"y":494.056814,"width":95.64957205790998,"height":9.3000002}]
[["page","lines",6],{"text":"Discussion","fontSize":10,"x":42.5196991,"y":514.3568141999999,"width":46.16999999999999,"height":10}]
[["page","lines",7],{"text":"This phase 3 trial utilized two mechanistically distinct single-","fontSize":9.3000002,"x":42.5196991,"y":525.556814,"width":249.08934535862008,"height":9.300000199999886}]
[["page","lines",8],{"text":"agent chemotherapeutics in unselected advanced TNBC and in","fontSize":9.3000002,"x":42.5196991,"y":536.0565136677999,"width":249.10701535537297,"height":9.300000200000113}]
[["page","lines",9],{"text":"biomarker-defined subpopulations that were specified a priori and","fontSize":9.3000002,"x":42.5196991,"y":546.5562133356,"width":249.11724535466297,"height":9.300000199999886}]
[["page","lines",10],{"text":"were thought likely to have targetable defects in HR DNA repair.","fontSize":9.3000002,"x":42.5196991,"y":557.0559130033998,"width":249.07911535495893,"height":9.300000200000113}]
[["page","lines",11],{"text":"In the unselected subjects with TNBC, no evidence of a superior","fontSize":9.3000002,"x":42.5196991,"y":567.5556126711999,"width":249.07818535577601,"height":9.300000199999886}]
[["page","lines",12],{"text":"response to carboplatin was observed when compared with a stan-","fontSize":9.3000002,"x":42.5196991,"y":578.0553123389998,"width":249.1181883712001,"height":9.300000200000113}]
[["page","lines",13],{"text":"dard of care taxane, docetaxel. Carboplatin was better tolerated","fontSize":9.3000002,"x":42.5196991,"y":588.55679876,"width":249.12747535850994,"height":9.3000002}]
[["page","lines",14],{"text":"than docetaxel when delivered at the full licensed dose. This trial","fontSize":9.3000002,"x":42.5196991,"y":599.0564984278,"width":249.08655535688607,"height":9.3000002}]
[["page","lines",15],{"text":"demonstrates clinically important activity for both agents. The","fontSize":9.3000002,"x":42.5196991,"y":609.5561980955999,"width":249.10050524177305,"height":9.3000002}]
[["page","lines",16],{"text":"level of response seen for docetaxel in this trial is consistent with","fontSize":9.3000002,"x":42.5196991,"y":620.0558977633999,"width":249.07725535222207,"height":9.3000002}]
[["page","lines",17],{"text":"that seen previously in breast cancer","fontSize":9.3000002,"x":42.5196991,"y":630.5555974311999,"width":141.3776730413101,"height":9.3000002}]
[["page","lines",18],{"text":"27","fontSize":5.4218998,"x":183.90359497,"y":631.3658989,"width":5.205023807999993,"height":5.421899799999892}]
[["page","lines",19],{"text":", and the level of response","fontSize":9.3000002,"x":189.1085968,"y":630.55679876,"width":102.52320220024308,"height":9.3000002}]
[["page","lines",20],{"text":"for carboplatin was comparable to that seen in uncontrolled trials","fontSize":9.3000002,"x":42.521992903599966,"y":641.0564984278,"width":249.12561536488718,"height":9.3000002}]
[["page","lines",21],{"text":"of single-agent platinums","fontSize":9.3000002,"x":42.521992903599966,"y":651.5561980955999,"width":96.11457206791002,"height":9.3000002}]
[["page","lines",22],{"text":"28,29","fontSize":5.4218998,"x":138.6387024,"y":652.3658989,"width":11.646240770399999,"height":5.421899799999892}]
[["page","lines",23],{"text":"or combinations of carboplatin with","fontSize":9.3000002,"x":153.53050536979998,"y":651.55679876,"width":138.09384297162006,"height":9.3000002}]
[["page","lines",24],{"text":"gemcitabine in unselected TNBC","fontSize":9.3000002,"x":42.51640019239994,"y":662.0564984278,"width":121.86534262262,"height":9.3000002}]
[["page","lines",25],{"text":"30","fontSize":5.4218998,"x":164.3764038,"y":662.8658989,"width":5.205023807999993,"height":5.421899799999892}]
[["page","lines",26],{"text":". The only other randomized trial","fontSize":9.3000002,"x":169.58140563,"y":662.05679876,"width":122.07180262975709,"height":9.3000002}]
[["page","lines",27],{"text":"that was conducted synchronously with our trial and was designed","fontSize":9.3000002,"x":42.5155019674,"y":672.5564984278,"width":249.12561536033002,"height":9.3000002}]
[["page","lines",28],{"text":"to specifically investigate platinum therapy in comparison with a","fontSize":9.3000002,"x":42.5155019674,"y":683.0561980955999,"width":249.10515535719304,"height":9.3000002}]
[["page","lines",29],{"text":"standard of care in advanced TNBC included the substitution of the","fontSize":9.3000002,"x":42.5155019674,"y":693.5558977633999,"width":249.09864535882002,"height":9.3000002}]
[["page","lines",30],{"text":"platinum therapy cisplatin for paclitaxel that was administered in a","fontSize":9.3000002,"x":42.5155019674,"y":704.0555974311999,"width":249.12561535140196,"height":9.300000200000113}]
[["page","lines",31],{"text":"doublet with gemcitabine. In this study, treatment was continued","fontSize":9.3000002,"x":42.5155019674,"y":714.555297099,"width":249.08748536043993,"height":9.3000002}]
[["page","lines",32],{"text":"until disease progression, as is common practice with paclitaxel, and","fontSize":9.3000002,"x":42.5155019674,"y":725.0549967668,"width":249.14421535635898,"height":9.3000002}]
[["page","lines",33],{"text":"the cisplatin doublet showed modestly increased activity compared","fontSize":9.3000002,"x":42.5155019674,"y":735.5546964345999,"width":249.119105353029,"height":9.3000002}]
[["page","lines",34],{"text":"to the paclitaxel doublet standard of care therapy","fontSize":9.3000002,"x":303.6316044207999,"y":462.55319484160003,"width":186.52824398671504,"height":9.3000002}]
[["page","lines",35],{"text":"31","fontSize":5.4218998,"x":490.17590332,"y":463.36591417,"width":5.205023808000021,"height":5.421899800000006}]
[["page","lines",36],{"text":". A criticism of","fontSize":9.3000002,"x":495.3808899,"y":462.556814,"width":57.37170123380014,"height":9.3000002}]
[["page","lines",37],{"text":"our study could be that subjects did not receive treatment to pro-","fontSize":9.3000002,"x":303.6334854974,"y":473.05651366779995,"width":249.1226270738,"height":9.3000002}]
[["page","lines",38],{"text":"gression but only for six cycles (and, at investigator discretion, to","fontSize":9.3000002,"x":303.63778686,"y":483.556814,"width":249.10050535699975,"height":9.3000002}]
[["page","lines",39],{"text":"a maximum of eight cycles). This was consistent with UK practice","fontSize":9.3000002,"x":303.63778686,"y":494.05651366779995,"width":249.1451453508921,"height":9.3000002}]
[["page","lines",40],{"text":"with docetaxel at the full licensed 100 mg/m","fontSize":9.3000002,"x":303.63778686,"y":504.5562133355999,"width":168.17190622060002,"height":9.300000199999943}]
[["page","lines",41],{"text":"2","fontSize":5.4218998,"x":471.81240844,"y":505.36591417,"width":2.6025119039999822,"height":5.421899800000006}]
[["page","lines",42],{"text":"dose, as this dose is","fontSize":9.3000002,"x":477.4187865346,"y":504.556814,"width":75.34674162222001,"height":9.300000199999943}]
[["page","lines",43],{"text":"rarely tolerated for more than six to eight cycles. This limited dura-","fontSize":9.3000002,"x":303.6389747993999,"y":515.0565136677999,"width":249.1171377718,"height":9.300000200000113}]
[["page","lines",44],{"text":"tion may explain the shorter PFS in our study compared to that in","fontSize":9.3000002,"x":303.63778686,"y":525.556814,"width":249.11631535110905,"height":9.300000199999886}]
[["page","lines",45],{"text":"Author et al.","fontSize":9.3000002,"x":303.63778686,"y":536.0565136677999,"width":31.54560067839998,"height":9.300000200000113}]
[["page","lines",46],{"text":"31","fontSize":5.4218998,"x":335.18310546,"y":536.8658989,"width":5.205023808000021,"height":5.421899799999892}]
[["page","lines",47],{"text":"despite similar OS between studies and may have caused","fontSize":9.3000002,"x":342.6433420885,"y":536.05679876,"width":210.12513452700404,"height":9.3000002}]
[["page","lines",48],{"text":"us to underestimate the effect of carboplatin in those without a pro-","fontSize":9.3000002,"x":303.63449217960004,"y":546.5564984278,"width":249.12162039159995,"height":9.3000002}]
[["page","lines",49],{"text":"gression event during treatment and who might have continued","fontSize":9.3000002,"x":303.63778686,"y":557.05679876,"width":249.08934535424896,"height":9.3000002}]
[["page","lines",50],{"text":"event-free for longer had treatment continued.","fontSize":9.3000002,"x":303.63778686,"y":567.5564984278,"width":172.26948369495494,"height":9.3000002}]
[["page","lines",51],{"text":"In contrast to the unselected population, the prespecified analy-","fontSize":9.3000002,"x":314.9744869178,"y":578.0561980955999,"width":237.78162565339977,"height":9.3000002}]
[["page","lines",52],{"text":"ses of treatment effect in subgroups found evidence of clinically and","fontSize":9.3000002,"x":303.63778686,"y":588.55679876,"width":249.125615355773,"height":9.3000002}]
[["page","lines",53],{"text":"statistically significant biomarker–treatment interactions. There is a","fontSize":9.3000002,"x":303.63778686,"y":599.0564984278,"width":249.09771535526602,"height":9.3000002}]
[["page","lines",54],{"text":"strong association between BRCA1 mutation and basal-like cancer","fontSize":9.3000002,"x":303.63778686,"y":609.5561980955999,"width":241.77954520597677,"height":9.3000002}]
