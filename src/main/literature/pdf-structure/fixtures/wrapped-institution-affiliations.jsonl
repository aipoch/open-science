[["items",32],{"text":"The purpose of this study is to examine the effects of a 16-week exercise intervention (mat Pilates or belly dance) on body","inlineSymbol":false,"baseline":434.5876047375,"height":15,"rect":[76.53539629050007,419.5876047375,816.4178962905013,434.5876047375],"horizontal":true}]
[["items",33],{"text":"image, self-esteem and sexual function in breast cancer survivors receiving hormone therapy. Seventy-four breast cancer","inlineSymbol":false,"baseline":453.3376047375,"height":15,"rect":[76.53539629050007,438.3376047375,815.8133962962138,453.3376047375],"horizontal":true}]
[["items",34],{"text":"survivors were randomly allocated into mat Pilates, belly dance, or control group. The physical activity groups received a","inlineSymbol":false,"baseline":472.0876047375,"height":15,"rect":[76.53539629050007,457.0876047375,816.2888962962318,472.0876047375],"horizontal":true}]
[["items",35],{"text":"16-week intervention, delivered 3 days a week, and 60 min a session. The control group received three education sessions.","inlineSymbol":false,"baseline":490.8376047375,"height":15,"rect":[76.53539629050007,475.8376047375,816.380396290502,490.8376047375],"horizontal":true}]
[["items",36],{"text":"Data collection occurred at baseline, post-intervention, 6 and 12 months of follow-up with a questionnaire including body","inlineSymbol":false,"baseline":509.5876047375,"height":15,"rect":[76.53539629050007,494.5876047375,816.2858962847712,509.5876047375],"horizontal":true}]
[["items",37],{"text":"image (Body Image After Breast Cancer Questionnaire), self-esteem (Rosenberg Self-Esteem Scale), and sexual function","inlineSymbol":false,"baseline":528.3376047375,"height":15,"rect":[76.53539629050007,513.3376047375,816.0548963105268,528.3376047375],"horizontal":true}]
[["items",38],{"text":"(Female Sexual Function Index) measures. The belly dance group significantly improved body image on limitations scale","inlineSymbol":false,"baseline":547.0876047375,"height":15,"rect":[76.53539629050007,532.0876047375,816.3518962962316,547.0876047375],"horizontal":true}]
[["items",39],{"text":"in the short term and long term, the mat Pilates significantly improved body image on limitations only in the long term, and","inlineSymbol":false,"baseline":565.8376047375,"height":15,"rect":[76.53539629050007,550.8376047375,816.4973962618517,565.8376047375],"horizontal":true}]
[["items",40],{"text":"the control group significantly decreased body image on limitations in the long term. The belly dance group experienced","inlineSymbol":false,"baseline":584.5876047375,"height":15,"rect":[76.53539629050007,569.5876047375,815.7683962561197,584.5876047375],"horizontal":true}]
[["items",41],{"text":"reduced discomfort and pain during sexual relations in the short and long term. All groups showed a significant improve-","inlineSymbol":false,"baseline":603.3376047375,"height":15,"rect":[76.53539629050007,588.3376047375,816.4268787585013,603.3376047375],"horizontal":true}]
[["items",42],{"text":"ment in self-esteem, but orgasm sub-scale scores declined over time. No adverse events were found for any of the exercise","inlineSymbol":false,"baseline":622.0876047375,"height":15,"rect":[76.53539629050007,607.0876047375,816.3953962962319,622.0876047375],"horizontal":true}]
[["items",43],{"text":"intervention groups. Belly dance seem to be more effective than mat Pilates and control group in improving limitations of","inlineSymbol":false,"baseline":640.8376047375,"height":15,"rect":[76.53539629050007,625.8376047375,816.3773962847703,640.8376047375],"horizontal":true}]
[["items",44],{"text":"body image and sexual discomfort in the short term for breast cancer survivors. ClinicalTrials.gov (NCT03194997) - \u201cPilates","inlineSymbol":false,"baseline":659.5876047375,"height":15,"rect":[76.53539629050007,644.5876047375,816.4823963248816,659.5876047375],"horizontal":true}]
