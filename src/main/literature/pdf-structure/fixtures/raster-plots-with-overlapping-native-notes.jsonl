[["pages",2],{"pageNumber":20,"width":612,"height":792,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":3},"captionStarts":[{"text":"Figure 5: The change in screening probability across social groups","fontSize":9.9626,"x":161.715,"y":69.27240000000006,"width":288.56770526000014,"height":9.962599999999952},{"text":"Figure 6: Percentage mammography use across the deprivation index","fontSize":9.9626,"x":153.401,"y":420.00440000000003,"width":301.8807276400001,"height":9.962600000000009}],"headingCandidates":[],"lines":[],"graphicsBounds":[],"invalidGraphicsBounds":0}]
[["pages",2,"lines",0],{"text":"Page 19 of 55","fontSize":10,"x":532,"y":752,"width":62.26999999999998,"height":10}]
[["pages",2,"lines",1],{"text":"Accepted Manuscript","fontSize":59.99988797089541,"x":107.0376,"y":126.28167119999978,"width":406.0662138000001,"height":467.7183288000002}]
[["pages",2,"lines",2],{"text":"Figure 5: The change in screening probability across social groups","fontSize":9.9626,"x":161.715,"y":69.27240000000006,"width":288.56770526000014,"height":9.962599999999952}]
[["pages",2,"lines",3],{"text":"Each dot represents the coefficient (and its 95% confidence interval) of the linear","fontSize":8.9664,"x":141.407,"y":332.6826,"width":329.18344319999994,"height":8.966400000000021}]
[["pages",2,"lines",4],{"text":"combination of two coefficients estimated using the interaction effect model in","fontSize":8.9664,"x":141.407,"y":343.6416,"width":329.1861331199997,"height":8.966400000000021}]
[["pages",2,"lines",5],{"text":"Table VII in Appendix F. These indicate the size and significance of the change","fontSize":8.9664,"x":141.407,"y":354.6006,"width":329.18882303999976,"height":8.966400000000021}]
[["pages",2,"lines",6],{"text":"in screening probability between each treatment and the control group for each","fontSize":8.9664,"x":141.407,"y":365.5596,"width":329.18344319999983,"height":8.966400000000021}]
[["pages",2,"lines",7],{"text":"deprivation quintile. For example, the effect of the mixed treatment on the 5th","fontSize":8.9664,"x":141.407,"y":376.5186,"width":329.18523647999984,"height":8.966400000000021}]
[["pages",2,"lines",8],{"text":"quintile corresponds to the following linear combination of coefficients from Table","fontSize":8.9664,"x":141.407,"y":387.4776,"width":329.1906163199998,"height":8.966400000000021}]
[["pages",2,"lines",9],{"text":"VII: (L+C X 5th quintile) + (L+C) = -0.007+(-0.007)=-0.014.","fontSize":8.9664,"x":141.407,"y":398.4366,"width":255.4088006399999,"height":8.966400000000021}]
[["pages",2,"lines",10],{"text":"Figure 6: Percentage mammography use across the deprivation index","fontSize":9.9626,"x":153.401,"y":420.00440000000003,"width":301.8807276400001,"height":9.962600000000009}]
[["pages",2,"lines",11],{"text":"Notes: This graph shows the the proportion of","fontSize":8.9664,"x":207.244,"y":565.6985999999999,"width":197.51275583999987,"height":8.966400000000021}]
[["pages",2,"lines",12],{"text":"mammograms undertaken within a year after the","fontSize":8.9664,"x":207.244,"y":576.6576,"width":197.51634239999996,"height":8.966400000000021}]
[["pages",2,"lines",13],{"text":"invitation among the women invited during the","fontSize":8.9664,"x":207.244,"y":587.6166000000001,"width":197.51544576000006,"height":8.966399999999908}]
[["pages",2,"lines",14],{"text":"experiment. We brake down the total sample","fontSize":8.9664,"x":207.244,"y":598.5756,"width":197.50827264,"height":8.966400000000021}]
[["pages",2,"lines",15],{"text":"by département. The X-axis represents the five","fontSize":8.9664,"x":207.244,"y":609.5346,"width":197.5100659199999,"height":8.966400000000021}]
[["pages",2,"lines",16],{"text":"quintile of the deprivation index. Q5 represents","fontSize":8.9664,"x":207.244,"y":620.4936,"width":197.50737599999988,"height":8.966400000000021}]
[["pages",2,"lines",17],{"text":"the highest level of deprivation.","fontSize":8.9664,"x":207.244,"y":631.4526000000001,"width":127.02250560000007,"height":8.966399999999908}]
[["pages",2,"lines",18],{"text":"may be a slight tendency for the treatments to reduce the uptake rate in the national program by","fontSize":10.9091,"x":70.86600000000001,"y":662.1369,"width":470.2738464399996,"height":10.90910000000008}]
