[["pages",1,"lines",3],{"text":"The vertical lines are 95% confidence intervals. Each bar depicts","fontSize":5.9776,"x":200.19,"y":273.7274,"width":211.61779968000025,"height":5.977600000000052}]
[["pages",1,"lines",4],{"text":"the percentage of mammograms undertaken within a year after the","fontSize":5.9776,"x":200.19,"y":280.70140000000004,"width":211.62138624000016,"height":5.977599999999995}]
[["pages",1,"lines",5],{"text":"invitation among women who were invited for the first time in each","fontSize":5.9776,"x":200.19,"y":287.67440000000005,"width":211.61959296000032,"height":5.977599999999995}]
[["pages",1,"lines",6],{"text":"group. We consider both mammograms undertaken in and outside","fontSize":5.9776,"x":200.19,"y":294.64840000000004,"width":211.62078848,"height":5.977599999999995}]
[["pages",1,"lines",7],{"text":"of the national screening program.","fontSize":5.9776,"x":200.19,"y":301.6224,"width":110.45767935999999,"height":5.977599999999995}]
