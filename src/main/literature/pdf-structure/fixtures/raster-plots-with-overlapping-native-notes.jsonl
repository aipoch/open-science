[["pages",0],{"pageNumber":15,"width":612,"height":792,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":2},"captionStarts":[{"text":"Table III provides further evidence of this lack of effect by showing the logit regression results.","fontSize":10.9091,"x":87.803,"y":230.80590000000018,"width":453.32874140999945,"height":10.909099999999967},{"text":"Figure 3: Treatment effects on total screening","fontSize":9.9626,"x":205.95499999999998,"y":298.04240000000016,"width":200.08985465999996,"height":9.962600000000009}],"headingCandidates":[{"text":"5.1 Treatment effects on total sample","fontSize":11.9552,"x":70.866,"y":69.86980000000005,"width":228.49615103999997,"height":11.95519999999999},{"text":"5.2 Treatment effects on the newly eligible","fontSize":11.9552,"x":70.866,"y":636.8628,"width":259.5270681600001,"height":11.95519999999999}],"lines":[],"graphicsBounds":[],"invalidGraphicsBounds":0}]
[["pages",0,"lines",0],{"text":"Page 14 of 55","fontSize":10,"x":532,"y":752,"width":62.26999999999998,"height":10}]
[["pages",0,"lines",1],{"text":"Accepted Manuscript","fontSize":59.99988797089541,"x":107.0376,"y":126.28167119999978,"width":406.0662138000001,"height":467.7183288000002}]
[["pages",0,"lines",2],{"text":"5.1 Treatment effects on total sample","fontSize":11.9552,"x":70.866,"y":69.86980000000005,"width":228.49615103999997,"height":11.95519999999999}]
[["pages",0,"lines",3],{"text":"Figure 3 depicts the percentage of women receiving a mammogram for each treatment and control","fontSize":10.9091,"x":70.866,"y":99.2709000000001,"width":470.2727555299999,"height":10.909099999999967}]
[["pages",0,"lines",4],{"text":"group in each département. There appears to be no differences between treatment and control mam-","fontSize":10.9091,"x":70.866,"y":121.1939000000001,"width":470.2727555299997,"height":10.909099999999967}]
[["pages",0,"lines",5],{"text":"mography use. Table II lists the percentages of women receiving a mammogram and the differences","fontSize":10.9091,"x":70.866,"y":143.11590000000012,"width":470.2716646199998,"height":10.909099999999967}]
[["pages",0,"lines",6],{"text":"between the treatment and control groups for the total sample and each département separately.","fontSize":10.9091,"x":70.866,"y":165.03890000000013,"width":470.2640282499997,"height":10.909099999999967}]
[["pages",0,"lines",7],{"text":"Bold figures reflect statistically-significant unadjusted p-values, and a star Holm-Bonferoni adjusted","fontSize":10.9091,"x":70.866,"y":186.96090000000015,"width":470.2673009799996,"height":10.909099999999967}]
[["pages",0,"lines",8],{"text":"p-values below 0.1. None of the differences are statistically significant.","fontSize":10.9091,"x":70.866,"y":208.88390000000015,"width":333.5915507199999,"height":10.909099999999967}]
[["pages",0,"lines",9],{"text":"Table III provides further evidence of this lack of effect by showing the logit regression results.","fontSize":10.9091,"x":87.803,"y":230.80590000000018,"width":453.32874140999945,"height":10.909099999999967}]
[["pages",0,"lines",10],{"text":"Columns 1, 3 and 5 include a département fixed effect to account for control-group differences, and","fontSize":10.9091,"x":70.866,"y":252.72890000000018,"width":470.2683918899994,"height":10.909099999999967}]
[["pages",0,"lines",11],{"text":"columns 2, 4 and 6 include the individual characteristics described in Appendix E.1.","fontSize":10.9091,"x":70.866,"y":274.6519000000002,"width":400.5701519899998,"height":10.909099999999967}]
[["pages",0,"lines",12],{"text":"Figure 3: Treatment effects on total screening","fontSize":9.9626,"x":205.95499999999998,"y":298.04240000000016,"width":200.08985465999996,"height":9.962600000000009}]
[["pages",0,"lines",13],{"text":"Notes: The vertical lines are 95% confidence inter-","fontSize":8.9664,"x":200.19,"y":501.7496,"width":211.62048959999987,"height":8.966400000000021}]
[["pages",0,"lines",14],{"text":"vals. Each bar depicts the percentage of mammo-","fontSize":8.9664,"x":200.19,"y":512.7085999999999,"width":211.61510975999994,"height":8.966400000000021}]
[["pages",0,"lines",15],{"text":"grams undertaken within a year after the invitation","fontSize":8.9664,"x":200.19,"y":523.6676,"width":211.61510976,"height":8.966400000000021}]
[["pages",0,"lines",16],{"text":"among women who were invited in each group. We","fontSize":8.9664,"x":200.19,"y":534.6266,"width":211.61600639999972,"height":8.966400000000021}]
[["pages",0,"lines",17],{"text":"consider both mammograms undertaken in and out-","fontSize":8.9664,"x":200.19,"y":545.5856,"width":211.62228288,"height":8.966400000000021}]
[["pages",0,"lines",18],{"text":"side of the national screening program.","fontSize":8.9664,"x":200.19,"y":556.5446000000001,"width":157.05456576,"height":8.966399999999908}]
[["pages",0,"lines",19],{"text":"The RCT results in Table II and III are clear and unambiguous: none of our four treatments","fontSize":10.9091,"x":87.803,"y":588.1019,"width":453.3309232299997,"height":10.909099999999967}]
[["pages",0,"lines",20],{"text":"caused any significant change in screening behavior.","fontSize":10.9091,"x":70.866,"y":610.0239,"width":246.37765986000005,"height":10.909099999999967}]
[["pages",0,"lines",21],{"text":"5.2 Treatment effects on the newly eligible","fontSize":11.9552,"x":70.866,"y":636.8628,"width":259.5270681600001,"height":11.95519999999999}]
[["pages",0,"lines",22],{"text":"The newly eligible are women aged 50 who are invited to undertake a mammogram for the first time.","fontSize":10.9091,"x":70.866,"y":666.2639,"width":470.2716646199998,"height":10.909099999999967}]
[["pages",0,"lines",23],{"text":"As they have never been invited before, there may be a greater chance that they will pay attention","fontSize":10.9091,"x":70.866,"y":688.1869,"width":470.2738464399997,"height":10.909099999999967}]
[["pages",0,"lines",24],{"text":"to the letter. Women who have already been invited a number of times may just take the voucher","fontSize":10.9091,"x":70.866,"y":710.1089000000001,"width":470.2662100699996,"height":10.909099999999967}]
[["pages",0,"lines",25],{"text":"14","fontSize":10.9091,"x":300.576,"y":740.1129,"width":10.848009040000022,"height":10.90910000000008}]
