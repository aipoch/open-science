[["page","lines",0],{"text":"t-test (Wilcoxon) for repeated measures was performed on these","fontSize":7.9702,"x":62.3622,"y":67.9987000000001,"width":235.3010276799997,"height":7.970199999999977}]
[["page","lines",1],{"text":"factors. All analyses, including tests for distribution normalcy,","fontSize":7.9702,"x":62.3622,"y":78.99678000000006,"width":235.25639093999982,"height":7.970199999999977}]
[["page","lines",2],{"text":"were conducted using the statistical package for the Social","fontSize":7.9702,"x":62.3622,"y":89.93826999999999,"width":235.34964474000034,"height":7.970199999999977}]
[["page","lines",3],{"text":"Sciences SPSS [39].","fontSize":7.9702,"x":62.3622,"y":100.87976000000003,"width":69.53999499999995,"height":7.970199999999977}]
[["page","lines",4],{"text":"Results","fontSize":14.944,"x":62.3622,"y":144.76030000000003,"width":48.50822400000001,"height":14.94399999999996}]
[["page","lines",5],{"text":"Participants","fontSize":11.9551,"x":62.3622,"y":180.12080000000003,"width":62.9436015,"height":11.955100000000016}]
[["page","lines",6],{"text":"A hundred and sixty-five patients were contacted and","fontSize":9.4646,"x":62.3622,"y":208.51999999999998,"width":235.24263299999998,"height":9.464600000000019}]
[["page","lines",7],{"text":"screened, out of which 101 participants were recruited","fontSize":9.4646,"x":62.3622,"y":221.44579999999996,"width":235.26818741999998,"height":9.464600000000019}]
[["page","lines",8],{"text":"and randomly assigned to each group. Seventy-eight","fontSize":9.4646,"x":62.3622,"y":234.4284,"width":235.24357946000006,"height":9.464600000000019}]
[["page","lines",9],{"text":"participants completed the study (Figure 1). There were","fontSize":9.4646,"x":62.3622,"y":247.3542,"width":235.29468829999993,"height":9.464600000000019}]
[["page","lines",10],{"text":"no significant differences between completers and non-","fontSize":9.4646,"x":62.3622,"y":260.28,"width":235.25682989999999,"height":9.464600000000019}]
[["page","lines",11],{"text":"completers in terms of sociodemographic, medical, or","fontSize":9.4646,"x":62.3622,"y":273.2626,"width":235.2606157399999,"height":9.464600000000019}]
[["page","lines",12],{"text":"baseline symptom scale variables. Uneven group","fontSize":9.4646,"x":62.3622,"y":286.1884,"width":235.2662945,"height":9.464600000000019}]
[["page","lines",13],{"text":"distributions can be explained by recruitment difficulties","fontSize":9.4646,"x":308.97655,"y":67.58074999999997,"width":235.25209759999996,"height":9.464600000000019}]
[["page","lines",14],{"text":"resulting in 22 participants being assigned rather than","fontSize":9.4646,"x":308.97655,"y":80.50654999999995,"width":235.22843609999995,"height":9.464600000000019}]
[["page","lines",15],{"text":"randomized to each group. However, no statistical differ-","fontSize":9.4646,"x":308.97655,"y":93.43236000000002,"width":235.2776520199999,"height":9.464600000000019}]
[["page","lines",16],{"text":"ences were observed between baseline measures and out-","fontSize":9.4646,"x":308.97655,"y":106.41494999999998,"width":235.2909024600001,"height":9.464600000000019}]
[["page","lines",17],{"text":"come measures when these participants were excluded","fontSize":9.4646,"x":308.97655,"y":119.34074999999996,"width":235.27008033999994,"height":9.464600000000019}]
[["page","lines",18],{"text":"from analyses. Class attendance was 5.5 sessions","fontSize":9.4646,"x":308.97655,"y":132.32334000000003,"width":235.28333078000014,"height":9.464600000000019}]
[["page","lines",19],{"text":"(SD = 2.57), while participants practiced 2.25 h (SD = 1.18)","fontSize":9.4646,"x":308.97655,"y":145.24915,"width":235.2785984799999,"height":9.464600000000019}]
[["page","lines",20],{"text":"per week at home. No adverse effects were reported due","fontSize":9.4646,"x":308.97655,"y":158.23174000000006,"width":235.28995599999985,"height":9.464600000000019}]
[["page","lines",21],{"text":"to the yoga intervention.","fontSize":9.4646,"x":308.97655,"y":171.15755000000001,"width":101.97349331999993,"height":9.464600000000019}]
[["page","lines",22],{"text":"There were no significant statistical differences in","fontSize":9.4646,"x":325.92765,"y":184.14013999999997,"width":218.28964147999994,"height":9.464600000000019}]
[["page","lines",23],{"text":"demographic characteristics between the BYP-BC experi-","fontSize":9.4646,"x":308.97655,"y":197.06593999999996,"width":235.25399052,"height":9.464600000000019}]
[["page","lines",24],{"text":"mental group and the WL control group (Table 2). There","fontSize":9.4646,"x":308.97655,"y":209.99175000000002,"width":235.26629449999996,"height":9.464600000000019}]
[["page","lines",25],{"text":"were no differences between groups in cancer stage,","fontSize":9.4646,"x":308.97655,"y":222.97433999999998,"width":235.26724095999964,"height":9.464600000000019}]
[["page","lines",26],{"text":"cancer recurrence, or type or dose of chemotherapy.","fontSize":9.4646,"x":308.97655,"y":235.90013999999996,"width":235.2151856600001,"height":9.464600000000019}]
[["page","lines",27],{"text":"A significant difference was found between both groups","fontSize":9.4646,"x":308.97655,"y":248.88273000000004,"width":235.28427723999994,"height":9.464600000000019}]
[["page","lines",28],{"text":"relating to BDI baseline scores. The experimental group","fontSize":9.4646,"x":308.97655,"y":261.80854,"width":235.26724095999987,"height":9.464600000000019}]
[["page","lines",29],{"text":"had a higher level of depression symptoms than the","fontSize":9.4646,"x":308.97655,"y":274.79113000000007,"width":235.24831175999998,"height":9.464599999999962}]
[["page","lines",30],{"text":"control group. As such, the baseline score was included","fontSize":9.4646,"x":308.97655,"y":287.71693,"width":235.2492582199999,"height":9.464600000000019}]
