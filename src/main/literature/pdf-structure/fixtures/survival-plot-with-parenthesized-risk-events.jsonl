[["page","lines",1],{"text":"Example Journal","fontSize":12,"x":450.5737915,"y":24.92581445999997,"width":102.4679999999999,"height":12}]
[["page","lines",2],{"text":"Safety. Both carboplatin and docetaxel demonstrated toxicity con-","fontSize":9.3000002,"x":42.5196991,"y":662.05679876,"width":249.1181883712001,"height":9.3000002}]
[["page","lines",3],{"text":"sistent with their known safety profiles, and grade 3 and 4 adverse","fontSize":9.3000002,"x":42.5196991,"y":672.55679876,"width":249.15537535910985,"height":9.3000002}]
[["page","lines",4],{"text":"events (AEs) occurred as anticipated for these well-known chemo-","fontSize":9.3000002,"x":42.5196991,"y":683.0564984278,"width":249.1181883712001,"height":9.3000002}]
[["page","lines",5],{"text":"therapy drugs (Supplementary Tables 7 and 8). There were more","fontSize":9.3000002,"x":42.5196991,"y":693.55679876,"width":249.10980540602495,"height":9.3000002}]
[["page","lines",6],{"text":"grade 3 and 4 AEs following treatment with docetaxel than with car-","fontSize":9.3000002,"x":42.5196991,"y":704.0564984278,"width":249.11818837119986,"height":9.3000002}]
[["page","lines",7],{"text":"boplatin. Throughout the trial, 276 serious adverse events (SAEs)","fontSize":9.3000002,"x":42.5196991,"y":714.55679876,"width":249.13491536052996,"height":9.3000002}]
[["page","lines",8],{"text":"were reported (102 and 174 in carboplatin- and docetaxel-treated","fontSize":9.3000002,"x":42.5196991,"y":725.0564984278,"width":249.12561535121606,"height":9.3000002}]
[["page","lines",9],{"text":"subjects, respectively). The spectrum of SAEs was as anticipated.","fontSize":9.3000002,"x":42.5196991,"y":735.5561980955999,"width":249.13770536245002,"height":9.3000002}]
[["page","lines",10],{"text":"Two SAEs were considered to be suspected unexpected serious","fontSize":9.3000002,"x":303.6358015533999,"y":662.058297724,"width":249.13212534968216,"height":9.3000002}]
[["page","lines",11],{"text":"adverse reactions (1 in each treatment group); these were (i) nau-","fontSize":9.3000002,"x":303.6358015533999,"y":672.5579973918,"width":249.1201889378001,"height":9.3000002}]
[["page","lines",12],{"text":"sea, vomiting and headaches and (ii) low magnesium. One death","fontSize":9.3000002,"x":303.63778686,"y":683.05679876,"width":249.0902753577102,"height":9.3000002}]
[["page","lines",13],{"text":"was considered possibly related to carboplatin treatment; this","fontSize":9.3000002,"x":303.63778686,"y":693.5564984278,"width":249.11631535566596,"height":9.3000002}]
[["page","lines",14],{"text":"subject died from pulmonary embolism. As a haploinsuffiency or","fontSize":9.3000002,"x":303.63778686,"y":704.0561980955999,"width":249.12561535130908,"height":9.3000002}]
[["page","lines",15],{"text":"dominant-negative effect of heterozygous mutation might affect","fontSize":9.3000002,"x":303.63778686,"y":714.5558977633999,"width":249.1358453597129,"height":9.3000002}]
[["page","lines",16],{"text":"toxicity from HR-targeting therapies, such as platinum, in carriers","fontSize":9.3000002,"x":303.63778686,"y":725.0555974311999,"width":249.09585535727183,"height":9.300000200000113}]
[["page","lines",17],{"text":"of a BRCA mutation, we sought evidence of excess hematological","fontSize":9.3000002,"x":303.63778686,"y":735.555297099,"width":249.11910535535412,"height":9.3000002}]
