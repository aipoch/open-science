[["page","lines",40],{"text":"sample of women who reported on sleep and hot","fontSize":8.4682,"x":346.6769391,"y":586.2849499400003,"width":185.34095294000008,"height":8.468200000000024}]
[["page","lines",41],{"text":"flashes. This study is strengthened by the subjective","fontSize":8.4682,"x":346.6769391,"y":597.7364968000003,"width":185.30623332000005,"height":8.468200000000024}]
