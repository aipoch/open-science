[["page","lines",19],{"text":"services.","fontSize":10.5,"x":45.4,"y":293.547,"width":35.49629999999997,"height":10.5}]
[["page","lines",20],{"text":"24","fontSize":6.1215,"x":80.7775,"y":294.4295000000001,"width":6.052327050000002,"height":6.121499999999969}]
[["page","lines",21],{"text":"These women could also have been comparatively","fontSize":10.5,"x":87.76595,"y":293.547,"width":198.48675,"height":10.5}]
[["page","lines",22],{"text":"more proactive and aware of the tools of cancer prevention","fontSize":10.5,"x":45.399499999999996,"y":306.14700000000005,"width":240.87630000000007,"height":10.5}]
[["page","lines",23],{"text":"and early detection, and were therefore more responsive.","fontSize":10.5,"x":45.399499999999996,"y":318.74700000000007,"width":238.2135,"height":10.5}]
[["page","lines",24],{"text":"Non-attendees might be inhibited by a range of reasons.","fontSize":10.5,"x":53.94965,"y":334.24710000000005,"width":232.32090000000002,"height":10.5}]
[["page","lines",25],{"text":"The lack of time, and \u201cnot having thought about it\u201d were","fontSize":10.5,"x":45.399499999999996,"y":346.84710000000007,"width":240.8699999999999,"height":10.5}]
[["page","lines",26],{"text":"reasons previously cited.","fontSize":10.5,"x":45.399499999999996,"y":359.4471000000001,"width":112.63350000000011,"height":10.5}]
[["page","lines",27],{"text":"25,26","fontSize":6.1215,"x":158.171,"y":360.3295,"width":14.091692999999964,"height":6.121500000000026}]
[["page","lines",28],{"text":"The rationality of these","fontSize":10.5,"x":177.54049999999998,"y":359.447,"width":108.70650000000032,"height":10.5}]
[["page","lines",29],{"text":"responses may however obscure the underlying fatalistic","fontSize":10.5,"x":45.40009999999998,"y":372.047,"width":240.8615999999998,"height":10.5}]
[["page","lines",30],{"text":"attitude or fear of pain associated with the reluctance to","fontSize":10.5,"x":45.40009999999998,"y":384.64700000000005,"width":240.8752499999998,"height":10.5}]
[["page","lines",31],{"text":"screen, and the lack of acceptability of mammography as","fontSize":10.5,"x":45.40009999999998,"y":397.24700000000007,"width":240.86999999999998,"height":10.5}]
[["page","lines",32],{"text":"a screening modality.","fontSize":10.5,"x":45.40009999999998,"y":409.8470000000001,"width":88.19264999999999,"height":10.5}]
[["page","lines",33],{"text":"21","fontSize":6.1215,"x":133.577,"y":410.7295,"width":6.1214999999999975,"height":6.121500000000026}]
[["page","lines",34],{"text":"The use of a personalised approach","fontSize":10.5,"x":141.5145,"y":409.847,"width":144.73725000000007,"height":10.5}]
[["page","lines",35],{"text":"in this study aimed to address this specific challenge,","fontSize":10.5,"x":45.39960000000001,"y":422.447,"width":240.849,"height":10.5}]
[["page","lines",36],{"text":"particularly among women with low attitude and belief","fontSize":10.5,"x":45.399599999999964,"y":435.047,"width":240.86894999999993,"height":10.5}]
[["page","lines",37],{"text":"scores.","fontSize":10.5,"x":45.399599999999964,"y":447.64700000000005,"width":28.864499999999992,"height":10.5}]
[["page","lines",38],{"text":"This study was designed as a quasi-randomised pragmatic","fontSize":10.5,"x":53.949749999999966,"y":463.1471,"width":232.38284999999988,"height":10.5}]
[["page","lines",39],{"text":"trial. Experimental blinding was thus not implemented.","fontSize":10.5,"x":45.399599999999964,"y":475.74710000000005,"width":240.87629999999996,"height":10.5}]
[["page","lines",40],{"text":"Analysis was done on an intention-to-treat basis, and the","fontSize":10.5,"x":45.399599999999964,"y":488.34710000000007,"width":240.86159999999995,"height":10.5}]
[["page","lines",41],{"text":"risk of treatment effect dilution was small despite 2 instances","fontSize":10.5,"x":45.399599999999964,"y":500.9471000000001,"width":240.88575000000026,"height":10.5}]
[["page","lines",42],{"text":"of cross-over.","fontSize":10.5,"x":45.399599999999964,"y":513.5471000000001,"width":57.1494,"height":10.5}]
[["page","lines",43],{"text":"Doctors\u2019 reminders were not consistently delivered","fontSize":10.5,"x":53.949749999999966,"y":529.0472000000001,"width":232.30200000000005,"height":10.5}]
[["page","lines",44],{"text":"because participants did not always present their cues upon","fontSize":10.5,"x":45.399599999999964,"y":541.6472000000001,"width":240.87419999999986,"height":10.5}]
[["page","lines",45],{"text":"consultation. Whilst cost reduction appeared to result in a","fontSize":10.5,"x":45.399599999999964,"y":554.2472000000001,"width":240.87524999999982,"height":10.5}]
[["page","lines",46],{"text":"pronounced effect and could reasonably be hypothesised as","fontSize":10.5,"x":45.399599999999964,"y":566.8472000000002,"width":240.86054999999993,"height":10.5}]
[["page","lines",47],{"text":"singularly achieving an effect in the absence of a doctor\u2019s","fontSize":10.5,"x":45.399599999999964,"y":579.4472000000002,"width":240.86999999999978,"height":10.5}]
[["page","lines",48],{"text":"reminder, possible reasons for the blunted effectiveness of","fontSize":10.5,"x":45.399599999999964,"y":592.0472000000002,"width":240.86474999999984,"height":10.5}]
[["page","lines",49],{"text":"the doctor\u2019s reminder intervention, as compared to other","fontSize":10.5,"x":45.399599999999964,"y":604.6472000000001,"width":240.8731499999999,"height":10.5}]
[["page","lines",50],{"text":"studies,","fontSize":10.5,"x":45.399599999999964,"y":617.2472000000001,"width":30.978150000000014,"height":10.5}]
[["page","lines",51],{"text":"27,28","fontSize":6.1215,"x":76.2557,"y":618.1295,"width":13.50158039999998,"height":6.121499999999969}]
[["page","lines",52],{"text":"may be the lack of time, or lack of standardisation,","fontSize":10.5,"x":90.88374999999999,"y":617.2470000000001,"width":195.4144500000002,"height":10.5}]
[["page","lines",53],{"text":"as reminders were not scripted. Future studies could address","fontSize":10.5,"x":45.399849999999994,"y":629.847,"width":240.8426999999996,"height":10.5}]
[["page","lines",54],{"text":"these factors, as observational studies suggest that the role","fontSize":10.5,"x":45.399849999999994,"y":642.447,"width":240.8741999999999,"height":10.5}]
[["page","lines",55],{"text":"of the doctor in promoting screening could be a positive","fontSize":10.5,"x":45.399849999999994,"y":655.047,"width":240.8658,"height":10.5}]
[["page","lines",56],{"text":"one. The current study did not attempt to assess the effect","fontSize":10.5,"x":45.399849999999994,"y":667.6469999999999,"width":240.87735,"height":10.5}]
[["page","lines",57],{"text":"of all possible predictors of screening, but focused on those","fontSize":10.5,"x":45.399849999999994,"y":680.247,"width":240.86684999999997,"height":10.5}]
[["page","lines",58],{"text":"most relevant to the intervention.","fontSize":10.5,"x":45.399849999999994,"y":692.847,"width":139.11450000000005,"height":10.5}]
[["page","lines",59],{"text":"Participants screened beyond the study period were not","fontSize":10.5,"x":53.949999999999996,"y":708.3471,"width":232.30725,"height":10.5}]
[["page","lines",60],{"text":"captured. Although a standardised protocol was followed,","fontSize":10.5,"x":45.399849999999994,"y":720.9471,"width":240.85950000000005,"height":10.5}]
[["page","lines",61],{"text":"patient navigators could have unconsciously varied","fontSize":10.5,"x":45.399849999999994,"y":733.5471,"width":240.8605499999998,"height":10.5}]
[["page","lines",62],{"text":"their behaviour towards different individuals, leading to","fontSize":10.5,"x":309.66175,"y":293.5467,"width":240.8699999999999,"height":10.5}]
[["page","lines",63],{"text":"experimenter bias. Misclassification and recall bias could","fontSize":10.5,"x":309.66175,"y":306.1467,"width":240.85845000000006,"height":10.5}]
[["page","lines",64],{"text":"not be excluded as self-reported information was not","fontSize":10.5,"x":309.66175,"y":318.74670000000003,"width":240.8825999999998,"height":10.5}]
[["page","lines",65],{"text":"verified. Interventions were designed as a package and","fontSize":10.5,"x":309.66175,"y":331.34670000000006,"width":240.86160000000007,"height":10.5}]
[["page","lines",66],{"text":"isolated effects were not analysed. Nonetheless, the study,","fontSize":10.5,"x":309.66175,"y":343.9467000000001,"width":240.86369999999988,"height":10.5}]
[["page","lines",67],{"text":"which was designed to model care under routine settings,","fontSize":10.5,"x":309.66175,"y":356.5467000000001,"width":240.85529999999972,"height":10.5}]
[["page","lines",68],{"text":"benefits from a higher external validity.","fontSize":10.5,"x":309.66175,"y":369.1467000000001,"width":165.54300000000012,"height":10.5}]
[["page","lines",69],{"text":"Conclusion","fontSize":10.5,"x":309.61135,"y":400.14690000000013,"width":50.17950000000002,"height":10.5}]
[["page","lines",70],{"text":"The demonstrated effectiveness of the overall intervention","fontSize":10.5,"x":318.21085,"y":415.6470000000001,"width":232.33035000000126,"height":10.5}]
[["page","lines",71],{"text":"strengthens the proposition for a longer-term, community-","fontSize":10.5,"x":309.6607,"y":428.2470000000001,"width":240.86790000000008,"height":10.5}]
[["page","lines",72],{"text":"based cancer prevention and outreach initiative that includes","fontSize":10.5,"x":309.6607,"y":440.84700000000015,"width":240.8910000000011,"height":10.5}]
[["page","lines",73],{"text":"patient navigation and cost reduction components. There","fontSize":10.5,"x":309.6607,"y":453.4470000000002,"width":240.86999999999978,"height":10.5}]
[["page","lines",74],{"text":"is a need for larger, more generalisable studies to validate","fontSize":10.5,"x":309.6607,"y":466.0470000000002,"width":240.87630000000013,"height":10.5}]
[["page","lines",75],{"text":"these results across multiple study sites. This would require","fontSize":10.5,"x":309.6607,"y":478.6470000000002,"width":240.86474999999984,"height":10.5}]
[["page","lines",76],{"text":"building on collaborations with the network of polyclinics","fontSize":10.5,"x":309.6607,"y":491.24700000000024,"width":240.8731499999999,"height":10.5}]
[["page","lines",77],{"text":"and diagnostics services, integrating patient navigation into","fontSize":10.5,"x":309.6607,"y":503.84700000000026,"width":240.8490000000014,"height":10.499999999999943}]
[["page","lines",78],{"text":"existing workflow and record-keeping. Interface with the","fontSize":10.5,"x":309.6607,"y":516.4470000000003,"width":240.85950000000003,"height":10.5}]
[["page","lines",79],{"text":"national screening programme, BreastScreen Singapore,","fontSize":10.5,"x":309.6607000000001,"y":529.0459500000003,"width":240.8678999999999,"height":10.5}]
[["page","lines",80],{"text":"would assist in the detection of under- and un-screened cases","fontSize":10.5,"x":309.6607000000001,"y":541.6449000000002,"width":240.8899500000012,"height":10.5}]
[["page","lines",81],{"text":"and the generation of cues for staff and clinicians at the","fontSize":10.5,"x":309.6607000000001,"y":554.2438500000003,"width":240.87000000000018,"height":10.5}]
[["page","lines",82],{"text":"primary care facility. Financing subsidy for mammograms","fontSize":10.5,"x":309.6607000000001,"y":566.8428000000004,"width":240.87315000000007,"height":10.5}]
[["page","lines",83],{"text":"for low income and medically underserved women would","fontSize":10.5,"x":309.6607000000001,"y":579.4417500000003,"width":240.86684999999994,"height":10.5}]
[["page","lines",84],{"text":"also be needed, as well as coordination with clinicians and","fontSize":10.5,"x":309.6607000000001,"y":592.0407000000002,"width":240.8741999999998,"height":10.5}]
[["page","lines",85],{"text":"the training of patient navigators.","fontSize":10.5,"x":309.6607000000001,"y":604.6396500000003,"width":139.692,"height":10.5}]
