[["page"],{"pageNumber":3,"width":612,"height":792,"rotation":0,"renderRotation":0,"structureRoles":{"Root":1,"Document":1,"P":5,"Span":1,"Sect":1},"graphicsOperators":{"paintImageXObject":1,"constructPath":192},"captionStarts":[{"text":"Figure 1. Circulating levels of MOTS-c in patients with HER2+ breast cancer treated with neoadjuvant metformin. (A) Left.","fontSize":9.96,"x":50.4,"y":647.74,"width":511.408,"height":9.960000000000036}],"headingCandidates":[{"text":"894 AGING","fontSize":12,"x":288.53,"y":755.256,"width":270.5300000000001,"height":12}],"lines":[{"text":"www.aging-us.com","fontSize":9.96,"x":50.4,"y":757.296,"width":77.19731999999999,"height":9.959999999999923},{"text":"894 AGING","fontSize":12,"x":288.53,"y":755.256,"width":270.5300000000001,"height":12},{"text":"immunoreactive species of circulating MOTS-c","fontSize":10.56,"x":50.4,"y":49.680000000000064,"width":237.89864000000003,"height":10.559999999999945},{"text":"detected using different kits are not identical. Our","fontSize":10.56,"x":50.4,"y":61.680000000000064,"width":237.57888000000005,"height":10.559999999999945},{"text":"previous analysis confirmed that treatment of non-","fontSize":10.56,"x":50.4,"y":73.80000000000007,"width":237.68648,"height":10.559999999999945},{"text":"diabetic patients with HER2+ BC with oral metformin","fontSize":10.56,"x":50.4,"y":85.82000000000005,"width":237.61056,"height":10.559999999999945},{"text":"(850 mg twice daily) for 24 weeks produced blood","fontSize":10.56,"x":50.4,"y":97.94000000000005,"width":237.61056000000005,"height":10.559999999999945},{"text":"levels of circulating metformin of ~7 μmol/L,","fontSize":10.56,"x":50.4,"y":110.06000000000006,"width":237.81216000000003,"height":10.559999999999945},{"text":"equivalent to those generally achieved in diabetic","fontSize":10.56,"x":50.4,"y":122.06000000000006,"width":237.55776000000006,"height":10.559999999999945},{"text":"patients with the usual clinical doses and schedule [17].","fontSize":10.56,"x":50.4,"y":134.18000000000006,"width":237.6739200000001,"height":10.559999999999945},{"text":"The exercise-induced augmentation of circulating","fontSize":10.56,"x":50.4,"y":146.30000000000007,"width":237.62192000000002,"height":10.559999999999945},{"text":"MOTS-c in young subjects was found to return to","fontSize":10.56,"x":50.4,"y":158.30000000000007,"width":237.69024000000005,"height":10.559999999999945},{"text":"baseline after only 4 hours of resting [4]. As we","fontSize":10.56,"x":50.4,"y":170.42000000000007,"width":237.67392000000004,"height":10.559999999999945},{"text":"measured circulating MOTS-c in blood that was not","fontSize":10.56,"x":50.4,"y":182.42000000000007,"width":237.62480000000014,"height":10.559999999999945},{"text":"strictly timed in relation to the last preceding oral dose","fontSize":10.56,"x":50.4,"y":194.54000000000008,"width":237.72672000000003,"height":10.559999999999945},{"text":"of metformin [17], our data need to be viewed","fontSize":10.56,"x":50.4,"y":206.66000000000008,"width":237.69503999999998,"height":10.559999999999945},{"text":"cautiously in terms of association between metformin","fontSize":10.56,"x":50.4,"y":218.66000000000008,"width":237.68448000000004,"height":10.559999999999945},{"text":"treatment, achieved serum concentration of MOTS-c,","fontSize":10.56,"x":50.4,"y":230.7800000000001,"width":237.76964,"height":10.559999999999945},{"text":"and probability of pCR in BC patients. Moreover, the","fontSize":10.56,"x":50.4,"y":242.7800000000001,"width":237.77960000000004,"height":10.559999999999945},{"text":"METTEN trial was conducted in patients with the","fontSize":10.56,"x":324.05,"y":49.680000000000064,"width":237.52608000000004,"height":10.559999999999945},{"text":"HER2+ subtype of breast cancer, which leaves open the","fontSize":10.56,"x":324.05,"y":61.680000000000064,"width":237.62111999999996,"height":10.559999999999945},{"text":"question of whether the circulating levels of MOTS-c","fontSize":10.56,"x":324.05,"y":73.80000000000007,"width":237.77863999999994,"height":10.559999999999945},{"text":"and/or the regulatory activity of metformin on MOTS-c","fontSize":10.56,"x":324.05,"y":85.82000000000005,"width":237.77863999999994,"height":10.559999999999945},{"text":"might be different in patients with other BC subtypes,","fontSize":10.56,"x":324.05,"y":97.94000000000005,"width":237.63168000000036,"height":10.559999999999945},{"text":"such as luminal A, HER2-negative luminal B or triple","fontSize":10.56,"x":324.05,"y":110.06000000000006,"width":237.58831999999978,"height":10.559999999999945},{"text":"negative [31]. Nonetheless, this is a retrospective study","fontSize":10.56,"x":324.05,"y":122.06000000000006,"width":237.72368,"height":10.559999999999945},{"text":"in a small sample size for which the evaluation of","fontSize":10.56,"x":324.05,"y":134.18000000000006,"width":237.7978399999999,"height":10.559999999999945},{"text":"MOTS-c was not part of the original study design. Care","fontSize":10.56,"x":324.05,"y":146.30000000000007,"width":237.66511999999983,"height":10.559999999999945},{"text":"should therefore be taken in interpreting and","fontSize":10.56,"x":324.05,"y":158.30000000000007,"width":237.70559999999983,"height":10.559999999999945},{"text":"generalizing these findings. With an ever-growing","fontSize":10.56,"x":324.05,"y":170.42000000000007,"width":237.76807999999977,"height":10.559999999999945},{"text":"recognition of the role of MOTS-c on age-related","fontSize":10.56,"x":324.05,"y":182.42000000000007,"width":237.7853599999999,"height":10.559999999999945},{"text":"diseases including diabetes, obesity, osteoporosis,","fontSize":10.56,"x":324.05,"y":194.54000000000008,"width":237.80167999999998,"height":10.559999999999945},{"text":"cardiovascular, and neurodegenerative diseases [32, 33],","fontSize":10.56,"x":324.05,"y":206.66000000000008,"width":237.76895999999982,"height":10.559999999999945},{"text":"further studies are needed to elucidate the nature of the","fontSize":10.56,"x":324.05,"y":218.66000000000008,"width":237.4204799999997,"height":10.559999999999945},{"text":"interaction between metformin and MOTS-c in cancer","fontSize":10.56,"x":324.05,"y":230.7800000000001,"width":237.79496,"height":10.559999999999945},{"text":"and non-cancer patients.","fontSize":10.56,"x":324.05,"y":242.7800000000001,"width":102.42416000000003,"height":10.559999999999945},{"text":"Figure 1. Circulating levels of MOTS-c in patients with HER2+ breast cancer treated with neoadjuvant metformin. (A) Left.","fontSize":9.96,"x":50.4,"y":647.74,"width":511.408,"height":9.960000000000036},{"text":"METTEN study design. Circulating MOTS-c levels were determined through blood draws obtained at pre- (0 weeks) and post- (24 weeks)","fontSize":9,"x":50.4,"y":659.98,"width":511.3570000000001,"height":9},{"text":"treatment using a commercial ELISA kit (CloudClone Corp., Wuhan, China; Catalog No. CEX132Hu). Right. Box plot (median, 25%–75%","fontSize":9,"x":50.4,"y":670.9,"width":511.3750000000001,"height":9},{"text":"quartiles and minimal and maximal values) of the pre- and post-treatment distribution of circulating MOTS-c in women randomized to arms A","fontSize":9,"x":50.4,"y":681.94,"width":511.471,"height":9},{"text":"(metformin-containing) and B (without metformin). (B) Box plot (median, 25%–75% quartiles and minimal and maximal values) of the pre-","fontSize":9,"x":50.4,"y":692.856,"width":511.2940000000001,"height":9},{"text":"and post-treatment distribution of circulating MOTS-c in non-pCR and pCR groups. No between-group comparisons reached statistical","fontSize":9,"x":50.4,"y":703.896,"width":511.34500000000037,"height":9},{"text":"significance in A and B.","fontSize":9,"x":50.4,"y":714.816,"width":82.56799999999998,"height":9}],"graphicsBounds":[{"operationIndex":102,"kind":"path","normalizedRect":[0.078125,0.94140625,0.92578125,0.94921875]},{"operationIndex":151,"kind":"path","normalizedRect":[0.30078125,0.09375,0.4765625,0.1171875]},{"operatio