[["tokens",107],{"text":"mental components were much smaller. Our findings suggest that","inlineSymbol":false,"baseline":901.245,"height":15,"rect":[469.50224999999995,886.245,863.9557499999999,901.245],"horizontal":true}]
[["tokens",108],{"text":"a home-based walking intervention with telephone counseling may","inlineSymbol":false,"baseline":917.745,"height":15,"rect":[469.50224999999995,902.745,863.7277500000009,917.745],"horizontal":true}]
[["tokens",109],{"text":"be particularly appropriate for improving physical well-being. It is","inlineSymbol":false,"baseline":934.245,"height":15,"rect":[469.50224999999995,919.245,864.0457499999995,934.245],"horizontal":true}]
[["tokens",110],{"text":"also important to note that the women in this study were much more","inlineSymbol":false,"baseline":950.745,"height":15,"rect":[469.50224999999995,935.745,864.222750000002,950.745],"horizontal":true}]
[["tokens",111],{"text":"impaired on the physical subscales than the emotional subscales at","inlineSymbol":false,"baseline":967.245,"height":15,"rect":[469.50224999999995,952.245,864.0022499999998,967.245],"horizontal":true}]
[["tokens",112],{"text":"baseline, leaving more room for improvement.","inlineSymbol":false,"baseline":983.745,"height":15,"rect":[469.50224999999995,968.745,748.29075,983.745],"horizontal":true}]
