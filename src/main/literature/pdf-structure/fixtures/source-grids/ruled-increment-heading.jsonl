[["tokens",98],{"text":"fatigue, sleep disturbances, arm symptoms, sexual functioning)","inlineSymbol":false,"baseline":785.745,"height":15,"rect":[469.5028500000001,770.745,863.6683499999997,785.745],"horizontal":true}]
[["tokens",99],{"text":"may persist a year after treatment ends.","inlineSymbol":false,"baseline":802.245,"height":15,"rect":[469.5028500000001,787.245,701.9728500000002,802.245],"horizontal":true}]
[["tokens",100],{"text":"29","inlineSymbol":false,"baseline":797.895,"height":9.75,"rect":[701.9872499999999,788.145,711.7372499999999,797.895],"horizontal":true}]
[["tokens",101],{"text":"Our findings suggest that","inlineSymbol":false,"baseline":802.245,"height":15,"rect":[715.00725,787.245,863.9872499999999,802.245],"horizontal":true}]
[["tokens",102],{"text":"physical activity may be a viable means for reducing such negative","inlineSymbol":false,"baseline":818.745,"height":15,"rect":[469.50224999999995,803.745,863.9722499999998,818.745],"horizontal":true}]
[["tokens",103],{"text":"side effects. Clinically significant improvements in a number of","inlineSymbol":false,"baseline":835.245,"height":15,"rect":[469.50224999999995,820.245,864.0472500000001,835.245],"horizontal":true}]
[["tokens",104],{"text":"aspects of QOL, as measured by the SF-36, were seen at 12 weeks.","inlineSymbol":false,"baseline":851.745,"height":15,"rect":[469.50224999999995,836.745,864.0022499999995,851.745],"horizontal":true}]
[["tokens",105],{"text":"With the exception of bodily pain, effect sizes for the physical com-","inlineSymbol":false,"baseline":868.245,"height":15,"rect":[469.50224999999995,853.245,864.0382500000012,868.245],"horizontal":true}]
