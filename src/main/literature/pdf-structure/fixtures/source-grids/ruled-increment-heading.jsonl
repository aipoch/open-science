[["tokens",114],{"text":"increases in breast cancer specific QOL, as measured by the IBCSG","inlineSymbol":false,"baseline":1016.745,"height":15,"rect":[469.50224999999995,1001.745,864.1972500000022,1016.745],"horizontal":true}]
[["tokens",115],{"text":"QOL Core questionnaire, were found, with effects generally in the","inlineSymbol":false,"baseline":1033.245,"height":15,"rect":[469.50224999999995,1018.2449999999999,864.00225,1033.245],"horizontal":true}]
[["tokens",116],{"text":"small to medium range. This finding is particularly important given","inlineSymbol":false,"baseline":1049.745,"height":15,"rect":[469.50224999999995,1034.745,864.2797499999997,1049.745],"horizontal":true}]
[["tokens",117],{"text":"the negative effects adjuvant therapy can have. Surprisingly, there","inlineSymbol":false,"baseline":1066.245,"height":15,"rect":[469.50224999999995,1051.245,863.9707500000002,1066.245],"horizontal":true}]
