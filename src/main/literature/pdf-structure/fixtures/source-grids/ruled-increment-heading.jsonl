[["tokens",87],{"text":"differences in change between groups were generally in the small to","inlineSymbol":false,"baseline":1000.2507,"height":15,"rect":[54.002700000000004,985.2507,448.51019999999994,1000.2507],"horizontal":true}]
[["tokens",88],{"text":"medium range. Increases in walking, which was the mode of physi-","inlineSymbol":false,"baseline":1016.7507,"height":15,"rect":[54.002700000000004,1001.7507,448.3182000000004,1016.7507],"horizontal":true}]
[["tokens",89],{"text":"cal activity this study focused on, was associated with improvements","inlineSymbol":false,"baseline":1033.2507,"height":15,"rect":[54.002700000000004,1018.2507,448.7516999999998,1033.2507],"horizontal":true}]
[["tokens",90],{"text":"in many of the outcomes examined. Wide-spread dissemination of","inlineSymbol":false,"baseline":1049.7507,"height":15,"rect":[54.002700000000004,1034.7507,448.50869999999986,1049.7507],"horizontal":true}]
