[["tokens",94],{"text":"motherapy, radiation) cause adverse emotional and physical side","inlineSymbol":false,"baseline":1115.7507,"height":15,"rect":[54.002700000000004,1100.7507,448.50269999999983,1115.7507],"horizontal":true}]
