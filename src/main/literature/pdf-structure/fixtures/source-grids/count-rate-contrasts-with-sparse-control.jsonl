[["tokens",98],{"text":"is 60%, while that in the treatment group is close to the total sample average. We thus interpret","inlineSymbol":false,"baseline":1009.9755,"height":16.36365,"rect":[106.299,993.61185,811.6966787399992,1009.9755],"horizontal":true}]
