[["tokens",100],{"text":"that this kind of Type-I error would arise for one subgroup.","inlineSymbol":false,"baseline":1075.743,"height":16.36365,"rect":[106.299,1059.37935,545.0215474199999,1075.743],"horizontal":true}]
[["tokens",101],{"text":"To further investigate, we collected","inlineSymbol":false,"baseline":1075.743,"height":16.36365,"rect":[556.3288295699997,1059.37935,811.7048605649998,1075.743],"horizontal":true}]
