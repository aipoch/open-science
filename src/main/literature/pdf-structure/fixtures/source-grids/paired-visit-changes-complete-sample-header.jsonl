[["page","lines",34],{"text":"Effect sizes (ES) were calculated by dividing beta by the pooled SD at baseline, with positive ES meaning a beneficial effect of the exercise intervention on a specific outcome. ES <0.2 indicate","fontSize":9,"x":55.7291,"y":399.6424,"width":668.5658999999999,"height":9}]
[["page","lines",35],{"text":"“no effect,” ES between 0.2 and 0.5 indicate “small effects,” ES between 0.5 and 0.8 indicate “medium effects,” and ES ≥0.8 indicate “large effects.”","fontSize":9,"x":52.38290000000006,"y":409.67740000000003,"width":520.5726000000001,"height":9}]
