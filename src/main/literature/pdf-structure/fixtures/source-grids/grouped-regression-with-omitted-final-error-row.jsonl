[["tokens",88],{"text":"multiple hypothesis testing. A third possibility is that treatments did have a real depressing effect","inlineSymbol":false,"baseline":787.5150000000002,"height":16.36365,"rect":[106.29900000000002,771.1513500000002,811.7081332949992,787.5150000000002],"horizontal":true}]
[["tokens",89],{"text":"on newly-eligible women in the Eure. We cannot rule out this possibility.","inlineSymbol":false,"baseline":820.3995000000002,"height":16.36365,"rect":[106.29900000000002,804.0358500000002,627.5041616099995,820.3995000000002],"horizontal":true}]
[["tokens",90],{"text":"Overall, the negative differences for the newly eligible are driven by the Eure and especially by","inlineSymbol":false,"baseline":853.2840000000002,"height":16.36365,"rect":[131.70450000000002,836.9203500000002,811.7074303049994,853.2840000000002],"horizontal":true}]
[["tokens",91],{"text":"the surprisingly high screening rate in the control group. We should be cautious in interpreting this","inlineSymbol":false,"baseline":886.1670000000003,"height":16.36365,"rect":[106.29900000000002,869.8033500000003,811.7081332949995,886.1670000000003],"horizontal":true}]
[["tokens",92],{"text":"as a negative effect of our behavioral interventions on the newly eligible.","inlineSymbol":false,"baseline":919.0515000000003,"height":16.36365,"rect":[106.29900000000002,902.6878500000003,621.7817932049999,919.0515000000003],"horizontal":true}]
[["tokens",93],{"text":"What do we then learn from the newly eligible?","inlineSymbol":false,"baseline":951.9345000000003,"height":16.36365,"rect":[131.70450000000002,935.5708500000003,480.1962449550002,951.9345000000003],"horizontal":true}]
[["tokens",94],{"text":"We believed that treatment effects would be","inlineSymbol":false,"baseline":951.9345000000003,"height":16.36365,"rect":[490.47261715499997,935.5708500000003,811.69597575,951.9345000000003],"horizontal":true}]
[["tokens",95],{"text":"more likely in a group that had a greater chance of reading the invitation letters.","inlineSymbol":false,"baseline":984.8190000000002,"height":16.36365,"rect":[106.29900000000002,968.4553500000002,706.5585911249993,984.8190000000002],"horizontal":true}]
[["tokens",96],{"text":"For instance,","inlineSymbol":false,"baseline":984.8190000000002,"height":16.36365,"rect":[718.5040556249991,968.4553500000002,811.706496929999,984.8190000000002],"horizontal":true}]
[["tokens",97],{"text":"if learning occurs through trial and error, these women may change the information they consider","inlineSymbol":false,"baseline":1017.7020000000002,"height":16.36365,"rect":[106.29900000000002,1001.3383500000002,811.6983151049991,1017.7020000000002],"horizontal":true}]
[["tokens",98],{"text":"to be relevant and thus their behavior.","inlineSymbol":false,"baseline":1050.5865000000003,"height":16.36365,"rect":[106.29900000000002,1034.2228500000003,391.87251070500014,1050.5865000000003],"horizontal":true}]
[["tokens",99],{"text":"However, our analysis provides suggestive evidence that","inlineSymbol":false,"baseline":1050.5865000000003,"height":16.36365,"rect":[404.21070280500015,1034.2228500000003,811.695042375,1050.5865000000003],"horizontal":true}]
[["tokens",100],{"text":"17","inlineSymbol":false,"baseline":1126.5330000000004,"height":16.36365,"rect":[450.86400000000003,1110.1693500000003,467.13601356000004,1126.5330000000004],"horizontal":true}]
