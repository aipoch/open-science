[["page"],{"pageNumber":5,"width":557.972,"height":773.972,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":1,"constructPath":15},"captionStarts":[{"text":"FIGURE 4. Number of events between the control and intervention groups to reduce (A) high-intensity pain (B) worsen moderate pain","fontSize":7.9702,"x":42.8598,"y":473.7499,"width":472.2845622600001,"height":7.970199999999977},{"text":"TABLE 3. Average Distribution of Scores Obtained in the Quality","fontSize":7.9702,"x":42.8598,"y":581.0129,"width":227.2128675599999,"height":7.970199999999977}],"headingCandidates":[],"lines":[{"text":"differences between groups (χ","fontSize":8.9663,"x":42.8598,"y":499.6262,"width":115.82845666,"height":8.96629999999999},{"text":"2","fontSize":5.9768,"x":158.6834,"y":499.4976,"width":3.3623000000000047,"height":5.976800000000026},{"text":") for comfort in application","fontSize":8.9663,"x":162.085,"y":499.6262,"width":107.91121375999998,"height":8.96629999999999},{"text":"(P = 0.537), ease in application (P = 0.601), alteration of sen-","fontSize":8.9663,"x":42.85921227,"y":509.60389863999995,"width":227.16748690999998,"height":8.96629999999999},{"text":"sitivity (P = 0.924), burning on application (P = 0.989), a feel-","fontSize":8.9663,"x":42.86010890000003,"y":519.58159728,"width":227.15403746,"height":8.966299999999933},{"text":"ing of improvement in hydration (P = 0.947), and pain relief","fontSize":8.9663,"x":42.85921227000006,"y":529.55929592,"width":227.13879475,"height":8.966300000000047},{"text":"(P = 0.387).","fontSize":8.9663,"x":42.85921227000003,"y":539.48050687,"width":42.70828016,"height":8.966299999999933},{"text":"DISCUSSION","fontSize":9.9626,"x":371.792,"y":498.62989999999996,"width":59.44583793999999,"height":9.962600000000009},{"text":"In this phase II randomized clinical trial, the incidence of","fontSize":8.9663,"x":306.7653,"y":510.62469999999996,"width":208.34094679999998,"height":8.966300000000047},{"text":"any grade of RD was not significantly reduced or delayed with","fontSize":8.9663,"x":287.94324304,"y":520.54591095,"width":227.16748690999992,"height":8.966299999999933},{"text":"the experimental use of microparticles of Chamomile. How-","fontSize":8.9663,"x":287.94324304,"y":530.52360959,"width":227.11099922,"height":8.966300000000047},{"text":"ever, a significant reduction in grade 2 or > RD rate and a","fontSize":8.9663,"x":287.94324304,"y":540.50130823,"width":227.17465995000003,"height":8.966300000000047},{"text":"delay of 7 days to RD developing was observed. The reduced","fontSize":8.9663,"x":287.9432430400001,"y":550.4790068699999,"width":227.13520823,"height":8.966300000000047},{"text":"and delayed incidence of grade 2 or > RD translated into a","fontSize":8.9663,"x":287.9432430400001,"y":560.40021782,"width":227.17376332000003,"height":8.966299999999933},{"text":"significant reduction in the severity of symptoms such as pain","fontSize":8.9663,"x":287.9432430400001,"y":570.3779164599999,"width":227.16300375999992,"height":8.966300000000047},{"text":"and pruritus.","fontSize":8.9663,"x":287.9432430400001,"y":580.3556151,"width":45.63308721999999,"height":8.966299999999933},{"text":"The incidence of any grade RD was similar in both groups","fontSize":8.9663,"x":306.7653000000001,"y":590.27682605,"width":208.34991309999992,"height":8.966300000000047},{"text":"(89%). Although the incidence of RD can be considered high, it","fontSize":8.9663,"x":287.9432430400001,"y":600.2545246899999,"width":227.12893182000016,"height":8.966300000000047},{"text":"is close to the acute toxicity rate detected in a randomized","fontSize":8.9663,"x":287.9432430400001,"y":610.2322233299999,"width":227.11279247999994,"height":8.966300000000047},{"text":"clinical trial. In the early report of the Arsenault et al,","fontSize":8.9663,"x":287.9432430400001,"y":620.20992197,"width":189.71166528999993,"height":8.966299999999933},{"text":"23","fontSize":6.7246,"x":477.6376,"y":619.2221999999999,"width":6.725272459999985,"height":6.7246000000000095},{"text":"a subset","fontSize":8.9663,"x":486.6519,"y":620.212,"width":28.445586750000018,"height":8.966300000000047},{"text":"of 161 from 1521 patients used to assess the acute toxicity, who","fontSize":8.9663,"x":287.94255266000005,"y":630.1332109499999,"width":227.1477610500001,"height":8.966300000000047},{"text":"were randomized to receive hypo or conventional fractionation,","fontSize":8.9663,"x":287.94255266000005,"y":640.11090959,"width":227.09844640000006,"height":8.966299999999933},{"text":"the incidence of any RD grade at 4 weeks was 86% and 75% for","fontSize":8.9663,"x":287.94255266000005,"y":650.08860823,"width":227.15852060999987,"height":8.966299999999933},{"text":"hypo and conventional fractionation, respectively.","fontSize":8.9663,"x":287.94255266000005,"y":660.06630687,"width":181.13898586,"height":8.966300000000047},{"text":"The anti-inflammatory activity of Chamomile is related to","fontSize":8.9663,"x":306.76460962000004,"y":669.98751782,"width":208.44764576999984,"height":8.966299999999933},{"text":"the apigenin, a flavonoid that acts to decrease the production of","fontSize":8.9663,"x":287.94344929000005,"y":679.96521646,"width":227.2248712299998,"height":8.966300000000047},{"text":"tumor necrosis factor-α, and consequently, the inflammation.","fontSize":8.9663,"x":287.94344929,"y":689.9429150999999,"width":220.62298454,"height":8.966300000000047},{"text":"24","fontSize":6.7246,"x":508.4786,"y":688.9544999999999,"width":6.725272459999985,"height":6.7246000000000095},{"text":"On the basis of this principle, we believed that Chamomile would","fontSize":8.9663,"x":287.9432,"y":699.9223,"width":227.17017679999964,"height":8.966300000000047},{"text":"have the power to reduce the rate of any grade of RD when the","fontSize":8.9663,"x":287.9432,"y":709.84351095,"width":227.17376331999998,"height":8.966299999999933},{"text":"A B","fontSize":9.9999,"x":50.7287,"y":74.76979999999992,"width":212.99087007000003,"height":9.999900000000025},{"text":"C D","fontSize":9.9999,"x":50.7287,"y":279.2717549599999,"width":213.54086457,"height":9.999900000000025},{"text":"number of events in each group","fontSize":7.2354,"x":49.506,"y":118.59868559999984,"width":7.2353999999999985,"height":91.42651440000009},{"text":"number of events in each group","fontSize":7.2354,"x":49.506,"y":320.3599852199999,"width":7.2353999999999985,"height":91.42651440000009},{"text":"Control","fontSize":7.24,"x":468.51,"y":94.71569999999997,"width":22.125440000000026,"height":7.240000000000009},{"text":"Intervention","fontSize":7.24,"x":468.51,"y":104.11104799999998,"width":35.38911999999999,"height":7.240000000000009},{"text":"Control","fontSize":7.24,"x":471.86212,"y":298.57165599999996,"width":22.125440000000026,"height":7.240000000000009},{"text":"Intervention","fontSize":7.24,"x":471.86212,"y":307.17567199999996,"width":35.38911999999999,"height":7.240000000000009},{"text":"Pain<8 Pain≥8 Without worsening","fontSize":7.2354,"x":105.328,"y":254.10159999999996,"width":243.80259132,"height":7.278088860000025},{"text":"pain (>3)","fontSize":7.2354,"x":308.72450002000005,"y":262.78335645999994,"width":26.951864999999998,"height":7.235400000000027},{"text":"Worsening of pain","fontSize":7.2354,"x":385.53550642000005,"y":254.10159999999996,"width":55.661932200000024,"height":7.235400000000027},{"text":"(>3)","fontSize":7.2354,"x":407.92834588000005,"y":262.78480354,"width":12.685826820000045,"height":7.235400000000027},{"text":"Without worsening of","fontSize":7.2354,"x":83.38737304000006,"y":450.26848834,"width":63.506552880000015,"height":7.235400000000027},{"text":"itching","fontSize":7.2354,"x":105.99438034000005,"y":458.95169188,"width":20.100219659999937,"height":7.235400000000027},{"text":"Worsening of itching Burning < 8 Burning ≥ 8","fontSize":7.2354,"x":174.5996,"y":449.9527600999999,"width":259.51570949999996,"height":8.315645220000022},{"text":"number of events in each group","fontSize":7.2354,"x":255.82770000000002,"y":319.4646855999999,"width":7.2353999999999985,"height":91.42651440000009},{"text":"number of events in each group","fontSize":7.2354,"x":255.82770000000002,"y":118.65918231999956,"width":7.2353999999999985,"height":91.42651440000009},{"text":"FIGURE 4. Number of events between the control and intervention groups to reduce (A) high-intensity pain (B) worsen moderate pain","fontSize":7.9702,"x":42.8598,"y":473.7499,"width":472.2845622600001,"height":7.970199999999977},{"text":"(C) pruritus and (D) burning.","fontSize":7.9702,"x":42.8598,"y":482.70760778000005,"width":102.81558000000001,"height":7.970199999999977},{"text":"TABLE 3. Average Distribution of Scores Obtained in the Quality","fontSize":7.9702,"x":42.8598,"y":581.0129,"width":227.2128675599999,"height":7.970199999999977},{"text":"of Life Evaluation by Skindex","fontSize":7.9702,"x":42.85979999999999,"y":590.0271961999999,"width":100.68514554000002,"height":7.970199999999977},{"text":"Control Intervention","fontSize":8.4682,"x":136.6299,"y":603.1921,"width":101.11538892000004,"height":8.468200000000024},{"text":"Skindex Evaluation Average SD Average SD P*","fontSize":8.4682,"x":42.85982776,"y":620.14289594,"width":222.89826675999998,"height":8.468200000000024},{"text":"Initial 0.576 0.874 0.532 0.905 0.787","fontSize":7.9702,"x":42.8598,"y":634.3609,"width":227.23916921999984,"height":7.970199999999977},{"text":"7 d 0.367 0.648 0.245 0.314 1.000","fontSize":7.9702,"x":42.8598,"y":643.31860778,"width":227.23996623999983,"height":7.970199999999977},{"text":"14 d 0.565 0.773 0.264 0.657 0.072","fontSize":7.9702,"x":42.8598,"y":652.27631556,"width":227.23996623999977,"height":7.970200000000091},{"text":"21 d 0.437 0.626 0.221 0.385 0.091","fontSize":7.9702,"x":42.8598,"y":661.23402334,"width":227.23996623999977,"height":7.970199999999977},{"text":"28 d 0.558 0.912 0.369 0.646 0.571","fontSize":7.9702,"x":42.8598,"y":670.19173112,"width":227.23996623999977,"height":7.9701999