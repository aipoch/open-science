[["page"],{"pageNumber":7,"width":600.945,"height":776.693,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":6,"constructPath":17},"captionStarts":[{"text":"Fig. 2 Kaplan-Meier curves for the cumulative dose to chemotherapy-induced peripheral neuropathy (CIPN)-related events in genotypes","fontSize":8.5039,"x":58.8189,"y":444.019,"width":483.3462225000003,"height":8.503899999999987}],"headingCandidates":[],"lines":[{"text":"s e ver it y of C I PN ( mu lt iv ar i ate OR : 2 . 3 3 ,","fontSize":10.6299,"x":58.8189,"y":522.528,"width":233.92583136000002,"height":10.629899999999907},{"text":"95%CI: 1.62-3.34, p < 0.0001).","fontSize":10.6299,"x":58.8189,"y":535.28388,"width":131.4812331,"height":10.62990000000002},{"text":"Discussion","fontSize":12.0472,"x":148.1904,"y":559.8362,"width":55.115939999999966,"height":12.047199999999975},{"text":"We examined the relationship between the onset and","fontSize":10.6299,"x":72.9921,"y":586.3075,"width":219.66475752000002,"height":10.62990000000002},{"text":"severity of CIPN and five SNPs that have been associ-","fontSize":10.6299,"x":58.822443299999996,"y":599.06338,"width":233.85480110000012,"height":10.629899999999907},{"text":"ated with CIPN [14]. EPHA4 had no genetic polymor-","fontSize":10.6299,"x":58.8189,"y":611.8193,"width":233.85834440000008,"height":10.62990000000002},{"text":"phism in the present patients and was excluded from the","fontSize":10.6299,"x":58.8189,"y":624.5753,"width":233.9768548799999,"height":10.62990000000002},{"text":"analysis. The XKR4 genotype was observed to be sig-","fontSize":10.6299,"x":58.8189,"y":637.33118,"width":233.85844440000005,"height":10.62990000000002},{"text":"nificantly associated with CIPN, with a significantly","fontSize":10.6299,"x":58.8189,"y":650.087,"width":233.83335122999995,"height":10.62990000000002},{"text":"worse CIPN grade than that at baseline in the patients","fontSize":10.6299,"x":58.8189,"y":662.8428799999999,"width":233.84610711000016,"height":10.62990000000002},{"text":"with the XKR4-rs4737264 heterozygous allele AC com-","fontSize":10.6299,"x":58.8189,"y":675.59876,"width":233.85844440000005,"height":10.62990000000002},{"text":"pared to those with AA. No association was revealed","fontSize":10.6299,"x":58.8189,"y":688.3547,"width":233.87693381999998,"height":10.62990000000002},{"text":"between the XKR4 genotype and other CIPN-related","fontSize":10.6299,"x":58.8189,"y":701.11058,"width":233.85461103000006,"height":10.629899999999907},{"text":"events (grade ≥ 2 CIPN on CTCAE v.4.0 or a PNQ sen-","fontSize":10.6299,"x":308.27076329999994,"y":522.52826,"width":233.8553811000001,"height":10.629899999999907},{"text":"sory grade of D or E). We speculate that this result was","fontSize":10.6299,"x":308.2677,"y":535.2839,"width":233.85780000000034,"height":10.62990000000002},{"text":"influenced by the detection sensitivity due to the differ-","fontSize":10.6299,"x":308.2677,"y":548.03978,"width":233.8584444000005,"height":10.62990000000002},{"text":"ence in the number of events. There was no significant","fontSize":10.6299,"x":308.2677,"y":560.7957,"width":233.85567402000038,"height":10.62990000000002},{"text":"association between the onset or severity of CIPN with","fontSize":10.6299,"x":308.2677,"y":573.55158,"width":233.82378432000007,"height":10.62990000000002},{"text":"genetic polymorphisms in EPHA5-rs7349683,","fontSize":10.6299,"x":308.2677,"y":586.30746,"width":233.87693381999986,"height":10.629899999999907},{"text":"EPHA6-rs301927, and LIMK2-rs5749248.","fontSize":10.6299,"x":308.2677,"y":599.0633399999999,"width":179.39975930999987,"height":10.62990000000002},{"text":"CIPN is a serious adverse event that may interfere","fontSize":10.6299,"x":322.4373567,"y":611.81922,"width":219.6860173199998,"height":10.62990000000002},{"text":"with drug efficacy, and the identification of risk factors","fontSize":10.6299,"x":308.2677,"y":624.5750999999999,"width":233.85673701000007,"height":10.62990000000002},{"text":"for CIPN’s onset and severity is important for patients","fontSize":10.6299,"x":308.2677,"y":637.33098,"width":233.89075268999977,"height":10.629899999999907},{"text":"and physicians, and for establishing preventive and","fontSize":10.6299,"x":308.2677,"y":650.0868599999999,"width":233.8779968099999,"height":10.62990000000002},{"text":"therapeutic approaches. Older age, obesity, and ethnic","fontSize":10.6299,"x":308.2677,"y":662.8427399999999,"width":233.7663828599998,"height":10.62990000000002},{"text":"differences are risk factors for CIPN, and African","fontSize":10.6299,"x":308.2677,"y":675.59862,"width":233.8588629899998,"height":10.629899999999907},{"text":"patients may have a higher incidence of CIPN [13];","fontSize":10.6299,"x":308.2677,"y":688.3544999999999,"width":233.87905980000005,"height":10.62990000000002},{"text":"there have been few studies of CIPN in Japanese","fontSize":10.6299,"x":308.2678,"y":701.1107,"width":233.86736691000016,"height":10.62990000000002},{"text":"December 2022 Association of SNPs with CIPN","fontSize":8.5039,"x":58.8189,"y":78.34969999999998,"width":454.9618350000005,"height":8.504000000000019},{"text":"667","fontSize":7.4835,"x":523.9099,"y":79.37019999999995,"width":18.216973399999915,"height":7.483500000000049},{"text":"C. LIMK2-rs5749248","fontSize":11.3386,"x":69.1137,"y":105.6312999999999,"width":100.40251800000001,"height":11.338600000000042},{"text":"p = 0.068","fontSize":9.2126,"x":138.0795,"y":201.6001,"width":34.04055700000001,"height":9.212599999999952},{"text":"p = 0.154","fontSize":9.2126,"x":321.36417700000004,"y":205.2298644,"width":34.04055699999998,"height":9.212599999999952},{"text":"p = 0.889","fontSize":9.2126,"x":432.04435340000003,"y":186.353247,"width":34.040557000000035,"height":9.212599999999952},{"text":"Incidence of CIPN over G2 Worsening of CIPN Grade Incidence of PNQ D/E","fontSize":9.2126,"x":89.34484600000008,"y":131.09607219999998,"width":431.64716039999973,"height":9.