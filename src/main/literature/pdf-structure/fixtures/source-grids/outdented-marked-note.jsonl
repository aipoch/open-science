[["page","lines",0],{"text":"Angiogenesis, the formation of new blood vessels from","fontSize":10.0001,"x":69.4488,"y":65.68489999999997,"width":231.02531023000006,"height":10.000099999999975}]
[["page","lines",1],{"text":"existing vasculature, has an essential role for supplying","fontSize":10.0001,"x":60.491710430000005,"y":76.68300997999995,"width":239.89739894999985,"height":10.000099999999975}]
[["page","lines",2],{"text":"nutrients and oxygen to rapidly growing tumors.","fontSize":10.0001,"x":60.491710430000005,"y":87.68111995999993,"width":208.76708764999995,"height":10.000099999999975}]
[["page","lines",3],{"text":"10","fontSize":6.666,"x":269.3479,"y":86.59379999999987,"width":7.139904800000011,"height":6.666000000000054}]
[["page","lines",4],{"text":"This","fontSize":10.0001,"x":283.2377,"y":87.68169999999998,"width":17.190171899999996,"height":10.000099999999975}]
[["page","lines",5],{"text":"process can be therapeutically targeted by antiangiogenetic","fontSize":10.0001,"x":60.49047255000002,"y":98.67980997999996,"width":240.00640004000005,"height":10.000099999999975}]
[["page","lines",6],{"text":"treatment.","fontSize":10.0001,"x":60.49047255000002,"y":109.67791995999994,"width":39.798397980000004,"height":10.000099999999975}]
[["page","lines",7],{"text":"11","fontSize":6.666,"x":100.4031,"y":108.59069999999986,"width":7.198404019999998,"height":6.666000000000054}]
[["page","lines",8],{"text":"Bevacizumab has the ability to inhibit the","fontSize":10.0001,"x":114.5197,"y":109.67859999999996,"width":185.94085938999996,"height":10.000099999999975}]
[["page","lines",9],{"text":"proangiogenetic vascular endothelial growth factor.","fontSize":10.0001,"x":60.49115972,"y":120.67670997999994,"width":197.46897467000008,"height":10.000099999999975}]
[["page","lines",10],{"text":"12","fontSize":6.666,"x":257.9527,"y":119.58909999999992,"width":7.139904800000011,"height":6.666000000000054}]
[["page","lines",11],{"text":"Because of improvements in treatment together with earlier","fontSize":10.0001,"x":69.4488,"y":131.67539999999997,"width":231.01831016000017,"height":10.000099999999975}]
[["page","lines",12],{"text":"diagnosis, mortality due to BC has decreased during the last","fontSize":10.0001,"x":60.491710430000005,"y":142.67350997999995,"width":239.98939986999994,"height":10.000099999999975}]
[["page","lines",13],{"text":"years.","fontSize":10.0001,"x":60.491710430000005,"y":153.67161995999993,"width":21.300213000000007,"height":10.000099999999975}]
[["page","lines",14],{"text":"1","fontSize":6.666,"x":81.7511,"y":152.58429999999987,"width":3.5699524000000054,"height":6.666000000000054}]
[["page","lines",15],{"text":"However, despite intensive treatment regimes, a great","fontSize":10.0001,"x":89.1779,"y":153.67229999999995,"width":211.29811296000005,"height":10.000099999999975}]
[["page","lines",16],{"text":"proportion of LABC patients will develop metastatic","fontSize":10.0001,"x":60.49161314,"y":164.67040997999993,"width":239.95739954999974,"height":10.000099999999975}]
[["page","lines",17],{"text":"disease.","fontSize":10.0001,"x":60.49161314,"y":175.6685199599999,"width":28.7502875,"height":10.000099999999975}]
[["page","lines",18],{"text":"13,14","fontSize":6.666,"x":89.2346,"y":174.58119999999997,"width":15.814289139999971,"height":6.666000000000054}]
[["page","lines",19],{"text":"Additionally, treatment may induce unwanted","fontSize":10.0001,"x":111.2315,"y":175.66920000000005,"width":189.25589253999988,"height":10.000099999999975}]
[["page","lines",20],{"text":"long-term side effects, such as fatigue, increased risk of","fontSize":10.0001,"x":60.4909926,"y":186.66730998000003,"width":239.98339980999995,"height":10.000099999999975}]
[["page","lines",21],{"text":"cardiovascular diseases (CVDs), and cardiotoxicity.","fontSize":10.0001,"x":60.49099260000001,"y":197.66541996,"width":219.71419712,"height":10.000099999999975}]
[["page","lines",22],{"text":"15−19","fontSize":6.666,"x":280.403,"y":196.57799999999986,"width":20.067482429999984,"height":6.666000000000054}]
[["page","lines",23],{"text":"Characterizing the systemic effect of cancer treatment may","fontSize":10.0001,"x":60.4913,"y":208.6644,"width":240.00940007,"height":10.000099999999975}]
[["page","lines",24],{"text":"further enhance our understanding of unwanted side-effects","fontSize":10.0001,"x":60.49130000000001,"y":219.66250997999998,"width":239.9953999299999,"height":10.000099999999975}]
[["page","lines",25],{"text":"and potentially identify mechanisms to prevent late effects.","fontSize":10.0001,"x":60.49129999999994,"y":230.71762052999998,"width":229.05229049999994,"height":10.000099999999975}]
[["page","lines",26],{"text":"Metabolomics is a rapidly growing field in medical research","fontSize":10.0001,"x":69.44838956999988,"y":241.71573050999996,"width":231.00831005999996,"height":10.000099999999975}]
[["page","lines",27],{"text":"and makes it possible to look at the contents of a biological","fontSize":10.0001,"x":60.49129999999988,"y":252.71384048999994,"width":239.96139959,"height":10.000099999999975}]
[["page","lines",28],{"text":"matrix at the molecular level. Metabolites are downstream","fontSize":10.0001,"x":60.49129999999988,"y":263.7119504699999,"width":239.9703996800001,"height":10.000099999999975}]
[["page","lines",29],{"text":"biochemical products in the omics cascade, and altered","fontSize":10.0001,"x":60.49129999999988,"y":274.7100604499999,"width":239.9243992199999,"height":10.000099999999975}]
[["page","lines",30],{"text":"metabolism has been defined as a hallmark of cancer.","fontSize":10.0001,"x":60.49129999999988,"y":285.7081704299999,"width":232.72132718999993,"height":10.000099999999975}]
[["page","lines",31],{"text":"11","fontSize":6.666,"x":293.2157,"y":284.56539999999995,"width":7.139904800000011,"height":6.666000000000054}]
[["page","lines",32],{"text":"Following a minimal sample preparation, a wide range of","fontSize":10.0001,"x":60.4913,"y":296.70849999999996,"width":239.9843998200001,"height":10.000100000000032}]
[["page","lines",33],{"text":"metabolites can be detected within a short amount of time","fontSize":10.0001,"x":60.4913,"y":307.70660998,"width":239.97039967999999,"height":10.000099999999975}]
[["page","lines",34],{"text":"using nuclear magnetic resonance (NMR) spectroscopy.","fontSize":10.0001,"x":60.4913,"y":318.70471996,"width":232.73432731999995,"height":10.000099999999975}]
[["page","lines",35],{"text":"20","fontSize":6.666,"x":293.2157,"y":317.5607,"width":7.139904800000011,"height":6.665999999999997}]
[["page","lines",36],{"text":"NMR metabolomics has already shown potential in strat-","fontSize":10.0001,"x":60.4913,"y":329.70369999999997,"width":239.97139968999997,"height":10.000099999999975}]
[["page","lines",37],{"text":"ification of BC patients with respect to treatment response and","fontSize":10.0001,"x":60.4913,"y":340.70180997999995,"width":240.01140009000002,"height":10.000099999999975}]
[["page","lines",38],{"text":"long-term survival.","fontSize":10.0001,"x":60.4913,"y":351.69991995999993,"width":72.55372553000001,"height":10.000099999999975}]
[["page","lines",39],{"text":"21,22","fontSize":6.666,"x":133.0015,"y":350.556,"width":15.81428914,"height":6.665999999999997}]
[["page","lines",40],{"text":"Most studies so far have focused on","fontSize":10.0001,"x":153.2409,"y":351.7006,"width":147.23347232000003,"height":10.000099999999975}]
[["page","lines",41],{"text":"metabolomics of invasive tissue biopsies.","fontSize":10.0001,"x":60.490972510000006,"y":362.69870998,"width":157.90457903000006,"height":10.000099999999975}]
[["page","lines",42],{"text":"3,21−24","fontSize":6.666,"x":218.4377,"y":361.5544,"width":24.487923490000014,"height":6.665999999999997}]
[["page","lines",43],{"text":"Metabolomics","fontSize":10.0001,"x":246.274,"y":362.699,"width":54.180541800000015,"height":10.000099999999975}]
[["page","lines",44],{"text":"of biofluids is minimally invasive and repeated sampling is","fontSize":10.0001,"x":60.49014218000002,"y":373.69710998,"width":239.97539972999994,"height":10.000099999999975}]
[["page","lines",45],{"text":"simple. A recent review concludes that many studies have","fontSize":10.0001,"x":60.490142180000035,"y":384.69521996,"width":240.00039997999994,"height":10.000099999999975}]
[["page","lines",46],{"text":"shown impressive associations between biofluid metabolomics","fontSize":10.0001,"x":60.490142180000035,"y":395.69332993999996,"width":239.98539983,"height":10.000099999999975}]
[["page","lines",47],{"text":"and cancer progression, suggesting that NMR metabolomics","fontSize":10.0001,"x":60.49014218000005,"y":406.69143991999994,"width":239.98739985000006,"height":10.000099999999975}]
[["page","lines",48],{"text":"can be used to provide information with prognostic or","fontSize":10.0001,"x":60.49014218000005,"y":417.6895498999999,"width":239.98239979999997,"height":10.000099999999975}]
[["page","lines",49],{"text":"predictive value.","fontSize":10.0001,"x":60.49014218000005,"y":428.6876598799999,"width":62.453624529999985,"height":10.000099999999975}]
[["page","lines",50],{"text":"25","fontSize":6.666,"x":122.9669,"y":427.60159999999996,"width":7.1399047999999965,"height":6.665999999999997}]
[["page","lines",51],{"text":"The NeoAva study is a phase II randomized clinical trial","fontSize":10.0001,"x":69.4488,"y":439.6879,"width":231.04731044999994,"height":10.000099999999975}]
[["page","lines",52],{"text":"assessing the effect of antiangiogenesis treatment by","fontSize":10.0001,"x":60.491710430000005,"y":450.68600998,"width":239.96339960999984,"height":10.000099999999975}]
[["page","lines",53],{"text":"bevacizumab in combination with standard NAC. We have","fontSize":10.0001,"x":60.49171043000001,"y":461.68411996,"width":240.0003999800001,"height":10.000099999999975}]
[["page","lines",54],{"text":"previously shown that metabolic profiling of tumor tissue by","fontSize":10.0001,"x":60.49171043000001,"y":472.68222993999996,"width":239.99939997,"height":10.000099999999975}]
[["page","lines",55],{"text":"magnetic resonance spectroscopy has a potential in predicting","fontSize":10.0001,"x":60.49271044000005,"y":483.68033991999994,"width":239.98839986000002,"height":10.000099999999975}]
[["page","lines",56],{"text":"treatment response in this cohort.","fontSize":10.0001,"x":60.49271044000005,"y":494.6784498999999,"width":129.56329562000002,"height":10.000099999999975}]
[["page","lines",57],{"text":"21","fontSize":6.666,"x":190.0346,"y":493.59209999999996,"width":7.139904800000011,"height":6.665999999999997}]
[["page","lines",58],{"text":"Furthermore, both clinical","fontSize":10.0001,"x":200.0125,"y":494.6801,"width":100.46900468000001,"height":10.000099999999975}]
[["page","lines",59],{"text":"and gene expression response was shown to differ between","fontSize":10.0001,"x":60.49110479999999,"y":505.67820997999996,"width":239.99739994999996,"height":10.000100000000032}]
[["page","lines",60],{"text":"patients receiving combination therapy with bevacizumab and","fontSize":10.0001,"x":60.49010478999995,"y":516.67631996,"width":240.0124001,"height":10.000099999999975}]
[["page","lines",61],{"text":"chemotherapy alone, and circulating cytokine profiles were","fontSize":10.0001,"x":60.49010478999995,"y":527.67442994,"width":239.98439982,"height":10.000099999999975}]
[["page","lines",62],{"text":"found to correlate with different immune cell types at the","fontSize":10.0001,"x":60.49010478999992,"y":538.67253992,"width":239.99739995,"height":10.000099999999975}]
[["page","lines",63],{"text":"tumor site.","fontSize":10.0001,"x":60.49010478999989,"y":549.6706499,"width":41.82641826,"height":10.000099999999975}]
[["page","lines",64],{"text":"26−28","fontSize":6.666,"x":102.3307,"y":548.5842,"width":19.385741519999996,"height":6.66599999999994}]
[["page","lines",65],{"text":"In this study, we performed metabolic profiling of serum","fontSize":10.0001,"x":69.4488,"y":560.6705999999999,"width":231.01431011999995,"height":10.000099999999975}]
[["page","lines",66],{"text":"samples from patients in the NeoAva study. The main aim was","fontSize":10.0001,"x":60.49171042999998,"y":571.6687099799999,"width":239.99539992999993,"height":10.000100000000089}]
[["page","lines",67],{"text":"to characterize systemic metabolic effects of NAC in BC","fontSize":10.0001,"x":60.49171042999998,"y":582.66681996,"width":239.97039967999999,"height":10.000099999999975}]
[["page","lines",68],{"text":"patients and to relate these changes to treatment response and","fontSize":10.0001,"x":60.491710429999955,"y":593.72193051,"width":240.01140009,"height":10.000099999999975}]
[["page","lines",69],{"text":"long-term survival. Additionally, the metabolic information in","fontSize":10.0001,"x":60.491710429999955,"y":604.72004049,"width":239.99539993000002,"height":10.000099999999975}]
[["page","lines",70],{"text":"serum and tissue samples from the same patients were","fontSize":10.0001,"x":60.491710429999955,"y":615.71815047,"width":239.99039987999998,"height":10.000099999999975}]
[["page","lines",71],{"text":"compared, allowing for a better understanding of the difference","fontSize":10.0001,"x":60.491710429999955,"y":626.7162604499999,"width":239.98339980999998,"height":10.000100000000089}]
[["page","lines",72],{"text":"in their metabolic information.","fontSize":10.0001,"x":60.490710419999914,"y":637.71437043,"width":119.37219371000003,"height":10.000099999999975}]
[["page","lines",73],{"text":"■","fontSize":32,"x":60.4913,"y":643.836,"width":10.208000000000006,"height":32}]
[["page","lines",74],{"text":"MATERIALS AND METHODS","fontSize":10.5001,"x":76.989,"y":661.3674,"width":126.94935903000007,"height":10.500099999999975}]
[["page","lines",75],{"text":"Patient and Tumor Characteristics","fontSize":9.5,"x":60.4913,"y":680.9628,"width":142.36034999999998,"height":9.5}]
[["page","lines",76],{"text":"Details of the inclusion criteria are fully described elsewhere.","fontSize":10.0001,"x":60.4913,"y":695.7130999999999,"width":232.73432732000018,"height":10.000099999999975}]
[["page","lines",77],{"text":"21","fontSize":6.666,"x":293.2157,"y":694.5685,"width":7.139904800000011,"height":6.666000000000054}]
[["page","lines",78],{"text":"In brief, 132 women of age ≥ 18 years with large (≥2.5 cm),","fontSize":10.0001,"x":60.4913,"y":706.7115,"width":239.96439962000002,"height":10.000099999999975}]
[["page","lines",79],{"text":"non-metastatic, human epidermal growth factor receptor 2","fontSize":10.0001,"x":60.49129999999997,"y":717.70960998,"width":239.98439982000008,"height":10.000099999999975}]
[["page","lines",80],{"text":"(HER 2) negative tumors were recruited in the period","fontSize":10.0001,"x":60.49129999999997,"y":728.70771996,"width":239.98939986999983,"height":10.000099999999975}]
[["page","lines",81],{"text":"November 2008−July 2012 in Norway. The study was","fontSize":10.0001,"x":60.49129999999997,"y":739.70582994,"width":239.96139958999987,"height":10.000099999999975}]
[["page","lines",82],{"text":"approved for all centers involved by the Regional Ethics","fontSize":10.0001,"x":60.49129999999995,"y":750.7039399199999,"width":239.97739974999996,"height":10.000099999999975}]
[["page","lines",83],{"text":"Committee (approval number S-08354a) and the Norwegian","fontSize":10.0001,"x":324.45493960999994,"y":65.68108975999996,"width":240.00039998000005,"height":10.000099999999975}]
[["page","lines",84],{"text":"Medical Agency and an informed written consent was obtained","fontSize":10.0001,"x":324.45493960999994,"y":76.67919973999994,"width":240.01040008000012,"height":10.000099999999975}]
[["page","lines",85],{"text":"from all patients. All patients included in this study received","fontSize":10.0001,"x":324.45493960999994,"y":87.67730971999993,"width":240.02740024999997,"height":10.000099999999975}]
[["page","lines",86],{"text":"NAC in the form of FEC100 (5-fluorouracil 600 mg/m","fontSize":10.0001,"x":324.45493960999994,"y":98.73242026999992,"width":234.77534772999996,"height":10.000099999999975}]
[["page","lines",87],{"text":"2","fontSize":6.7,"x":559.2188,"y":98.12509999999997,"width":3.189200000000028,"height":6.7000000000000455}]
[["page","lines",88],{"text":",","fontSize":10.0001,"x":562.4503,"y":98.73689999999999,"width":2.040020400000003,"height":10.000099999999975}]
[["page","lines",89],{"text":"epirubicine 100 mg/m","fontSize":10.0001,"x":324.45292005,"y":109.73500997999997,"width":88.67788677000004,"height":10.000099999999975}]
[["page","lines",90],{"text":"2","fontSize":6.7,"x":413.1212,"y":109.12349999999992,"width":3.189200000000028,"height":6.7000000000000455}]
[["page","lines",91],{"text":", and cyclophosphamide 600 mg/m","fontSize":10.0001,"x":416.296,"y":109.73529999999994,"width":140.95040949000003,"height":10.000099999999975}]
[["page","lines",92],{"text":"2","fontSize":6.7,"x":557.2345,"y":109.12349999999992,"width":3.189200000000028,"height":6.7000000000000455}]
[["page","lines",93],{"text":")","fontSize":10.0001,"x":560.4093,"y":109.73529999999994,"width":4.050040500000023,"height":10.000099999999975}]
[["page","lines",94],{"text":"followed by taxane-based therapy for 12 weeks, whereas they","fontSize":10.0001,"x":324.45294046000004,"y":120.73340997999992,"width":240.0024000000002,"height":10.000099999999975}]
[["page","lines",95],{"text":"were randomized to receive bevacizumab or not. Tissue","fontSize":10.0001,"x":324.45294046000004,"y":131.7315199599999,"width":240.02540023000006,"height":10.000099999999975}]
[["page","lines",96],{"text":"samples were obtained by ultrasound-guided needle biopsies","fontSize":10.0001,"x":324.45294046000004,"y":142.72962993999988,"width":239.99739995000004,"height":10.000099999999975}]
[["page","lines",97],{"text":"prior to treatment (TP1) and 12 weeks into treatment (TP2),","fontSize":10.0001,"x":324.45294046000004,"y":153.78474048999988,"width":239.99539993000008,"height":10.000099999999975}]
[["page","lines",98],{"text":"whereas surgical biopsies were obtained from the surgically","fontSize":10.0001,"x":324.45294046000004,"y":164.78285046999986,"width":240.02540023000006,"height":10.000099999999975}]
[["page","lines",99],{"text":"removed tumor (TP3). Nonfasting serum was sampled at TP1,","fontSize":10.0001,"x":324.45294046000004,"y":175.78096044999984,"width":240.00340000999995,"height":10.000099999999975}]
[["page","lines",100],{"text":"TP2, and TP3, in addition to 6 weeks after surgery (TP4). See","fontSize":10.0001,"x":324.45294046000004,"y":186.77907042999982,"width":240.00540003000015,"height":10.000099999999975}]
[["page","lines",101],{"text":"Figure S1 for a graphical representation of the study design.","fontSize":10.0001,"x":324.45294046000004,"y":197.83418097999981,"width":240.0424003999999,"height":10.000099999999975}]
[["page","lines",102],{"text":"The study cohort for further analyses has been restricted to","fontSize":10.0001,"x":324.45294046000004,"y":208.8322909599998,"width":240.0224002000001,"height":10.000099999999975}]
[["page","lines",103],{"text":"contain subjects with full clinical data and available sample","fontSize":10.0001,"x":324.45294046000004,"y":219.83040093999978,"width":240.01640013999997,"height":10.000099999999975}]
[["page","lines",104],{"text":"material from at least one sampling time point, giving N = 118","fontSize":10.0001,"x":324.45294046000004,"y":230.82851091999976,"width":240.03140028999997,"height":10.000099999999975}]
[["page","lines",105],{"text":"subjects. In total, 357 serum samples and 270 tissue samples","fontSize":10.0001,"x":324.45294046000004,"y":241.82662089999974,"width":240.00740005,"height":10.000099999999975}]
[["page","lines",106],{"text":"were analyzed. Details on the patient and tumor characteristics","fontSize":10.0001,"x":324.45294046000004,"y":252.88173144999973,"width":240.02040018000002,"height":10.000099999999975}]
[["page","lines",107],{"text":"are summarized in Table 1, whereas sample availability,","fontSize":10.0001,"x":324.45294046000004,"y":263.8798414299997,"width":240.04040038000005,"height":10.000099999999975}]
[["page","lines",108],{"text":"including survival data, for each time point is illustrated in","fontSize":10.0001,"x":324.45294046000004,"y":274.8779514099997,"width":239.99739995000004,"height":10.000099999999975}]
[["page","lines",109],{"text":"Figure S2.","fontSize":10.0001,"x":324.45294046000004,"y":285.8760613899997,"width":39.344393439999976,"height":10.000099999999975}]
[["page","lines",110],{"text":"Prognostic Measures and Survival Evaluation","fontSize":9.5,"x":324.4535,"y":693.2085,"width":188.79825,"height":9.5}]
[["page","lines",111],{"text":"Residual cancer burden (RCB) is a measurement of patient","fontSize":10.0001,"x":324.4535,"y":706.7115,"width":240.04340041000006,"height":10.000099999999975}]
[["page","lines",112],{"text":"response to NAC. It is a continuous index, which combines","fontSize":10.0001,"x":324.4535,"y":717.70960998,"width":240.00840006000004,"height":10.000099999999975}]
[["page","lines",113],{"text":"pathologic measurements of the primary tumor (size and","fontSize":10.0001,"x":324.4535,"y":728.70771996,"width":240.01140008999988,"height":10.000099999999975}]
[["page","lines",114],{"text":"cellularity) and nodal metastases (number and size).","fontSize":10.0001,"x":324.4535,"y":739.70582994,"width":209.97109969000013,"height":10.000099999999975}]
[["page","lines",115],{"text":"29","fontSize":6.666,"x":534.3873,"y":738.5621,"width":7.139904799999954,"height":6.66599999999994}]
