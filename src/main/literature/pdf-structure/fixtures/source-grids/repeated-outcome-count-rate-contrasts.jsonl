[["page","lines",31],{"text":"7 Robustness and limitations","fontSize":14.3462,"x":70.866,"y":526.5208,"width":211.19758330000008,"height":14.346199999999953}]
[["page","lines",32],{"text":"We first list the potential problems that may affect our results, and then explore the external validity","fontSize":10.9091,"x":70.866,"y":561.7438999999999,"width":470.27166461999934,"height":10.90910000000008}]
[["page","lines",33],{"text":"of our results, i.e. the extent to which our results may hold in different contexts.","fontSize":10.9091,"x":70.866,"y":583.6668999999999,"width":383.02068281999976,"height":10.90910000000008}]
[["page","lines",34],{"text":"7.1 Limitations and internal validity","fontSize":11.9552,"x":70.866,"y":610.5058,"width":221.4760576,"height":11.95519999999999}]
[["page","lines",35],{"text":"We here adopt an intention-to-treat (ITT) approach, based on the initial allocation of treatment","fontSize":10.9091,"x":70.866,"y":639.9069,"width":470.26839188999963,"height":10.90910000000008}]
[["page","lines",36],{"text":"rather than the actual treatment received: we sent the letters out randomly, but cannot know if","fontSize":10.9091,"x":70.866,"y":661.8289,"width":470.2651191599998,"height":10.909099999999967}]
[["page","lines",37],{"text":"these letters were actually received, opened, read and their contents taken into account. At the","fontSize":10.9091,"x":70.866,"y":683.7519,"width":470.2651191599996,"height":10.909099999999967}]
[["page","lines",38],{"text":"extreme, almost all women may have already made up their mind before receiving the letters, so","fontSize":10.9091,"x":70.866,"y":705.6739,"width":470.2636394199999,"height":10.909099999999967}]
[["page","lines",39],{"text":"20","fontSize":10.9091,"x":300.57599999999996,"y":740.1129,"width":10.848009040000022,"height":10.909099999999967}]
