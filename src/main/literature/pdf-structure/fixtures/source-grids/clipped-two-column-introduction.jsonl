[["page","lines",0],{"text":"Taussig Cancer Institute, Cleveland Clinic,","fontSize":7.9702,"x":36.9638,"y":229.06320000000005,"width":136.12145175999999,"height":7.970199999999977}]
[["page","lines",1],{"text":"Cleveland, OH","fontSize":7.9702,"x":36.9638,"y":239.49459776000003,"width":46.13789375999999,"height":7.970199999999977}]
[["page","lines",2],{"text":"ASSOCIATED CONTENT","fontSize":10.959,"x":36.9638,"y":261.3941,"width":96.0972792,"height":10.959000000000003}]
[["page","lines",3],{"text":"See accompanying commentary","fontSize":7.9702,"x":58.2236,"y":279.80330000000004,"width":99.11182806,"height":7.970199999999977}]
[["page","lines",4],{"text":"on page 157","fontSize":7.9702,"x":58.2236,"y":290.74479056,"width":40.41130506000001,"height":7.970199999999977}]
[["page","lines",5],{"text":"DOI: https://doi.org/10.1200/JOP.","fontSize":7.9702,"x":57.7133,"y":702.3355,"width":114.12290273999992,"height":7.970199999999977}]
[["page","lines",6],{"text":"17.00038","fontSize":7.9702,"x":57.7133,"y":713.27699056,"width":33.712351960000014,"height":7.970200000000091}]
[["page","lines",7],{"text":"Management of Chemotherapy-","fontSize":23.9102,"x":189.4109,"y":89.87279999999998,"width":330.46765624,"height":23.91020000000003}]
[["page","lines",8],{"text":"Induced Alopecia With","fontSize":23.9102,"x":189.4109,"y":118.73002037999993,"width":231.2235891,"height":23.91020000000003}]
[["page","lines",9],{"text":"Scalp Cooling","fontSize":23.9102,"x":189.4109,"y":147.64223421999998,"width":137.87338625999993,"height":23.91020000000003}]
[["page","lines",10],{"text":"Megan Kruse and Jame Abraham","fontSize":10.959,"x":189.4109,"y":182.9878,"width":141.9037074,"height":10.958999999999946}]
[["page","lines",11],{"text":"Abstract","fontSize":15.9403,"x":205.3417,"y":225.85530000000006,"width":54.22890060000003,"height":15.94029999999998}]
[["page","lines",12],{"text":"Chemotherapy-induced alopecia is a common and distressing adverse effect of many","fontSize":8.9663,"x":205.3417,"y":253.74889999999994,"width":332.2928712599997,"height":8.966300000000047}]
[["page","lines",13],{"text":"types of chemotherapy. Scalp cooling has been used since the 1970s for prevention of","fontSize":8.9663,"x":205.3417,"y":266.67471807999993,"width":338.3325709399998,"height":8.966300000000047}]
[["page","lines",14],{"text":"chemotherapy-induced alopecia; however, most data regarding this treatment modality","fontSize":8.9663,"x":205.3417,"y":279.65702385,"width":342.3234710699998,"height":8.96629999999999}]
[["page","lines",15],{"text":"are retrospective in nature, and use in the United States has been limited by safety","fontSize":8.9663,"x":205.3417,"y":292.58284193,"width":326.35897391999964,"height":8.96629999999999}]
[["page","lines",16],{"text":"concerns, specifically the potential for scalp metastases. Two prospective studies of scalp-","fontSize":8.9663,"x":205.3417,"y":305.56514769999995,"width":342.6650871000001,"height":8.96629999999999}]
[["page","lines",17],{"text":"cooling systems performed in the United States were published within the last year and","fontSize":8.9663,"x":205.34170000000003,"y":318.49096577999995,"width":342.68122644000005,"height":8.96629999999999}]
[["page","lines",18],{"text":"add evidence supporting the efficacy and safety of scalp cooling in preventing","fontSize":8.9663,"x":205.34170000000003,"y":331.47327154999994,"width":304.8093685,"height":8.96629999999999}]
[["page","lines",19],{"text":"chemotherapy-induced alopecia in patients receiving chemotherapy for solid tumor","fontSize":8.9663,"x":205.34080337000006,"y":344.39908962999993,"width":326.60016738999997,"height":8.96629999999999}]
[["page","lines",20],{"text":"malignancies. Available data suggest that this technology is most effective for","fontSize":8.9663,"x":205.34080337000006,"y":357.3813953999999,"width":304.39960858999996,"height":8.96629999999999}]
[["page","lines",21],{"text":"taxane-based chemotherapy regimens compared with anthracycline-based chemotherapy","fontSize":8.9663,"x":205.34080337000006,"y":370.3072134799999,"width":342.67495002999993,"height":8.96629999999999}]
[["page","lines",22],{"text":"regimens. Two scalp-cooling devices have been cleared by the US Food and Drug","fontSize":8.9663,"x":205.34080337000006,"y":383.2330315599999,"width":318.6640952599998,"height":8.96629999999999}]
[["page","lines",23],{"text":"Administration, and multiple cold caps are available for patient rental. The adverse effect","fontSize":8.9663,"x":205.34080337000006,"y":396.2153373299999,"width":342.68839947999976,"height":8.96629999999999}]
[["page","lines",24],{"text":"profile of scalp cooling includes scalp pain, headache, and chills but is tolerable for most","fontSize":8.9663,"x":205.34080337000006,"y":409.1411554099999,"width":336.38598720999966,"height":8.96629999999999}]
[["page","lines",25],{"text":"patients included in recent clinical trials. Retrospective data suggest that the incidence","fontSize":8.9663,"x":205.34080337000006,"y":422.1234611799999,"width":331.88400798000015,"height":8.96629999999999}]
[["page","lines",26],{"text":"of scalp metastases related to scalp cooling is low and should not limit use of this technology.","fontSize":8.9663,"x":205.34080337000006,"y":435.0492792599999,"width":342.69736577999987,"height":8.96629999999999}]
[["page","lines",27],{"text":"Logistic issues related to use of scalp cooling include availability of devices, inconsistent","fontSize":8.9663,"x":205.34080337000006,"y":448.03158502999986,"width":336.44337152999964,"height":8.96629999999999}]
[["page","lines",28],{"text":"insurance coverage, and incorporation of use into typical infusion center workflow.","fontSize":8.9663,"x":205.34080337000006,"y":460.95740310999986,"width":318.50718501,"height":8.96629999999999}]
[["page","lines",29],{"text":"INTRODUCTION","fontSize":10.959,"x":189.4109,"y":484.7074,"width":73.38803939999988,"height":10.959000000000003}]
[["page","lines",30],{"text":"Chemotherapy-induced alopecia is a well-","fontSize":10.959,"x":189.4109,"y":498.6538234,"width":170.32696979999994,"height":10.959000000000003}]
[["page","lines",31],{"text":"recognized adverse effect of many cytotoxic","fontSize":10.959,"x":189.4109,"y":512.6002468,"width":170.32368210000007,"height":10.958999999999946}]
[["page","lines",32],{"text":"chemotherapyagents.Typically,theonsetof","fontSize":10.959,"x":189.4109,"y":526.5466702000001,"width":170.31710669999998,"height":10.958999999999946}]
[["page","lines",33],{"text":"chemotherapy-induced alopecia occurs 2 to","fontSize":10.959,"x":189.4109,"y":540.5500804000001,"width":170.3313534000001,"height":10.958999999999946}]
[["page","lines",34],{"text":"4 weeks after the initiation of chemother-","fontSize":10.959,"x":189.4109,"y":554.4965038,"width":170.3269698,"height":10.958999999999946}]
[["page","lines",35],{"text":"apy.","fontSize":10.959,"x":189.4109,"y":568.4429272,"width":16.339868999999993,"height":10.95900000000006}]
[["page","lines",36],{"text":"1","fontSize":7.3052,"x":205.6251,"y":567.221,"width":3.6739377000000104,"height":7.3052000000000135}]
[["page","lines",37],{"text":"Most cases of chemotherapy-induced","fontSize":10.959,"x":211.4645,"y":568.4428,"width":148.35855840000005,"height":10.958999999999946}]
[["page","lines",38],{"text":"alopecia resolve within 3 to 6 months","fontSize":10.959,"x":189.4106084,"y":582.3892234,"width":170.32149030000005,"height":10.958999999999946}]
[["page","lines",39],{"text":"after completion of chemotherapy; however,","fontSize":10.959,"x":189.4106084,"y":596.3356468,"width":170.33902469999975,"height":10.95900000000006}]
[["page","lines",40],{"text":"there are cases in which patients have","fontSize":10.959,"x":189.4106084,"y":610.2820701999999,"width":170.35765500000002,"height":10.95900000000006}]
[["page","lines",41],{"text":"permanent hair loss after cancer-directed","fontSize":10.959,"x":189.4106084,"y":624.2284935999999,"width":170.32477800000015,"height":10.95900000000006}]
[["page","lines",42],{"text":"therapy, termed chemotherapy-induced","fontSize":10.959,"x":189.4106084,"y":638.1749169999999,"width":170.3916279,"height":10.958999999999946}]
[["page","lines",43],{"text":"irreversible alopecia.","fontSize":10.959,"x":189.4106084,"y":652.1213403999999,"width":78.7086339,"height":10.95900000000006}]
[["page","lines",44],{"text":"2,3","fontSize":7.3052,"x":267.9306,"y":650.8996999999999,"width":8.66293139999999,"height":7.3052000000000135}]
[["page","lines",45],{"text":"Hair loss is often one","fontSize":10.959,"x":278.4755,"y":652.1215,"width":81.26756039999987,"height":10.95900000000006}]
[["page","lines",46],{"text":"of the most feared complications of che-","fontSize":10.959,"x":189.4106111,"y":666.0679233999999,"width":170.3412165,"height":10.95900000000006}]
[["page","lines",47],{"text":"motherapy, and it has been reported that","fontSize":10.959,"x":189.4106111,"y":680.0143468,"width":170.3445042,"height":10.958999999999946}]
[["page","lines",48],{"text":"up to 8% of patients are hesitant to receive","fontSize":10.959,"x":189.4106111,"y":693.9607702,"width":170.33792880000007,"height":10.95900000000006}]
[["page","lines",49],{"text":"curative-intent chemotherapy because of","fontSize":10.959,"x":189.4106111,"y":707.9071936,"width":170.34450420000005,"height":10.958999999999946}]
[["page","lines",50],{"text":"concerns centering around chemotherapy-","fontSize":10.959,"x":377.687327,"y":484.70743239999996,"width":170.46834089999993,"height":10.959000000000003}]
[["page","lines",51],{"text":"induced alopecia.","fontSize":10.959,"x":377.687327,"y":498.6538558,"width":65.22358439999971,"height":10.959000000000003}]
[["page","lines",52],{"text":"2,4-6","fontSize":7.3052,"x":442.4314,"y":497.4887,"width":13.765348679999988,"height":7.3052000000000135}]
[["page","lines",53],{"text":"Chemotherapy-induced","fontSize":10.959,"x":459.3259,"y":498.65389999999996,"width":88.66050180000019,"height":10.959000000000003}]
[["page","lines",54],{"text":"alopecia is associated with increased","fontSize":10.959,"x":377.6879254,"y":512.6003234,"width":170.34012059999958,"height":10.95900000000006}]
[["page","lines",55],{"text":"psychosocial stress with respect to body","fontSize":10.959,"x":377.6879254,"y":526.5467467999999,"width":170.3017640999994,"height":10.95900000000006}]
[["page","lines",56],{"text":"image, self-esteem, and sexuality and is","fontSize":10.959,"x":377.6879254,"y":540.5501569999999,"width":170.37628529999932,"height":10.95900000000006}]
[["page","lines",57],{"text":"common with many chemotherapeutic","fontSize":10.959,"x":377.6879254,"y":554.4965804,"width":170.33464110000006,"height":10.958999999999946}]
[["page","lines",58],{"text":"classes, including anthracyclines, taxanes,","fontSize":10.959,"x":377.6879254,"y":568.4430037999999,"width":170.37847709999988,"height":10.958999999999946}]
[["page","lines",59],{"text":"and alkylating agents. Various techniques","fontSize":10.959,"x":377.6879254,"y":582.3894271999999,"width":170.36751810000004,"height":10.95900000000006}]
[["page","lines",60],{"text":"have been used in an attempt to prevent","fontSize":10.959,"x":377.6879254,"y":596.3358506,"width":170.3729975999999,"height":10.958999999999946}]
[["page","lines",61],{"text":"chemotherapy-induced alopecia, including","fontSize":10.959,"x":377.6879254,"y":610.2822739999999,"width":170.33683290000005,"height":10.958999999999946}]
[["page","lines",62],{"text":"scalp compression, scalp cooling, and med-","fontSize":10.959,"x":377.6879254,"y":624.2286973999999,"width":170.3762853,"height":10.95900000000006}]
[["page","lines",63],{"text":"ical therapies such as minoxidil and vitamin","fontSize":10.959,"x":377.6879254,"y":638.1751207999998,"width":170.35875089999996,"height":10.95900000000006}]
[["page","lines",64],{"text":"D3.","fontSize":10.959,"x":377.6879254,"y":652.1215441999999,"width":14.015465100000029,"height":10.958999999999946}]
[["page","lines",65],{"text":"2,7,8","fontSize":7.3052,"x":391.4645,"y":650.8996999999999,"width":13.481789729999946,"height":7.3052000000000135}]
[["page","lines",66],{"text":"Although each of these techniques","fontSize":10.959,"x":408.8125,"y":652.1215,"width":139.23080729999958,"height":10.95900000000006}]
[["page","lines",67],{"text":"has shown promise in animal studies, scalp","fontSize":10.959,"x":377.6878441,"y":666.0679233999999,"width":170.3653263,"height":10.95900000000006}]
[["page","lines",68],{"text":"cooling is the best studied and is the only","fontSize":10.959,"x":377.6878441,"y":680.0143468,"width":170.35875090000002,"height":10.958999999999946}]
[["page","lines",69],{"text":"modality with consistent efficacy docu-","fontSize":10.959,"x":377.6878441,"y":693.9607702,"width":170.30943539999998,"height":10.95900000000006}]
[["page","lines",70],{"text":"mented in humans.","fontSize":10.959,"x":377.6878441,"y":707.9071936,"width":82.56510600000013,"height":10.958999999999946}]
