[["page"],{"pageNumber":11,"width":585,"height":783,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":1,"constructPath":5},"captionStarts":[{"text":"Fig. 5. VAS scores at rest and during mobilization during the first 2 postoperative hours and 48 postoperative hours. In the first 2 postoper-","fontSize":10,"x":60.715,"y":366.6799,"width":463.76060000000064,"height":10}],"headingCandidates":[],"lines":[{"text":"Anesthesiology 2021; 135:1091–103 1101","fontSize":7,"x":240.93900000000002,"y":758.9,"width":315.06300000000005,"height":7},{"text":"Paravertebral block and chronic Pain","fontSize":10,"x":389.577,"y":33.33979999999997,"width":132.96999999999946,"height":10},{"text":"Albi-Feldzer et al.","fontSize":7,"x":29,"y":758.9,"width":48.957999999999984,"height":7},{"text":"for generalization of the results. We also provided long-term","fontSize":10,"x":51.215,"y":497.9476,"width":232.37900000000005,"height":10},{"text":"monitoring of pain with numerous validated tools. Moreover,","fontSize":10,"x":51.215,"y":509.9476,"width":233.3700000000002,"height":9.999999999999943},{"text":"our study, unlike others, compared the treatment group to a","fontSize":10,"x":51.215,"y":521.9476,"width":232.37800000000018,"height":10},{"text":"control group that received a saline injection in the paraver-","fontSize":10,"x":51.215,"y":533.9476,"width":232.4090000000002,"height":10},{"text":"tebral space, evaluated the results according to type of surgery","fontSize":10,"x":51.215,"y":545.9476,"width":232.37000000000026,"height":10},{"text":"(complete or partial mastectomy, sentinel or axillary lymph","fontSize":10,"x":51.215,"y":557.9476,"width":232.3600000000002,"height":10},{"text":"node dissection) and paravertebral block technique (one-","fontSize":10,"x":51.215,"y":569.9476,"width":232.40000000000023,"height":10},{"text":"level single thoracic puncture under ultrasound guidance),","fontSize":10,"x":51.215,"y":581.9476,"width":233.39000000000024,"height":10},{"text":"and specifically determined the blocked dermatomes.","fontSize":10,"x":51.215,"y":593.9476,"width":205.65900000000036,"height":10},{"text":"conclusions","fontSize":11.25,"x":51.215,"y":622.6976,"width":49.77000000000001,"height":11.25},{"text":"Paravertebral block did not reduce the incidence of chronic","fontSize":10,"x":51.215,"y":640.4476,"width":232.41099999999997,"height":10},{"text":"pain after breast surgery. Paravertebral block did result in","fontSize":10,"x":51.215,"y":652.4476,"width":232.36999999999998,"height":10},{"text":"less immediate postoperative pain, but there were no other","fontSize":10,"x":51.215,"y":664.4476,"width":232.35,"height":10},{"text":"significant differences in postoperative outcomes.","fontSize":10,"x":51.215,"y":676.4476,"width":193.67800000000005,"height":10},{"text":"Acknowledgments","fontSize":11.25,"x":51.215,"y":699.1976,"width":76.543875,"height":11.25},{"text":"The authors would like to extend their sincere thanks","fontSize":10,"x":51.215,"y":716.9476,"width":232.3889999999998,"height":10},{"text":"to Karine Hardmeier, M.Sc., and assistant nurses,","fontSize":10,"x":51.215,"y":728.9476,"width":233.39999999999972,"height":10},{"text":"Department of Surgery, Institut Curie, PSL Research","fontSize":10,"x":301.595,"y":497.9476,"width":232.36999999999978,"height":10},{"text":"University, Saint-Cloud, France, and Isabelle Turbiez,","fontSize":10,"x":301.595,"y":509.9476,"width":233.37099999999964,"height":9.999999999999943},{"text":"M.Sc., the Biometry Unit Institut Curie, Paris Sciences","fontSize":10,"x":301.595,"y":521.9476,"width":232.35799999999983,"height":10},{"text":"& Lettres University, Paris, France, for their constant","fontSize":10,"x":301.595,"y":533.9476,"width":232.39800000000002,"height":10},{"text":"support; and to Dale Roche, M.Sc., Institut Curie, PSL","fontSize":10,"x":301.595,"y":545.9476,"width":232.3489999999997,"height":10},{"text":"Research University, Saint-Cloud, France, for correcting","fontSize":10,"x":301.595,"y":557.9476,"width":232.38099999999997,"height":10},{"text":"the manuscript.","fontSize":10,"x":301.595,"y":569.9476,"width":64.42999999999984,"height":10},{"text":"research Support","fontSize":11.25,"x":301.595,"y":592.6976,"width":73.92374999999998,"height":11.25},{"text":"Support was provided solely from institutional and/or","fontSize":10,"x":301.595,"y":610.4476,"width":232.38999999999965,"height":10},{"text":"departmental sources (the study was funded by the French","fontSize":10,"x":301.595,"y":622.4476,"width":232.40999999999985,"height":10},{"text":"National Cancer Institute, Boulogne-Billancourt, France).","fontSize":10,"x":301.595,"y":634.4476,"width":228.96699999999998,"height":10},{"text":"competing Interests","fontSize":11.25,"x":301.595,"y":657.1976,"width":83.29500000000002,"height":11.25},{"text":"The authors declare no competing interests.","fontSize":10,"x":301.595,"y":674.9476,"width":173.63799999999992,"height":10},{"text":"reproducible Science","fontSize":11.25,"x":301.595,"y":699.1976,"width":89.77499999999998,"height":11.25},{"text":"Full protocol available at: isabelle.turbiez@curie.fr. Raw","fontSize":10,"x":301.595,"y":716.9476,"width":232.36700000000008,"height":10},{"text":"data available at: isabelle.turbiez@curie.fr.","fontSize":10,"x":301.595,"y":728.9476,"width":163.2469999999999,"height":10},{"text":"Fig. 5. VAS scores at rest and during mobilization during the first 2 postoperative hours and 48 postoperative hours. In the first 2 postoper-","fontSize":10,"x":60.715,"y":366.6799,"width":463.76060000000064,"height":10},{"text":"ative hours, both groups had a maximum pain score approximately 30 min after surgery both at rest and during mobilization. This maximum","fontSize":9,"x":60.71459999999996,"y":378.18289999999996,"width":463.7771999999998,"height":9},{"text":"pain score was higher in the control group than in the paravertebral group. At rest, the mean VAS score at 30 min was 3.8 ± 2.1 in the control","fontSize":9,"x":60.71459999999996,"y":388.68589999999995,"width":463.7636999999999,"height":9},{"text":"group and 2.5 ± 2.5 in the paravertebral group (P < 0.001). During mobilization, the mean VAS score at 30 min was 4.0 ± 2.2 in the control","fontSize":9,"x":60.71459999999996,"y":399.18889999999993,"width":463.7430000000001,"height":9},{"text":"group and 2.4 ± 2.5 in the paravertebral group (P < 0.001). The AUcs reflects the intensity and duration of mean pain over the first 2 h.","fontSize":9,"x":60.71459999999996,"y":409.6918999999999,"width":464.094,"height":9},{"text":"A comparison of AUcs between the two groups showed that the pain at rest was greater in the control group (4.3 ± 2.8 VAS score units ×","fontSize":9,"x":60.71459999999996,"y":420.1948999999999,"width":463.76820000000004,"height":9},{"text":"hours) than in the paravertebral group (2.9 ± 2.8 VAS score units × hours; P < 0.001). For pain during mobilization, the AUcs were 3.7 ± 3.2","fontSize":9,"x":60.71459999999996,"y":430.6978999999999,"width":463.7591999999998,"height":9},{"text":"in the control group versus 2.5 ± 2.5 VAS score units × hours in the paravertebral group (P < 0.001). After the first 2 postoperative hours","fontSize":9,"x":60.71459999999999,"y":441.2008999999999,"width":463.7114999999999,"height":9},{"text":"and over the next 46 h, there was no difference in pain between the two groups at rest or during mobilization. AUc, area under the receiver","fontSize":9,"x":60.71459999999999,"y":451.70389999999986,"width":463.7006999999992,"height":9},{"text":"operating characteristics curve; VAS, visual analogue scale.","fontSize":9,"x":60.71459999999999,"y":462.20689999999985,"width":196.9263,"height":9},{"text":"Copyright © 2021, the American Society of Anesthesiologists. All Rights Reserved. Unauthorized reproduction of this article is prohibited.","fontSize":8.5,"x":38.6462,"y":768.571,"width":512.7131999999993,"height":8.5}],"graphicsBounds":[{"operationIndex":16,"kind":"path","normalizedRect":[0,0,1,0.078125]},{"operationIndex":227,"kind":"image","normalizedRect":[0.09765625,0.11328125,0.90625,0.453125],"imageHash":"dcb619aff8f876b4f47a6a2ec936955a56120ae37a8812e55fba8cedd7d33533"},{"operationIndex":234,"kind":"path","normalizedRect":[0.0859375,0.45703125,0.91796875,0.6171875]},{"operationIndex":362,"kind":"path","normalizedRect":[0.08203125,0.09765625,0.91796875,0.62109375]}],"invalidGraphicsBounds":0}]
