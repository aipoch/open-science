[["page"],{"pageNumber":6,"width":585.071,"height":782.929,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"constructPath":16},"captionStarts":[{"text":"Figure 2 .","fontSize":10.0001,"x":305.0645,"y":218.07539999999995,"width":38.27322499999997,"height":10.000099999999975},{"text":"Table 3","fontSize":9,"x":45.5811,"y":536.2157,"width":28.764900000000004,"height":9},{"text":"Table 2","fontSize":9,"x":45.5811,"y":328.6062,"width":28.764900000000004,"height":9}],"headingCandidates":[],"lines":[{"text":"Upstage consisted of one patient in each group with an in-","fontSize":10.0001,"x":42.0094,"y":49.07389999999998,"width":241.5054150299999,"height":10.000099999999975},{"text":"crease in stage from pNmi to pN1a, one in the post-Z0011","fontSize":10.0001,"x":42.0094,"y":62.11303038999995,"width":241.47341470999996,"height":10.000099999999975},{"text":"group from pN2a to pN3a, and one in each group from pN1a","fontSize":10.0001,"x":42.0094,"y":75.09616022,"width":241.45441451999986,"height":10.000099999999975},{"text":"to pN3a. All three cases upstaged to pN3a had the pathologic","fontSize":10.0001,"x":42.0094,"y":88.07929005000005,"width":241.5414153899999,"height":10.000099999999975},{"text":"tumor subtype of invasive lobular carcinoma (ILC) with a","fontSize":10.0001,"x":42.0094,"y":101.11842044000002,"width":241.4554145299999,"height":10.000099999999975},{"text":"size range of 1.5 to 3.1 cm. Two of these cases had negative","fontSize":10.0001,"x":42.0094,"y":114.10155027000008,"width":241.45341451,"height":10.000099999999975},{"text":"preoperative axillary US; in these cases, there was metastatic","fontSize":10.0001,"x":42.0094,"y":127.08468010000013,"width":241.4554145299999,"height":10.000099999999975},{"text":"carcinoma in 21 of 29 and 17 of 20 lymph nodes, with largest","fontSize":10.0001,"x":42.0094,"y":140.1238104900001,"width":241.54641543999995,"height":10.000099999999975},{"text":"metastatic deposits of 0.9 and 1.0 cm, respectively. The other","fontSize":10.0001,"x":42.0094,"y":153.10694032000015,"width":241.55641553999996,"height":10.000099999999975},{"text":"case upstaged to pN3a was suspicious via preoperative axil-","fontSize":10.0001,"x":42.0094,"y":166.0900701500002,"width":241.50241499999973,"height":10.000099999999975},{"text":"lary US, but FNA yielded a nondiagnostic hypocellular speci-","fontSize":10.0001,"x":42.0094,"y":179.12920054000017,"width":241.50241499999984,"height":10.000099999999975},{"text":"men. This case had metastatic carcinoma in 11 of 12 lymph","fontSize":10.0001,"x":42.0094,"y":192.11233037000022,"width":241.47541472999993,"height":10.000099999999975},{"text":"nodes, with the largest metastatic focus of 0.9 cm.","fontSize":10.0001,"x":42.0094,"y":205.09546020000028,"width":194.9759497399999,"height":10.000099999999975},{"text":"Reoperation for ALND","fontSize":10.0001,"x":42.0094,"y":231.4577238200003,"width":98.89998899000003,"height":10.000099999999975},{"text":"Three of eight pre-Z0011 patients and four of six post-","fontSize":10.0001,"x":59.98157972,"y":246.65187576000028,"width":223.5362353399999,"height":10.000099999999975},{"text":"Z0011 patients who underwent additional surgery for","fontSize":10.0001,"x":42.0094,"y":259.63500559000033,"width":241.50541502999985,"height":10.000099999999975},{"text":"ALND had designed two-step procedures with separate","fontSize":10.0001,"x":42.0094,"y":272.6181354200003,"width":241.46741464999994,"height":10.000099999999975},{"text":"SLN biopsy occurring prior to primary breast surgery. Two","fontSize":10.0001,"x":42.0094,"y":285.65726581000035,"width":241.47641473999997,"height":10.000099999999975},{"text":"patients from each group also necessitated margin","fontSize":10.0001,"x":42.0094,"y":298.64039564000035,"width":241.5094150699999,"height":10.000099999999975},{"text":"reexcision following the SLN biopsy procedure. Thus, only","fontSize":10.0001,"x":301.49399482,"y":49.07690003000039,"width":241.5124151,"height":10.000099999999975},{"text":"three patients in the pre-Z0011 group and no patients in the","fontSize":10.0001,"x":301.49399482,"y":62.11603042000036,"width":241.50041497999985,"height":10.000099999999975},{"text":"post-Z0011 group underwent ALND as the sole indication","fontSize":10.0001,"x":301.49399482,"y":75.09916025000041,"width":241.45041447999984,"height":10.000099999999975},{"text":"for surgery. These three pre-Z0011 patients were all BCT","fontSize":10.0001,"x":301.49399482,"y":88.08229008000046,"width":241.4824147999999,"height":10.000099999999975},{"text":"patients for whom subsequent ALND specimens were nega-","fontSize":10.0001,"x":301.49399482,"y":101.12142047000043,"width":241.45641453999986,"height":10.000099999999975},{"text":"tive for additional lymph node involvement. Furthermore,","fontSize":10.0001,"x":301.49399482,"y":114.10455030000048,"width":241.50741504999974,"height":10.000099999999975},{"text":"all three pre-Z0011 patients who underwent a separate pro-","fontSize":10.0001,"x":301.49399482,"y":127.08768013000054,"width":241.52041517999987,"height":10.000099999999975},{"text":"cedure for ALND met Z0011 eligibility criteria, and only","fontSize":10.0001,"x":301.49399482,"y":140.1268105200005,"width":241.53441532,"height":10.000099999999975},{"text":"one would have been recommended ALND by conservative","fontSize":10.0001,"x":301.49399482,"y":153.10994035000056,"width":241.5034150099999,"height":10.000099999999975},{"text":"institutional post-Z0011 selection criteria.","fontSize":10.0001,"x":301.49399482,"y":166.0930701800006,"width":167.92267920999996,"height":10.000099999999975},{"text":"In the subset of post-Z0011 patients who met all Z0011","fontSize":10.0001,"x":319.5221751,"y":179.13220057000058,"width":223.44323440999995,"height":10.000099999999975},{"text":"inclusion criteria, no patients underwent ALND as the","fontSize":10.0001,"x":301.49399482,"y":192.11533040000063,"width":241.50141499000006,"height":10.000099999999975},{"text":"sole surgical indication despite infrequent use of SLN FS","fontSize":10.0001,"x":301.49399482,"y":205.09846023000068,"width":241.50841505999995,"height":10.000099999999975},{"text":"Figure 2 .","fontSize":10.0001,"x":305.0645,"y":218.07539999999995,"width":38.27322499999997,"height":10.000099999999975},{"text":"Discussion","fontSize":11.0001,"x":301.4928,"y":252.22500000000002,"width":56.34251219999999,"height":11.000099999999975},{"text":"Prior to the ACOSOG Z0011 clinical trial, there were","fontSize":10.0001,"x":319.5212,"y":272.2172,"width":223.44123438999986,"height":10.000099999999975},{"text":"shifting attitudes toward less aggressive axillary manage-","fontSize":10.0001,"x":301.49301972,"y":285.20032983,"width":241.43341430999988,"height":10.000099999999975},{"text":"ment for patients with low-volume SLN metastasis. Results","fontSize":10.0001,"x":301.49301972,"y":298.23946022,"width":241.51631513899986,"height":10.000099999999975},{"text":"of this trial further supported omitting ALND, and thus its","fontSize":10.0001,"x":301.49301972,"y":311.22259005,"width":241.4704146800001,"height":10.000099999999975},{"text":"morbidity, for many of these patients as there was no differ-","fontSize":10.0001,"x":301.49301972,"y":324.20571988,"width":241.43941436999978,"height":10.000099999999975},{"text":"ence among 6-year locoregional control, DFS, and OS be-","fontSize":10.0001,"x":301.49301972,"y":337.18884971,"width":241.43941437,"height":10.000099999999975},{"text":"tween those who did and did not undergo subsequent","fontSize":10.0001,"x":301.49301972,"y":350.2279801,"width":241.4664146399998,"height":10.000099999999975},{"text":"ALND.","fontSize":10.0001,"x":301.49301972,"y":363.21110993,"width":30.180301799999995,"height":10.000099999999975},{"text":"11,12","fontSize":6.666,"x":331.7101,"y":362.12129999999996,"width":16.911524509999992,"height":6.665999999999997},{"text":"Significant practice change resulted at many institu-","fontSize":10.0001,"x":319.5212,"y":376.192,"width":223.45323451000002,"height":10.000099999999975},{"text":"tions as a result of publication of Z0011 results. However,","fontSize":10.0001,"x":301.49301972,"y":389.23113039000003,"width":241.50641503999987,"height":10.000099999999975},{"text":"different approaches have arisen due to their variable inter-","fontSize":10.0001,"x":301.49301972,"y":402.21426022,"width":241.44741444999977,"height":10.000099999999975},{"text":"pretation.","fontSize":10.0001,"x":301.49301972,"y":415.19739005,"width":38.20038199999999,"height":10.000099999999975},{"text":"35-38","fontSize":6.666,"x":339.7605,"y":414.1087,"width":17.53476619999998,"height":6.665999999999997},{"text":"At our institution, a conservative approach","fontSize":10.0001,"x":361.7574,"y":415.1967,"width":181.20081198999986,"height":10.000099999999975},{"text":"was initially taken owing to selection bias in Z0011.","fontSize":10.0001,"x":301.49279736,"y":428.23583039000005,"width":241.4744147200002,"height":10.000099999999975},{"text":"Specifically, ALND was only routinely omitted for BCT pa-","fontSize":10.0001,"x":301.49279736,"y":441.21896022000004,"width":241.51041507999997,"height":10.000099999999975},{"text":"tients with one or two positive SLNs who had good progno-","fontSize":10.0001,"x":301.49279736,"y":454.20209005000004,"width":241.49041487999995,"height":10.000099999999975},{"text":"sis clinicopathologic features (cT1, ER positive, HER-2/neu","fontSize":10.0001,"x":301.49279736,"y":467.18521988000003,"width":241.46941467000005,"height":10.000099999999975},{"text":"negative, aged >50 years, and micrometastatic SLN disease","fontSize":10.0001,"x":301.49279736000005,"y":480.22435027000006,"width":241.50641503999998,"height":10.000099999999975},{"text":"only). This study, like others, showed a significant overall","fontSize":10.0001,"x":301.49279736000005,"y":493.20748010000005,"width":241.46441461999984,"height":10.000099999999975},{"text":"decline in performance of ALND for patients with positive","fontSize":10.0001,"x":301.49279736000005,"y":506.19060993000005,"width":241.4684146599999,"height":10.000099999999975},{"text":"Table 3","fontSize":9,"x":45.5811,"y":536.2157,"width":28.764900000000004,"height":9},{"text":"ALND Utilization and Outcomes Before (Pre-Z0011) and After (Post-Z0011) Publication of ACOSOG Z0011 Clinical Trial","fontSize":9,"x":42.2362,"y":546.1936,"width":471.03569999999974,"height":9},{"text":"Results","fontSize":9,"x":42.2362,"y":557.1925,"width":27.909000000000006,"height":9},{"text":"Characteristic Pre-Z0011 Post-Z0011 P Value","fontSize":7.9999,"x":42.0094,"y":575.4267,"width":501.02093716,"height":7.999900000000025},{"text":"No. of ALNDs performed/total No. (%) of cases with metastases","fontSize":7.9999,"x":42.00939999999997,"y":590.96010583,"width":224.75559051999994,"height":7.999900000000025},{"text":"subdivided by SLN metastasis size","fontSize":7.9999,"x":57.996400159999965,"y":600.9383811,"width":121.50968110999996,"height":7.999900000000025},{"text":".014","fontSize":7.9999,"x":516.18667271,"y":590.96010583,"width":15.495806300000027,"height":7.999900000000025},{"text":"Isolated tumor cells (<0.2 mm) 0/1 (0) 0/3 (0)","fontSize":7.9999,"x":50.00290008000002,"y":610.9158563799999,"width":391.07671148,"height":7.999900000000025},{"text":"Micrometastasis (0.2 mm to 0.2 cm) 4/9 (44.4) 3/13 (23.1)","fontSize":7.9999,"x":50.00210009,"y":620.95013095,"width":406.52291840000004,"height":7.999899999999911},{"text":"Macrometastasis (>0.2 cm) 13/14 (92.9) 10/18 (55.6)","fontSize":7.9999,"x":50.00210009,"y":630.9284062199999,"width":410.94526312,"height":7.999900000000025},{"text":"No. of cases with additional positive axillary lymph","fontSize":7.9999,"x":42.00860001000001,"y":640.96268079,"width":175.51940598,"height":7.999899999999911},{"text":"nodes/total No. (%) ALND cases subdivided by SLN","fontSize":7.9999,"x":57.99560017000001,"y":650.94095606,"width":179.59615502,"height":7.999900000000025},{"text":"metastasis size","fontSize":7.99