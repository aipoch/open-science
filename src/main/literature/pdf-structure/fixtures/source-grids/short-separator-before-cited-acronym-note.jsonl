[["page"],{"pageNumber":1,"width":593.972,"height":782.986,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"constructPath":36},"captionStarts":[{"text":"TABLE 1","fontSize":8.9663,"x":152.9574,"y":32.9867999999999,"width":37.03619878000001,"height":8.966300000000047},{"text":"TABLE 2","fontSize":8.9663,"x":278.4755,"y":514.0261,"width":37.03619878000001,"height":8.966299999999933}],"headingCandidates":[],"lines":[{"text":"Buffered Lidocaine Preparation","fontSize":8.9663,"x":51.9307,"y":172.9049,"width":134.62092483,"height":8.966300000000047},{"text":"Immediately before injection, the radiologist performing the","fontSize":8.9663,"x":61.851910950000004,"y":183.84647588999997,"width":229.1580055099999,"height":8.966300000000047},{"text":"injection withdrew 1 mL of sodium bicarbonate into a 5-mL","fontSize":8.9663,"x":51.9307,"y":194.78805177999993,"width":239.08907938999988,"height":8.966300000000047},{"text":"syringe capable of holding a total volume of 6 mL. The remainder","fontSize":8.9663,"x":51.9307,"y":205.7296276699999,"width":239.04335125999995,"height":8.966300000000047},{"text":"of the syringe was filled with 2% lidocaine.","fontSize":8.9663,"x":51.9307,"y":216.7276912499999,"width":160.90204676000002,"height":8.966300000000047},{"text":"corded by a research assistant who was present throughout the pro-","fontSize":8.9663,"x":302.96763331,"y":43.9258779999999,"width":239.08907939000085,"height":8.966300000000047},{"text":"cedure. Blood pressure and heart rates were recorded at the beginning","fontSize":8.9663,"x":302.96763331,"y":54.923941579999905,"width":239.0817270240001,"height":8.966300000000047},{"text":"of the patient encounter and after the injection. Averages of blood","fontSize":8.9663,"x":302.96763331,"y":65.86551746999987,"width":239.08100971999966,"height":8.966300000000047},{"text":"pressures and heart rates were calculated. A summary of the control","fontSize":8.9663,"x":302.96763331,"y":76.80709335999984,"width":239.15991315999975,"height":8.966300000000047},{"text":"group and experimental group characteristics is provided in Table 2.","fontSize":8.9663,"x":302.96763331,"y":87.80515693999985,"width":239.16529293999963,"height":8.966300000000047},{"text":"Imaging Parameters and Technique","fontSize":8.9663,"x":302.96763331,"y":104.6994593999998,"width":153.6393437600001,"height":8.966300000000047},{"text":"Approximately 30 min after breast lymphoscintigraphy, imag-","fontSize":8.9663,"x":312.94533194999997,"y":115.6975229799998,"width":229.1122773799999,"height":8.966300000000047},{"text":"ing was performed according to routine departmental breast im-","fontSize":8.9663,"x":302.96763331,"y":126.63909886999977,"width":239.10342546999993,"height":8.966300000000047},{"text":"aging procedure. Anterior, lateral, and oblique spot planar images","fontSize":8.9663,"x":302.96763331,"y":137.58067475999974,"width":239.08369960999994,"height":8.966300000000047},{"text":"were obtained using a Philips Forte and Philips Skylight g camera.","fontSize":8.9663,"x":302.96763331,"y":148.57873833999975,"width":239.0469377799999,"height":8.966300000000047},{"text":"Statistical Methods","fontSize":8.9663,"x":302.9676333099999,"y":165.4730407999997,"width":83.12746393000003,"height":8.966300000000047},{"text":"Data were modeled before and after treatment by treatment","fontSize":8.9663,"x":312.94533194999985,"y":176.4711043799997,"width":229.07103239999992,"height":8.966300000000047},{"text":"group using SAS/GLIMMIX Statistical Software 9.3 (SAS In-","fontSize":8.9663,"x":302.9676333099999,"y":187.41268026999967,"width":239.08997601999988,"height":8.966300000000047},{"text":"stitute). Baseline differences were tested using SAS/NPAR1WAY","fontSize":8.9663,"x":302.9676333099999,"y":198.35425615999964,"width":239.09894231999976,"height":8.966300000000047},{"text":"and SAS/TTEST. Difference in lymph node visualization between","fontSize":8.9663,"x":302.9676333099999,"y":209.35231973999964,"width":239.08190634999983,"height":8.966300000000047},{"text":"NIH Pain Scale Gradations","fontSize":8.9663,"x":117.41050365000001,"y":43.92837588999987,"width":108.07978020000002,"height":8.966300000000047},{"text":"Gradation Descriptor","fontSize":7.9702,"x":63.8362,"y":63.80340000000001,"width":146.04435076000001,"height":7.970199999999977},{"text":"0 No pain","fontSize":7.9702,"x":63.836200000000005,"y":80.69783294000001,"width":67.95551924000002,"height":7.970199999999977},{"text":"1–3 Mild pain (nagging, annoying, interfering little","fontSize":7.9702,"x":63.836200000000005,"y":90.16563352000003,"width":200.67130454,"height":7.970199999999977},{"text":"with ADLs)","fontSize":7.9702,"x":111.68449868000002,"y":100.14352689999998,"width":38.531134879999996,"height":7.970199999999977},{"text":"4–6 Moderate pain (interferes significantly with ADLs)","fontSize":7.9702,"x":63.83540298000002,"y":110.06483186000003,"width":215.23764205999998,"height":7.970199999999977},{"text":"7–10 Severe pain (disabling; unable to perform ADLs)","fontSize":7.9702,"x":63.83540298000002,"y":119.53263244000004,"width":211.78096631999995,"height":7.970199999999977},{"text":"ADLs = activities of daily living.","fontSize":7.9702,"x":62.87100878000002,"y":146.63210946000004,"width":113.65266094,"height":7.970199999999977}],"graphicsBounds":[{"operationIndex":265,"kind":"path","normalizedRect":[0.0859375,0.1015625,0.1796875,0.12109375]},{"operationIndex":266,"kind":"path","normalizedRect":[0.1640625,0.1015625,0.49609375,0.12109375]},{"operationIndex":267,"kind":"path","normalizedRect":[0.0859375,0.13671875,0.1796875,0.16015625]},{"operationIndex":268,"kind":"path","normalizedRect":[0.1640625,0.13671875,0.49609375,0.16015625]},{"operationIndex":270,"kind":"path","normalizedRect":[0.0859375,0.07421875,0.49609375,0.08203125]},{"operationIndex":271,"kind":"path","normalizedRect":[0.0859375,0.09765625,0.49609375,0.10546875]},{"operationIndex":272,"kind":"path","normalizedRect":[0.0859375,0.203125,0.49609375,0.2