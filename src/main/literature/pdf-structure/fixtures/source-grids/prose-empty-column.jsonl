[["tokens",125],{"text":"intervention experienced greater reductions in fatigue than control","inlineSymbol":false,"baseline":455.7450000000001,"height":15,"rect":[469.5,440.7450000000001,864.0000000000001,455.7450000000001],"horizontal":true}]
[["tokens",126],{"text":"participants, and this effect was in the small to medium range (ES =","inlineSymbol":false,"baseline":472.2450000000001,"height":15,"rect":[469.5,457.2450000000001,863.974500000001,472.2450000000001],"horizontal":true}]
[["tokens",127],{"text":"–0.36). The walking intervention resulted in improvements in many","inlineSymbol":false,"baseline":488.7450000000001,"height":15,"rect":[469.5,473.7450000000001,864.1620000000006,488.7450000000001],"horizontal":true}]
[["tokens",128],{"text":"indicators of QOL as measured by the IBCSG QOL Core question-","inlineSymbol":false,"baseline":505.2450000000001,"height":15,"rect":[469.5,490.2450000000001,864.0000000000002,505.2450000000001],"horizontal":true}]
[["tokens",129],{"text":"naire. Compared with those in the control group, participants in","inlineSymbol":false,"baseline":521.7450000000001,"height":15,"rect":[469.5,506.7450000000001,863.9999999999998,521.7450000000001],"horizontal":true}]
[["tokens",130],{"text":"the walking intervention showed greater improvements in: current","inlineSymbol":false,"baseline":538.2450000000001,"height":15,"rect":[469.5,523.2450000000001,864,538.2450000000001],"horizontal":true}]
[["tokens",131],{"text":"health (ES = 0.27) and mood (ES = 0.30), with effects in the small","inlineSymbol":false,"baseline":554.7450000000001,"height":15,"rect":[469.5,539.7450000000001,863.9684999999995,554.7450000000001],"horizontal":true}]
[["tokens",132],{"text":"range; physical well-being (ES = 0.38), with effects in the small to","inlineSymbol":false,"baseline":571.2450000000001,"height":15,"rect":[469.5,556.2450000000001,863.9999999999998,571.2450000000001],"horizontal":true}]
[["tokens",133],{"text":"medium range; feeling sick (ES = 0.51), appetite (ES = 0.56), and","inlineSymbol":false,"baseline":587.7450000000001,"height":15,"rect":[469.5,572.7450000000001,863.9550000000002,587.7450000000001],"horizontal":true}]
[["tokens",134],{"text":"effort in coping (ES = 0.59), with effects in the medium range; and","inlineSymbol":false,"baseline":604.2450000000001,"height":15,"rect":[469.5,589.2450000000001,863.9999999999995,604.2450000000001],"horizontal":true}]
[["tokens",135],{"text":"tiredness (ES = 0.68), with effects in the medium to large range.","inlineSymbol":false,"baseline":620.7450000000001,"height":15,"rect":[469.5,605.7450000000001,863.9850000000001,620.7450000000001],"horizontal":true}]
[["tokens",136],{"text":"The intervention had no effect on social support (ES = –0.01) or","inlineSymbol":false,"baseline":637.2450000000001,"height":15,"rect":[469.5,622.2450000000001,864.0285000000001,637.2450000000001],"horizontal":true}]
[["tokens",137],{"text":"hot flashes (ES = 0.07), and participants in the control group had","inlineSymbol":false,"baseline":653.7450000000001,"height":15,"rect":[469.5,638.7450000000001,863.9399999999996,653.7450000000001],"horizontal":true}]
[["tokens",138],{"text":"greater improvements in restricted use of arm, with effects in the","inlineSymbol":false,"baseline":670.2450000000001,"height":15,"rect":[469.5,655.2450000000001,863.9385,670.2450000000001],"horizontal":true}]
[["tokens",139],{"text":"medium to large range (ES = –0.65)","inlineSymbol":false,"baseline":686.7450000000001,"height":15,"rect":[469.5,671.7450000000001,685.575,686.7450000000001],"horizontal":true}]
[["tokens",140],{"text":"The walking intervention also resulted in a number of improve-","inlineSymbol":false,"baseline":703.2450000000001,"height":15,"rect":[496.5,688.2450000000001,863.9355,703.2450000000001],"horizontal":true}]
[["tokens",141],{"text":"ments in aspects of QOL as measured by the SF-36 questionnaire.","inlineSymbol":false,"baseline":719.7450000000001,"height":15,"rect":[469.5,704.7450000000001,864.0449999999997,719.7450000000001],"horizontal":true}]
[["tokens",142],{"text":"Participants in the walking intervention had greater improvements","inlineSymbol":false,"baseline":736.2450000000001,"height":15,"rect":[469.5,721.2450000000001,864.0150000000001,736.2450000000001],"horizontal":true}]
[["tokens",143],{"text":"than the control group on the following subscales: role-emotional","inlineSymbol":false,"baseline":752.7450000000001,"height":15,"rect":[469.5,737.7450000000001,863.9849999999998,752.7450000000001],"horizontal":true}]
[["tokens",144],{"text":"(ES = 0.14) and mental health (ES = 0.28), with effects in the small","inlineSymbol":false,"baseline":769.2450000000001,"height":15,"rect":[469.5,754.2450000000001,864.0000000000003,769.2450000000001],"horizontal":true}]
[["tokens",145],{"text":"range; vitality (ES = 0.57) and role-physical (ES = 0.60), with","inlineSymbol":false,"baseline":785.7450000000001,"height":15,"rect":[469.5,770.7450000000001,864.1920000000005,785.7450000000001],"horizontal":true}]
[["tokens",146],{"text":"effects in the medium range; and general health (ES = 0.66) and","inlineSymbol":false,"baseline":802.2450000000001,"height":15,"rect":[469.5,787.2450000000001,864.0599999999995,802.2450000000001],"horizontal":true}]
[["tokens",147],{"text":"physical functioning (ES = 0.69), with effects in the medium to","inlineSymbol":false,"baseline":818.7450000000001,"height":15,"rect":[469.5,803.7450000000001,863.9999999999998,818.7450000000001],"horizontal":true}]
[["tokens",148],{"text":"large range. The walking intervention had no effect on pain (ES =","inlineSymbol":false,"baseline":835.2450000000001,"height":15,"rect":[469.5,820.2450000000001,864.0164999999997,835.2450000000001],"horizontal":true}]
[["tokens",149],{"text":"–0.04) or social functioning (ES = 0.04). For the summary scores,","inlineSymbol":false,"baseline":851.7450000000001,"height":15,"rect":[469.5,836.7450000000001,864.0600000000002,851.7450000000001],"horizontal":true}]
[["tokens",150],{"text":"participants in the walking intervention had greater improvements","inlineSymbol":false,"baseline":868.2450000000001,"height":15,"rect":[469.5,853.2450000000001,864.03,868.2450000000001],"horizontal":true}]
[["tokens",151],{"text":"than the control group on the mental (ES = –0.16, small effect) and","inlineSymbol":false,"baseline":884.7450000000001,"height":15,"rect":[469.5,869.7450000000001,863.9549999999999,884.7450000000001],"horizontal":true}]
[["tokens",152],{"text":"physical components (ES = 0.79, large effect).","inlineSymbol":false,"baseline":901.2450000000001,"height":15,"rect":[469.5,886.2450000000001,747.5985,901.2450000000001],"horizontal":true}]
[["tokens",153],{"text":"Participants in the walking intervention had greater increases","inlineSymbol":false,"baseline":917.7450000000001,"height":15,"rect":[496.5,902.7450000000001,863.9699999999998,917.7450000000001],"horizontal":true}]
[["tokens",154],{"text":"in energy expenditure from walking for exercise than the control","inlineSymbol":false,"baseline":934.2450000000001,"height":15,"rect":[469.5,919.2450000000001,864.0360000000001,934.2450000000001],"horizontal":true}]
[["tokens",155],{"text":"group (ES intervention = 3.07; ES control = 0.18; ES between group","inlineSymbol":false,"baseline":950.7450000000001,"height":15,"rect":[469.5,935.7450000000001,863.7059999999992,950.7450000000001],"horizontal":true}]
[["tokens",156],{"text":"= 2.89). Table 4 shows the association between changes in walking","inlineSymbol":false,"baseline":967.2450000000001,"height":15,"rect":[469.5,952.2450000000001,864.0015,967.2450000000001],"horizontal":true}]
[["tokens",157],{"text":"behavior and changes in fatigue and QOL as measured by the IBCSG","inlineSymbol":false,"baseline":983.7450000000001,"height":15,"rect":[469.5,968.7450000000001,864.1979999999999,983.7450000000001],"horizontal":true}]
[["tokens",158],{"text":"QOL Core and SF-36 questionnaires. For most outcomes, changes","inlineSymbol":false,"baseline":1000.2450000000001,"height":15,"rect":[469.5,985.2450000000001,863.9684999999998,1000.2450000000001],"horizontal":true}]
[["tokens",159],{"text":"in walking explained a meaningful amount of variance in change in","inlineSymbol":false,"baseline":1016.7450000000001,"height":15,"rect":[469.5,1001.7450000000001,864.2115,1016.7450000000001],"horizontal":true}]
[["tokens",160],{"text":"the outcome, with effects typically in the small to medium range.","inlineSymbol":false,"baseline":1033.2450000000001,"height":15,"rect":[469.5,1018.2450000000001,863.9699999999996,1033.2450000000001],"horizontal":true}]
[["tokens",161],{"text":"Effects were generally smaller for mental health-related outcomes","inlineSymbol":false,"baseline":1049.7450000000001,"height":15,"rect":[469.5,1034.7450000000001,863.9999999999998,1049.7450000000001],"horizontal":true}]
[["tokens",162],{"text":"and greater for physical health-related outcomes.","inlineSymbol":false,"baseline":1066.2450000000001,"height":15,"rect":[469.5,1051.2450000000001,762.6735000000001,1066.2450000000001],"horizontal":true}]
