[["tokens",0],{"text":"18010","inlineSymbol":false,"baseline":58.81663916100001,"height":12.75,"rect":[76.5354022965,46.06663916100001,106.8166522965,58.81663916100001],"horizontal":true}]
[["tokens",1],{"text":"Journal of Cancer Research and Clinical Oncology (2023) 149:18005–18021","inlineSymbol":false,"baseline":58.81663916100001,"height":12.75,"rect":[453.285149568,46.06663916100001,816.3796495680001,58.81663916100001],"horizontal":true}]
[["tokens",2],{"text":"1 3","inlineSymbol":false,"baseline":1117.7517,"height":22.5,"rect":[78.7464,1095.2517,104.0589,1117.7517],"horizontal":true}]
[["tokens",3],{"text":"PSS","inlineSymbol":false,"baseline":490.3542063,"height":15,"rect":[76.5354022965,475.3542063,98.6454022965,490.3542063],"horizontal":true}]
[["tokens",4],{"text":"Perceived stress levels were assessed using the Perceived","inlineSymbol":false,"baseline":527.8542063,"height":15,"rect":[76.5354022965,512.8542063,433.5549023022296,527.8542063],"horizontal":true}]
[["tokens",5],{"text":"Stress Scale (PSS), a 14-item instrument to evaluate an indi-","inlineSymbol":false,"baseline":546.6042063,"height":15,"rect":[76.5354022965,531.6042063,433.70040229649976,546.6042063],"horizontal":true}]
[["tokens",6],{"text":"vidual’s perception of life’s unpredictability (Miceli et al.","inlineSymbol":false,"baseline":565.3542063,"height":15,"rect":[76.5354022965,550.3542063,433.4454023107951,565.3542063],"horizontal":true}]
[["tokens",7],{"text":"2019). Participants were instructed to rate their thoughts and","inlineSymbol":false,"baseline":584.1042063,"height":15,"rect":[76.5354022965,569.1042063,433.9389023022153,584.1042063],"horizontal":true}]
[["tokens",8],{"text":"feelings experienced over the past month using a 5-point","inlineSymbol":false,"baseline":602.8542063,"height":15,"rect":[76.5354022965,587.8542063,433.73040229649985,602.8542063],"horizontal":true}]
[["tokens",9],{"text":"scale.","inlineSymbol":false,"baseline":621.6042063,"height":15,"rect":[76.5354022965,606.6042063,110.64540229649998,621.6042063],"horizontal":true}]
[["tokens",10],{"text":"Data collection","inlineSymbol":false,"baseline":659.1042063,"height":16.5,"rect":[76.5354022965,642.6042063,179.295752290197,659.1042063],"horizontal":true}]
[["tokens",11],{"text":"This research was undertaken by a team of six dedicated","inlineSymbol":false,"baseline":696.6042063,"height":15,"rect":[76.5354022965,681.6042063,433.5459022907702,696.6042063],"horizontal":true}]
[["tokens",12],{"text":"professionals hailing from the Second Affiliated Hospital","inlineSymbol":false,"baseline":715.3542063,"height":15,"rect":[76.5354022965,700.3542063,433.93290230221487,715.3542063],"horizontal":true}]
[["tokens",13],{"text":"of Anhui Medical University. The team consisted of four","inlineSymbol":false,"baseline":734.1042063,"height":15,"rect":[76.5354022965,719.1042063,433.84290226793973,734.1042063],"horizontal":true}]
[["tokens",14],{"text":"postgraduate researchers, a psychologist, and an oncologist,","inlineSymbol":false,"baseline":752.8542063,"height":15,"rect":[76.5354022965,737.8542063,433.72590229077025,752.8542063],"horizontal":true}]
[["tokens",15],{"text":"all working in concert. Following an evaluation of patient","inlineSymbol":false,"baseline":771.6042063,"height":15,"rect":[76.5354022965,756.6042063,433.97490232513576,771.6042063],"horizontal":true}]
[["tokens",16],{"text":"suitability, baseline measurement data was meticulously col-","inlineSymbol":false,"baseline":790.3542063,"height":15,"rect":[76.5354022965,775.3542063,433.8744022993649,790.3542063],"horizontal":true}]
[["tokens",17],{"text":"lected, and individuals were randomly assigned to either the","inlineSymbol":false,"baseline":809.1042063,"height":15,"rect":[76.5354022965,794.1042063,433.49190229650003,809.1042063],"horizontal":true}]
[["tokens",18],{"text":"study or control groups. To safeguard patient confidential-","inlineSymbol":false,"baseline":827.8542063,"height":15,"rect":[76.5354022965,812.8542063,433.92390231652416,827.8542063],"horizontal":true}]
[["tokens",19],{"text":"ity and ensure their convenience, the CALM interventions","inlineSymbol":false,"baseline":846.6042063,"height":15,"rect":[76.5354022965,831.6042063,433.9179023394154,846.6042063],"horizontal":true}]
[["tokens",20],{"text":"were thoughtfully conducted within the oncology meeting","inlineSymbol":false,"baseline":865.3542063,"height":15,"rect":[76.5354022965,850.3542063,433.9479023108099,865.3542063],"horizontal":true}]
[["tokens",21],{"text":"rooms of Anhui Medical University’s Second Affiliated","inlineSymbol":false,"baseline":884.1042063,"height":15,"rect":[76.5354022965,869.1042063,433.5369023108103,884.1042063],"horizontal":true}]
[["tokens",22],{"text":"Hospital during the patients' hospital stays. Upon reach-","inlineSymbol":false,"baseline":902.8542063,"height":15,"rect":[76.5354022965,887.8542063,433.9194023136598,902.8542063],"horizontal":true}]
[["tokens",23],{"text":"ing the 24-week mark, participants underwent follow-up","inlineSymbol":false,"baseline":921.6042063,"height":15,"rect":[76.5354022965,906.6042063,433.5414022764753,921.6042063],"horizontal":true}]
[["tokens",24],{"text":"assessments by phone or, whenever feasible, in person at","inlineSymbol":false,"baseline":940.3542063,"height":15,"rect":[76.5354022965,925.3542063,433.49040231939,940.3542063],"horizontal":true}]
[["tokens",25],{"text":"the hospital.","inlineSymbol":false,"baseline":959.1042063,"height":15,"rect":[76.5354022965,944.1042063,150.8514022965,959.1042063],"horizontal":true}]
[["tokens",26],{"text":"The CALM therapists received rigorous training and","inlineSymbol":false,"baseline":977.8542063,"height":15,"rect":[93.5454022965,962.8542063,433.80390229078523,977.8542063],"horizontal":true}]
[["tokens",27],{"text":"supervision from clinical investigators before implementing","inlineSymbol":false,"baseline":996.6042063,"height":15,"rect":[76.5354022965,981.6042063,433.6134023251344,996.6042063],"horizontal":true}]
[["tokens",28],{"text":"the treatment. After six hours of training and two practical","inlineSymbol":false,"baseline":1015.3542063,"height":15,"rect":[76.5354022965,1000.3542063,433.6539022907706,1015.3542063],"horizontal":true}]
[["tokens",29],{"text":"exercises, they were considered proficient in delivering the","inlineSymbol":false,"baseline":1034.1042063,"height":15,"rect":[76.5354022965,1019.1042063,433.73040229650053,1034.1042063],"horizontal":true}]
[["tokens",30],{"text":"CALM intervention. Senior clinicians oversaw the quality","inlineSymbol":false,"baseline":490.17419074500003,"height":15,"rect":[459.21538924649997,475.17419074500003,816.0983892522139,490.17419074500003],"horizontal":true}]
[["tokens",31],{"text":"and effectiveness of the interventions. Regular group super-","inlineSymbol":false,"baseline":508.92419074500003,"height":15,"rect":[459.21538924649997,493.92419074500003,816.3803892465,508.92419074500003],"horizontal":true}]
[["tokens",32],{"text":"vision meetings were conducted weekly to maintain adher-","inlineSymbol":false,"baseline":527.674190745,"height":15,"rect":[459.21538924649985,512.674190745,816.3803892465002,527.674190745],"horizontal":true}]
[["tokens",33],{"text":"ence to the intervention protocol and foster the ongoing skill","inlineSymbol":false,"baseline":546.424190745,"height":15,"rect":[459.21538924649985,531.424190745,816.2288892636609,546.424190745],"horizontal":true}]
[["tokens",34],{"text":"development of the therapists. They were closely monitored","inlineSymbol":false,"baseline":565.174190745,"height":15,"rect":[459.21538924649985,550.174190745,816.6323892779985,565.174190745],"horizontal":true}]
[["tokens",35],{"text":"weekly and required to submit detailed case reports. Further-","inlineSymbol":false,"baseline":583.924190745,"height":15,"rect":[459.21538924649985,568.924190745,816.3803892465003,583.924190745],"horizontal":true}]
[["tokens",36],{"text":"more, the therapists recorded interviews in written reports","inlineSymbol":false,"baseline":602.674190745,"height":15,"rect":[459.21538924649985,587.674190745,816.4748892321743,602.674190745],"horizontal":true}]
[["tokens",37],{"text":"for subsequent analysis and evaluation. In the intervention","inlineSymbol":false,"baseline":621.424190745,"height":15,"rect":[459.21538924649985,606.424190745,816.2033892836995,621.424190745],"horizontal":true}]
[["tokens",38],{"text":"group, patients received six CALM interventions, each last-","inlineSymbol":false,"baseline":640.174190745,"height":15,"rect":[459.21538924649985,625.174190745,816.0908892350386,640.174190745],"horizontal":true}]
[["tokens",39],{"text":"ing at least 30 min over 12 weeks. Psychological scales were","inlineSymbol":false,"baseline":658.924190745,"height":15,"rect":[459.21538924649985,643.924190745,816.4043892522318,658.924190745],"horizontal":true}]
[["tokens",40],{"text":"administered at the 6-week mark, 12 weeks following the","inlineSymbol":false,"baseline":677.674190745,"height":15,"rect":[459.21538924649985,662.674190745,816.4088892464996,677.674190745],"horizontal":true}]
[["tokens",41],{"text":"initiation of the first intervention, and again at 12 weeks fol-","inlineSymbol":false,"baseline":696.424190745,"height":15,"rect":[459.21538924649985,681.424190745,816.680389246544,696.424190745],"horizontal":true}]
[["tokens",42],{"text":"lowing the conclusion of the last intervention to gauge its","inlineSymbol":false,"baseline":715.174190745,"height":15,"rect":[459.21538924649985,700.174190745,816.0893892293111,715.174190745],"horizontal":true}]
[["tokens",43],{"text":"effectiveness.","inlineSymbol":false,"baseline":733.924190745,"height":15,"rect":[459.21538924649985,718.924190745,540.8903892465,733.924190745],"horizontal":true}]
[["tokens",44],{"text":"Informed by the previous research (Zhou et al. 2019), we","inlineSymbol":false,"baseline":752.674190745,"height":15,"rect":[476.22538924649984,737.674190745,816.3803892465003,752.674190745],"horizontal":true}]
[["tokens",45],{"text":"adapted the single CALM intervention into a cyclic interven-","inlineSymbol":false,"baseline":771.424190745,"height":15,"rect":[459.2153995514999,756.424190745,816.1433995343399,771.424190745],"horizontal":true}]
[["tokens",46],{"text":"tion. The intervener established a trusting relationship with","inlineSymbol":false,"baseline":790.174190745,"height":15,"rect":[459.2153995514999,775.174190745,816.3623995400401,790.174190745],"horizontal":true}]
[["tokens",47],{"text":"the patient and assisted the patient in expressing and con-","inlineSymbol":false,"baseline":808.924190745,"height":15,"rect":[459.2153995514999,793.924190745,816.4613995515012,808.924190745],"horizontal":true}]
[["tokens",48],{"text":"trolling their emotions. Next, the intervener discussed with","inlineSymbol":false,"baseline":827.674190745,"height":15,"rect":[459.2153995514999,812.674190745,816.3788995515004,827.674190745],"horizontal":true}]
[["tokens",49],{"text":"patients the adverse effects of illness and treatment, which","inlineSymbol":false,"baseline":846.424190745,"height":15,"rect":[459.2153995514999,831.424190745,816.3533995572293,846.424190745],"horizontal":true}]
[["tokens",50],{"text":"are primary factors in low resilience and the patient's under-","inlineSymbol":false,"baseline":865.174190745,"height":15,"rect":[459.2153995514999,850.174190745,816.3803995515002,865.174190745],"horizontal":true}]
[["tokens",51],{"text":"standing of death. Following this discussion, the behavioural","inlineSymbol":false,"baseline":883.924190745,"height":15,"rect":[459.2153995514999,868.924190745,816.1733995743896,883.924190745],"horizontal":true}]
[["tokens",52],{"text":"intervention was performed with VR equipment, according","inlineSymbol":false,"baseline":902.674190745,"height":15,"rect":[459.2153995514999,887.674190745,816.4073995457699,902.674190745],"horizontal":true}]
[["tokens",53],{"text":"to the CALM manual. If the interventionist determines that","inlineSymbol":false,"baseline":921.424190745,"height":15,"rect":[459.2153995514999,906.424190745,816.3788995457695,921.424190745],"horizontal":true}]
[["tokens",54],{"text":"the patient continues to experience depression after the ini-","inlineSymbol":false,"baseline":940.174190745,"height":15,"rect":[459.2153995514999,925.174190745,816.4238995457702,940.174190745],"horizontal":true}]
[["tokens",55],{"text":"tial intervention, the CALM intervention is continued for","inlineSymbol":false,"baseline":958.924190745,"height":15,"rect":[459.2153995514999,943.924190745,816.2888995829694,958.924190745],"horizontal":true}]
[["tokens",56],{"text":"up to three additional cycles. This cyclic approach ensured","inlineSymbol":false,"baseline":977.674190745,"height":15,"rect":[459.2153995514999,962.674190745,816.3803995515,977.674190745],"horizontal":true}]
[["tokens",57],{"text":"that the intervention was tailored to the patient's needs and","inlineSymbol":false,"baseline":996.424190745,"height":15,"rect":[459.2153995514999,981.424190745,816.4253995514997,996.424190745],"horizontal":true}]
[["tokens",58],{"text":"that the patients received the necessary support to cope with","inlineSymbol":false,"baseline":1015.174190745,"height":15,"rect":[459.2153995514999,1000.174190745,816.0653995228508,1015.174190745],"horizontal":true}]
[["tokens",59],{"text":"their condition.","inlineSymbol":false,"baseline":1033.924190745,"height":15,"rect":[459.2153995514999,1018.924190745,551.9378995515001,1033.924190745],"horizontal":true}]
