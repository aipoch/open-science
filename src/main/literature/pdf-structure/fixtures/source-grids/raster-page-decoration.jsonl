[["page"],{"pageNumber":8,"width":585,"height":783,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":1,"constructPath":5},"captionStarts":[{"text":"Fig. 2. brief Pain Inventory before surgery and 3, 6, and 12 months after surgery and Hospital Anxiety and Depression Scale and Douleur","fontSize":10,"x":60.5399,"y":366.5599,"width":463.81920000000116,"height":10}],"headingCandidates":[],"lines":[{"text":"1098 Anesthesiology 2021; 135:1091–103","fontSize":7,"x":28.825,"y":758.9,"width":314.8529999999998,"height":7},{"text":"PAIN mEDIcINE","fontSize":10,"x":51.0251,"y":35.83879999999999,"width":54.760000000000026,"height":10},{"text":"Albi-Feldzer et al.","fontSize":7,"x":507.302,"y":758.9,"width":48.958000000000084,"height":7},{"text":"study that reported a lower incidence of chronic pain at 3","fontSize":10,"x":51.04,"y":518.9684,"width":232.37000000000054,"height":10},{"text":"and 6 months in the paravertebral group was limited by","fontSize":10,"x":51.04,"y":530.9684,"width":232.4050000000004,"height":10},{"text":"the absence of pain evaluation during mobilization, and of","fontSize":10,"x":51.04,"y":542.9684,"width":232.36000000000067,"height":10},{"text":"sensory blockade tests. Moreover, mastectomies were only","fontSize":10,"x":51.04,"y":554.9684,"width":232.35900000000046,"height":10},{"text":"partial.","fontSize":10,"x":51.04,"y":566.9684,"width":27.369999999999983,"height":10},{"text":"12","fontSize":5.83,"x":78.4595,"y":567.8084,"width":5.7425500000000085,"height":5.830000000000041},{"text":"The second study found that the incidence and","fontSize":10,"x":86.9001,"y":566.9684,"width":196.5300000000003,"height":10},{"text":"severity of persistent postoperative incisional breast pain","fontSize":10,"x":51.0411,"y":578.9684,"width":232.3590000000004,"height":10},{"text":"at 6 and 12 months were unaffected by the analgesia tech-","fontSize":10,"x":51.0411,"y":590.9684,"width":232.3990000000006,"height":10},{"text":"nique. However, pain was not the primary outcome, and","fontSize":10,"x":51.0411,"y":602.9684,"width":232.37700000000055,"height":10},{"text":"the study had several limitations: no reduction in postop-","fontSize":10,"x":51.0411,"y":614.9684,"width":232.3500000000005,"height":10},{"text":"erative morphine consumption in the paravertebral group,","fontSize":10,"x":51.0411,"y":626.9684,"width":233.3590000000004,"height":10},{"text":"no sensory blockade tests, and no placebo group for the","fontSize":10,"x":51.0411,"y":638.9684,"width":232.41000000000045,"height":10},{"text":"paravertebral block; thus, the study was not double-blind.","fontSize":10,"x":51.0411,"y":650.9684,"width":229.45000000000053,"height":10},{"text":"2","fontSize":5.83,"x":280.5634,"y":651.8084,"width":2.8566999999999894,"height":5.830000000000041},{"text":"The overall incidence of chronic pain at 3 months in our","fontSize":10,"x":51.04000000000002,"y":662.9684,"width":232.42000000000047,"height":10},{"text":"study (53% and 48% in the paravertebral block and con-","fontSize":10,"x":51.04000000000002,"y":674.9684,"width":232.3990000000004,"height":10},{"text":"trol groups, respectively) was similar to that in other pub-","fontSize":10,"x":51.04000000000002,"y":686.9684,"width":232.38000000000034,"height":10},{"text":"lished studies (30 to 65%). The wide range of prevalence","fontSize":10,"x":51.04000000000002,"y":698.9684,"width":232.38800000000032,"height":10},{"text":"of chronic pain reported in the literature is probably due","fontSize":10,"x":51.04000000000002,"y":710.9684,"width":232.38100000000037,"height":10},{"text":"to several factors such as the definition and the pain score.","fontSize":10,"x":51.04000000000002,"y":722.9684,"width":233.4190000000005,"height":10},{"text":"Different pain scores might provide different results. A","fontSize":10,"x":301.42,"y":518.9684,"width":232.3980000000002,"height":10},{"text":"moderate or greater pain score (greater than or equal to 3)","fontSize":10,"x":301.42,"y":530.9684,"width":232.36000000000053,"height":10},{"text":"is clinically relevant after breast surgery. Less than 3 would","fontSize":10,"x":301.42,"y":542.9684,"width":232.34900000000022,"height":10},{"text":"be considered mild.","fontSize":10,"x":301.42,"y":554.9684,"width":78.56000000000012,"height":10},{"text":"Our study also showed the absence of a statistically signif-","fontSize":10,"x":313.42,"y":566.9684,"width":220.37899999999905,"height":10},{"text":"icant reduction in the incidence of chronic and neuropathic","fontSize":10,"x":301.42,"y":578.9684,"width":232.37999999999937,"height":10},{"text":"pain at 3, 6, and 12 months, despite better control of acute","fontSize":10,"x":301.42,"y":590.9684,"width":232.38099999999912,"height":10},{"text":"pain, which could have been due to the short-term benefit of","fontSize":10,"x":301.42,"y":602.9684,"width":232.41999999999922,"height":10},{"text":"postoperative pain relief in the paravertebral group. Although","fontSize":10,"x":301.42,"y":614.9684,"width":232.38899999999882,"height":10},{"text":"we also used numerous tools to identify pain-related func-","fontSize":10,"x":301.42,"y":626.9684,"width":232.38899999999927,"height":10},{"text":"tional interference, including the Brief Pain Inventory;","fontSize":10,"x":301.42,"y":638.9684,"width":233.399999999999,"height":10},{"text":"Hospital Anxiety Depression Scale; Pain Interference Total","fontSize":10,"x":301.42,"y":650.9684,"width":232.39399999999915,"height":10},{"text":"Score from the Brief Pain Inventory; the average score of","fontSize":10,"x":301.42,"y":662.9684,"width":232.41999999999956,"height":10},{"text":"work, general activity, and walking from Brief Pain Inventory;","fontSize":10,"x":301.42,"y":674.9684,"width":233.34799999999922,"height":10},{"text":"and average score of relations with others, enjoyment of life,","fontSize":10,"x":301.42,"y":686.9684,"width":233.39999999999924,"height":10},{"text":"and mood from Brief Pain Inventory, no differences in these","fontSize":10,"x":301.42,"y":698.9684,"width":232.37999999999926,"height":10},{"text":"items were found between the two groups. These scores on","fontSize":10,"x":301.42,"y":710.9684,"width":232.37999999999914,"height":10},{"text":"patient outcome provide more precise information than pain","fontSize":10,"x":301.42,"y":722.9684,"width":232.40999999999946,"height":10},{"text":"Fig. 2. brief Pain Inventory before surgery and 3, 6, and 12 months after surgery and Hospital Anxiety and Depression Scale and Douleur","fontSize":10,"x":60.5399,"y":366.5599,"width":463.81920000000116,"height":10},{"text":"Neuropathique 4 questionnaire scores 3 months after surgery. Pain interference at 3 months after surgery was assessed with the brief Pain","fontSize":9,"x":60.538700000000006,"y":378.0629,"width":463.75740000000013,"height":9},{"text":"Inventory (sleep disturbances, general activity, mood, work, relations with others, walking, and enjoyment of life). The brief Pain Inventory","fontSize":9,"x":60.538700000000006,"y":388.5659,"width":463.7340000000008,"height":9},{"text":"measures pain severity and interference. Pain severity is measured by four items: worst pain, least pain, average pain in the last 24 h, and pain","fontSize":9,"x":60.538700000000006,"y":399.0689,"width":463.76100000000014,"height":9},{"text":"now. The seven interference items (sleep disturbance, general activity, mood, work, relations with others, walking, and enjoyment of life) are","fontSize":9,"x":60.538700000000006,"y":409.57189999999997,"width":463.82040000000126,"height":9},{"text":"assessed on a 0 to 10 scale, with 0 being “did not interfere” and 10 being “interfered completely.” Three subscale scores can be generated: Pain","fontSize":9,"x":60.538700000000006,"y":420.07489999999996,"width":463.8231000000015,"height":9},{"text":"Interference Total Score (the average score of all seven items), physical interference (the average score of work, general activity, and walking),","fontSize":9,"x":60.538700000000006,"y":430.57789999999994,"width":464.0940000000015,"height":9},{"text":"and affective interference (the average score of relations with others, enjoyment of life, and mood). The complete figure with all items is in the","fontSize":9,"x":60.538700000000006,"y":441.08089999999993,"width":463.7259000000011,"height":9},{"text":"appendix. (A–D) brief Pain Inventory, item 5: before surgery and 3, 6, and 12 months after surgery. (E) Hospital Anxiety and Depression Scale: anx-","fontSize":9,"x":60.538700000000006,"y":451.5838999999999,"width":463.7763000000006,"height":9},{"text":"iety score 3 months after surgery. (F) Hospital Anxiety and Depression Scale: depression score 3 months after surgery. (G) Douleur Neuropathique","fontSize":9,"x":60.538700000000006,"y":462.0868999999999,"width":463.76100000000037,"height":9},{"text":"4 questionnaire score equal to or higher than 4 evaluated 3 months after surgery. (H) brief Pain Inventory—Pain Interference Total Score: seven","fontSize":9,"x":60.53870000000006,"y":472.5898999999999,"width":463.75830000000065,"height":9},{"text":"interference items (sleep disturbances, general activity, mood, work, relations with others, walking, and enjoyment of life) 3 months after surgery.","fontSize":9,"x":60.53870000000006,"y":483.0928999999999,"width":464.0850000000012,"height":9},{"text":"Copyright © 2021, the American Society of Anesthesiologists. All Rights Reserved. Unauthorized reproduction of this article is prohibited.","fontSize":8.5,"x":38.6462,"y":768.571,"width":512.7131999999993,"height":8.5}],"graphicsBounds":[{"operationIndex":16,"kind":"path","normalizedRect":[0,0,1,0.078125]},{"operationIndex":230,"kind":"image","normalizedRect":[0.09765625,0.11328125,0.90625,0.453125],"imageHash":"76ebf6bed24e7ff7d995808f3a65f985e3e09140357d21e98042807da2927c9f"},{"operationIndex":237,"kind":"path","normalizedRect":[0.0859375,0.45703125,0.91796875,0.64453125]},{"operationIndex":365,"kind":"path","normalizedRect":[0.08203125,0.09765625,0.91796875,0.6484375]}],"invalidGraphicsBounds":0}]
