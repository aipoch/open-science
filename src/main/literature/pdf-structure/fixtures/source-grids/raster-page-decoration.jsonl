[["tokens",2],{"text":"PAIN mEDIcINE","inlineSymbol":false,"baseline":68.75819999999999,"height":15,"rect":[76.53765,53.75819999999999,158.67765000000003,68.75819999999999],"horizontal":true}]
[["tokens",3],{"text":"Albi-Feldzer","inlineSymbol":false,"baseline":1148.85,"height":10.5,"rect":[760.953,1138.35,810.4395000000005,1148.85],"horizontal":true}]
[["tokens",4],{"text":"et al.","inlineSymbol":false,"baseline":1148.85,"height":10.5,"rect":[813.5895,1138.35,834.3900000000002,1148.85],"horizontal":true}]
[["tokens",5],{"text":"study that reported a lower incidence of chronic pain at 3","inlineSymbol":false,"baseline":793.4526000000001,"height":15,"rect":[76.56,778.4526000000001,425.11500000000075,793.4526000000001],"horizontal":true}]
[["tokens",6],{"text":"and 6 months in the paravertebral group was limited by","inlineSymbol":false,"baseline":811.4526000000001,"height":15,"rect":[76.56,796.4526000000001,425.1675000000006,811.4526000000001],"horizontal":true}]
[["tokens",7],{"text":"the absence of pain evaluation during mobilization, and of","inlineSymbol":false,"baseline":829.4526000000001,"height":15,"rect":[76.56,814.4526000000001,425.10000000000093,829.4526000000001],"horizontal":true}]
[["tokens",8],{"text":"sensory blockade tests. Moreover, mastectomies were only","inlineSymbol":false,"baseline":847.4526000000001,"height":15,"rect":[76.56,832.4526000000001,425.0985000000007,847.4526000000001],"horizontal":true}]
[["tokens",9],{"text":"partial.","inlineSymbol":false,"baseline":865.4526000000001,"height":15,"rect":[76.56,850.4526000000001,117.61499999999998,865.4526000000001],"horizontal":true}]
[["tokens",10],{"text":"12","inlineSymbol":false,"baseline":860.4576,"height":8.745000000000001,"rect":[117.68925000000002,851.7126,126.30307500000002,860.4576],"horizontal":true}]
[["tokens",11],{"text":"The second study found that the incidence and","inlineSymbol":false,"baseline":865.4526000000001,"height":15,"rect":[130.35014999999999,850.4526000000001,425.1451500000005,865.4526000000001],"horizontal":true}]
[["tokens",12],{"text":"severity of persistent postoperative incisional breast pain","inlineSymbol":false,"baseline":883.4526000000001,"height":15,"rect":[76.56165,868.4526000000001,425.10015000000067,883.4526000000001],"horizontal":true}]
[["tokens",13],{"text":"at 6 and 12 months were unaffected by the analgesia tech-","inlineSymbol":false,"baseline":901.4526000000001,"height":15,"rect":[76.56165,886.4526000000001,425.1601500000009,901.4526000000001],"horizontal":true}]
[["tokens",14],{"text":"nique. However, pain was not the primary outcome, and","inlineSymbol":false,"baseline":919.4526000000001,"height":15,"rect":[76.56165,904.4526000000001,425.1271500000009,919.4526000000001],"horizontal":true}]
[["tokens",15],{"text":"the study had several limitations: no reduction in postop-","inlineSymbol":false,"baseline":937.4526000000001,"height":15,"rect":[76.56165,922.4526000000001,425.0866500000008,937.4526000000001],"horizontal":true}]
[["tokens",16],{"text":"erative morphine consumption in the paravertebral group,","inlineSymbol":false,"baseline":955.4526000000001,"height":15,"rect":[76.56165,940.4526000000001,426.60015000000067,955.4526000000001],"horizontal":true}]
[["tokens",17],{"text":"no sensory blockade tests, and no placebo group for the","inlineSymbol":false,"baseline":973.4526000000001,"height":15,"rect":[76.56165,958.4526000000001,425.1766500000007,973.4526000000001],"horizontal":true}]
[["tokens",18],{"text":"paravertebral block; thus, the study was not double-blind.","inlineSymbol":false,"baseline":991.4526000000001,"height":15,"rect":[76.56165,976.4526000000001,420.73665000000085,991.4526000000001],"horizontal":true}]
[["tokens",19],{"text":"2","inlineSymbol":false,"baseline":986.4576,"height":8.745000000000001,"rect":[420.8451,977.7126,425.13015,986.4576],"horizontal":true}]
[["tokens",20],{"text":"The overall incidence of chronic pain at 3 months in our","inlineSymbol":false,"baseline":1009.4526000000001,"height":15,"rect":[76.56000000000003,994.4526000000001,425.19000000000074,1009.4526000000001],"horizontal":true}]
[["tokens",21],{"text":"study (53% and 48% in the paravertebral block and con-","inlineSymbol":false,"baseline":1027.4526,"height":15,"rect":[76.56000000000003,1012.4526000000001,425.1585000000006,1027.4526],"horizontal":true}]
[["tokens",22],{"text":"trol groups, respectively) was similar to that in other pub-","inlineSymbol":false,"baseline":1045.4526,"height":15,"rect":[76.56000000000003,1030.4526,425.13000000000056,1045.4526],"horizontal":true}]
[["tokens",23],{"text":"lished studies (30 to 65%). The wide range of prevalence","inlineSymbol":false,"baseline":1063.4526,"height":15,"rect":[76.56000000000003,1048.4526,425.1420000000005,1063.4526],"horizontal":true}]
[["tokens",24],{"text":"of chronic pain reported in the literature is probably due","inlineSymbol":false,"baseline":1081.4526,"height":15,"rect":[76.56000000000003,1066.4526,425.13150000000064,1081.4526],"horizontal":true}]
[["tokens",25],{"text":"to several factors such as the definition and the pain score.","inlineSymbol":false,"baseline":1099.4526,"height":15,"rect":[76.56000000000003,1084.4526,426.6885000000008,1099.4526],"horizontal":true}]
[["tokens",26],{"text":"Different pain scores might provide different results. A","inlineSymbol":false,"baseline":793.4526000000001,"height":15,"rect":[452.13,778.4526000000001,800.7270000000003,793.4526000000001],"horizontal":true}]
[["tokens",27],{"text":"moderate or greater pain score (greater than or equal to 3)","inlineSymbol":false,"baseline":811.4526000000001,"height":15,"rect":[452.13,796.4526000000001,800.6700000000008,811.4526000000001],"horizontal":true}]
[["tokens",28],{"text":"is clinically relevant after breast surgery. Less than 3 would","inlineSymbol":false,"baseline":829.4526000000001,"height":15,"rect":[452.13,814.4526000000001,800.6535000000003,829.4526000000001],"horizontal":true}]
[["tokens",29],{"text":"be considered mild.","inlineSymbol":false,"baseline":847.4526000000001,"height":15,"rect":[452.13,832.4526000000001,569.9700000000003,847.4526000000001],"horizontal":true}]
[["tokens",30],{"text":"Our study also showed the absence of a statistically signif-","inlineSymbol":false,"baseline":865.4526000000001,"height":15,"rect":[470.13,850.4526000000001,800.6984999999986,865.4526000000001],"horizontal":true}]
[["tokens",31],{"text":"icant reduction in the incidence of chronic and neuropathic","inlineSymbol":false,"baseline":883.4526000000001,"height":15,"rect":[452.13,868.4526000000001,800.6999999999991,883.4526000000001],"horizontal":true}]
[["tokens",32],{"text":"pain at 3, 6, and 12 months, despite better control of acute","inlineSymbol":false,"baseline":901.4526000000001,"height":15,"rect":[452.13,886.4526000000001,800.7014999999988,901.4526000000001],"horizontal":true}]
[["tokens",33],{"text":"pain, which could have been due to the short-term benefit of","inlineSymbol":false,"baseline":919.4526000000001,"height":15,"rect":[452.13,904.4526000000001,800.7599999999989,919.4526000000001],"horizontal":true}]
[["tokens",34],{"text":"postoperative pain relief in the paravertebral group.","inlineSymbol":false,"baseline":937.4526000000001,"height":15,"rect":[452.13,922.4526000000001,744.449999999999,937.4526000000001],"horizontal":true}]
[["tokens",35],{"text":"Although","inlineSymbol":false,"baseline":937.4526000000001,"height":15,"rect":[745.3334999999985,922.4526000000001,800.7134999999982,937.4526000000001],"horizontal":true}]
