[["page"],{"pageNumber":1,"width":585,"height":783,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"constructPath":66},"lines":[{"text":"Oncology Nursing Forum • Vol. 39, No. 6, November 2012 575","fontSize":9,"x":51,"y":743.9998,"width":495.10800000000006,"height":9},{"text":"physical functioning. Those results are supported","fontSize":10,"x":51,"y":27.659200000000055,"width":238.31999999999942,"height":10},{"text":"by Gupta, Grutsch, and Lis (2008), who reported a","fontSize":10,"x":51,"y":40.34910000000002,"width":238.41999999999996,"height":10},{"text":"strong association between dyspnea and QOL among","fontSize":10,"x":51,"y":53.03909999999996,"width":238.53000000000037,"height":10},{"text":"a sample of 954 patients with cancer, of whom the most","fontSize":10,"x":51,"y":65.72910000000002,"width":238.6099999999999,"height":10},{"text":"common site was breast. Additional support for that","fontSize":10,"x":51,"y":78.41909999999996,"width":238.40000000000066,"height":10},{"text":"positive impact on breathing was found among a small","fontSize":10,"x":51,"y":91.10910000000001,"width":238.71999999999957,"height":10},{"text":"convenience sample of patients with cancer receiving","fontSize":10,"x":51,"y":103.79909999999995,"width":238.57000000000045,"height":10},{"text":"palliative care (Hodgson, 2000). Another possibility","fontSize":10,"x":51,"y":116.48910000000001,"width":238.37999999999988,"height":10},{"text":"is that when women are less short of breath, they are","fontSize":10,"x":51,"y":129.17909999999995,"width":238.5599999999995,"height":10},{"text":"more willing and able to be active. In future work,","fontSize":10,"x":51,"y":141.8691,"width":238.42000000000024,"height":10},{"text":"metastatic locations should be assessed to determine","fontSize":10,"x":51,"y":154.55909999999994,"width":238.5999999999998,"height":10},{"text":"why dyspnea was the symptom most associated with","fontSize":10,"x":51,"y":167.2491,"width":238.52000000000044,"height":10},{"text":"physical functioning and how to better design targeted","fontSize":10,"x":51,"y":179.93910000000005,"width":238.70000000000016,"height":10},{"text":"interventions. In a systematic review of evidence-based","fontSize":10,"x":51,"y":192.62919999999997,"width":238.41999999999956,"height":10},{"text":"approaches to symptom management in advanced-","fontSize":10,"x":51,"y":205.31920000000002,"width":238.44000000000017,"height":10},{"text":"stage cancer, only opioids and nonpharmacologic","fontSize":10,"x":51,"y":218.00919999999996,"width":238.3300000000002,"height":10},{"text":"treatments (e.g., use of a fan) were included for dysp-","fontSize":10,"x":51,"y":230.69920000000002,"width":238.5501,"height":10},{"text":"nea (Dy & Apostol, 2010). In a breast cancer–specific","fontSize":10,"x":51,"y":243.38919999999996,"width":238.32000000000016,"height":10},{"text":"review of reflexology, Kim et al. (2010) concluded that","fontSize":10,"x":51,"y":256.0792,"width":238.53000000000043,"height":10},{"text":"existing evidence does not show reflexology to be ef-","fontSize":10,"x":51,"y":268.76919999999996,"width":238.5501,"height":10.000000000000057},{"text":"fective in breast cancer care. Reflexology may now be","fontSize":10,"x":51,"y":281.4591,"width":238.5600000000004,"height":10},{"text":"suggested as a supportive care intervention for women","fontSize":10,"x":51,"y":294.1491,"width":238.69999999999948,"height":10},{"text":"with advanced-stage breast cancer, particularly when","fontSize":10,"x":51,"y":306.8391,"width":238.5700000000005,"height":10},{"text":"dyspnea is a symptom of concern.","fontSize":10,"x":51,"y":319.5291,"width":151.9300000000001,"height":10},{"text":"Fatigue","fontSize":11,"x":51,"y":339.5291,"width":36.81700000000002,"height":11},{"text":"This study is the first to demonstrate significant im-","fontSize":10,"x":60,"y":357.2191,"width":229.5501,"height":10},{"text":"provement in fatigue using LFM; however, in contrast","fontSize":10,"x":51,"y":369.9091,"width":238.68999999999994,"height":10},{"text":"to the reflexology group, no improvement in physical","fontSize":10,"x":51,"y":382.5992,"width":238.7299999999999,"height":10},{"text":"functioning occurred in the LFM group versus control","fontSize":10,"x":51,"y":395.2892,"width":238.7199999999999,"height":10},{"text":"group. As argued by Cleeland (2007), improvements","fontSize":10,"x":51,"y":407.9792,"width":238.5300000000001,"height":10},{"text":"in symptoms are noteworthy even in the absence of","fontSize":10,"x":51,"y":420.6692,"width":238.6099999999998,"height":10},{"text":"improved physical functioning. LFM providers may","fontSize":10,"x":51,"y":433.3592,"width":238.49000000000012,"height":10},{"text":"have been close enough to some reflexes to have an","fontSize":10,"x":51,"y":446.0492,"width":238.31999999999988,"height":10},{"text":"adequate impact, and that proximity to the exact loca-","fontSize":10,"x":51,"y":458.7391,"width":238.5501,"height":10},{"text":"tion may have been adequate. That premise suggests","fontSize":10,"x":51,"y":471.4291,"width":238.53999999999985,"height":10},{"text":"that LFM modality may be a valuable addition to","fontSize":10,"x":51,"y":484.1191,"width":238.65999999999974,"height":10},{"text":"supportive care for patients with cancer.","fontSize":10,"x":51,"y":496.8091,"width":181.36999999999983,"height":10},{"text":"Those findings support the therapeutic effects","fontSize":10,"x":60,"y":509.4991,"width":229.62999999999954,"height":10},{"text":"of reflexology, as well as the usefulness of LFM.","fontSize":10,"x":51,"y":522.1891,"width":238.4200000000002,"height":10},{"text":"Stephenson et al. (2007) reported the benefits of pro-","fontSize":10,"x":51,"y":534.8792,"width":238.5501,"height":10},{"text":"viding reflexology via lay friend or family members","fontSize":10,"x":51,"y":547.5692,"width":238.43999999999994,"height":10},{"text":"of 86 hospitalized patients with metastatic cancer and","fontSize":10,"x":51,"y":560.2592,"width":238.64999999999952,"height":10},{"text":"found an immediate decrease in pain intensity and","fontSize":10,"x":51,"y":572.9492,"width":238.63,"height":10},{"text":"anxiety as a result of LFM. Wyatt, Sikorskii, Siddiqi,","fontSize":10,"x":51,"y":585.6392,"width":238.74000000000012,"height":10},{"text":"and Given (2007) also successfully involved lay family","fontSize":10,"x":51,"y":598.3292,"width":238.7499999999996,"height":10},{"text":"members in a feasibility study of reflexology among a","fontSize":10,"x":51,"y":611.0192,"width":238.30000000000013,"height":10},{"text":"sample of 100 patients with solid tumors undergoing","fontSize":10,"x":51,"y":623.7092,"width":238.56999999999994,"height":10},{"text":"chemotherapy. The total time needed to train a fam-","fontSize":10,"x":51,"y":636.3992000000001,"width":238.5501,"height":10},{"text":"ily member in the protocol was about three hours,","fontSize":10,"x":51,"y":649.0892,"width":238.60000000000008,"height":10},{"text":"including two hours for initial training plus a one-","fontSize":10,"x":51,"y":661.7792,"width":238.62999999999982,"height":10},{"text":"hour booster session. Future research could employ a","fontSize":10,"x":51,"y":674.4692,"width":238.56999999999977,"height":10},{"text":"reflexologist to teach a lay family member to deliver","fontSize":10,"x":51,"y":687.1592,"width":238.60999999999962,"height":10},{"text":"the foot sessions at home and measure outcomes over","fontSize":10,"x":51,"y":699.8491,"width":238.71999999999952,"height":10},{"text":"time. That would make reflexology more available to","fontSize":10,"x":51,"y":712.5391,"width":238.52999999999986,"height":10},{"text":"patients and provide a way for family members to","fontSize":10,"x":307.55,"y":573.3591,"width":238.34999999999962,"height":10},{"text":"participate in supportive care with this therapeutic","fontSize":10,"x":307.55,"y":586.0491,"width":238.6499999999998,"height":10},{"text":"skill. No adverse events related to reflexology or LFM","fontSize":10,"x":307.55,"y":598.7392,"width":238.42999999999978,"height":10},{"text":"were found; therefore, patients could have access to a","fontSize":10,"x":307.55,"y":611.4291000000001,"width":238.35999999999916,"height":10},{"text":"session from lay friends or family members whenever","fontSize":10,"x":307.55,"y":624.1191,"width":238.32000000000056,"height":10},{"text":"they experience symptoms or lowered functioning.","fontSize":10,"x":307.55,"y":636.8091,"width":229.9500000000009,"height":10},{"text":"Pain and Nausea","fontSize":11,"x":307.55,"y":656.8091,"width":86.09700000000021,"height":11},{"text":"In contrast to other studies, significant effects were","fontSize":10,"x":316.55,"y":674.7491,"width":229.52000000000083,"height":10},{"text":"not found for pain. Reasons for those differences may","fontSize":10,"x":307.55,"y":687.4391,"width":238.4999999999995,"height":10},{"text":"be that Tsay (2008) investigated pain in a different","fontSize":10,"x":307.55,"y":700.1291,"width":238.36999999999995,"height":10},{"text":"population (i.e., postoperative patients with gastric","fontSize":10,"x":307.55,"y":712.8190999999999,"width":238.3600000000012,"height":10.000000000000114},{"text":"a","fontSize":4.9555,"x":313.55,"y":413.572,"width":2.3835955000000126,"height":4.955499999999972},{"text":"Average difference over time (week 5 and week 11) between","fontSize":8.5,"x":317.4835,"y":412.858,"width":222.70850000000024,"height":8.5},{"text":"reflexology and control was significant (p = 0.04).","fontSize":8.5,"x":313.55,"y":422.858,"width":177.63299999999998,"height":8.5},{"text":"b","fontSize":4.9555,"x":313.55,"y":435.572,"width":2.7205695000000105,"height":4.955499999999972},{"text":"Average difference over time (week 5 and week 11) between","fontSize":8.5,"x":317.6271,"y":434.858,"width":217.8295000000001,"height":8.5},{"text":"lay foot manipulation and control was significant (p < 0.01).","fontSize":8.5,"x":313.55,"y":444.858,"width":214.79500000000013,"height":8.5},{"text":"c","fontSize":4.9555,"x":313.55,"y":457.572,"width":2.294396500000005,"height":4.955499999999972},{"text":"Average difference over time (week 5 and week 11) between","fontSize":8.5,"x":317.4929,"y":456.858,"width":222.6575000000003,"height":8.5},{"text":"reflexology and control was significant (p < 0.01).","fontSize":8.5,"x":313.55,"y":466.858,"width":173.3830000000009,"height":8.5},{"text":"d","fontSize":4.9555,"x":313.55,"y":479.572,"width":2.7750800000000027,"height":4.955499999999972},{"text":"Average difference over time (week 5 and week 11) between","fontSize":8.5,"x":317.8674,"y":478.858,"width":222.26650000000097,"height":8.5},{"text":"reflexology and lay foot manipulation was significant (p = 0.02).","fontSize":8.5,"x":313.55,"y":488.858,"width":223.09100000000086,"height":8.5},{"text":"Note. Higher scores reflect better physical function, higher fatigue","fontSize":8.5,"x":313.55,"y":500.858,"width":225.9975999999986,"height":8.5},{"text":"severity, and lower dyspnea severity.","fontSize":8.5,"x":313.55,"y":510.858,"width":124.60149999999913,"height":8.499999999999943},{"text":"Figure 1. Source panels and native labels.","fontSize":10,"x":313.55,"y":529.358,"width":209.8500000000002,"height":10},{"text":"Additional description of the source panels and measured groups.","fontSize":10,"x":313.55,"y":541.358,"width":196.96000000000026,"height":10},{"text":"Physical Function","fontSize":8.5,"x":311.508,"y":46.57870000000014,"width":8.5,"height":64.93149999999991},{"text":"60","fontSize":8.5,"x":325.05,"y":33.95799999999997,"width":9.333000000000027,"height":8.5},{"text":"58","fontSize":8.5,"x":325.05,"y":49.95799999999997,"width":9.333000000000027,"height":8.5},{"text":"56","fontSize":8.5,"x":325.05,"y":65.95799999999997,"width":9.333000000000027,"height":8.5},{"text":"54","fontSize":8.5,"x":325.05,"y":81.95799999999997,"width":9.333000000000027,"height":8.5},{"text":"52","fontSize":8.5,"x":325.05,"y":97.95799999999997,