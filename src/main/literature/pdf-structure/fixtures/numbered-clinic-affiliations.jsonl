[["items",26],{"text":"The two main outcomes were quality of life and sleep quality, and both were evaluated by standardized question-","inlineSymbol":false,"baseline":463.8376047375,"height":15,"rect":[137.660547135,448.8376047375,816.289047135001,463.8376047375],"horizontal":true}]
[["items",27],{"text":"naires (EORTC-QLQ 30 BR 23 and PSQI). Participants (","inlineSymbol":false,"baseline":482.5876047375,"height":15,"rect":[76.53554999999999,467.5876047375,425.1955500000003,482.5876047375],"horizontal":true}]
[["items",28],{"text":"n","inlineSymbol":false,"baseline":482.5876047375,"height":15,"rect":[425.2705500000003,467.5876047375,432.7705500000003,482.5876047375],"horizontal":true}]
