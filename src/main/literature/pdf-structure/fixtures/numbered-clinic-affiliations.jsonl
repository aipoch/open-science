[["items",18],{"text":"Abstract","inlineSymbol":false,"baseline":351.3376047375,"height":15,"rect":[76.53555,336.3376047375,133.65705000573004,351.3376047375],"horizontal":true}]
[["items",19],{"text":"Introduction","inlineSymbol":false,"baseline":370.0876047375,"height":15,"rect":[76.53555,355.0876047375,153.10754999427004,370.0876047375],"horizontal":true}]
[["items",20],{"text":"There is growing evidence of the benefit of physical activity and mindfulness in breast cancer patients (HC","inlineSymbol":false,"baseline":370.0876047375,"height":15,"rect":[160.80554999999998,355.0876047375,816.6940500057294,370.0876047375],"horizontal":true}]
[["items",21],{"text":"et al. in BMC Complement Altern Med, 2017). Yoga offers a combination of both. The aim of this study was to establish an","inlineSymbol":false,"baseline":388.8376047375,"height":15,"rect":[76.53554999999999,373.8376047375,816.1930500057581,388.8376047375],"horizontal":true}]
[["items",22],{"text":"online yoga program for breast cancer patients and survivors. As the project was launched during the (COVID) pandemic","inlineSymbol":false,"baseline":407.5876047375,"height":15,"rect":[76.53554999999999,392.5876047375,816.377550000001,407.5876047375],"horizontal":true}]
[["items",23],{"text":"restrictions, we intended to prove effective online yoga as a way to access supportive therapy independently of sanitary issues","inlineSymbol":false,"baseline":426.3376047375,"height":15,"rect":[76.53554999999999,411.3376047375,816.1000501001416,426.3376047375],"horizontal":true}]
[["items",24],{"text":"and geographic locations in rural regions.","inlineSymbol":false,"baseline":445.0876047375,"height":15,"rect":[76.53554999999999,430.0876047375,327.9850500000004,445.0876047375],"horizontal":true}]
