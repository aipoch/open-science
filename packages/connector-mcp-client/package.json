{
  "name": "@aipoch/connector-mcp-client",
  "version": "0.1.0",
  "description": "Independent MCP connection and OAuth lifecycle",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oauth-redirect": {
      "types": "./dist/oauth-redirect.d.ts",
      "default": "./dist/oauth-redirect.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tsc.cjs -p tsconfig.json",
    "typecheck": "node tsc.cjs -p tsconfig.json --noEmit && node tsc.cjs -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "peerDependencies": {
    "@aipoch/connector-core": "^0.1.0"
  }
}
