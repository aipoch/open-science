{
  "source": "AIPOCH design system v3.1 — https://aipoch-design-system.vercel.app/ . Colours are the design system's own values. Type roles map the design system's scale to video (a 1080p frame is read from further away than a web page, so sizes are about 1.6–2× the web px). Entries under 'videoExtensions' are not in the design system; they exist because videos draw things (data lines, air, machines) that interfaces don't.",
  "color": {
    "canvas": "#F7F7F5",
    "surface": "#FFFFFF",
    "surfaceSubtle": "#F6F6F4",
    "ink": "#111111",
    "text2": "#61615C",
    "muted": "#6B6B66",
    "border": "#E7E5DE",
    "action": "#000000",
    "gold": "#EDB732",
    "goldSoft": "#FBDD67",
    "good": "#147047",
    "warn": "#F06E14",
    "bad": "#B42318",
    "info": "#759EB8",
    "accentText": "#915600",
    "accentSoft": "#FFF1D6",
    "badgeBorder": "#D8D5CC",
    "paper": "#FFFFFF"
  },
  "videoExtensions": {
    "blue": "#1F5FBF",
    "sky": "#BFDDF0",
    "steel": "#5C6670",
    "track": "#F1F0EC",
    "line": "#C9C6BC"
  },
  "colorRoles": {
    "ink": "structure, subjects, primary text",
    "text2 / muted": "supporting text, labels",
    "gold": "the ONE thing to look at (brand highlight)",
    "goldSoft / accentText / accentSoft": "softer highlight, badges",
    "good / bad": "pass and fail only",
    "warn": "attention, limits being approached",
    "info": "informational marks",
    "blue": "data lines and measured series (video extension)",
    "sky": "air, gas, water, exhaust (video extension)",
    "steel": "machinery and hardware parts (video extension)",
    "track / line / border": "empty bar tracks, rulers, ground lines, dividers"
  },
