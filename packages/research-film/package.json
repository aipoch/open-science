{
  "name": "@aipoch/research-film",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Narrated research films with standalone playback and optional video export",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "resources",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./export": {
      "types": "./dist/export-mp4.d.ts",
      "default": "./dist/export-mp4.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "default": "./dist/resources.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:assets",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build",
    "build:assets": "esbuild browser/playback-clock.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=dist/browser/playback-clock.txt",
    "pretest": "npm run build:assets"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "zod": "^4.6.6",
    "papaparse": "^5.7.0",
    "fflate": "0.8.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.19.1",
    "@types/papaparse": "^5.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "jsdom": "^29.1.1",
    "esbuild": "0.25.12"
  }
}
