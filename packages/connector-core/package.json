{
  "name": "@aipoch/connector-core",
  "version": "0.1.0",
  "description": "Independent Connector execution and schema validation",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./url-admission": {
      "types": "./dist/url-admission.d.ts",
      "default": "./dist/url-admission.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tsc.cjs -p tsconfig.json",
    "typecheck": "node tsc.cjs -p tsconfig.json --noEmit && node tsc.cjs -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
