{
  "name": "@aipoch/test-impact",
  "version": "0.1.0",
  "private": true,
  "description": "Diagnostic static dependency evidence from immutable Git revisions",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "test-impact": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tsc.cjs -p tsconfig.json",
    "typecheck": "node tsc.cjs -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dependency-cruiser": "18.6.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "vitest": "^4.1.11"
  }
}
