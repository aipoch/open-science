{
  "name": "@aipoch/resilient-download",
  "version": "0.1.0",
  "description": "Verified HTTP downloads with guarded range resume, retry and progress",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tsc.cjs -p tsconfig.json",
    "typecheck": "node tsc.cjs -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
