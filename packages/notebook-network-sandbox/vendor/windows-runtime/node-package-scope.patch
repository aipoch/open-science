+#ifdef _WIN32
+// An AppContainer can read a granted descendant without access to its ancestors.
+// The native host grants ancestor directories only FILE_TRAVERSE,
+// FILE_READ_ATTRIBUTES and SYNCHRONIZE. Request FILE_LIST_DIRECTORY to
+// distinguish those traversal-only ancestors from readable directories.
+// Only terminate package-scope searches at such a boundary: direct package
+// reads and unreadable package.json files inside readable directories must
+// still fail.
+static bool IsAppContainerPackageScopeBoundary(std::string_view package_path) {
+  static const bool is_app_container = []() {
+    HANDLE token;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return false;
+    DWORD value = 0;
+    DWORD length = sizeof(value);
+    const BOOL success = GetTokenInformation(
+        token, TokenIsAppContainer, &value, length, &length);
+    CloseHandle(token);
+    return success && value != 0;
+  }();
+  if (!is_app_container) return false;
+
+  const auto directory = std::filesystem::u8path(package_path).parent_path();
+  HANDLE handle = CreateFileW(directory.c_str(),
+                              FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                              nullptr,
+                              OPEN_EXISTING,
+                              FILE_FLAG_BACKUP_SEMANTICS,
+                              nullptr);
+  if (handle == INVALID_HANDLE_VALUE) {
+    return GetLastError() == ERROR_ACCESS_DENIED;
+  }
+  CloseHandle(handle);
+  return false;
+}
+#endif
 
