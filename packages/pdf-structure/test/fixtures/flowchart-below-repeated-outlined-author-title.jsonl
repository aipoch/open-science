[["pages",0],{"pageNumber":1,"width":609.449,"height":807.874,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":1,"constructPath":9},"captionStarts":[],"headingCandidates":[{"text":"Abstract","fontSize":10,"x":42.5196,"y":310.161,"width":37.21000000000001,"height":10}],"lines":[{"text":"J Musculoskelet Neuronal Interact 2012; 12(3):127-135","fontSize":9,"x":42.5196,"y":40.26970000000006,"width":200.71799999999996,"height":9},{"text":"Original Article","fontSize":10,"x":42.51959999999999,"y":72.12650000000008,"width":67.50299999999999,"height":10},{"text":"Hylonome","fontSize":7,"x":520.9832,"y":75.45429999999999,"width":29.553999999999974,"height":7}],"graphicsBounds":[{"operationIndex":162,"kind":"path","normalizedRect":[0.06640625,0.05078125,0.44140625,0.0703125]},{"operationIndex":328,"kind":"image","normalizedRect":[0.84765625,0.05078125,0.91015625,0.09375]},{"operationIndex":336,"kind":"path","normalizedRect":[0.84765625,0.08984375,0.9140625,0.09765625]}],"invalidGraphicsBounds":0}]
[["pages",1],{"pageNumber":2,"width":609.449,"height":807.874,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":1,"constructPath":6},"captionStarts":[{"text":"Figure 1. The trial flow diagram.","fontSize":9,"x":56.6929,"y":315.552,"width":119.91059999999999,"height":9}],"headingCandidates":[],"lines":[{"text":"A. Authors et al.: Exercise trial","fontSize":9,"x":56.6929,"y":40.79899999999998,"width":164.19599999999997,"height":9},{"text":"128","fontSize":8,"x":57.6929,"y":762.7183,"width":12.000000000000007,"height":8},{"text":"(pQCT) permits this with a marginal X-ray dose","fontSize":10,"x":56.6929,"y":365.7332,"width":190.00099999999998,"height":10},{"text":"13","fontSize":6,"x":246.6609,"y":365.7332,"width":5.996399999999994,"height":6},{"text":". So far, spe-","fontSize":10,"x":252.6534,"y":365.7332,"width":49.23900000000023,"height":10},{"text":"cific effects of exercise on bone structure have not been re-","fontSize":10,"x":56.69239999999999,"y":378.0562,"width":245.2049999999995,"height":10},{"text":"ported among breast cancer survivors.","fontSize":10,"x":56.69239999999999,"y":390.37919999999997,"width":152.45999999999995,"height":10},{"text":"The present study represents a substudy of a large multicen-","fontSize":10,"x":67.26539999999999,"y":402.70219999999995,"width":234.62899999999985,"height":10},{"text":"ter exercise trial of breast cancer survivors","fontSize":10,"x":56.692399999999985,"y":415.0251999999999,"width":173.72799999999998,"height":10},{"text":"10","fontSize":6,"x":230.4106,"y":415.02340000000004,"width":6.0005999999999915,"height":6},{"text":"and was under-","fontSize":10,"x":239.537,"y":415.02340000000004,"width":62.155999999999864,"height":10},{"text":"taken to assess the effects of a 12-month vigorous aerobic","fontSize":10,"x":56.692999999999984,"y":427.3464,"width":245.21599999999978,"height":10},{"text":"exercise regimen on bone structural traits in pre- and post-","fontSize":10,"x":56.692999999999984,"y":439.6694,"width":245.2199999999998,"height":10},{"text":"menopausal breast cancer patients after adjuvant treatments.","fontSize":10,"x":56.692999999999984,"y":451.9924,"width":245.20899999999972,"height":10},{"text":"The apparent osteogenicity of this exercise regimen was eval-","fontSize":10,"x":56.692999999999984,"y":464.31539999999995,"width":245.2319999999999,"height":10},{"text":"uated in a pilot study","fontSize":10,"x":56.692999999999984,"y":476.63839999999993,"width":84.48599999999999,"height":10},{"text":"14","fontSize":6,"x":141.1656,"y":476.6361,"width":6,"height":6},{"text":". We hypothesized that participation in","fontSize":10,"x":147.1656,"y":476.63620000000003,"width":154.75300000000007,"height":10},{"text":"regular vigorous exercise would result in better maintained","fontSize":10,"x":56.69260000000001,"y":488.95820000000003,"width":245.21399999999932,"height":10},{"text":"bone strength and physical performance of breast cancer sur-","fontSize":10,"x":56.69260000000001,"y":501.28020000000004,"width":245.0299999999997,"height":10},{"text":"vivors, as well as facilitate their weight management. The pri-","fontSize":10,"x":56.69260000000001,"y":513.6022,"width":245.23399999999998,"height":10},{"text":"mary outcomes of the present study were bone structural traits","fontSize":10,"x":56.69260000000001,"y":525.9242,"width":245.2250000000003,"height":10},{"text":"of the weight-bearing tibia and femoral neck assessed with","fontSize":10,"x":56.69260000000001,"y":538.2462,"width":245.22599999999983,"height":10},{"text":"pQCT and DXA-based structural analysis, respectively,","fontSize":10,"x":56.69260000000001,"y":550.5682,"width":245.209,"height":10},{"text":"whereas the secondary outcomes included different traits phys-","fontSize":10,"x":56.69260000000001,"y":562.8902,"width":245.2110000000003,"height":10},{"text":"ical performance and body composition.","fontSize":10,"x":56.69260000000001,"y":575.2122,"width":161.36,"height":10},{"text":"Materials and Methods","fontSize":12,"x":56.6929,"y":599.7950000000001,"width":119.32799999999997,"height":12},{"text":"Study design","fontSize":10,"x":56.6929,"y":619.2696000000001,"width":50.82999999999999,"height":10},{"text":"The present study is a 12-month prospective randomized","fontSize":10,"x":67.2659,"y":637.2616,"width":234.6429999999997,"height":10},{"text":"controlled, examiner-blinded exercise trial of breast cancer pa-","fontSize":10,"x":56.6929,"y":649.5846,"width":245.24100000000004,"height":10},{"text":"tients that represents a substudy of a multicenter BREX study","fontSize":10,"x":56.6929,"y":661.9076,"width":245.22699999999986,"height":10},{"text":"(NCT00639210). While the multicenter study was carried out","fontSize":10,"x":56.6929,"y":674.2306000000001,"width":245.223,"height":10},{"text":"in Helsinki, Tampere and Turku University Hospitals","fontSize":10,"x":56.6929,"y":686.5536000000001,"width":214.16899999999993,"height":10},{"text":"10,15","fontSize":6,"x":270.8434,"y":686.5516,"width":13.5,"height":6},{"text":", the","fontSize":10,"x":284.3434,"y":686.5516,"width":17.549999999999955,"height":10},{"text":"present study with a larger set of measurements (including","fontSize":10,"x":56.69339999999997,"y":698.8746,"width":245.22199999999967,"height":10},{"text":"pQCT and dynamic muscle force assessment) than in the par-","fontSize":10,"x":56.69339999999997,"y":711.1976,"width":245.02299999999977,"height":10},{"text":"ent trial, was carried out in Tampere only. All measurements","fontSize":10,"x":56.69339999999997,"y":723.5206000000001,"width":245.23199999999989,"height":10},{"text":"were done at baseline before randomization and after the 12-","fontSize":10,"x":56.69339999999997,"y":735.8436,"width":245.22999999999982,"height":10},{"text":"month intervention. Further, the examiners were kept blinded","fontSize":10,"x":321.7324,"y":365.73460000000006,"width":245.22900000000004,"height":10},{"text":"to the group allocation. The ethical committee of Helsinki Uni-","fontSize":10,"x":321.7324,"y":378.00860000000006,"width":245.22399999999982,"height":10},{"text":"versity Hospital approved the study protocol and the partici-","fontSize":10,"x":321.7324,"y":390.28260000000006,"width":245.02799999999968,"height":10},{"text":"pants gave signed informed consent.","fontSize":10,"x":321.7324,"y":402.55660000000006,"width":145.80999999999995,"height":10},{"text":"Participants","fontSize":10,"x":321.7324,"y":423.3346000000001,"width":49.44999999999999,"height":10},{"text":"Eighty-six patients aged from 38 to 66 years could be re-","fontSize":10,"x":332.30539999999996,"y":441.27760000000006,"width":234.63400000000024,"height":10},{"text":"cruited from the Department of Oncology in Tampere Univer-","fontSize":10,"x":321.7324,"y":453.55160000000006,"width":245.0319999999998,"height":10},{"text":"sity Hospital during a two-year period. The flowchart is","fontSize":10,"x":321.7324,"y":465.82560000000007,"width":245.2160000000007,"height":10},{"text":"presented in Figure 1. All patients were operated with total","fontSize":10,"x":321.7324,"y":478.09960000000007,"width":245.1979999999993,"height":10},{"text":"mastectomy or breast conserving resection with sentinel lym-","fontSize":10,"x":321.7324,"y":490.37360000000007,"width":245.23299999999972,"height":10},{"text":"phnode biopsy, or axillary evacuation. Adjuvant treatment was","fontSize":10,"x":321.7324,"y":502.64760000000007,"width":245.1970000000009,"height":9.999999999999943},{"text":"given according to clinical guidelines either with chemother-","fontSize":10,"x":321.7324,"y":514.9216000000001,"width":245.04699999999968,"height":10},{"text":"apy or endocrine therapy or both. Post-operative radiotherapy","fontSize":10,"x":321.7324,"y":527.1956,"width":245.22400000000005,"height":10},{"text":"was given after the breast conserving operation and to regional","fontSize":10,"x":321.7324,"y":539.4696000000001,"width":245.1989999999987,"height":10},{"text":"lymphnodes in node positive patients. The group characteris-","fontSize":10,"x":321.7324,"y":551.7436,"width":245.0319999999998,"height":10},{"text":"tics are given in Table 1.","fontSize":10,"x":321.7324,"y":564.0176000000001,"width":97.99599999999998,"height":10},{"text":"Inclusion criteria were histologically proven invasive breast","fontSize":10,"x":332.30539999999996,"y":576.2916,"width":234.6659999999997,"height":10},{"text":"cancer, pre- or postmenopausal breast cancer patient treated","fontSize":10,"x":321.7324,"y":588.5656000000001,"width":245.2119999999992,"height":10},{"text":"with adjuvant chemotherapy or radiotherapy within four","fontSize":10,"x":321.7324,"y":600.8396,"width":245.22400000000096,"height":10},{"text":"months or started adjuvant endocrine therapy no later than 4","fontSize":10,"x":321.7324,"y":613.1136000000001,"width":245.22699999999998,"height":10},{"text":"months earlier, and age between 35 and 68 years (the trial was","fontSize":10,"x":321.7324,"y":625.3876,"width":245.22199999999987,"height":10},{"text":"primarily designed for women at their working age). Because","fontSize":10,"x":321.7324,"y":637.6616000000001,"width":245.2199999999999,"height":10},{"text":"of ethical reasons, patients were not recruited immediately","fontSize":10,"x":321.7324,"y":649.9356,"width":245.23300000000074,"height":10},{"text":"after getting their cancer diagnosis and primary treatment. The","fontSize":10,"x":321.7324,"y":662.2096000000001,"width":245.2080000000002,"height":10},{"text":"4 month time frame was set for consistency between partici-","fontSize":10,"x":321.7324,"y":674.4836,"width":245.03200000000004,"height":10},{"text":"pants and to avoid considerable variation in their spontaneous","fontSize":10,"x":321.7324,"y":686.7576000000001,"width":245.2299999999999,"height":10},{"text":"recovery before the intervention. Because the oldest breast","fontSize":10,"x":321.7324,"y":699.0316,"width":245.227000000001,"height":10},{"text":"cancer patients were excluded, the exercise classes could be","fontSize":10,"x":321.7324,"y":711.3056000000001,"width":245.2010000000006,"height":10},{"text":"designed vigorous enough to be potentially osteogenic but not","fontSize":10,"x":321.7324,"y":723.5796,"width":245.216,"height":10},{"text":"too demanding and thus feasible for all participants.","fontSize":10,"x":321.7324,"y":735.8536000000001,"width":207.7499999999999,"height":10},{"text":"Figure 1. The trial flow diagram.","fontSize":9,"x":56.6929,"y":315.552,"width":119.91059999999999,"height":9}],"graphicsBounds":[{"operationIndex":7,"kind":"path","normalizedRect":[0.08984375,0.05078125,0.6484375,0.0703125]},{"operationIndex":18,"kind":"path","normalizedRect":[0.08984375,0.93359375,0.93359375,0.97265625]},{"operationIndex":273,"kind":"path","normalizedRect":[0.08984375,0.0859375,0.93359375,0.4609375]},{"operationIndex":274,"kind":"path","normalizedRect":[0.08984375,0.0859375,0.93359375,0.37890625]},{"operationIndex":278,"kind":"image","normalizedRect":[0.1875,0.0859375,0.8359375,0.37890625]}],"invalidGraphicsBounds":0}]
[["pages",2],{"pageNumber":3,"width":609.449,"height":807.874,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"constructPath":18},"captionStarts":[{"text":"Table 1. Group characteristics.","fontSize":9,"x":42.5196,"y":538.9156,"width":111.40199999999999,"height":9}],"headingCandidates":[],"lines":[{"text":"A. Authors et al.: Exercise trial","fontSize":9,"x":388.5849,"y":40.79899999999998,"width":164.19599999999997,"height":9},{"text":"Training Control","fontSize":9,"x":288.4511,"y":72.82600000000002,"width":134.65800000000007,"height":9}],"graphicsBounds":[{"operationIndex":7,"kind":"path","normalizedRect":[0.359375,0.05078125,0.91015625,0.0703125]},{"operationIndex":131,"kind":"path","normalizedRect":[0.06640625,0.0859375,0.91015625,0.734375]},{"operationIndex":140,"kind":"path","normalizedRect":[0.06640625,0.0859375,0.9140625,0.09375]}],"invalidGraphicsBounds":0}]
[["pages",3],{"pageNumber":4,"width":609.449,"height":807.874,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"constructPath":4},"captionStarts":[],"headingCandidates":[],"lines":[{"text":"A. Authors et al.: Exercise trial","fontSize":9,"x":56.6929,"y":40.79899999999998,"width":164.19599999999997,"height":9},{"text":"training was based either on step aerobics or circuit training. Ex-","fontSize":10,"x":56.6929,"y":67.9488,"width":245.0799999999998,"height":10},{"text":"ercise movements rested on impact training originally found ef-","fontSize":10,"x":56.6929,"y":80.0548,"width":245.25999999999993,"height":10},{"text":"Physical activity","fontSize":10,"x":321.73199999999997,"y":68.01620000000003,"width":66.38,"height":10}],"graphicsBounds":[{"operationIndex":7,"kind":"path","normalizedRect":[0.08984375,0.05078125,0.6484375,0.0703125]}],"invalidGraphicsBounds":0}]
