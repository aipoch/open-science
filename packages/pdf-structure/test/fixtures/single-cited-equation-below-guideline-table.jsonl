[["page"],{"width":595.276,"height":793.701,"pageNumber":1,"lines":[{"text":"ALND","fontSize":6.376,"x":158.2876976,"y":298.85981520000325,"width":17.109924000000007,"height":6.375999999999976},{"text":"ALND","fontSize":6.376,"x":206.5333616,"y":281.6803208000034,"width":17.109924000000007,"height":6.376000000000033},{"text":"deltoid muscles excluding the thoracodorsal artery and vein,","fontSize":7.9702,"x":42.5197,"y":651.6521,"width":251.08735162000005,"height":7.970199999999977},{"text":"which drain the back, and more caudally a horizontal line from","fontSize":7.9702,"x":42.5197,"y":662.08349776,"width":251.0677068999999,"height":7.970199999999977},{"text":"the ventral edge of the latissimus dorsi muscle to the intercostal","fontSize":7.9702,"x":42.5197,"y":672.57148394,"width":251.10126662999983,"height":7.970199999999977},{"text":"that is positioned cranial to the vein, preferably with 1 extra slice","fontSize":7.9702,"x":311.5275,"y":651.6521,"width":251.02514333999983,"height":7.970199999999977},{"text":"for partial volume effect. The dorsal limit extends to a 5 mm secu-","fontSize":7.9702,"x":311.5275,"y":662.0836,"width":251.06115866,"height":7.970199999999977},{"text":"rity margin dorsal to the axillary vein into the surrounding fatty","fontSize":7.9702,"x":311.5275,"y":672.57158618,"width":251.03578422999982,"height":7.970199999999977},{"text":"ALND = axillary lymph node dissection.","fontSize":6.376,"x":42.52289079999997,"y":613.1999999999997,"width":119.25348559999995,"height":6.37600000000009}]}]
