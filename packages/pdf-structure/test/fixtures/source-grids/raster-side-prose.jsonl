[["page"],{"pageNumber":3,"width":576,"height":774,"rotation":0,"renderRotation":0,"structureRoles":{"Root":1,"Figure":1},"graphicsOperators":{"paintImageXObject":1,"constructPath":1},"captionStarts":[{"text":"Figure 1. CONSORT diagram of study participants","fontSize":9.5,"x":303,"y":437.8096,"width":206.14999999999986,"height":9.5}],"headingCandidates":[],"lines":[{"text":"not participated up to that point were included in the study. All","fontSize":9,"x":48,"y":57,"width":237.00600000000009,"height":9},{"text":"women were sent reminder letters. These women were assigned","fontSize":9,"x":48,"y":67.99800000000005,"width":237.00600000000009,"height":9},{"text":"randomly to the intervention group or the control group. For","fontSize":9,"x":48,"y":78.9960000000001,"width":237.05100000000004,"height":9},{"text":"randomization, the mammography-organizing center transmitted","fontSize":9,"x":48,"y":89.99400000000014,"width":237.06900000000002,"height":9},{"text":"the name, fırst name, and residential address to a study assistant","fontSize":9,"x":48,"y":100.99200000000019,"width":237.04199999999997,"height":9},{"text":"who was responsible only for randomization and was not involved","fontSize":9,"x":48,"y":111.99000000000024,"width":237.0150000000001,"height":9},{"text":"in telephone counseling.","fontSize":9,"x":48,"y":122.98800000000028,"width":88.05600000000001,"height":9},{"text":"The data were provided in the form of a Microsoft Excel table,","fontSize":9,"x":57,"y":133.98600000000033,"width":228.06000000000006,"height":9},{"text":"which was submitted to a simple randomization procedure: every","fontSize":9,"x":48,"y":144.98400000000038,"width":237.0150000000001,"height":9},{"text":"second woman from the table was assigned to the intervention","fontSize":9,"x":48,"y":155.98200000000043,"width":237.0780000000001,"height":9},{"text":"group and the other women to the control group. The procedure","fontSize":9,"x":48,"y":166.98000000000047,"width":237.03300000000002,"height":9},{"text":"was automated by developing a software tool that can be integrated","fontSize":9,"x":48,"y":177.97800000000052,"width":237.06899999999996,"height":9},{"text":"into MS Excel. Next, all double entries and men from the two sets","fontSize":9,"x":48,"y":188.97600000000057,"width":237.0780000000001,"height":9},{"text":"were removed, resulting in 2455 women in the intervention group","fontSize":9,"x":48,"y":199.97400000000061,"width":237.05100000000004,"height":9},{"text":"and 2952 in the control group. The intervention group was sent","fontSize":9,"x":48,"y":210.97200000000066,"width":237.06000000000006,"height":9},{"text":"written reminders together with information about telephone","fontSize":9,"x":48,"y":221.9700000000007,"width":237.03300000000002,"height":9},{"text":"counseling. The control group was sent written reminders alone","fontSize":9,"x":48,"y":232.96800000000076,"width":237.04200000000003,"height":9},{"text":"(Figure 1).","fontSize":9,"x":48,"y":243.9660000000008,"width":37.971000000000004,"height":9},{"text":"Intervention","fontSize":11,"x":48,"y":267,"width":56.441,"height":11},{"text":"The present study used barrier-specifıc telephone counseling as a","fontSize":9,"x":48,"y":285,"width":237.0870000000001,"height":9},{"text":"common intervention because of the promise it had shown in","fontSize":9,"x":48,"y":295.998,"width":237.05100000000004,"height":9},{"text":"previous studies","fontSize":9,"x":48,"y":306.996,"width":59.597999999999985,"height":9},{"text":"21–30","fontSize":5.5,"x":107.6,"y":306.7499,"width":17.080000000000013,"height":5.5},{"text":"of mammography. In barrier-specifıc tele-","fontSize":9,"x":128.0325,"y":307.0028,"width":157.0230000000001,"height":9},{"text":"phone counseling, the counselor uses a standardized protocol,","fontSize":9,"x":47.995499999999964,"y":318.00079999999997,"width":237.03300000000004,"height":9},{"text":"identifıes the subject’s barriers to performing a health behavior,","fontSize":9,"x":47.995499999999964,"y":328.99879999999996,"width":237.08700000000002,"height":9},{"text":"and then provides information to address and overcome the barri-","fontSize":9,"x":47.995499999999964,"y":339.99679999999995,"width":237.04200000000017,"height":9},{"text":"ers. The theoretic framework includes the Health Belief Model,","fontSize":9,"x":47.995499999999964,"y":350.99479999999994,"width":230.35500000000005,"height":9},{"text":"33","fontSize":5.5,"x":278.3266,"y":350.75,"width":6.720000000000027,"height":5.5},{"text":"the Transtheoretical Model,","fontSize":9,"x":48,"y":362,"width":101.53799999999998,"height":9},{"text":"34,35","fontSize":5.5,"x":149.5394,"y":361.75,"width":15.036000000000001,"height":5.5},{"text":"and the Conflict Model of Deci-","fontSize":9,"x":167.2064,"y":362.0028,"width":117.89099999999999,"height":9},{"text":"sion Making.","fontSize":9,"x":48.00139999999999,"y":373.00079999999997,"width":47.897999999999996,"height":9},{"text":"36","fontSize":5.5,"x":95.8927,"y":372.75,"width":6.719999999999999,"height":5.5},{"text":"In the intervention group, a female staff member","fontSize":9,"x":105.2463,"y":373.0028,"width":179.83799999999997,"height":9},{"text":"who holds a university degree in social work and had 5 years of","fontSize":9,"x":47.99730000000001,"y":384.00079999999997,"width":236.99700000000007,"height":9},{"text":"experience in motivational counseling performed telephone coun-","fontSize":9,"x":47.99730000000001,"y":394.99879999999996,"width":237.05100000000004,"height":9},{"text":"seling following a scripted computer-based protocol.","fontSize":9,"x":47.99730000000001,"y":405.99679999999995,"width":189.61200000000014,"height":9},{"text":"The Transtheoretical Model developed by Prochaska and DiCle-","fontSize":9,"x":56.99730000000001,"y":416.99479999999994,"width":228.0870000000001,"height":9},{"text":"mente","fontSize":9,"x":47.99730000000001,"y":427.99279999999993,"width":22.689000000000007,"height":9},{"text":"34","fontSize":5.5,"x":70.6881,"y":427.75,"width":6.719999999999999,"height":5.5},{"text":"in the context of smoking cessation was adapted for mam-","fontSize":9,"x":79.0133,"y":428.0028,"width":206.01900000000018,"height":9},{"text":"mography by Rakowsky et al.","fontSize":9,"x":47.999300000000005,"y":439.00079999999997,"width":104.52600000000001,"height":9},{"text":"37,38","fontSize":5.5,"x":152.5152,"y":438.75,"width":15.036000000000001,"height":5.5},{"text":"According to the model, women","fontSize":9,"x":169.3498,"y":439.0028,"width":115.71300000000011,"height":9},{"text":"are at various stages (precontemplation, contemplation, prepara-","fontSize":9,"x":48.00279999999998,"y":450.00079999999997,"width":237.0780000000001,"height":9},{"text":"tion, action, or maintenance) of readiness for mammography.","fontSize":9,"x":48.00279999999998,"y":460.99879999999996,"width":237.03300000000002,"height":9},{"text":"Some women have relapsed and are off schedule. Additionally, the","fontSize":9,"x":48.00279999999998,"y":471.99679999999995,"width":237.06,"height":9},{"text":"model includes the perceptions of pros, positive aspects of mam-","fontSize":9,"x":48.00279999999998,"y":482.99479999999994,"width":237.05100000000004,"height":9},{"text":"mography, and cons, negative aspects of mammography, which are","fontSize":9,"x":48.00279999999998,"y":493.99279999999993,"width":237.06900000000002,"height":9},{"text":"associated with movement from one stage to another.","fontSize":9,"x":48.00279999999998,"y":504.9907999999999,"width":189.82800000000006,"height":9},{"text":"39","fontSize":5.5,"x":237.8358,"y":504.75,"width":6.719999999999999,"height":5.5},{"text":"These pros","fontSize":9,"x":246.1781,"y":505.0028,"width":38.880000000000024,"height":9},{"text":"and cons are complementary to the facilitators and barriers of the","fontSize":9,"x":47.998099999999994,"y":516.0008,"width":237.078,"height":9},{"text":"Health Belief Model.","fontSize":9,"x":47.998099999999994,"y":526.9988,"width":73.638,"height":9},{"text":"33","fontSize":5.5,"x":121.62899999999999,"y":526.75,"width":6.719999999999999,"height":5.5},{"text":"Considering individual facilitators and bar-","fontSize":9,"x":130.0111,"y":527.0028,"width":155.04299999999995,"height":9},{"text":"riers to action interventions are more likely to be successful when","fontSize":9,"x":48.00309999999999,"y":538.0008,"width":237.08700000000002,"height":9},{"text":"they are tailored to a person’s stage of adoption.","fontSize":9,"x":48.00309999999999,"y":548.9988,"width":177.06600000000003,"height":9},{"text":"33,34","fontSize":5.5,"x":225.0469,"y":548.75,"width":15.036000000000001,"height":5.5},{"text":"Parts of the","fontSize":9,"x":242.7366,"y":549.0028,"width":42.34499999999997,"height":9},{"text":"telephone counseling protocol intended to reduce the barriers and","fontSize":9,"x":48.003600000000006,"y":560.0008,"width":237.04200000000003,"height":9},{"text":"increase the facilitators to screening.","fontSize":9,"x":48.003600000000006,"y":570.9988,"width":131.08500000000004,"height":9},{"text":"Using the data provided, the counselor searched the local tele-","fontSize":9,"x":57.003600000000006,"y":581.9968,"width":228.02400000000011,"height":9},{"text":"phone directories with the aid of a commercial telephone software","fontSize":9,"x":48.003600000000006,"y":592.9947999999999,"width":237.06900000000002,"height":9},{"text":"(klickTel 2006), identifying telephone numbers for 1619 of the","fontSize":9,"x":48.003600000000006,"y":603.9928,"width":237.06900000000002,"height":9},{"text":"2455 women (66%) in the intervention group and for 1762 of 2952","fontSize":9,"x":48.003600000000006,"y":614.9907999999999,"width":237.03300000000013,"height":9},{"text":"(60%) of those in the control group. A total of 948 women in the","fontSize":9,"x":48.003600000000006,"y":625.9888,"width":237.0150000000001,"height":9},{"text":"intervention group were counseled. First, women were asked","fontSize":9,"x":48.003600000000006,"y":636.9867999999999,"width":237.04200000000003,"height":9},{"text":"whether they wished information on the role of mammography","fontSize":9,"x":48.003600000000006,"y":647.9848,"width":237.02399999999994,"height":9},{"text":"screening. If so, the counselor provided a brief description of mam-","fontSize":9,"x":48.003600000000006,"y":658.9828,"width":237.06900000000002,"height":9},{"text":"mography. Second, according to women’s current stage of readi-","fontSize":9,"x":48.003600000000006,"y":669.9807999999999,"width":237.03300000000002,"height":9},{"text":"ness for mammography, the counselor provided appropriate stage-","fontSize":9,"x":48.003600000000006,"y":680.9788,"width":237.04200000000014,"height":9},{"text":"specifıc information.","fontSize":9,"x":48.003600000000006,"y":691.9767999999999,"width":74.673,"height":9},{"text":"During the most extensive part of telephone counseling, the","fontSize":9,"x":57.003600000000006,"y":702.9748,"width":228.04200000000003,"height":9},{"text":"counselor tried to identify and overcome the woman’s individual","fontSize":9,"x":48.003600000000006,"y":713.9728,"width":237.024,"height":9},{"text":"barriers to screening and answered the woman’s questions. In her","fontSize":9,"x":303.00059999999996,"y":570.9717999999999,"width":237.06900000000007,"height":9},{"text":"answers, the counselor was trained to refer to a set of preformulated","fontSize":9,"x":303.00059999999996,"y":581.9698,"width":237.09600000000012,"height":9},{"text":"facts, which were derived from guidelines or other validated","fontSize":9,"x":303.00059999999996,"y":592.9677999999999,"width":237.07799999999997,"height":9},{"text":"sources and were implemented in the information system that the","fontSize":9,"x":303.00059999999996,"y":603.9658,"width":237.05729999999983,"height":9},{"text":"counselor used for interview documentation. The components","fontSize":9,"x":303.00059999999996,"y":614.9637999999999,"width":237.03209999999967,"height":9},{"text":"of the protocol included information on breast cancer risk,","fontSize":9,"x":303.00059999999996,"y":625.9617999999999,"width":237.0599999999996,"height":9},{"text":"usefulness of a screening mammogram, inclusion and exclusion","fontSize":9,"x":303.00059999999996,"y":636.9597999999999,"width":237.02219999999977,"height":9},{"text":"criteria for the German MSP, details of the mammography","fontSize":9,"x":303.00059999999996,"y":647.9577999999999,"width":237.0455999999997,"height":9},{"text":"examination (e.g., breast compression, possible pain, and radi-","fontSize":9,"x":303.00059999999996,"y":658.9558,"width":237.06449999999973,"height":9},{"text":"ation exposure, information on the reliability of mammography","fontSize":9,"x":303.00059999999996,"y":669.9537999999999,"width":237.04829999999959,"height":9},{"text":"fındings, consequences of mammography fındings, the screen-","fontSize":9,"x":303.00059999999996,"y":680.9517999999999,"width":237.03119999999956,"height":9},{"text":"ing facility, the trip to the facility, and costs). All telephone calls","fontSize":9,"x":303.00059999999996,"y":691.9497999999999,"width":237.0698999999994,"height":9},{"text":"and topics discussed were documented during the consultations","fontSize":9,"x":303.00059999999996,"y":702.9477999999999,"width":237.05729999999937,"height":9},{"text":"using a dedicated database.","fontSize":9,"x":303.00059999999996,"y":713.9458,"width":102.29130000000009,"height":9},{"text":"Figure 1. CONSORT diagram of study participants","fontSize":9.5,"x":303,"y":437.8096,"width":206.14999999999986,"height":9.5},{"text":"Note: Eligible women for the national MSP receive mailed invitation letters.","fontSize":7,"x":303,"y":450.3096,"width":237.0899999999997,"height":7},{"text":"After 6 weeks, nonresponders were sent written reminders. These nonre-","fontSize":7,"x":303,"y":460.3126,"width":237.08299999999986,"height":7},{"text":"sponders were the base population of the present study and were randomized","fontSize":7,"x":303,"y":470.31559999999996,"width":237.04799999999977,"height":7},{"text":"to the intervention or control group. Controls received written reminders; the","fontSize":7,"x":303,"y":480.31859999999995,"width":237.0899999999998,"height":7},{"text":"intervention group additionally received telephone counseling. After random-","fontSize":7,"x":303,"y":490.32159999999993,"width":237.08299999999986,"height":7},{"text":"ization, all double entries and men from the two sets were removed. In the","fontSize":7,"x":303,"y":500.3245999999999,"width":237.03399999999988,"height":7},{"text":"intervention group, 1507 women were not counseled for different reasons. A","fontSize":7,"x":303,"y":510.3275999999999,"width":237.08999999999992,"height":6.999999999999943},{"text":"total of 948 women in the intervention group were counseled. Attendances","fontSize":7,"x":303,"y":520.3305999999999,"width":237.08999999999958,"height":7},{"text":"rates were assessed in both groups, respectively, and groups were compared","fontSize":7,"x":303,"y":530.3335999999999,"width":237.08999999999992,"height":7},{"text":"using the","fontSize":7,"x":303,"y":540.3365999999999,"width":28.511000000000024,"height":7},{"text":"\u0002","fontSize":7.084063919107449,"x":333.8395,"y":540.3096,"width":4.980099999999993,"height":7},{"text":"2","fontSize":4.5,"x":337.7316,"y":540.0596,"width":3.3000000000000114,"height":4.5},{"text":"test.","fontSize":7,"x":343.3609,"y":540.3125,"width":14,"height":7},{"text":"MSP, mammography-screening program","fontSize":7,"x":302.9989,"y":550.3085,"width":121.70200000000006,"height":7},{"text":"Hegenscheid et al / Am J Prev Med 2011;41(4):421– 427 423","fontSize":9,"x":195.9801,"y":41,"width":344.0250000000001,"height":9},{"text":"October 2011","fontSize":9,"x":47.993100000000084,"y":742.001,"width":49.23899999999999,"height":9}],"graphicsBounds":[{"operationIndex":225,"kind":"image","normalizedRect":[0.5234375,0.078125,0.9453125,0.55859375],"imageHash":"d9ec88fc552315fb2fd3987e848b96d3f6f89fe88267703393a03ba8b2551e04"},{"operationIndex":229,"kind":"path","normalizedRect":[0.5234375,0.55859375,0.9453125,0.56640625]}],"invalidGraphicsBounds":0}]
