[["tokens",0],{"text":"Table 1. Staging of malignant neoplastic wounds*","inlineSymbol":false,"baseline":154.19804999999997,"height":12,"rect":[427.32284999999996,142.19804999999997,731.7220499999995,154.19804999999997],"horizontal":true}]
[["tokens",1],{"text":"Stage 1","inlineSymbol":false,"baseline":178.70280000000002,"height":10.5,"rect":[435.8268,168.20280000000002,476.94270000000006,178.70280000000002],"horizontal":true}]
[["tokens",2],{"text":"Whole skin: reddish and/or violet tissue; visible and delimited","inlineSymbol":false,"baseline":178.70280000000002,"height":10.5,"rect":[508.96065,168.20280000000002,802.5238500000007,178.70280000000002],"horizontal":true}]
[["tokens",3],{"text":"nodule; in an asymptomatic state","inlineSymbol":false,"baseline":192.20280000000002,"height":10.5,"rect":[508.96065,181.70280000000002,668.3496000000004,192.20280000000002],"horizontal":true}]
[["tokens",4],{"text":"Stage 1N","inlineSymbol":false,"baseline":216.70770000000005,"height":10.5,"rect":[435.8268,206.20770000000005,484.48064999999997,216.70770000000005],"horizontal":true}]
[["tokens",5],{"text":"Closed wound or with exudate drainage holes and reddish or violet","inlineSymbol":false,"baseline":216.70770000000005,"height":10.5,"rect":[508.96065,206.20770000000005,830.573550000001,216.70770000000005],"horizontal":true}]
[["tokens",6],{"text":"tissue; dry or wet lesion; possible presence of pain and itching;","inlineSymbol":false,"baseline":230.20770000000005,"height":10.5,"rect":[508.96065,219.70770000000005,811.9938000000008,230.20770000000005],"horizontal":true}]
[["tokens",7],{"text":"absence of pain and tunnelling and/or crater formation","inlineSymbol":false,"baseline":243.70770000000005,"height":10.5,"rect":[508.96065,233.20770000000005,770.8873500000002,243.70770000000005],"horizontal":true}]
[["tokens",8],{"text":"Stage 2","inlineSymbol":false,"baseline":268.21230000000014,"height":10.5,"rect":[435.8268,257.71230000000014,476.93955,268.21230000000014],"horizontal":true}]
[["tokens",9],{"text":"Open wound involving the dermis and epidermis; superficial","inlineSymbol":false,"baseline":268.21230000000014,"height":10.5,"rect":[508.96065,257.71230000000014,797.2182000000007,268.21230000000014],"horizontal":true}]
[["tokens",10],{"text":"ulcerations may be sensitive to manipulation, with no exudate but","inlineSymbol":false,"baseline":281.71230000000014,"height":10.5,"rect":[508.96065,271.21230000000014,823.5070500000006,281.71230000000014],"horizontal":true}]
[["tokens",11],{"text":"humid; intense inflammatory process; reddish and/or violet tissue,","inlineSymbol":false,"baseline":295.21230000000014,"height":10.5,"rect":[508.96065,284.71230000000014,826.5888000000002,295.21230000000014],"horizontal":true}]
[["tokens",12],{"text":"wound bed with dry and moist areas; possible presence of pain","inlineSymbol":false,"baseline":308.71230000000014,"height":10.5,"rect":[508.96065,298.21230000000014,814.3668000000007,308.71230000000014],"horizontal":true}]
[["tokens",13],{"text":"and odor; no tunnelling","inlineSymbol":false,"baseline":322.21230000000014,"height":10.5,"rect":[508.96065,311.71230000000014,620.0979000000003,322.21230000000014],"horizontal":true}]
[["tokens",14],{"text":"Stage 3","inlineSymbol":false,"baseline":346.7170500000001,"height":10.5,"rect":[435.8268,336.2170500000001,476.93955,346.7170500000001],"horizontal":true}]
[["tokens",15],{"text":"Wounds involving the dermis, epidermis and subcutaneous (do not","inlineSymbol":false,"baseline":346.7170500000001,"height":10.5,"rect":[508.96065,336.2170500000001,830.1966000000008,346.7170500000001],"horizontal":true}]
[["tokens",16],{"text":"surpass the subcutaneous); regular depth but with irregular","inlineSymbol":false,"baseline":360.2170500000001,"height":10.5,"rect":[508.96065,349.7170500000001,793.9611000000007,360.2170500000001],"horizontal":true}]
[["tokens",17],{"text":"formation/appearance (vegetative aspect); friable, with ulceration","inlineSymbol":false,"baseline":373.7170500000001,"height":10.5,"rect":[508.96065,363.2170500000001,822.0874500000003,373.7170500000001],"horizontal":true}]
[["tokens",18],{"text":"areas and adherent liquefied or solid necrotic tissue; fetid and","inlineSymbol":false,"baseline":387.2170500000001,"height":10.5,"rect":[508.96065,376.7170500000001,806.3290500000004,387.2170500000001],"horizontal":true}]
[["tokens",19],{"text":"exudative, but not surpassing the subcutaneous; possible","inlineSymbol":false,"baseline":400.7170500000001,"height":10.5,"rect":[508.96065,390.2170500000001,787.2789000000006,400.7170500000001],"horizontal":true}]
[["tokens",20],{"text":"presence of satellite lesions at risk of imminent rupture; reddish","inlineSymbol":false,"baseline":414.2170500000001,"height":10.5,"rect":[508.96065,403.7170500000001,813.8649000000004,414.2170500000001],"horizontal":true}]
[["tokens",21],{"text":"and/or violet, but predominantly yellowish in colour","inlineSymbol":false,"baseline":427.71705,"height":10.5,"rect":[508.96065,417.21705,754.4979000000005,427.71705],"horizontal":true}]
[["tokens",22],{"text":"Stage 4","inlineSymbol":false,"baseline":452.2219500000001,"height":10.5,"rect":[435.8268,441.7219500000001,476.93955,452.2219500000001],"horizontal":true}]
[["tokens",23],{"text":"Wounds invading deep anatomical structures; significant depth;","inlineSymbol":false,"baseline":452.2219500000001,"height":10.5,"rect":[508.96065,441.7219500000001,815.5417500000008,452.2219500000001],"horizontal":true}]
[["tokens",24],{"text":"with abundant exudate, foul odor and pain; reddish and/or violet,","inlineSymbol":false,"baseline":465.7219500000001,"height":10.5,"rect":[508.96065,455.2219500000001,820.5387000000004,465.7219500000001],"horizontal":true}]
[["tokens",25],{"text":"but predominantly yellowish in colour","inlineSymbol":false,"baseline":479.2219500000001,"height":10.5,"rect":[508.96065,468.7219500000001,688.4119500000004,479.2219500000001],"horizontal":true}]
[["tokens",26],{"text":"*Translated and adapted from: Haisfield-Wolfe and Baxendale-Cox","inlineSymbol":false,"baseline":502.6557,"height":9,"rect":[435.8268,493.6557,703.0161,502.6557],"horizontal":true}]
