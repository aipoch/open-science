[["page","lines",46],{"text":"The findings of the present study show that the ultrasound-guid-","fontSize":9.5,"x":56.6929,"y":692.8259,"width":232.4411,"height":9.5}]
[["page","lines",47],{"text":"ed bi-level (T2–T4). ESPB reduced total morphine consumption in","fontSize":9.5,"x":48.189,"y":706.9991,"width":240.95514999999997,"height":9.5}]
[["page","lines",48],{"text":"the first 24 h postoperatively significantly more than the modified","fontSize":9.5,"x":48.189,"y":721.1724,"width":240.8686999999999,"height":9.5}]
[["page","lines",49],{"text":"PECS block. Postoperative pain scores were also significantly lower","fontSize":9.5,"x":306.1417,"y":664.4794,"width":240.94279999999992,"height":9.5}]
[["page","lines",50],{"text":"in the ESPB group.","fontSize":9.5,"x":306.1417,"y":678.6527,"width":68.73249999999996,"height":9.5}]
[["page","lines",51],{"text":"PECS blocks are superficial interfascial plane blocks that access","fontSize":9.5,"x":314.6457,"y":692.8259,"width":232.41465,"height":9.5}]
[["page","lines",52],{"text":"branches of the brachial plexus, which supplies innervation to the","fontSize":9.5,"x":306.1417,"y":706.9991,"width":240.93710000000044,"height":9.5}]
[["page","lines",53],{"text":"pectoral muscles and upper anterior thoracic wall [10]. Three re-","fontSize":9.5,"x":306.1417,"y":721.1724,"width":240.94499999999994,"height":9.5}]
