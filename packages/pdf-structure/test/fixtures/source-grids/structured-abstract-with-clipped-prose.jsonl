[["tokens",5],{"text":"For Permissions, please e-mail: author@example.invalid","inlineSymbol":false,"baseline":46.492500000000064,"height":10.5,"rect":[518.82075,35.992500000000064,837.0022500000002,46.492500000000064],"horizontal":true}]
[["tokens",6],{"text":"Does a Community-Based Stress Management Intervention","inlineSymbol":false,"baseline":160.28999999999996,"height":22.5,"rect":[63,137.78999999999996,767.4975000000003,160.28999999999996],"horizontal":true}]
[["tokens",7],{"text":"Affect Psychological Adaptation Among Underserved Black","inlineSymbol":false,"baseline":188.7975,"height":22.5,"rect":[63,166.2975,773.5500000000004,188.7975],"horizontal":true}]
[["tokens",8],{"text":"Breast Cancer Survivors?","inlineSymbol":false,"baseline":217.30500000000006,"height":22.5,"rect":[63,194.80500000000006,364.6575000000001,217.30500000000006],"horizontal":true}]
[["tokens",9],{"text":"Suzanne C. Lechner, Nicole E. Whitehead, Sara Vargas, Debra W. Annane, Belinda R. Robertson,","inlineSymbol":false,"baseline":245.78999999999996,"height":13.5,"rect":[63,232.28999999999996,636.6824999999997,245.78999999999996],"horizontal":true}]
[["tokens",10],{"text":"Charles S. Carver, Erin Kobetz, Michael H. Antoni","inlineSymbol":false,"baseline":263.78549999999996,"height":13.5,"rect":[63,250.28549999999996,355.0320000000002,263.78549999999996],"horizontal":true}]
[["tokens",11],{"text":"Correspondence to:","inlineSymbol":false,"baseline":287.78999999999996,"height":10.5,"rect":[63,277.28999999999996,160.0725,287.78999999999996],"horizontal":true}]
[["tokens",12],{"text":"Suzanne C. Lechner, PhD, 1120 NW 14 St, C-202, Miami, FL 33180 (e-mail: author@example.invalid","inlineSymbol":false,"baseline":287.78999999999996,"height":10.5,"rect":[162.9915,277.28999999999996,668.0414999999994,287.78999999999996],"horizontal":true}]
[["tokens",13],{"text":"Background","inlineSymbol":false,"baseline":359.78999999999996,"height":12.75,"rect":[63,347.03999999999996,126.036,359.78999999999996],"horizontal":true}]
[["tokens",14],{"text":"In this randomized trial, Project CARE, we examined whether participation in a cognitive-behavioral stress man-","inlineSymbol":false,"baseline":359.78999999999996,"height":12.75,"rect":[171.00525,347.03999999999996,837.0524999999993,359.78999999999996],"horizontal":true}]
[["tokens",15],{"text":"agement and breast cancer wellness and education program improved psychological outcomes among a sam-","inlineSymbol":false,"baseline":377.7929999999999,"height":12.75,"rect":[171.00525,365.0429999999999,836.9377499999996,377.7929999999999],"horizontal":true}]
[["tokens",16],{"text":"ple of underserved black breast cancer survivors.","inlineSymbol":false,"baseline":395.79600000000005,"height":12.75,"rect":[171.00525,383.04600000000005,466.39725000000004,395.79600000000005],"horizontal":true}]
[["tokens",17],{"text":"Methods","inlineSymbol":false,"baseline":422.80049999999994,"height":12.75,"rect":[63,410.05049999999994,108.32624999999999,422.80049999999994],"horizontal":true}]
[["tokens",18],{"text":"Both complementary medicine interventions were 10-sessions, manualized, group-based, and were culturally","inlineSymbol":false,"baseline":422.80049999999994,"height":12.75,"rect":[171.00525,410.05049999999994,837.0014999999996,422.80049999999994],"horizontal":true}]
[["tokens",19],{"text":"adapted for black women in the community from evidence-based interventions. Participants were 114 black","inlineSymbol":false,"baseline":440.8035,"height":12.75,"rect":[171.00525,428.0535,837.0397499999995,440.8035],"horizontal":true}]
[["tokens",20],{"text":"women (mean age = 51.1, 27–77 years) who had completed breast cancer treatment 0–12 months before enroll-","inlineSymbol":false,"baseline":458.8064999999999,"height":12.75,"rect":[171.00525,446.0564999999999,837.0142499999997,458.8064999999999],"horizontal":true}]
[["tokens",21],{"text":"ment (stages 0–IV, mean time since cancer diagnosis = 14.1 months). Women were enrolled upon completion","inlineSymbol":false,"baseline":476.80949999999996,"height":12.75,"rect":[171.00525,464.05949999999996,836.9632499999991,476.80949999999996],"horizontal":true}]
[["tokens",22],{"text":"of curative treatment (ie, surgical, chemotherapy, radiation oncology) and randomized to receive cognitive-","inlineSymbol":false,"baseline":494.8125,"height":12.75,"rect":[171.00525,482.0625,837.0524999999991,494.8125],"horizontal":true}]
[["tokens",23],{"text":"behavioral stress management or cancer wellness and education program.","inlineSymbol":false,"baseline":512.8155,"height":12.75,"rect":[171.00525,500.06550000000004,621.59025,512.8155],"horizontal":true}]
[["tokens",24],{"text":"Results","inlineSymbol":false,"baseline":539.8199999999999,"height":12.75,"rect":[63,527.0699999999999,101.25,539.8199999999999],"horizontal":true}]
[["tokens",25],{"text":"There was a remarkable 95% retention rate from baseline to 6-month follow-up. Participants in both conditions","inlineSymbol":false,"baseline":539.8199999999999,"height":12.75,"rect":[171.00525,527.0699999999999,836.9887499999991,539.8199999999999],"horizontal":true}]
[["tokens",26],{"text":"showed statistically significant improvement on indices of psychological well-being, including overall quality","inlineSymbol":false,"baseline":557.823,"height":12.75,"rect":[171.00525,545.073,836.9377499999991,557.823],"horizontal":true}]
[["tokens",27],{"text":"of life (Functional Assessment of Cancer Therapy-Breast), intrusive thoughts (Impact of Event Scale-Revised),","inlineSymbol":false,"baseline":575.826,"height":12.75,"rect":[171.00525,563.076,836.9632499999996,575.826],"horizontal":true}]
[["tokens",28],{"text":"depressive symptoms (Center for Epidemiologic Studies-Depression), and stress levels (Perceived Stress Scale)","inlineSymbol":false,"baseline":593.8290000000001,"height":12.75,"rect":[171.00525,581.0790000000001,837.0269999999991,593.8290000000001],"horizontal":true}]
[["tokens",29],{"text":"over the 6-month postintervention follow-up (all repeated measures analysis of variance within-subjects time","inlineSymbol":false,"baseline":611.832,"height":12.75,"rect":[171.00525,599.082,837.0014999999992,611.832],"horizontal":true}]
[["tokens",30],{"text":"effects:","inlineSymbol":false,"baseline":629.835,"height":12.75,"rect":[171.00525,617.085,213.89624999999998,629.835],"horizontal":true}]
[["tokens",31],{"text":"P","inlineSymbol":false,"baseline":629.835,"height":12.75,"rect":[218.2695,617.085,226.05975,629.835],"horizontal":true}]
[["tokens",32],{"text":"< .05, except for overall mood; Profile of Mood States-Short Version). Contrary to hypotheses, how-","inlineSymbol":false,"baseline":629.835,"height":12.75,"rect":[230.433,617.085,837.0015,629.835],"horizontal":true}]
[["tokens",33],{"text":"ever, condition × time effects were not statistically significant.","inlineSymbol":false,"baseline":647.838,"height":12.75,"rect":[171.00525,635.088,541.5712499999997,647.838],"horizontal":true}]
[["tokens",34],{"text":"Conclusions","inlineSymbol":false,"baseline":674.8425,"height":12.75,"rect":[63,662.0925,126.75,674.8425],"horizontal":true}]
[["tokens",35],{"text":"Findings suggest that improvements in multiple measures over time may have been due to intensive training in","inlineSymbol":false,"baseline":674.8425,"height":12.75,"rect":[171.00525,662.0925,836.9759999999987,674.8425],"horizontal":true}]
[["tokens",36],{"text":"stress management, extensive provision of breast cancer information, or participation in an ongoing supportive","inlineSymbol":false,"baseline":692.8455,"height":12.75,"rect":[171.00525,680.0955,837.0269999999994,692.8455],"horizontal":true}]
[["tokens",37],{"text":"group of individuals from a similar racial background. Implications bear on decisions about appropriate control","inlineSymbol":false,"baseline":710.8485000000001,"height":12.75,"rect":[171.00525,698.0985000000001,836.9632499999991,710.8485000000001],"horizontal":true}]
[["tokens",38],{"text":"groups, the timing of intervention delivery during the treatment trajectory, and perceived support from the","inlineSymbol":false,"baseline":728.8515,"height":12.75,"rect":[171.00525,716.1015,836.9632499999993,728.8515],"horizontal":true}]
[["tokens",39],{"text":"research team.","inlineSymbol":false,"baseline":746.8545,"height":12.75,"rect":[171.00525,734.1045,259.64324999999997,746.8545],"horizontal":true}]
[["tokens",40],{"text":"J Natl Cancer Inst Monogr 2014;50:315–322","inlineSymbol":false,"baseline":773.859,"height":12.75,"rect":[171.00525,761.109,429.7282500000001,773.859],"horizontal":true}]
[["tokens",41],{"text":"Despite lower incidence of disease, black women have higher breast","inlineSymbol":false,"baseline":817.29,"height":13.5,"rect":[63,803.79,441.0405000000001,817.29],"horizontal":true}]
[["tokens",42],{"text":"cancer mortality than other racial and ethnic groups (1). Black","inlineSymbol":false,"baseline":835.2855,"height":13.5,"rect":[63,821.7855,440.97299999999984,835.2855],"horizontal":true}]
[["tokens",43],{"text":"women with breast cancer are more likely to be diagnosed with","inlineSymbol":false,"baseline":853.281,"height":13.5,"rect":[63,839.781,440.97299999999984,853.281],"horizontal":true}]
[["tokens",44],{"text":"later stage disease, imparting a poorer prognosis. This necessitates","inlineSymbol":false,"baseline":871.2764999999999,"height":13.5,"rect":[63,857.7764999999999,441.0135,871.2764999999999],"horizontal":true}]
[["tokens",45],{"text":"more invasive treatments, thereby resulting in diminished quality","inlineSymbol":false,"baseline":889.272,"height":13.5,"rect":[63,875.772,441.02699999999965,889.272],"horizontal":true}]
[["tokens",46],{"text":"of life and greater physical discomfort (2,3). Black and low-income","inlineSymbol":false,"baseline":907.2674999999999,"height":13.5,"rect":[63,893.7674999999999,440.97299999999984,907.2674999999999],"horizontal":true}]
[["tokens",47],{"text":"women are traditionally underserved in all aspects of cancer care","inlineSymbol":false,"baseline":925.263,"height":13.5,"rect":[63,911.763,440.98649999999986,925.263],"horizontal":true}]
[["tokens",48],{"text":"(4) including psychosocial support (5) and integrative medicine","inlineSymbol":false,"baseline":943.2585,"height":13.5,"rect":[63,929.7585,441.0269999999998,943.2585],"horizontal":true}]
[["tokens",49],{"text":"modalities (6).","inlineSymbol":false,"baseline":961.254,"height":13.5,"rect":[63,947.754,144.24300000000005,961.254],"horizontal":true}]
[["tokens",50],{"text":"Black breast cancer survivors report several unique concerns,","inlineSymbol":false,"baseline":979.2495,"height":13.5,"rect":[80.99549999999999,965.7495,441.486,979.2495],"horizontal":true}]
[["tokens",51],{"text":"while sharing many of the issues that plague breast cancer survivors","inlineSymbol":false,"baseline":997.245,"height":13.5,"rect":[63,983.745,441.04049999999995,997.245],"horizontal":true}]
[["tokens",52],{"text":"in general, such as distress, anxiety, fatigue, and sleep disruption","inlineSymbol":false,"baseline":1015.2405,"height":13.5,"rect":[63,1001.7405,441.01349999999985,1015.2405],"horizontal":true}]
[["tokens",53],{"text":"(7,8). Black women have specific concerns about keloid scarring","inlineSymbol":false,"baseline":1033.2359999999999,"height":13.5,"rect":[63,1019.7359999999999,441.01349999999985,1033.2359999999999],"horizontal":true}]
[["tokens",54],{"text":"and the unavailability of prosthetic devices that match skin tone.","inlineSymbol":false,"baseline":1051.2314999999999,"height":13.5,"rect":[63,1037.7314999999999,441.4995,1051.2314999999999],"horizontal":true}]
[["tokens",55],{"text":"They also report the erosion of social support after surgery due to","inlineSymbol":false,"baseline":1069.227,"height":13.5,"rect":[63,1055.727,441.05399999999986,1069.227],"horizontal":true}]
[["tokens",56],{"text":"stigma (9,10). The latter may be of great importance. Among black","inlineSymbol":false,"baseline":1087.2225,"height":13.5,"rect":[63,1073.7225,440.9594999999998,1087.2225],"horizontal":true}]
[["tokens",57],{"text":"and white women with breast cancer, lower perceived emotional","inlineSymbol":false,"baseline":817.2225,"height":13.5,"rect":[458.9955,803.7225,836.9549999999997,817.2225],"horizontal":true}]
[["tokens",58],{"text":"support at diagnosis predicted higher risk of death over 10-year","inlineSymbol":false,"baseline":835.2180000000001,"height":13.5,"rect":[458.9955,821.7180000000001,836.9819999999997,835.2180000000001],"horizontal":true}]
[["tokens",59],{"text":"follow-up (11). Such findings suggest that black women with breast","inlineSymbol":false,"baseline":853.2135000000001,"height":13.5,"rect":[458.9955,839.7135000000001,836.9819999999996,853.2135000000001],"horizontal":true}]
[["tokens",60],{"text":"cancer might benefit greatly from interventions designed to main-","inlineSymbol":false,"baseline":871.2090000000001,"height":13.5,"rect":[458.9955,857.7090000000001,837.0225000000003,871.2090000000001],"horizontal":true}]
[["tokens",61],{"text":"tain and augment their social support networks.","inlineSymbol":false,"baseline":889.2045,"height":13.5,"rect":[458.9955,875.7045,730.4535000000002,889.2045],"horizontal":true}]
[["tokens",62],{"text":"Within the field of integrative oncology, researchers are devel-","inlineSymbol":false,"baseline":907.2,"height":13.5,"rect":[476.991,893.7,836.9685000000002,907.2],"horizontal":true}]
[["tokens",63],{"text":"oping interventions to mitigate the symptoms caused by disease","inlineSymbol":false,"baseline":925.1955,"height":13.5,"rect":[458.9955,911.6955,837.0225000000003,925.1955],"horizontal":true}]
[["tokens",64],{"text":"and treatment for cancer (12). Often called “complementary medi-","inlineSymbol":false,"baseline":943.191,"height":13.5,"rect":[458.9955,929.691,836.9955000000007,943.191],"horizontal":true}]
[["tokens",65],{"text":"cine,” psychosocial approaches are used alongside traditional med-","inlineSymbol":false,"baseline":961.1865,"height":13.5,"rect":[458.9955,947.6865,837.0225000000005,961.1865],"horizontal":true}]
[["tokens",66],{"text":"ical care and are designed to reduce emotional distress, improve","inlineSymbol":false,"baseline":979.182,"height":13.5,"rect":[458.9955,965.682,836.9820000000002,979.182],"horizontal":true}]
[["tokens",67],{"text":"quality of life, foster social support, enhance coping, support the","inlineSymbol":false,"baseline":997.1775,"height":13.5,"rect":[458.9955,983.6775,837.0090000000005,997.1775],"horizontal":true}]
[["tokens",68],{"text":"adoption of healthy behaviors (eg, dietary changes, increased","inlineSymbol":false,"baseline":1015.173,"height":13.5,"rect":[458.9955,1001.673,836.9549999999999,1015.173],"horizontal":true}]
[["tokens",69],{"text":"physical activity, quitting smoking), and encourage stress manage-","inlineSymbol":false,"baseline":1033.1685,"height":13.5,"rect":[458.9955,1019.6685,836.9819999999995,1033.1685],"horizontal":true}]
[["tokens",70],{"text":"ment [eg, (13,14); for a meta-analysis, see (15)]. Unfortunately, the","inlineSymbol":false,"baseline":1051.164,"height":13.5,"rect":[458.9955,1037.664,836.9549999999999,1051.164],"horizontal":true}]
[["tokens",71],{"text":"samples in published studies typically contain little racial/ethnic","inlineSymbol":false,"baseline":1069.1595,"height":13.5,"rect":[458.9955,1055.6595,836.9954999999999,1069.1595],"horizontal":true}]
[["tokens",72],{"text":"diversity.","inlineSymbol":false,"baseline":1087.155,"height":13.5,"rect":[458.9955,1073.655,510.5115000000002,1087.155],"horizontal":true}]
