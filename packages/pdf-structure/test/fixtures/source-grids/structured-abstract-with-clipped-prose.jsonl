[["tokens",0],{"text":"Journal of the National Cancer Institute Monographs, No. 50, 2014","inlineSymbol":false,"baseline":1129.53675,"height":11.25,"rect":[63,1118.28675,413.71874999999994,1129.53675],"horizontal":true}]
