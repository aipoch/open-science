[["page"],{"pageNumber":5,"width":585,"height":783,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"paintImageXObject":1,"constructPath":1},"captionStarts":[{"text":"Figure. Dexmedetomidine concentration versus time following the","fontSize":8,"x":302,"y":451.6879,"width":236,"height":8}],"headingCandidates":[],"lines":[{"text":"Copyright © 2020 International Anesthesia Research Society. Unauthorized reproduction of this article is prohibited.","fontSize":11,"x":21.1872,"y":758.939,"width":541.6289999999999,"height":11},{"text":"460 www.anesthesia-analgesia.org aNesthesia & aNalgesia","fontSize":9,"x":48,"y":747,"width":490.02549999999985,"height":9},{"text":"Buccal DEX Gel Premedication in Adults","fontSize":8,"x":48,"y":18,"width":144.07760000000005,"height":8},{"text":"at 5% within each hypothesis. The overall significance","fontSize":10,"x":48,"y":51.25999999999999,"width":236.02500000000003,"height":10},{"text":"level of 0.05 was divided by the number of pairwise","fontSize":10,"x":48,"y":63.49000000000001,"width":235.96999999999997,"height":10},{"text":"comparisons that were performed (3) to obtain the","fontSize":10,"x":48,"y":75.72000000000003,"width":235.98899999999992,"height":10},{"text":"significance criterion of 0.05/3 = 0.0167 for each test","fontSize":10,"x":48,"y":87.95000000000005,"width":235.99999999999994,"height":10},{"text":"within an outcome variable.","fontSize":10,"x":48,"y":100.18000000000006,"width":123.88999999999999,"height":10},{"text":"Statistical analysis was conducted by the Statistical","fontSize":10,"x":60,"y":112.41000000000008,"width":224.02000000000004,"height":10},{"text":"Package for the Social Sciences (SPSS) software ver-","fontSize":10,"x":48,"y":124.6400000000001,"width":235.99999999999994,"height":10},{"text":"sion 19 for Microsoft Windows for the pharmacody-","fontSize":10,"x":47.99999999999997,"y":136.87000000000012,"width":236.021,"height":10},{"text":"namic and baseline data (SPSS Inc, Chicago, IL) and","fontSize":10,"x":47.99999999999997,"y":149.10000000000014,"width":236.02,"height":10},{"text":"by Stata version 11.0 for pharmacokinetic data (Stata","fontSize":10,"x":47.99999999999997,"y":161.33000000000015,"width":236.02,"height":10},{"text":"Corp LP, College Station, TX).","fontSize":10,"x":47.99999999999997,"y":173.56000000000017,"width":131.47000000000003,"height":10},{"text":"RESULTS","fontSize":10,"x":47.99999999999997,"y":196.7900000000002,"width":42.3,"height":10},{"text":"Thirty-six female patients were recruited in this study","fontSize":10,"x":47.99999999999997,"y":209.0200000000002,"width":235.97900000000018,"height":10},{"text":"(12 patients in each group) of whom 24 patients com-","fontSize":10,"x":47.99999999999997,"y":221.25000000000023,"width":236.03000000000023,"height":10},{"text":"pleted the blood sampling and pharmacokinetic analy-","fontSize":10,"x":47.99999999999997,"y":233.48000000000025,"width":236.00000000000026,"height":10},{"text":"sis (8 patients in each group). Descriptive analysis and","fontSize":10,"x":47.99999999999997,"y":245.71000000000026,"width":236.0100000000003,"height":10},{"text":"pharmacodynamic statistical testing were done for 12","fontSize":10,"x":47.99999999999997,"y":257.9400000000003,"width":236.00000000000014,"height":10},{"text":"patients in each group, then pharmacokinetic analysis","fontSize":10,"x":47.99999999999997,"y":270.1700000000003,"width":236.00900000000016,"height":10},{"text":"and calculations were done for 8 patients in each group.","fontSize":10,"x":47.99999999999997,"y":282.4000000000003,"width":236.00300000000018,"height":10},{"text":"The baseline and clinical characteristics of the patients","fontSize":10,"x":47.99999999999997,"y":294.63000000000034,"width":236.02000000000007,"height":10},{"text":"were matched in the 3 studied groups (Table 1).","fontSize":10,"x":47.99999999999997,"y":306.86000000000035,"width":205.0590000000002,"height":10},{"text":"Pharmacokinetic Results","fontSize":10,"x":47.99999999999997,"y":330.0900000000004,"width":120.549,"height":10},{"text":"The plasma concentrations of DEX in the 3 stud-","fontSize":10,"x":47.99999999999997,"y":342.3200000000004,"width":236.00000000000003,"height":10},{"text":"ied groups are shown on a logarithmic scale versus","fontSize":10,"x":47.99999999999997,"y":354.5500000000004,"width":235.96999999999994,"height":10},{"text":"time (minutes) in the Figure. The median (Q1–Q3)","fontSize":10,"x":47.99999999999997,"y":366.7800000000004,"width":236.00300000000007,"height":10},{"text":"peak concentration of DEX (C","fontSize":10,"x":47.99999999999997,"y":379.01000000000045,"width":133.18000000000004,"height":10},{"text":"max) in plasma was 0.35","fontSize":10,"x":181.178,"y":379.0639,"width":102.82230000000004,"height":12},{"text":"ng/mL (0.31–0.49), 0.37 ng/mL (0.34–0.40), and 0.54","fontSize":10,"x":48.00030000000001,"y":391.2939,"width":235.99000000000004,"height":10},{"text":"ng/mL (0.45–0.61) in DEX 0.5, DEX 0.75, and DEX","fontSize":10,"x":48.00030000000001,"y":403.5239,"width":236.01000000000002,"height":10},{"text":"1 groups (P = .082). The median time to reach peak","fontSize":10,"x":48.00030000000001,"y":415.75390000000004,"width":235.99000000000004,"height":10},{"text":"serum concentration of DEX (T","fontSize":10,"x":48.00030000000001,"y":427.98390000000006,"width":141.66000000000005,"height":10},{"text":"max) was significantly","fontSize":10,"x":189.6451,"y":427.9926,"width":94.36229999999995,"height":12},{"text":"shorter in patients who received 1 μg/kg (60 min-","fontSize":10,"x":47.9974,"y":440.2226,"width":236.00500000000002,"height":10},{"text":"utes) compared with those who received 0.5 μg/kg","fontSize":10,"x":47.9974,"y":452.4526,"width":236.00899999999993,"height":10},{"text":"(120 minute; P = .003) and 0.75 μg/kg (120 minutes;","fontSize":10,"x":47.9974,"y":464.68260000000004,"width":236.00000000000003,"height":10},{"text":"P = .004). No significant differences between groups","fontSize":10,"x":47.9974,"y":476.91260000000005,"width":236.02899999999997,"height":10},{"text":"were recorded in other pharmacokinetic parameters","fontSize":10,"x":47.9974,"y":489.1426000000001,"width":236.009,"height":10},{"text":"(Table 2).","fontSize":10,"x":47.9974,"y":501.3726000000001,"width":40.099999999999994,"height":10},{"text":"Pharmacodynamic Results","fontSize":10,"x":47.9974,"y":524.6026,"width":127.34899999999996,"height":10},{"text":"Compared to baseline values in each group, the non-","fontSize":10,"x":47.9974,"y":536.8326000000001,"width":236.00100000000006,"height":10},{"text":"invasive systolic and diastolic blood pressure sig-","fontSize":10,"x":47.9974,"y":549.0626000000001,"width":236.00999999999996,"height":10},{"text":"nificantly decreased at 20 and 30 minutes after the","fontSize":10,"x":47.9974,"y":561.2926,"width":236.01300000000006,"height":10},{"text":"administration of the DEX gel and at 5 minutes after","fontSize":10,"x":47.9974,"y":573.5226,"width":236.02000000000007,"height":10},{"text":"induction of anesthesia in the 3 studied groups with","fontSize":10,"x":47.9974,"y":585.7526,"width":236.03000000000011,"height":10},{"text":"no significant differences in other studied timepoints.","fontSize":10,"x":47.9974,"y":597.9826,"width":235.99999999999997,"height":10},{"text":"Intergroup comparisons showed no significant differ-","fontSize":10,"x":47.9974,"y":610.2126000000001,"width":235.99999999999997,"height":10},{"text":"ences in the blood pressure at any studied timepoint","fontSize":10,"x":47.9974,"y":622.4426,"width":236.01000000000008,"height":10},{"text":"(data not represented). Intragroup and intergroup","fontSize":10,"x":47.9974,"y":634.6726,"width":235.99800000000013,"height":10},{"text":"comparisons revealed significant decreases in the","fontSize":10,"x":47.9974,"y":646.9026,"width":235.99899999999994,"height":10},{"text":"median heart rate preoperatively at 20 and 30 minutes","fontSize":10,"x":47.9974,"y":659.1326,"width":236.00999999999996,"height":10},{"text":"after administration of the DEX gel (data not repre-","fontSize":10,"x":47.9974,"y":671.3626,"width":236.02999999999994,"height":10},{"text":"sented) and throughout the intraoperative and post-","fontSize":10,"x":47.9974,"y":683.5926,"width":235.99999999999997,"height":10},{"text":"operative periods, with the lowest values recorded in","fontSize":10,"x":47.9974,"y":695.8226,"width":235.98999999999992,"height":10},{"text":"DEX 1 group (Tables 3–4).","fontSize":10,"x":47.9974,"y":710.4526000000001,"width":114.18999999999997,"height":9.999999999999886},{"text":"On admission to the SICU, patients in DEX 1 group","fontSize":10,"x":313.99739999999997,"y":505.9026,"width":224.02499999999986,"height":10},{"text":"showed higher sedation score compared with DEX 0.5","fontSize":10,"x":301.99739999999997,"y":517.9326,"width":236.00900000000013,"height":10},{"text":"(P = .022) and DEX 0.75 (P = .032) groups (Table 4).","fontSize":10,"x":301.99739999999997,"y":529.9626000000001,"width":235.9910000000001,"height":10},{"text":"Otherwise, the sedation score was 0 (fully conscious)","fontSize":10,"x":301.99739999999997,"y":541.9926,"width":236.0100000000001,"height":10},{"text":"in all patients in this study at all recorded preopera-","fontSize":10,"x":301.99739999999997,"y":554.0226,"width":236.0340000000001,"height":10},{"text":"tive and postoperative timepoints. Visual analog","fontSize":10,"x":301.99739999999997,"y":566.0526,"width":236,"height":10},{"text":"scale (VAS) pain scores were lower in DEX 1 group","fontSize":10,"x":301.99739999999997,"y":578.0826,"width":236.0089999999999,"height":10},{"text":"compared with DEX 0.5 and DEX 0.75 groups that","fontSize":10,"x":301.99739999999997,"y":590.1126,"width":236.0000000000001,"height":10},{"text":"reached statistical significance at admission to the","fontSize":10,"x":301.99739999999997,"y":602.1426,"width":236,"height":10},{"text":"SICU (Table 4). No patient in DEX 1 group requested","fontSize":10,"x":301.99739999999997,"y":614.1726,"width":236.01800000000026,"height":10},{"text":"for IV morphine-PCA during the study period ver-","fontSize":10,"x":301.99739999999997,"y":626.2026000000001,"width":236.0000000000001,"height":10},{"text":"sus 2 patients in DEX 0.5 and 2 patients in DEX 0.75","fontSize":10,"x":301.99739999999997,"y":638.2326,"width":236.02000000000032,"height":10},{"text":"groups, respectively.","fontSize":10,"x":301.99739999999997,"y":650.2626,"width":90.57900000000001,"height":10},{"text":"No significant differences were recorded between","fontSize":10,"x":313.99739999999997,"y":662.2926,"width":224.0139999999999,"height":10},{"text":"groups in the perioperative adverse effects (Table 1).","fontSize":10,"x":301.99739999999997,"y":674.3226,"width":236.01599999999985,"height":10},{"text":"No local irritation adverse events were seen with the","fontSize":10,"x":301.99739999999997,"y":686.3526,"width":235.96900000000005,"height":10},{"text":"oral-mucosal gel preparation and it was well tolerated","fontSize":10,"x":301.99739999999997,"y":698.3826,"width":236.02499999999998,"height":10},{"text":"in all patients in this study.","fontSize":10,"x":301.99739999999997,"y":710.4126,"width":118.88799999999998,"height":10},{"text":"Figure. Dexmedetomidine concentration versus time following the","fontSize":8,"x":302,"y":451.6879,"width":236,"height":8},{"text":"administration of buccal dexmedetomidine gel at 0.5 μg/kg (A),","fontSize":8,"x":302,"y":460.6879,"width":236.41599999999994,"height":8},{"text":"0.75 μg/kg (B), and 1 μg/kg (C). P indicates patient number.","fontSize":8,"x":302,"y":469.6879,"width":211.6615999999998,"height":8}],"graphicsBounds":[{"operationIndex":64,"kind":"path","normalizedRect":[0.078125,0.01953125,0.92578125,0.02734375]},{"operationIndex":418,"kind":"image","normalizedRect":[0.51953125,0.06640625,0.91796875,0.578125],"imageHash":"d76d25b5638be68c68591a1cda80d8046e8697917c01cd76c5ee15156a621cab"}],"invalidGraphicsBounds":0}]
