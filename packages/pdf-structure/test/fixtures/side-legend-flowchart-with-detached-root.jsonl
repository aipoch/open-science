[["page"],{"pageNumber":1,"width":595.276,"height":790.866,"rotation":0,"renderRotation":0,"structureRoles":{},"graphicsOperators":{"constructPath":47},"captionStarts":[{"text":"Fig. 1 Enrollment and study","fontSize":8.46819972,"x":51.02360153,"y":342.00738891000003,"width":96.1335440686068,"height":8.468199719999973}],"headingCandidates":[],"lines":[{"text":"(Hologic Inc., Bedford, MA). Our precision ranged from 1.2","fontSize":9.96259975,"x":51.02360153,"y":56.36812193000003,"width":238.10414112776635,"height":9.962599749999981},{"text":"to 1.9 % at these skeletal sites [21]. Measured skeletal sites","fontSize":9.96259975,"x":51.02360153,"y":68.78351333994601,"width":238.08920034862695,"height":9.962599749999981},{"text":"included the hip (total hip, femoral neck), spine (posterior-","fontSize":9.96259975,"x":51.0246009780069,"y":81.25569146884106,"width":238.0842161373812,"height":9.962599749999981},{"text":"anterior), and total body. The bone turnover markers","fontSize":9.96259975,"x":51.0246009780069,"y":93.72786959773612,"width":238.1967933167988,"height":9.962599749999981},{"text":"(BTMs) included a marker for bone resorption assessed by","fontSize":9.96259975,"x":51.0246009780069,"y":106.1432610076821,"width":238.14996948930468,"height":9.962599749999981},{"text":"serum C-telopeptide crosslinks type I collagen (CTX,","fontSize":9.96259975,"x":51.0246009780069,"y":118.61543913657715,"width":238.08421542884128,"height":9.962599749999981},{"text":"Crosslaps, Osteometer Biotech, Herlev, Denmark). Bone for-","fontSize":9.96259975,"x":51.02460097800689,"y":131.0876172654722,"width":238.0862089880896,"height":9.962599749999981},{"text":"mation was assessed by serum intact N-terminal propeptide","fontSize":9.96259975,"x":51.02460097800689,"y":143.5030086754182,"width":238.2037676952267,"height":9.962599749999981},{"text":"type I procollagen (P1NP, Orion Diagnostica, Espoo, Fin-","fontSize":9.96259975,"x":51.02460097800689,"y":155.97518680431324,"width":238.04536197305129,"height":9.962599749999981},{"text":"land). Serum 25-hydroxy vitamin D was assessed by liquid","fontSize":9.96259975,"x":51.02460097800689,"y":168.4473649332083,"width":238.18683090713523,"height":9.962599749999981},{"text":"chromatography/mass spectrometry.","fontSize":9.96259975,"x":51.02460097800689,"y":180.86275634315427,"width":140.25447569688782,"height":9.962599749999981},{"text":"Sample size","fontSize":9.96259975,"x":51.02460097800689,"y":205.80711270057031,"width":46.80329730495238,"height":9.962599749999981},{"text":"Standard deviations of BMD improvement is approximately","fontSize":9.96259975,"x":51.02460097800689,"y":230.6946835345493,"width":238.10214898011867,"height":9.962599749999981},{"text":"4 % [22–24]. We conservatively assumed a 1-year dropout","fontSize":9.96259975,"x":51.02460097800689,"y":243.16686166344437,"width":238.08023158405456,"height":9.962599749999981},{"text":"rate of 20 % and zero BMD change in dropouts. Under this","fontSize":9.96259975,"x":51.02559972863182,"y":255.58225307339035,"width":238.17089090484458,"height":9.962599749999981},{"text":"assumption, we conservatively sought to detect 75 % of effect","fontSize":9.96259975,"x":51.02559972863182,"y":268.0544312022854,"width":238.1818497871847,"height":9.962599749999981},{"text":"actually attained by others [25] or 2.76 %. With 55 partici-","fontSize":9.96259975,"x":51.02559972863182,"y":280.5266093311804,"width":238.1698980307588,"height":9.962599749999981},{"text":"pants per arm, we estimated to have 89 % power to detect","fontSize":9.96259975,"x":51.02560152189973,"y":292.94200074112644,"width":238.17886171729407,"height":9.962599749999981},{"text":"statistical significance of such an effect in a two-tailed test at","fontSize":9.96259975,"x":51.02560152189973,"y":305.41417887002143,"width":238.18184922758553,"height":9.962599749999981},{"text":"α=0.05.","fontSize":9.96259975,"x":51.02560152189973,"y":317.8863569989164,"width":32.99114906545006,"height":9.962599749999981},{"text":"Statistical analysis","fontSize":9.96259975,"x":306.14287651291875,"y":56.36313505106932,"width":71.3561245790134,"height":9.962599749999981},{"text":"Analyses were performed on an intention-to-treat basis. To","fontSize":9.96259975,"x":306.14287651291875,"y":81.2517010491373,"width":238.10812889592387,"height":9.962599749999981},{"text":"compare baseline characteristics between subjects in the","fontSize":9.96259975,"x":306.14287651291875,"y":93.72387917803235,"width":238.03539962854325,"height":9.962599749999981},{"text":"active and placebo arms, we used independent sample t,","fontSize":9.96259975,"x":306.14287651291875,"y":106.13927058797833,"width":238.10514085343095,"height":9.962599749999981},{"text":"chi-squared, and Fisher’s exact tests. For the main analysis,","fontSize":9.96259975,"x":306.1428753174067,"y":118.61144871687338,"width":238.07027111062223,"height":9.962599749999981},{"text":"we fitted a series of linear mixed models, using raw and","fontSize":9.96259975,"x":306.1428753174067,"y":131.08362684576844,"width":238.12008215291723,"height":9.962599749999981},{"text":"percent change between baseline and follow-up assessment","fontSize":9.96259975,"x":306.1428753174067,"y":143.49901825571442,"width":238.07026869748177,"height":9.962599749999981},{"text":"in each of the BMD and biomarker measures as the depen-","fontSize":9.96259975,"x":306.1428753174067,"y":155.97119638460947,"width":238.1370180217599,"height":9.962599749999981},{"text":"dent variable; treatment arm (active/placebo), follow-up as-","fontSize":9.96259975,"x":306.1428753174067,"y":168.44337451350452,"width":238.16989460053617,"height":9.962599749999981},{"text":"sessment (6, 12, 18, 24 months) and their interaction as","fontSize":9.96259975,"x":306.1428753174067,"y":180.8587659234505,"width":238.04137700308866,"height":9.962599749999981},{"text":"fixed effects of interest; baseline value of the measure as a","fontSize":9.96259975,"x":306.1428753174067,"y":193.33094405234556,"width":238.09916014709313,"height":9.962599749999981},{"text":"fixed effect covariate; and a subject random effect to ac-","fontSize":9.96259975,"x":306.1428753174067,"y":205.8031221812406,"width":238.0632946027887,"height":9.962599749999981},{"text":"count for multiple measurements from the same participant","fontSize":9.96259975,"x":306.1428753174067,"y":218.2185135911866,"width":238.03041845479436,"height":9.962599749999981},{"text":"over time and the resulting nonindependence of observa-","fontSize":9.96259975,"x":306.1428753174067,"y":230.69069172008165,"width":238.11410423082657,"height":9.962599749999981},{"text":"tions. We used appropriately constructed contrasts to com-","fontSize":9.96259975,"x":306.1428753174067,"y":243.1628698489767,"width":238.04536195501942,"height":9.962599749999981},{"text":"pare treatment arms at each of the 6-, 12-, 18-, and 24-","fontSize":9.96259975,"x":306.1428753174067,"y":255.57826125892268,"width":238.0702685933719,"height":9.962599749999981},{"text":"month assessments. We assessed sensitivity of the results","fontSize":9.96259975,"x":306.1428753174067,"y":268.05043938781773,"width":238.09716765822645,"height":9.962599749999981},{"text":"to both last-value-carried-forward and multiple imputation","fontSize":9.96259975,"x":306.1428753174067,"y":280.5226175167127,"width":238.01049325320184,"height":9.962599749999981},{"text":"[26] approaches to missing data. To examine association","fontSize":9.96259975,"x":306.1428753174067,"y":292.93800892665877,"width":238.12008125319448,"height":9.962599749999981},{"text":"between early changes in markers of bone turnover with","fontSize":9.96259975,"x":306.14287501852874,"y":305.41018705555376,"width":238.08421636791599,"height":9.962599749999981},{"text":"more distal changes in BMD, we computed correlation","fontSize":9.96259975,"x":306.14287501852874,"y":317.88236518444876,"width":238.12904813005406,"height":9.962599749999981},{"text":"Risedronate (N=55)","fontSize":8.43879985,"x":246.42089843,"y":652.42610152,"width":66.59816453621514,"height":8.43879985000001},{"text":"Completed 12 months (N=50)","fontSize":6.13310003,"x":249.19183302355398,"y":662.8007024,"width":73.83823119117895,"height":6.133100030000037},{"text":"Completed 24 months (N=48)","fontSize":6.13310003,"x":249.19183302355398,"y":670.317429796768,"width":73.83823119117895,"height":6.133100029999923},{"text":"Lost to Follow-up (N=1)","fontSize":6.13310003,"x":249.19305964356002,"y":677.834157193536,"width":58.45518969470632,"height":6.133100029999923},{"text":"Discon\u0002nued Study (N=5)","fontSize":6.13310003,"x":249.19305964356002,"y":685.350884590304,"width":63.54014292957939,"height":6.133100030000037},{"text":"Died (N=1)","fontSize":6.13310003,"x":249.19305964356002,"y":692.912997172618,"width":26.69370457057201,"height":6.133100030000037},{"text":"Placebo (N=54)","fontSize":8.43879985,"x":367.97738647,"y":652.42610152,"width":52.29355491048034,"height":8.43879985000001},{"text":"Completed 12 months (N=50)","fontSize":6.13310003,"x":370.75077430356595,"y":662.8007024,"width":73.85479056187364,"height":6.133100030000037},{"text":"Completed 24 months (N=47)","fontSize":6.13310003,"x":370.75077430356595,"y":670.317429796768,"width":73.85479056187364,"height":6.133100029999923},{"text":"Lost to Follow-up (N=3)","fontSize":6.13310003,"x":370.74954768356,"y":677.834157193536,"width":58.45518969470635,"height":6.133100029999923},{"text":"Discon\u0002nued Study (N=4)","fontSize":6.13310003,"x":370.74954768356,"y":685.350884590304,"width":63.53891631079995,"height":6.133100030000037},{"text":"Randomized","fontSize":8.43879985,"x":328.27261352,"y":553.88459762,"width":42.67416695977715,"height":8.438799849999896},{"text":"N=109","fontSize":8.43879985,"x":338.37132504733097,"y":573.436453076853,"width":22.489401600250005,"height":8.438799849999896},{"text":"Randomized","fontSize":8.43879985,"x":328.27261352,"y":553.88459762,"width":42.67416695977715,"height":8.438799849999896},{"text":"N=109","fontSize":8.43879985,"x":338.37132504733097,"y":573.436453076853,"width":22.489401600250005,"height":8.438799849999896},{"text":"Withdrew","fontSize":8.43879985,"x":481.09280395,"y":553.88459762,"width":34.31216019009997,"height":8.438799849999896},{"text":"N=1","fontSize":8.43879985,"x":491.28349864886,"y":573.436453076853,"width":13.929083032409949,"height":8.438799849999896},{"text":"Consent","fontSize":8.43879985,"x":366.31640625,"y":447.23008711999995,"width":28.145085259720133,"height":8.43879985000001},{"text":"N=110","fontSize":8.43879985,"x":369.175471723568,"y":466.78194257685294,"width":22.489401600250005,"height":8.43879985000001},{"text":"Refused","fontSize":8.43879985,"x":210.82150268,"y":450.09019453999997,"width":27.751837186709935,"height":8.43879985000001},{"text":"N=172","fontSize":8.43879985,"x":213.450188917663,"y":469.641206960748,"width":22.489401600250005,"height":8.43879985000001},{"text":"Contacts","fontSize":8.43879985,"x":328.08859252,"y":345.78471357999996,"width":29.94676902769487,"height":8.43879985000001},{"text":"N=282","fontSize":8.43879985,"x":331.870018732785,"y":365.291842975708,"width":22.489401600250005,"height":8.43879985000001},{"text":"Fig. 1 Enrollment and study","fontSize":8.46819972,"x":51.02360153,"y":342.00738891000003,"width":96.1335440686068,"height":8.468199719999973},{"text":"design flowchart—CONSORT","fontSize":8.46819972,"x":51.02360152999999,"y":351.98546880944,"width":101.49221895945759,"height":8.468199719999973},{"text":"diagram","fontSize":8.46819972,"x":51.0235984814481,"y":361.96354870888,"width":26.81709486702953,"height":8.468199719999973}],"graphicsBounds":[{"operationIndex":191,"kind":"path","normalizedRect":[0.68359375,0.796875,0.69140625,0.828125]},{"operationIndex":193,"kind":"path","normalizedRect":[0.47265625,0.796875,0.48046875,0.828125]},{"operationIndex":195,"kind":"path","normalizedRect":[0.47265625,0.796875,0.69140625,0.8046875]},{"operationIndex":197,"kind":"path","normalizedRect":[