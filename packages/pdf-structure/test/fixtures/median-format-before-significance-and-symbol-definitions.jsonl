[["page"],{"width":595.276,"height":793.701,"pageNumber":1,"lines":[{"text":"Values are median (q1, q3) or number (proportion).","fontSize":6.8,"x":46,"y":679.7852,"width":131.512,"height":6.800000000000068},{"text":"For other outcomes, a two-sided p<0.05 was regarded as statistically significant.","fontSize":6.8,"x":46,"y":687.9452000000001,"width":206.51599999999996,"height":6.7999999999999545},{"text":"*Non-inferiority p value with a margin of 1 for PACU worst resting pain score in 30 min and −8 for QoR-15 score at 24 hours after surgery.","fontSize":6.8,"x":46,"y":696.1052000000001,"width":355.19120000000004,"height":6.7999999999999545},{"text":"†For resting NRS pain score, a two-sided p<0.0125 was considered statistically significant after Bonferroni correction.","fontSize":6.8,"x":46.00000000000006,"y":704.2652,"width":301.2943999999998,"height":6.800000000000068},{"text":"‡Differential p value.","fontSize":6.8,"x":46,"y":712.4252000000001,"width":53.611200000000025,"height":6.7999999999999545},{"text":"§For QoR- 15 domains at 24 hours, a two-sided p<0.01 was considered statistically significant after Bonferroni correction.","fontSize":6.8,"x":46,"y":720.5852000000001,"width":310.86199999999985,"height":6.7999999999999545},{"text":"ITPB, intertransverse process block; NA, not applicable; NRS, numerical rating scale; PACU, postanesthesia care unit; PCA, patient-controlled analgesia; QoR-15, 15-item quality of recovery; TPVB,","fontSize":6.8,"x":46,"y":728.7452000000001,"width":496.17560000000014,"height":6.7999999999999545},{"text":"thoracic paravertebral block.","fontSize":6.8,"x":46.00000000000006,"y":736.9052000000001,"width":73.6304,"height":6.7999999999999545}]}]
