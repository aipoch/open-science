[["page","captionStarts",0],{"text":"Table 1. Treatment plan for CBTi.p. and PE.","fontSize":7.9999,"x":48.0188,"y":50.45010000000002,"width":135.41430729999996,"height":7.999900000000025}]
[["page","headingCandidates"],[]]
[["page","lines"],[]]
[["page","lines",0],{"text":"therapists facilitated treatment delivery, the majority (67%) of whom facilitated both CBTi.p. and PE","fontSize":10,"x":48.0188,"y":509.024,"width":407.9870000000001,"height":10}]
[["page","lines",1],{"text":"sessions.","fontSize":10,"x":48.0188,"y":520.986,"width":34.46000000000001,"height":10}]
[["page","lines",2],{"text":"CBTi.p. was grounded in empirically supported CBT for insomnia, CBT for pain, CBT for anxiety/","fontSize":10,"x":59.9808,"y":533.004,"width":396.03900000000016,"height":10}]
[["page","lines",3],{"text":"depression and Cognitive Behavioral Stress Management interventions for individuals with cancer","fontSize":10,"x":48.01880000000007,"y":545.023,"width":407.957,"height":10}]
[["page","lines",4],{"text":"(Antoni, 2003; McCrae, 2014; McCrae et al., 2019; Waxenberg, 2008). Treatment components are listed","fontSize":10,"x":48.01880000000014,"y":556.985,"width":407.9559999999998,"height":10}]
[["page","lines",5],{"text":"in Table 1. Strategies unique to CBT for insomnia included psychoeducation on insomnia, sleep hygiene,","fontSize":10,"x":48.01880000000014,"y":569.004,"width":408.0039999999998,"height":10}]
[["page","lines",6],{"text":"stimulus control, and sleep restriction; strategies unique to CBT for pain included psychoeducation on","fontSize":10,"x":48.01880000000014,"y":581.023,"width":407.97799999999984,"height":10}]
[["page","lines",7],{"text":"the gate control theory of pain and activity pacing; strategies common among all three interventions","fontSize":10,"x":48.01880000000014,"y":592.985,"width":407.9549999999997,"height":10}]
[["page","lines",8],{"text":"included relaxation, cognitive restructuring, pleasant activity scheduling, and self-monitoring/home-","fontSize":10,"x":48.01880000000014,"y":605.004,"width":407.98699999999985,"height":10}]
[["page","lines",9],{"text":"work. PE was developed utilizing peer-reviewed and expert-verified materials available publicly (e.g.,","fontSize":10,"x":48.0188,"y":617.023,"width":407.9939999999999,"height":10}]
[["page","lines",10],{"text":"LIVESTRONG Guidebook). While PE was matched to CBTi.p. on level of attention and time, it did not","fontSize":10,"x":48.0188,"y":628.985,"width":407.96,"height":10}]
[["page","lines",11],{"text":"incorporate cognitive behavioral approaches integral for improved psychophysiological outcomes.","fontSize":10,"x":48.01880000000007,"y":641.004,"width":388.76499999999976,"height":10}]
