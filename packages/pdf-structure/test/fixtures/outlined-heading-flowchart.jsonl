[["page","lines"],[{"text":"680 www.revistachirurgia.ro Chirurgia, 119 (6), 2024","fontSize":8,"x":58.8049,"y":739.0118,"width":464.90879999999925,"height":8},{"text":"A.K. Ebrahim et al","fontSize":8,"x":58.8049,"y":36.20270000000005,"width":56.80480000000004,"height":8},{"text":"operative identification of SLNB and were","fontSize":11,"x":58.8049,"y":317.922,"width":226.78699999999978,"height":11},{"text":"excluded and underwent ALND. Six patients","fontSize":11,"x":58.8049,"y":331.122,"width":226.79579999999996,"height":11},{"text":"were lost to follow-up.","fontSize":11,"x":58.8049,"y":344.322,"width":105.82879999999994,"height":11},{"text":"All patients had the usual work-up for","fontSize":11,"x":72.97840000000001,"y":357.522,"width":212.62010000000026,"height":11},{"text":"LABC in the form of a chest, abdomen, and","fontSize":11,"x":58.8049,"y":370.722,"width":226.79360000000005,"height":11},{"text":"pelvis CT. Immuno-histochemical studies","fontSize":11,"x":58.8049,"y":383.92199999999997,"width":226.77049999999983,"height":11},{"text":"were performed for ER, PR, HER2/neu","fontSize":11,"x":58.8049,"y":397.12199999999996,"width":226.7759999999998,"height":11},{"text":"receptors, and Ki67 proliferation index (PI).","fontSize":11,"x":58.8049,"y":410.32199999999995,"width":215.89920000000026,"height":11},{"text":"All study subjects received NACT, consisting","fontSize":11,"x":72.97840000000001,"y":423.52199999999993,"width":212.62779999999992,"height":11},{"text":"of sequential anthracycline/taxane-based","fontSize":11,"x":58.8049,"y":436.7219999999999,"width":226.77380000000002,"height":11},{"text":"chemo-therapy administered for 6-8 cycles with","fontSize":11,"x":58.8049,"y":449.9219999999999,"width":226.79799999999986,"height":11},{"text":"regular clinical and radiological assessment","fontSize":11,"x":58.8049,"y":463.1219999999999,"width":226.80239999999995,"height":11},{"text":"of response.","fontSize":11,"x":58.8049,"y":476.3219999999999,"width":56.82599999999994,"height":11},{"text":"In HER2-positive cases, Trastuzumab target","fontSize":11,"x":72.97840000000001,"y":489.5219999999999,"width":212.6123999999997,"height":11},{"text":"therapy was added.","fontSize":11,"x":58.8049,"y":502.72199999999987,"width":94.63299999999995,"height":11},{"text":"Before initiation of NACT, a surgical plan is","fontSize":11,"x":72.97840000000001,"y":515.9219999999998,"width":212.63329999999996,"height":11},{"text":"decided based on tumour and breast sizes,","fontSize":11,"x":58.8049,"y":529.1219999999998,"width":226.7957999999999,"height":11},{"text":"multifocality, multicentricity, intra-ductal","fontSize":11,"x":58.8049,"y":542.3219999999999,"width":226.77600000000004,"height":11},{"text":"extension, and the presence and extent of","fontSize":11,"x":58.8049,"y":555.5219999999998,"width":226.80679999999987,"height":11},{"text":"suspicious micro-calcifications. The surgical","fontSize":11,"x":58.8049,"y":568.7219999999998,"width":226.79799999999986,"height":11},{"text":"decision was then revalidated by the MDT after","fontSize":11,"x":58.8049,"y":581.9219999999998,"width":226.80019999999976,"height":11},{"text":"NACT within the context of tumour response","fontSize":11,"x":58.8049,"y":595.1219999999998,"width":226.8023999999999,"height":11},{"text":"to treatment in addition to the previously","fontSize":11,"x":58.8049,"y":608.3219999999998,"width":226.78589999999994,"height":11},{"text":"mentioned factors.","fontSize":11,"x":58.8049,"y":621.5219999999997,"width":89.42119999999997,"height":11},{"text":"As for the axilla, patients enrolled in this","fontSize":11,"x":72.97840000000001,"y":634.7219999999998,"width":212.62120000000039,"height":11},{"text":"study were randomized into two groups, i.e.,","fontSize":11,"x":58.8049,"y":647.9219999999998,"width":226.80130000000017,"height":11},{"text":"Group A, where patients underwent ALND,","fontSize":11,"x":58.8049,"y":661.1219999999997,"width":226.8035000000003,"height":11},{"text":"and Group B, where patients underwent","fontSize":11,"x":58.8049,"y":674.3219999999997,"width":226.80129999999988,"height":11},{"text":"SLNB followed by ART.","fontSize":11,"x":58.8049,"y":687.5219999999997,"width":116.24140000000008,"height":11},{"text":"Selected eligible patients were randomized","fontSize":11,"x":296.9318,"y":344.2427999999997,"width":226.7815000000001,"height":11},{"text":"through a closed envelope technique (chosen","fontSize":11,"x":296.9318,"y":357.4427999999997,"width":226.80460000000045,"height":11},{"text":"randomly by an assigned nurse) into two","fontSize":11,"x":296.9318,"y":370.6427999999997,"width":226.79580000000038,"height":11},{"text":"groups:","fontSize":11,"x":296.9318,"y":383.84279999999967,"width":36.37480000000011,"height":11},{"text":"Group A (Control Group): underwent","fontSize":11,"x":311.1053,"y":402.81999999999965,"width":165.132,"height":11},{"text":"ALND according to the protocol of the","fontSize":11,"x":311.1046,"y":416.0245,"width":170.39660000000003,"height":11},{"text":"department.","fontSize":11,"x":311.1046,"y":429.2309,"width":56.10989999999998,"height":11},{"text":"Patients were positioned supine with","fontSize":11,"x":311.1046,"y":449.4165,"width":212.63109999999972,"height":11},{"text":"arms extended at \u2264 90 degrees abducted from","fontSize":11,"x":296.9311,"y":462.6165,"width":226.76609999999994,"height":11},{"text":"the chest wall to avoid overstretching of the","fontSize":11,"x":296.9311,"y":475.81649999999996,"width":226.7825999999999,"height":11},{"text":"brachial plexus. The incision would vary","fontSize":11,"x":296.9311,"y":489.01649999999995,"width":226.81559999999934,"height":11},{"text":"depending on the surgery being performed.","fontSize":11,"x":296.9311,"y":502.21649999999994,"width":226.78150000000005,"height":11.000000000000057},{"text":"For patients undergoing ALND concurrently","fontSize":11,"x":296.9311,"y":515.4164999999999,"width":226.78919999999994,"height":11},{"text":"with BCS, a curvilinear incision is made","fontSize":11,"x":296.9311,"y":528.6164999999999,"width":226.7979999999999,"height":11},{"text":"approximately 1 to 2 cm below the edge of","fontSize":11,"x":296.9311,"y":541.8164999999999,"width":226.7693999999999,"height":11},{"text":"the axillary hairline following the natural","fontSize":11,"x":296.9311,"y":555.0165,"width":226.7903,"height":11},{"text":"skin folds, extending from the anterior to","fontSize":11,"x":296.9311,"y":568.2164999999999,"width":226.78699999999992,"height":11},{"text":"the posterior axillary fold. For patients","fontSize":11,"x":296.9311,"y":581.4164999999998,"width":226.79799999999977,"height":11},{"text":"under-going a standard, modified radical","fontSize":11,"x":296.9311,"y":594.6164999999999,"width":226.76280000000008,"height":11},{"text":"mastectomy without reconstruction, ALND","fontSize":11,"x":296.9311,"y":607.8164999999999,"width":226.7847999999999,"height":11},{"text":"was performed through the mastectomy","fontSize":11,"x":296.9311,"y":621.0164999999998,"width":226.7946999999997,"height":11},{"text":"incision once the breast had been removed.","fontSize":11,"x":296.9311,"y":634.2164999999998,"width":226.78699999999992,"height":11},{"text":"For patients undergoing oncoplastic breast","fontSize":11,"x":296.9311,"y":647.4164999999998,"width":226.77819999999997,"height":11},{"text":"surgery, ALND was performed from the same","fontSize":11,"x":296.9311,"y":660.6164999999999,"width":226.78370000000007,"height":11},{"text":"skin incision if feasible.","fontSize":11,"x":296.9311,"y":673.8164999999998,"width":118.77140000000009,"height":11},{"text":"Figure 1. Consort diagram of patients","fontSize":8,"x":59.3597,"y":75.85180000000003,"width":127.33920000000006,"height":8},{"text":"included in the study.","fontSize":8,"x":98.3597,"y":85.45900000000006,"width":67.67920000000004,"height":8}]]
