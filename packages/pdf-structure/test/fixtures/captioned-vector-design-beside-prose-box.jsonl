[["page","lines",99],{"text":"from the date","fontSize":6.146599769,"x":390.523372509244,"y":649.3640466766,"width":36.215765838948016,"height":6.14659976900009}]
[["page","lines",100],{"text":"of last patient","fontSize":6.146599769,"x":390.35126771571197,"y":656.7399663994,"width":36.559975426012045,"height":6.146599768999977}]
[["page","lines",101],{"text":"enrolled","fontSize":6.146599769,"x":398.550831807558,"y":664.1158861222,"width":21.863455378333015,"height":6.146599768999977}]
