[["page","headingCandidates",0],{"text":"2 Methods","fontSize":12,"x":51.001998901,"y":462.921114747,"width":59.93880000000002,"height":12}]
[["page","headingCandidates",1],{"text":"2.1 Study Design","fontSize":11,"x":51.001998901,"y":488.921114747,"width":80.045899932856,"height":11}]
[["page","lines"],[]]
[["page","lines",0],{"text":"434 J. Stebbing et al.","fontSize":8.5,"x":51.023601531,"y":30.711092774000008,"width":493.22949376950015,"height":8.5}]
[["page","lines",1],{"text":"Key Points","fontSize":10,"x":57.3736,"y":66.25577050799996,"width":46.59200000382001,"height":10}]
[["page","lines",2],{"text":"The equivalent efficacy and comparable safety and","fontSize":10,"x":57.8236,"y":90.86581689499997,"width":201.88799999999998,"height":10}]
[["page","lines",3],{"text":"immunogenicity of CT-P6 to reference trastuzumab was","fontSize":10,"x":57.8236,"y":103.36581689499997,"width":223.67799999999994,"height":10}]
[["page","lines",4],{"text":"demonstrated in the randomised, Phase 3 CT-P6 3.2","fontSize":10,"x":57.8236,"y":115.86581689499997,"width":207.65800001526003,"height":10}]
[["page","lines",5],{"text":"study, which compared the products administered as neo-","fontSize":10,"x":57.8236,"y":128.36581689499997,"width":229.05799999999994,"height":10}]
[["page","lines",6],{"text":"adjuvant and post-surgery adjuvant treatment in patients","fontSize":10,"x":57.8236,"y":140.86581689499997,"width":224.36899999999997,"height":10}]
[["page","lines",7],{"text":"with human epidermal growth factor receptor-2 (HER2)-","fontSize":10,"x":57.8236,"y":153.36581689499997,"width":227.27799999617997,"height":10}]
[["page","lines",8],{"text":"positive early breast cancer.","fontSize":10,"x":57.8236,"y":165.86581689499997,"width":110.52900000000008,"height":10}]
[["page","lines",9],{"text":"The current study, CT-P6 4.2, was a further 3-year exten-","fontSize":10,"x":57.8236,"y":183.97568017599997,"width":228.80699999235986,"height":10}]
[["page","lines",10],{"text":"sion to the 3 years of follow-up included in the CT-P6","fontSize":10,"x":57.8236,"y":196.47568017599997,"width":215.42900001526,"height":10}]
[["page","lines",11],{"text":"3.2 study, providing efficacy data after a median of 76.4","fontSize":10,"x":57.8236,"y":208.97568017599997,"width":223.13899999618002,"height":10}]
[["page","lines",12],{"text":"months of follow-up.","fontSize":10,"x":57.8236,"y":221.47568017599997,"width":84.02000000000004,"height":10}]
[["page","lines",13],{"text":"Our data extend the findings of the CT-P6 3.2 study,","fontSize":10,"x":57.8236,"y":239.58578759800002,"width":208.81800001526,"height":10}]
[["page","lines",14],{"text":"demonstrating the comparable long-term effects of","fontSize":10,"x":57.8236,"y":252.08578759800002,"width":202.52799999618003,"height":10}]
[["page","lines",15],{"text":"CT-P6 and reference trastuzumab on overall survival,","fontSize":10,"x":57.8236,"y":264.585787598,"width":213.35800001525996,"height":10}]
[["page","lines",16],{"text":"disease-free survival, and progression-free survival over","fontSize":10,"x":57.8236,"y":277.085787598,"width":224.44699999617984,"height":10}]
[["page","lines",17],{"text":"up to 6 years.","fontSize":10,"x":57.8236,"y":289.585787598,"width":53.63000000000001,"height":10}]
[["page","lines",18],{"text":"and 39.6 months of follow-up in the CT-P6 and reference","fontSize":10,"x":51.0036,"y":327.425787598,"width":238.10999999999973,"height":10}]
[["page","lines",19],{"text":"trastuzumab groups, respectively, median DFS, PFS and OS","fontSize":10,"x":51.0036,"y":339.925787598,"width":238.27200000192022,"height":10}]
[["page","lines",20],{"text":"were not reached [5].","fontSize":10,"x":51.0036,"y":352.425787598,"width":85.11999786000001,"height":10}]
[["page","lines",21],{"text":"This article reports the findings of the CT-P6 4.2 study—","fontSize":10,"x":62.33359897,"y":364.925787598,"width":226.81400000761997,"height":10}]
[["page","lines",22],{"text":"an extended observational follow-up study of patients in the","fontSize":10,"x":50.993598969999994,"y":377.425787598,"width":238.15300001144016,"height":10}]
[["page","lines",23],{"text":"CT-P6 3.2 study—which was conducted to provide addi-","fontSize":10,"x":50.993598969999994,"y":389.925787598,"width":238.15700000381986,"height":10}]
[["page","lines",24],{"text":"tional long-term data on the efficacy of CT-P6 relative to","fontSize":10,"x":50.993598969999994,"y":402.425787598,"width":237.97999999236976,"height":10}]
[["page","lines",25],{"text":"reference trastuzumab. We report survival outcomes after a","fontSize":10,"x":50.993598969999994,"y":414.925787598,"width":238.09700000762024,"height":10}]
[["page","lines",26],{"text":"period of up to 6 years.","fontSize":10,"x":50.993598969999994,"y":427.425787598,"width":93.22400000382004,"height":10}]
[["page","lines",27],{"text":"2 Methods","fontSize":12,"x":51.001998901,"y":462.921114747,"width":59.93880000000002,"height":12}]
[["page","lines",28],{"text":"2.1 Study Design","fontSize":11,"x":51.001998901,"y":488.921114747,"width":80.045899932856,"height":11}]
[["page","lines",29],{"text":"The CT-P6 4.2 study (EudraCT number: 2019-003518-15)","fontSize":10,"x":51.001998901,"y":514.921114747,"width":238.1000000000004,"height":10}]
[["page","lines",30],{"text":"was a multicentre, observational, extended follow-up study","fontSize":10,"x":51.001998901,"y":527.421114747,"width":238.11000000000038,"height":10}]
[["page","lines",31],{"text":"of patients who completed the last follow-up visit in the","fontSize":10,"x":51.001998901,"y":539.921114747,"width":238.1820000076399,"height":10}]
[["page","lines",32],{"text":"CT-P6 3.2 study. In countries where CT-P6 had already","fontSize":10,"x":51.001998901,"y":552.421114747,"width":238.14700004005985,"height":10}]
[["page","lines",33],{"text":"received regulatory approval, CT-P6 4.2 was conducted as","fontSize":10,"x":51.001998901,"y":564.921114747,"width":237.98799999999997,"height":10}]
[["page","lines",34],{"text":"a Phase 4 study. In all other countries (Belarus, Russia and","fontSize":10,"x":51.001998901,"y":577.421114747,"width":238.12900000000045,"height":10}]
[["page","lines",35],{"text":"Ukraine), it was considered a Phase 3 study.","fontSize":10,"x":51.001998901,"y":589.921114747,"width":177.08300000000025,"height":10}]
[["page","lines",36],{"text":"Full details of the study design for the randomised,","fontSize":10,"x":62.341998901,"y":602.421114747,"width":226.60499999235986,"height":10}]
[["page","lines",37],{"text":"double-blind, active-controlled CT-P6 3.2 study, includ-","fontSize":10,"x":51.00199890099999,"y":614.921114747,"width":238.2190000114502,"height":10}]
[["page","lines",38],{"text":"ing randomisation procedures, have been published pre-","fontSize":10,"x":51.00199890099999,"y":627.421114747,"width":238.1090000000001,"height":10}]
[["page","lines",39],{"text":"viously [3, 4]. In brief, patients were recruited into the","fontSize":10,"x":51.00199890099999,"y":639.921114747,"width":238.08300000762983,"height":10}]
[["page","lines",40],{"text":"CT-P6 3.2 study from 112 centres across 23 countries.","fontSize":10,"x":51.001998900999986,"y":652.421114747,"width":238.0179999847502,"height":10}]
[["page","lines",41],{"text":"Neoadjuvant treatment consisted of eight 3-week cycles","fontSize":10,"x":51.001998900999986,"y":664.921114747,"width":237.93700000000018,"height":10}]
[["page","lines",42],{"text":"of CT-P6 (Herzuma","fontSize":10,"x":51.001998900999986,"y":677.421114747,"width":80.51499999999999,"height":10}]
[["page","lines",43],{"text":"®","fontSize":7,"x":131.598297119,"y":676.4211,"width":5.319999999999993,"height":7}]
[["page","lines",44],{"text":"; Celltrion, Inc., Incheon, Republic of","fontSize":10,"x":136.977905273,"y":677.4211,"width":152.14500000000012,"height":10}]
[["page","lines",45],{"text":"Korea) or reference trastuzumab (Herceptin","fontSize":10,"x":50.997909553,"y":689.9211,"width":180.48000000000002,"height":10}]
[["page","lines",46],{"text":"®","fontSize":7,"x":231.634094238,"y":688.9211,"width":5.319999999999993,"height":7}]
[["page","lines",47],{"text":"; Genentech,","fontSize":10,"x":237.05909729,"y":689.9211,"width":52.0499999999999,"height":10}]
[["page","lines",48],{"text":"San Francisco, CA, USA), consisting of a loading dose","fontSize":10,"x":50.99909729000001,"y":702.4211,"width":238.20900001907984,"height":10}]
[["page","lines",49],{"text":"of 8 mg/kg on Day 1 of Cycle 1 followed by 6 mg/kg on","fontSize":10,"x":306.13909729,"y":55.25107132000005,"width":238.08699999808982,"height":10}]
[["page","lines",50],{"text":"Day 1 of Cycles 2–8, with docetaxel and fluorouracil, epiru-","fontSize":10,"x":306.13909729,"y":67.75107132000005,"width":238.12699999617996,"height":10}]
[["page","lines",51],{"text":"bicin and cyclophosphamide, followed by surgery. Post-sur-","fontSize":10,"x":306.13909729,"y":80.25107132000005,"width":238.11000000000035,"height":10}]
[["page","lines",52],{"text":"gery, patients received up to ten cycles of adjuvant CT-P6 or","fontSize":10,"x":306.13909729000005,"y":92.75107132000005,"width":237.89900001144082,"height":10}]
[["page","lines",53],{"text":"reference trastuzumab (6 mg/kg administered every 3 weeks,","fontSize":10,"x":306.13909729000005,"y":105.25107132000005,"width":238.1839999961898,"height":10}]
[["page","lines",54],{"text":"per original randomisation), and were followed for up to 3","fontSize":10,"x":306.13909729000005,"y":117.75107132000005,"width":237.9099999961797,"height":10}]
[["page","lines",55],{"text":"years from the date of enrolment of the last patient.","fontSize":10,"x":306.13909729000005,"y":130.25107132000005,"width":206.16200000000055,"height":10}]
[["page","lines",56],{"text":"Patients who completed the last follow-up visit of the","fontSize":10,"x":317.47909729,"y":142.75107132000005,"width":226.75500001145974,"height":10}]
[["page","lines",57],{"text":"CT-P6 3.2 study could participate in the CT-P6 4.2 study,","fontSize":10,"x":306.13909729000005,"y":155.25107132000005,"width":237.90900004196106,"height":10}]
[["page","lines",58],{"text":"and could be enrolled irrespective of their study treatment","fontSize":10,"x":306.13909729000005,"y":167.75107132000005,"width":238.17099999617955,"height":10}]
[["page","lines",59],{"text":"completion status (Fig. 1). No study drugs were adminis-","fontSize":10,"x":306.13909729000005,"y":180.25107132000005,"width":238.13900000381994,"height":10}]
[["page","lines",60],{"text":"tered during the CT-P6 4.2 study.","fontSize":10,"x":306.13909844000005,"y":192.75107132000005,"width":134.24300000000022,"height":10}]
[["page","lines",61],{"text":"At the on-site enrolment visit, data regarding survival","fontSize":10,"x":317.47909844000003,"y":205.25107132000005,"width":226.80000000000007,"height":10}]
[["page","lines",62],{"text":"status, disease progression/recurrence and initiation of any","fontSize":10,"x":306.13909844000005,"y":217.75107132000005,"width":238.10899999618022,"height":10}]
[["page","lines",63],{"text":"anticancer therapies since the end of the CT-P6 3.2 study","fontSize":10,"x":306.13909844000005,"y":230.25107132000005,"width":237.98600000763003,"height":10}]
[["page","lines",64],{"text":"were collected directly from the patients or obtained from","fontSize":10,"x":306.13909844000005,"y":242.75107132000005,"width":238.14600000000115,"height":10}]
[["page","lines",65],{"text":"medical charts. For patients who died during the ~ 1-year","fontSize":10,"x":306.13909844000005,"y":255.25107132000005,"width":238.27200001335012,"height":10}]
[["page","lines",66],{"text":"period between the end of their participation in the CT-P6","fontSize":10,"x":306.13909844000005,"y":267.75107132000005,"width":238.17800000571987,"height":10}]
[["page","lines",67],{"text":"3.2 study and the beginning of the current study, survival","fontSize":10,"x":306.13909844000005,"y":280.25107132000005,"width":238.13200001143952,"height":10}]
[["page","lines",68],{"text":"data, assessment dates for progressive/recurrent disease, and","fontSize":10,"x":306.13909844000005,"y":292.75107132000005,"width":238.08500000382145,"height":10}]
[["page","lines",69],{"text":"the start date of breast cancer-related therapy were retrospec-","fontSize":10,"x":306.13909844000005,"y":305.25107132000005,"width":238.14599999236037,"height":10}]
[["page","lines",70],{"text":"tively collected from medical charts or patients’ relatives,","fontSize":10,"x":306.13909844000005,"y":317.75107132000005,"width":238.26600003815014,"height":10}]
[["page","lines",71],{"text":"where possible.","fontSize":10,"x":306.13909844000005,"y":330.25107132000005,"width":62.7650000000001,"height":10}]
[["page","lines",72],{"text":"After enrolment in the CT-P6 4.2 study, survival status,","fontSize":10,"x":317.47909844000003,"y":342.75107132000005,"width":226.93600002098958,"height":10}]
[["page","lines",73],{"text":"disease progression/recurrence, and anticancer treatment","fontSize":10,"x":306.13909844000005,"y":355.25107132000005,"width":237.91099999236025,"height":10}]
[["page","lines",74],{"text":"initiation data were collected via telephone every 6 months","fontSize":10,"x":306.13909844000005,"y":367.75107132000005,"width":238.09000000000043,"height":10}]
[["page","lines",75],{"text":"(± 21 days). Data were collected from the patients, their","fontSize":10,"x":306.1390984400001,"y":380.25107132000005,"width":238.18899999999996,"height":10}]
[["page","lines",76],{"text":"medical charts, or from relatives in case of patient death.","fontSize":10,"x":306.1390984400001,"y":392.75107132000005,"width":237.9739999961896,"height":10}]
[["page","lines",77],{"text":"Patient data collection ceased with a final visit or telephone","fontSize":10,"x":306.1390984400001,"y":405.25107132000005,"width":238.3180000038202,"height":10}]
[["page","lines",78],{"text":"call at the end of the 3-year CT-P6 4.2 study follow-up","fontSize":10,"x":306.1390984400001,"y":417.75107132000005,"width":238.19999999239076,"height":10}]
[["page","lines",79],{"text":"period, upon withdrawal of the patient from the study, or","fontSize":10,"x":306.1390984400001,"y":430.25107132000005,"width":238.21300000380882,"height":10}]
[["page","lines",80],{"text":"with the death of the patient.","fontSize":10,"x":306.1390984400001,"y":442.75107132000005,"width":115.5730000000002,"height":10}]
[["page","lines",81],{"text":"The study was conducted in accordance with the ethical","fontSize":10,"x":317.4790984400001,"y":455.25107132000005,"width":226.7390000000001,"height":10}]
[["page","lines",82],{"text":"principles originating in the Declaration of Helsinki, Good","fontSize":10,"x":306.1390984400001,"y":467.75107132000005,"width":238.11000000000047,"height":10}]
[["page","lines",83],{"text":"Clinical Practice, and all applicable laws or regulations.","fontSize":10,"x":306.1390984400001,"y":480.25107132000005,"width":238.16499999999985,"height":10}]
[["page","lines",84],{"text":"Before the start of the study, the protocol, informed consent","fontSize":10,"x":306.1390984400001,"y":492.75107132000005,"width":237.98299999809876,"height":10}]
[["page","lines",85],{"text":"form, advertisements to be used for the recruitment of study","fontSize":10,"x":306.1390984400001,"y":505.25107132000005,"width":238.06000001145946,"height":10}]
[["page","lines",86],{"text":"patients, and any other written information to be provided to","fontSize":10,"x":306.1390984400001,"y":517.75107132,"width":238.27000001335057,"height":10}]
[["page","lines",87],{"text":"the patients were approved by the institutional review board","fontSize":10,"x":306.1390984400001,"y":530.25107132,"width":237.92899999426925,"height":10}]
[["page","lines",88],{"text":"and/or independent ethics committee at each site (Table S1;","fontSize":10,"x":306.1390984400001,"y":542.75107132,"width":238.0449999962085,"height":10}]
[["page","lines",89],{"text":"Online Supplemental Material (OSM), Resource 1). All","fontSize":10,"x":306.1390984400001,"y":555.25107132,"width":238.22800000000052,"height":10}]
[["page","lines",90],{"text":"patients provided written informed consent before entering","fontSize":10,"x":306.1390984400001,"y":567.75107132,"width":238.12,"height":10}]
[["page","lines",91],{"text":"the study.","fontSize":10,"x":306.1390984400001,"y":580.25107132,"width":38.504999999999995,"height":10}]
[["page","lines",92],{"text":"Enrolment","fontSize":6.146599769,"x":312.38889217400003,"y":638.763346891667,"width":6.146599768999977,"height":28.01005514733299}]
