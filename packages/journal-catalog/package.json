{
  "name": "@aipoch/journal-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "resources",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.6",
    "fflate": "0.8.3",
    "papaparse": "^5.7.0",
    "styled-exceljs": "0.21.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "@types/papaparse": "^5.5.2"
  }
}
