{
  "name": "@aipoch/compute",
  "version": "0.37.0",
  "private": true,
  "description": "Remote Compute execution protocols, scheduling and lifecycle",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "TESTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tsc.cjs -p tsconfig.json",
    "typecheck": "node tsc.cjs -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aipoch/diagnostics": "0.1.0",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/micromatch": "^4.0.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
