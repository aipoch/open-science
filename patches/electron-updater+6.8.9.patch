--- /dev/null
+++ b/node_modules/electron-updater/out/differentialDownloader/cancelRequest.js
@@ -0,0 +1,24 @@
+"use strict";
+const { CancellationError } = require("builder-util-runtime");
+// Range transfers bypass HttpExecutor.download's cancellation wiring. Keep cancellation
+// attached to the request even when the server has stopped delivering response bytes.
+exports.cancelRequest = (request, token, reject) => {
+    if (token == null) return true;
+    const cleanup = () => token.removeListener("cancel", cancel);
+    const cancel = () => {
+        cleanup();
+        reject(new CancellationError());
+        request.abort();
+    };
+    // Electron may close the upload side before delivering the response.
+    // Keep ownership until the response finishes or the request aborts/fails.
+    request.once("response", response => {
+        response.once("end", cleanup);
+        response.once("error", cleanup);
+        response.once("aborted", cleanup);
+    });
+    request.once("error", cleanup);
+    request.once("abort", cleanup);
+    token.onCancel(cancel);
+    return !token.cancelled;
+};
