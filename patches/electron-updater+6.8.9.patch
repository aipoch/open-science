+"use strict";
+const { CancellationError } = require("builder-util-runtime");
+// Request.close may describe only Electron's upload side. Own cancellation until
+// response completion, and explicitly abort when validation rejects a response.
+exports.configureRequestCancellation = (request, token, reject) => {
+    let response;
+    let cleaned = false;
+    const cleanup = () => {
+        if (cleaned) return;
+        cleaned = true;
+        if (token != null) token.removeListener("cancel", cancel);
+        request.removeListener("response", onResponse);
+        request.removeListener("error", cleanup);
+        request.removeListener("abort", cleanup);
+        if (response != null) {
+            response.removeListener("end", cleanup);
+            response.removeListener("error", cleanup);
+            response.removeListener("aborted", cleanup);
+        }
+    };
+    const fail = error => {
+        cleanup();
+        reject(error);
+        request.abort();
+    };
+    const cancel = () => fail(new CancellationError());
+    const onResponse = value => {
+        // The response callback may already have rejected its status or headers.
+        if (cleaned) return;
+        response = value;
+        response.once("end", cleanup);
+        response.once("error", cleanup);
+        response.once("aborted", cleanup);
+    };
+    request.once("response", onResponse);
+    request.once("error", cleanup);
+    request.once("abort", cleanup);
+    if (token != null) token.onCancel(cancel);
+    return fail;
+};
