+import { spawn } from "node:child_process";
+import { lstatSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+const absentProcess = (pid) => {
+    if (!Number.isSafeInteger(pid) || pid <= 0) return false;
+    try { process.kill(pid, 0); } catch (error) { return error.code === "ESRCH"; }
+    return false;
+};
+
+// Only reclaim complete receipts whose adapter AND CLI are gone. PID reuse or inaccessible
+// processes retain the files; an incomplete receipt may cover a crash during spawn and is retained.
+function recoverLaunchDirectories(root) {
+    for (const entry of readdirSync(root, { withFileTypes: true })) {
+        if (!/^launch-[a-zA-Z0-9]{6}$/.test(entry.name) || !entry.isDirectory() || entry.isSymbolicLink()) continue;
+        const directory = join(root, entry.name);
+        try {
+            const receipt = join(directory, "owner.json");
+            if (!lstatSync(receipt).isFile() || lstatSync(receipt).isSymbolicLink()) continue;
+            const owner = JSON.parse(readFileSync(receipt, "utf8"));
+            if (absentProcess(owner.pid) && absentProcess(owner.childPid)) {
+                rmSync(directory, { recursive: true, force: true });
+            }
+        } catch { /* Preserve uncertain ownership and retry a later launch. */ }
+    }
+}
+
+// Keep the SDK's default transport for ordinary sessions. The conservative threshold leaves room
+// for Windows quoting and the other flags in CreateProcessW's 32,767-character command line.
+export function needsFileConfiguration(options) {
+    if (process.platform !== "win32" || options.spawnClaudeCodeProcess) return false;
+    const servers = Object.fromEntries(Object.entries(options.mcpServers ?? {}).map(([name, server]) =>
+        [name, server.type === "sdk" ? { type: "sdk", name: server.name } : server]));
+    return JSON.stringify(servers).length + JSON.stringify(options.settings ?? {}).length > 8192;
+}
+
+// This is the SDK's supported process-launch hook. Rewrite only JSON-valued flags after the SDK
+// has serialized its MCP servers (including in-process SDK servers); preserve every other argument.
+export function spawnWithFileConfiguration(options, stderr) {
+    let directory;
+    let child;
+    const cleanup = () => {
+        if (!directory) return;
+        try {
+            rmSync(directory, { recursive: true, force: true, maxRetries: 3, retryDelay: 50 });
+        } catch {
+            // A later launch can retry from the ownership receipt. Never log configuration contents.
+        }
+    };
+    try {
+        const args = [...options.args];
+        for (let index = 0; index < args.length - 1; index++) {
+            if (args[index] !== "--mcp-config" && args[index] !== "--settings") continue;
+            const value = args[index + 1];
+            // Existing file paths stay paths. Only the SDK's inline JSON is moved to a file.
+            if (!value.trimStart().startsWith("{")) continue;
+            JSON.parse(value);
+            if (!directory) {
+                const configRoot = options.env.CLAUDE_CONFIG_DIR;
+                if (!configRoot) throw new Error("Claude config directory is required for file configuration.");
+                const root = join(configRoot, ".open-science-launch");
+                mkdirSync(root, { recursive: true, mode: 0o700 });
+                const rootInfo = lstatSync(root);
+                if (!rootInfo.isDirectory() || rootInfo.isSymbolicLink()) throw new Error("Invalid Claude launch directory.");
+                recoverLaunchDirectories(root);
+                directory = mkdtempSync(join(root, "launch-"));
+                writeFileSync(join(directory, "owner.json"), JSON.stringify({ pid: process.pid }), { flag: "wx", mode: 0o600 });
+            }
+            const file = join(directory, `${index}.json`);
+            writeFileSync(file, value, { encoding: "utf8", flag: "wx", mode: 0o600 });
+            args[++index] = file;
+        }
+        child = spawn(options.command, args, {
+            cwd: options.cwd,
+            env: options.env,
+            signal: options.signal,
+            stdio: ["pipe", "pipe", "pipe"],
+            windowsHide: true,
+        });
+        // The custom-spawn SDK contract leaves stderr ownership to the hook. Always drain it.
+        child.stderr.setEncoding("utf8");
+        child.stderr.on("data", (chunk) => stderr?.(chunk));
+        child.once("close", cleanup);
+        child.once("error", () => { if (!child.pid) cleanup(); });
+        if (directory && child.pid) {
+            writeFileSync(join(directory, "owner.json"), JSON.stringify({ pid: process.pid, childPid: child.pid }), { mode: 0o600 });
+        }
+        return child;
+    } catch (error) {
+        if (child?.pid) child.kill();
+        else cleanup();
+        throw error;
+    }
+}
