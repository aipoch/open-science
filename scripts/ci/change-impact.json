{
  "schemaVersion": 1,
  "alwaysLanes": ["policy"],
  "laneOrder": [
    "policy",
    "docs",
    "format",
    "lint",
    "typecheck_node",
    "typecheck_web",
    "interface_contracts",
    "cli_sdk",
    "i18n",
    "unit_macos",
    "linux_runtime",
    "windows_runtime",
    "windows_path",
    "build",
    "e2e_functional_macos",
    "e2e_functional_windows",
    "e2e_workspace_macos",
    "e2e_workspace_windows",
    "e2e_accessibility_macos",
    "e2e_visual_macos"
  ],
  "bundleOrder": [
    "policy",
    "static",
    "unit",
    "linux_runtime",
    "windows_core",
    "macos_e2e",
    "windows_e2e"
  ],
  "laneBundles": {
    "policy": "policy",
    "docs": "static",
    "format": "static",
    "lint": "static",
    "typecheck_node": "static",
    "typecheck_web": "static",
    "interface_contracts": "static",
    "cli_sdk": "static",
    "i18n": "static",
    "unit_macos": "unit",
    "linux_runtime": "linux_runtime",
    "windows_runtime": "windows_core",
    "windows_path": "windows_core",
    "build": "macos_e2e",
    "e2e_functional_macos": "macos_e2e",
    "e2e_functional_windows": "windows_e2e",
    "e2e_workspace_macos": "macos_e2e",
    "e2e_workspace_windows": "windows_e2e",
    "e2e_accessibility_macos": "macos_e2e",
    "e2e_visual_macos": "macos_e2e"
  },
  "rules": [
    {
      "id": "global_gate_input",
      "role": "global",
      "paths": [
        "package*.json",
        ".nvmrc",
        "tsconfig*.json",
        "vitest.config.*",
        "electron.vite.config.*",
        "vite.web.config.*",
        "playwright.config.*",
        "electron-builder.yml",
        "scripts/ci/**",
        ".github/workflows/pr-gate.yml"
      ],
      "mode": "full",
      "capabilities": []
    },
    {
      "id": "ci_integrity_surface",
      "role": "owner",
      "paths": [
        ".github/workflows/**",
        ".github/actions/**",
        ".github/dependabot.yml",
        ".github/CODEOWNERS",
        "CODEOWNERS"
      ],
      "capabilities": ["ci_integrity_surface"]
    },
    {
      "id": "documentation",
      "role": "owner",
      "paths": ["**/*.md", "docs/**", "LICENSE", ".gitignore"],
      "capabilities": ["documentation"]
    },
    {
      "id": "notebook_network_sandbox",
      "role": "owner",
      "paths": ["packages/notebook-network-sandbox/**"],
      "capabilities": ["notebook_network_sandbox"]
    },
    {
      "id": "shared_contract",
      "role": "owner",
      "fallbackOwner": true,
      "paths": ["src/shared/**"],
      "capabilities": ["shared_contract"]
    },
    {
      "id": "preload_contract",
      "role": "owner",
      "paths": ["src/preload/**"],
      "capabilities": ["preload_contract"]
    },
    {
      "id": "main_runtime",
      "role": "owner",
      "fallbackOwner": true,
      "paths": ["src/main/**"],
      "capabilities": ["main_runtime"]
    },
    {
      "id": "windows_sensitive",
      "role": "overlay",
      "paths": [
        "src/main/**/*windows*.ts",
        "src/main/**/*powershell*.ts",
        "src/main/**/*path*.ts",
        "src/main/**/*acl*.ts",
        "src/main/acp/agent-process.ts",
        "src/main/acp/claude-executable.ts",
        "src/main/acp/permission-broker.ts",
        "src/main/acp/restricted-runtime-profile.ts",
        "src/main/acp/runtime.ts",
        "src/main/agent-framework/codebuddy.ts",
        "src/main/agent-framework/codex.ts",
        "src/main/agent-framework/opencode.ts",
        "src/main/agent-framework/types.ts",
        "src/main/app-lifecycle.ts",
        "src/main/artifacts/durability.ts",
        "src/main/cli-install/launcher.ts",
        "src/main/compute/connection-adapters.ts",
        "src/main/compute/credential-vault.ts",
        "src/main/compute/scp-runner.ts",
        "src/main/compute/ssh-runner.ts",
        "src/main/crash-diagnostics.ts",
        "src/main/immutable-input-authority.ts",
        "src/main/index.ts",
        "src/main/lifecycle-shutdown.ts",
        "src/main/local-rpc-transport.ts",
        "src/main/notebook/environment-discovery.ts",
        "src/main/notebook/environment-state-tracker.ts",
        "src/main/notebook/execution-owner.ts",
        "src/main/notebook/kernel-executor.ts",
        "src/main/notebook/local-rpc-server.ts",
        "src/main/notebook/managed-runtime-guard.ts",
        "src/main/notebook/mcp-server.ts",
        "src/main/notebook/micromamba-cache-recovery.ts",
        "src/main/notebook/micromamba-cache.ts",
        "src/main/notebook/micromamba.ts",
        "src/main/notebook/network-sandbox-owner.ts",
        "src/main/notebook/package-listing.ts",
        "src/main/notebook/package-manager.ts",
        "src/main/notebook/package-process-sandbox.ts",
        "src/main/notebook/process-environment.ts",
        "src/main/notebook/provisioner-runtime.ts",
        "src/main/notebook/provisioner.ts",
        "src/main/notebook/python-command.ts",
        "src/main/notebook/r-command.ts",
        "src/main/notebook/shell-process.ts",
        "src/main/notebook/venv-overlay.ts",
        "src/main/notifications/desktop-attention.ts",
        "src/main/notifications/desktop-badge.ts",
        "src/main/process-tree.ts",
        "src/main/remote-access/remoteit.ts",
        "src/main/settings/agent-runtime-manager.ts",
        "src/main/settings/claude-detect.ts",
        "src/main/settings/claude-install.ts",
        "src/main/settings/codebuddy-detect.ts",
        "src/main/settings/codex-auth.ts",
        "src/main/settings/codex-detect.ts",
        "src/main/settings/environment-check.ts",
        "src/main/settings/managed-claude.ts",
        "src/main/settings/managed-codebuddy.ts",
        "src/main/settings/managed-codex.ts",
        "src/main/settings/managed-opencode.ts",
        "src/main/settings/notebook-runtime-settings.ts",
        "src/main/settings/opencode-detect.ts",
        "src/main/settings/opencode-install.ts",
        "src/main/settings/preferences.ts",
        "src/main/settings/process-tree.ts",
        "src/main/settings/skill-catalog.ts",
        "src/main/storage-root.ts",
        "src/main/storage/**",
        "src/main/tray.ts",
        "src/main/update/create-strategy.ts",
        "src/main/update/electron-updater-strategy.ts",
        "src/main/session-persistence/**",
        "src/main/file-save.ts",
        "src/main/specialist/repository.ts",
        "src/preload/**/*windows*.ts",
        "src/preload/**/*powershell*.ts",
        "src/preload/**/*path*.ts",
        "src/preload/**/*acl*.ts",
        "src/preload/renderer-api.d.ts",
        "src/shared/local-fs.ts",
        "src/shared/notebook-network.ts",
        "src/shared/settings.ts",
        "src/shared/update.ts"
      ],
      "capabilities": ["windows_sensitive"]
    },
    {
      "id": "renderer_view",
      "role": "owner",
      "fallbackOwner": true,
      "paths": ["src/renderer/**"],
      "capabilities": ["renderer_view"]
    },
    {
      "id": "renderer_state",
      "role": "overlay",
      "paths": [
        "src/renderer/src/stores/**",
        "src/renderer/src/hooks/**",
        "src/renderer/src/navigation/**",
        "src/renderer/src/pages/workspace/**"
      ],
      "capabilities": ["renderer_state"]
    },
    {
      "id": "cli_sdk",
      "role": "owner",
      "paths": ["cli/**", "packages/open-science/**"],
      "capabilities": ["cli_sdk"]
    },
    {
      "id": "settings_ipc",
      "role": "overlay",
      "paths": ["src/main/settings/ipc.ts"],
      "capabilities": ["settings_ipc"]
    }
  ],
  "capabilities": {
    "ci_integrity_surface": {
      "consumers": [],
      "lanes": []
    },
    "documentation": {
      "consumers": [],
      "lanes": ["docs"]
    },
    "shared_contract": {
      "consumers": ["preload_adapter", "i18n_catalog"],
      "lanes": [
        "format",
        "lint",
        "typecheck_node",
        "typecheck_web",
        "interface_contracts",
        "unit_macos"
      ]
    },
    "preload_contract": {
      "consumers": [],
      "lanes": [
        "format",
        "lint",
        "typecheck_node",
        "typecheck_web",
        "interface_contracts",
        "unit_macos",
        "build"
      ]
    },
    "main_runtime": {
      "consumers": ["renderer_runtime", "i18n_catalog"],
      "lanes": ["format", "lint", "typecheck_node", "interface_contracts", "unit_macos"]
    },
    "notebook_network_sandbox": {
      "consumers": [],
      "lanes": [
        "format",
        "lint",
        "typecheck_node",
        "interface_contracts",
        "unit_macos",
        "linux_runtime",
        "windows_runtime",
        "windows_path",
        "build"
      ]
    },
    "renderer_runtime": {
      "consumers": ["e2e_functional", "e2e_workspace"],
      "lanes": ["typecheck_web", "unit_macos", "build"]
    },
    "windows_sensitive": {
      "consumers": [],
      "lanes": [
        "windows_runtime",
        "windows_path",
        "e2e_functional_windows",
        "e2e_workspace_windows"
      ]
    },
    "renderer_view": {
      "consumers": ["e2e_functional", "e2e_accessibility", "e2e_visual", "i18n_catalog"],
      "lanes": ["format", "lint", "typecheck_web", "unit_macos", "build"]
    },
    "i18n_catalog": {
      "consumers": [],
      "lanes": ["i18n"]
    },
    "renderer_state": {
      "consumers": ["e2e_workspace"],
      "lanes": []
    },
    "cli_sdk": {
      "consumers": [],
      "lanes": ["format", "lint", "cli_sdk"]
    },
    "settings_ipc": {
      "consumers": ["preload_adapter"],
      "lanes": ["typecheck_node", "interface_contracts"]
    },
    "preload_adapter": {
      "consumers": ["renderer_settings"],
      "lanes": ["typecheck_web", "build"]
    },
    "renderer_settings": {
      "consumers": ["e2e_functional", "e2e_workspace", "e2e_accessibility", "e2e_visual"],
      "lanes": ["unit_macos"]
    },
    "e2e_functional": {
      "consumers": [],
      "lanes": ["e2e_functional_macos"]
    },
    "e2e_workspace": {
      "consumers": [],
      "lanes": ["e2e_workspace_macos"]
    },
    "e2e_accessibility": {
      "consumers": [],
      "lanes": ["e2e_accessibility_macos"]
    },
    "e2e_visual": {
      "consumers": [],
      "lanes": ["e2e_visual_macos"]
    }
  }
}
