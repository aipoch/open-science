// Prisma schema for the project data layer.
//
// Session content stays on disk (see src/shared/session-persistence.ts). SQLite stores projects,
// lightweight Session metadata and usage projections, preview state, the message center, reviewer
// results, and a query projection of app-managed files; file bytes remain on disk. At runtime the
// datasource url is supplied programmatically (see prisma-client.ts), so DATABASE_URL is CLI-only.

generator client {
  provider      = "prisma-client-js"
  // Generate query engines for both macOS architectures so the x64 build can be cross-packaged on an
  // Apple Silicon CI runner (the scarce Intel `macos-13` runner is no longer needed). "native" is the
  // build host's engine (darwin-arm64 on mac CI, the distro engine on Linux); "darwin" adds x64 mac.
  // The release build prunes engines it doesn't need per platform (see .github/workflows/build.yml).
  binaryTargets = ["native", "darwin"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id               String               @id @default(cuid())
  name             String
  description      String               @default("")
  agentContext     String               @default("")
  sessionDefaults  String               @default("{}")
  isExample        Boolean              @default(false)
  pinned           Boolean              @default(false)
  archivedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  permissionGrants PermissionGrant[]
  previewState     ProjectPreviewState?
  visionEvidence   VisionEvidence[]
  sessions         Session[]
  memoryEntries    MemoryEntry[]
}

// Monotonic allocator for the app-wide human-facing Session number. The row is never deleted when
// Session projections are rebuilt, so deleted Session numbers are not reused.
model SessionNumberSequence {
  id         String @id
  nextNumber Int
}

// Query projection of metadata duplicated in one authoritative live Session JSON file. A deleted
// Session keeps this row as a tombstone after its JSON is removed.
// The existing string `id` remains domain identity; `number` is an unreferenced alternate key.
model Session {
  id                    String               @id
  number                Int                  @unique
  projectId             String
  title                 String
  status                String
  presentedStatus       String
  pinned                Boolean              @default(false)
  archivedAtMs          BigInt?
  revision              BigInt               @default(0)
  activeMessageCount    Int                  @default(0)
  artifactCount         Int                  @default(0)
  filesRevision         Int                  @default(0)
  createdAtMs           BigInt
  updatedAtMs           BigInt
  presentedActivityAtMs BigInt?
  needsStartupRecovery  Boolean              @default(false)
  sourceByteLength      BigInt?
  sourceMtimeMs         BigInt?
  deletedAtMs           BigInt?
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  turnUsage             SessionTurnUsage[]
  runs                  SessionRun[]
  artifactRefs          SessionArtifactRef[]

  @@index([projectId, deletedAtMs, archivedAtMs, updatedAtMs, id])
  @@index([deletedAtMs, archivedAtMs, updatedAtMs, id])
  @@index([createdAtMs])
}

// Singleton completion marker. Its absence/version mismatch means the projection must be rebuilt
// from Session JSON before a genuinely empty catalog can be distinguished from an uninitialized one.
model SessionProjectionState {
  id                String   @id
  projectionVersion Int
  completedAt       DateTime
}

// Durable cross-store write intent. Deliberately has no foreign key: it must survive a missing or
// deleted projection row long enough to reconcile that Session from its authoritative JSON file.
model PendingSessionReconciliation {
  sessionId String   @id
  projectId String
  operation String   @default("save")
  markedAt  DateTime @default(now())

  @@index([projectId])
}

// One completed Agent turn usage report. Inactive branches and delegated frames are retained.
model SessionTurnUsage {
  sessionId         String
  messageId         String
  frameworkId       String?
  providerId        String?
  model             String?
  completedAtMs     BigInt
  inputTokens       BigInt
  cacheTokens       BigInt
  cachedReadTokens  BigInt?
  cachedWriteTokens BigInt?
  outputTokens      BigInt
  modelCallCount    Int?
  isRootFrame       Boolean
  session           Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  modelCalls        SessionModelCallUsage[]

  @@id([sessionId, messageId])
  @@index([completedAtMs])
}

// Exact per-inference usage retained only when the framework reports complete call coverage.
// Framework/model attribution comes from the owning conversation runtime segment and may be absent
// for imported or legacy Sessions. Session JSON remains authoritative; this is a query projection.
model SessionModelCallUsage {
  sessionId          String
  messageId          String
  callId             String
  callIndex          Int
  sourceInvocationId String?
  frameworkId        String?
  providerId         String?
  backendId          String?
  model              String?
  inputTokens        BigInt
  cacheTokens        BigInt
  cachedReadTokens   BigInt?
  cachedWriteTokens  BigInt?
  outputTokens       BigInt
  contextUsedTokens  BigInt?
  contextWindowSize  BigInt?
  turnUsage          SessionTurnUsage @relation(fields: [sessionId, messageId], references: [sessionId, messageId], onDelete: Cascade)

  @@id([sessionId, callId])
  @@unique([sessionId, messageId, callIndex])
}

// One provider-reported logical turn outside the durable Agent message graph. These facts have no
// Session foreign key because a projection rebuild temporarily deletes and recreates live Session
// rows; direct auxiliary consumption must survive that rebuild.
model SessionAuxiliaryTurnUsage {
  sessionId         String
  eventId           String
  source            String
  frameworkId       String
  providerId        String?
  model             String?
  completedAtMs     BigInt
  inputTokens       BigInt
  cacheTokens       BigInt
  cachedReadTokens  BigInt?
  cachedWriteTokens BigInt?
  outputTokens      BigInt
  modelCallCount    Int?

  @@id([sessionId, eventId])
  @@index([completedAtMs])
}

// One user-authored root-frame run, excluding hidden control and delegated caller messages.
model SessionRun {
  sessionId   String
  messageId   String
  createdAtMs BigInt
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, messageId])
  @@index([createdAtMs])
}

// Distinct artifact identity referenced by a Session, with the best known creation timestamp.
model SessionArtifactRef {
  sessionId           String
  artifactId          String
  artifactCreatedAtMs BigInt?
  session             Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, artifactId])
  @@index([artifactId, artifactCreatedAtMs])
}

model PermissionGrant {
  id             String    @id
  capabilityKind String
  capabilityKey  String
  qualifierMode  String    @default("none")
  qualifierValue String?
  scopeKind      String
  projectId      String?
  sessionId      String?
  fingerprint    String    @unique
  revision       Int       @default(1)
  createdAt      DateTime?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([capabilityKind, capabilityKey, qualifierMode, qualifierValue, scopeKind, projectId, sessionId])
  @@index([projectId, sessionId])
}

// Records one-time application-owned permission seeds so a user-revoked default is not recreated on
// a later startup. Seed definitions remain application logic; this table only records completion.
model PermissionGrantSeed {
  id        String   @id
  appliedAt DateTime
}

// Per-project preview panel state (panel open/collapsed, active tab, opened file previews as JSON).
// Runtime-only tabs (notebook) are not stored; see src/shared/preview-state.ts.
model ProjectPreviewState {
  projectId    String   @id
  panelState   String
  activeItemId String?
  items        String   @default("[]")
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Legacy unread-task rows retained only as the source for the message-center startup migration.
// Runtime code removes each row after converting it into a generic inbox item.
model UnreadTaskSession {
  id        Int    @id @default(autoincrement())
  sessionId String @unique
}

// Backend-owned message center shared by desktop and Web clients connected to one single-user
// instance. `sequence` is the atomic mark-all boundary and retention order; `dedupeKey` makes every
// producer retry-safe without exposing provider payloads in the inbox.
model NotificationInboxItem {
  sequence            Int       @id @default(autoincrement())
  id                  String    @unique
  dedupeKey           String    @unique
  kind                String
  source              String?
  attentionReason     String?
  projectId           String?
  sessionId           String?
  originId            String
  title               String
  summary             String
  createdAt           DateTime  @default(now())
  readAt              DateTime?
  actionState         String?
  settledAt           DateTime?
  targetInvalidatedAt DateTime?

  @@index([readAt, sequence])
  @@index([sessionId])
  @@index([projectId])
}

// One reviewer pass over a single completed turn. Checks live in Finding rows; the review carries
// the turn scope, task lifecycle, outcome, and captured reviewer action stream. Canonical runtime
// SQL is generated from this schema plus prisma/sqlite-check-constraints.json.
model Review {
  id                 String                     @id @default(cuid())
  projectId          String
  sessionId          String
  turnMessageId      String
  scope              String                     @default("{}")
  lifecycle          String                     @default("running")
  outcome            String?
  errorMessage       String?
  model              String                     @default("")
  reviewerLog        String                     @default("[]")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  findings           Finding[]
  causedDispositions ReviewFindingDisposition[]
  scopeSnapshot      ReviewScopeSnapshot?

  @@index([projectId, sessionId, createdAt])
  @@index([sessionId])
}

// A unified check row — replaces both the old warn/fail-only Finding and the pass-only ReviewCheck
// JSON blob on Review. status is 'pass'|'warn'|'fail'. locator is optional (pass checks may omit it).
// resolution is meaningful only for warn/fail checks. Cascade-deleted with its Review.
// reflagCount records how many times the claim was re-flagged after a fix attempt.
model Finding {
  id                   String                     @id @default(cuid())
  reviewId             String
  status               String                     @default("pass")
  resolution           String                     @default("open")
  claim                String                     @default("")
  evidence             String                     @default("")
  locator              String                     @default("{}")
  artifactVersionId    String?
  artifactBindingState String                     @default("legacy_unverified")
  sortIndex            Int                        @default(0)
  reflagCount          Int                        @default(0)
  review               Review                     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  dispositions         ReviewFindingDisposition[]

  @@index([reviewId])
}

model ProjectDeletionIntent {
  projectId String   @id
  createdAt DateTime @default(now())
}

model ManagedFile {
  seq               Int       @id @default(autoincrement())
  source            String
  sourceFileId      String
  sourceVersionId   String?
  checksum          String?
  projectId         String
  sessionId         String
  messageId         String?
  displayName       String
  storageKey        String
  mimeType          String?
  sizeBytes         BigInt
  mtimeMs           BigInt?
  sortAtMs          BigInt
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deleteOperationId String?

  @@unique([projectId, source, sourceFileId])
  @@unique([projectId, source, storageKey])
  @@index([projectId, deletedAt, sortAtMs, seq])
  @@index([projectId, source, deletedAt, sortAtMs, seq])
  @@index([projectId, sessionId, source, deletedAt, sortAtMs, seq])
  @@index([sessionId, deletedAt])
}

model ManagedFileSessionSync {
  projectId         String
  sessionId         String
  filesRevision     Int
  groupSortAtMs     BigInt
  artifactCount     Int       @default(0)
  uploadCount       Int       @default(0)
  syncedAt          DateTime  @default(now())
  deletedAt         DateTime?
  deleteOperationId String?

  @@id([projectId, sessionId])
  @@index([projectId, deletedAt, groupSortAtMs, sessionId])
}

// Narrow origin lifecycle retained after a live Session JSON is deleted. This is not a second
// editable Session model; it exists only to preserve managed-file ownership and deletion state.
model FileOriginSession {
  projectId             String
  sessionId             String
  titleSnapshot         String?
  state                 String                    @default("active")
  deletedAt             DateTime?
  deletionOperationId   String?
  retainedReviewIdsJson String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  lineages              ArtifactLineage[]
  uploads               UploadFile[]
  messageSnapshots      ArtifactMessageSnapshot[]
  sourceInputs          ArtifactVersionInput[]

  @@id([projectId, sessionId])
  @@index([projectId, state])
}

// Stable identity for same-named generated Artifact saves inside one Project Session.
model ArtifactLineage {
  id                 String            @id
  projectId          String
  sessionId          String
  normalizedFilename String
  filename           String
  currentVersionId   String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  versions           ArtifactVersion[] @relation("ArtifactLineageVersions")
  currentVersion     ArtifactVersion?  @relation("ArtifactLineageCurrentVersion", fields: [id, currentVersionId], references: [artifactId, id], onDelete: Restrict)
  originSession      FileOriginSession @relation(fields: [projectId, sessionId], references: [projectId, sessionId], onDelete: Restrict)

  @@unique([projectId, sessionId, normalizedFilename])
  @@unique([id, currentVersionId])
  @@index([projectId, sessionId])
}

model UploadFile {
  id               String            @id
  projectId        String
  sessionId        String
  filename         String
  originalFilename String
  currentVersionId String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         UploadVersion[]   @relation("UploadFileVersions")
  currentVersion   UploadVersion?    @relation("UploadFileCurrentVersion", fields: [id, currentVersionId], references: [uploadFileId, id], onDelete: Restrict)
  originSession    FileOriginSession @relation(fields: [projectId, sessionId], references: [projectId, sessionId], onDelete: Restrict)

  @@unique([id, currentVersionId])
  @@index([projectId, sessionId])
}

model UploadVersion {
  id                String                 @id
  uploadFileId      String
  versionNumber     Int
  state             String                 @default("staging")
  originKind        String                 @default("user_upload")
  basedOnVersionId  String?
  storageTag        String?
  storedFilename    String?
  writeOperationId  String?                @unique
  contentStorageKey String                 @unique
  filename          String
  originalFilename  String
  contentType       String?
  sizeBytes         BigInt
  checksum          String
  createdAt         DateTime?
  registeredAt      DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  uploadFile        UploadFile             @relation("UploadFileVersions", fields: [uploadFileId], references: [id], onDelete: Cascade)
  currentForFile    UploadFile?            @relation("UploadFileCurrentVersion")
  basedOnVersion    UploadVersion?         @relation("UploadVersionDerivations", fields: [uploadFileId, basedOnVersionId], references: [uploadFileId, id], onDelete: Restrict)
  derivedVersions   UploadVersion[]        @relation("UploadVersionDerivations")
  sourceInputs      ArtifactVersionInput[] @relation("UploadVersionSourceInputs")
  visionEvidence    VisionEvidence[]

  @@unique([uploadFileId, versionNumber])
  @@unique([uploadFileId, id])
  @@index([uploadFileId, state, registeredAt])
}

// Canonical, reusable image analysis. Session transcripts keep only their existing upload/image
// metadata; this derived record is independently invalidated by its extractor fingerprint.
model VisionEvidence {
  id                    String         @id
  projectId             String
  sessionId             String
  sourceKind            String
  uploadVersionId       String?
  sourceMessageId       String?
  sourceImageId         String?
  imageChecksum         String
  mimeType              String
  extractorFingerprint  String
  evidenceSchemaVersion Int
  evidenceJson          String
  evidenceChecksum      String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadVersion         UploadVersion? @relation(fields: [uploadVersionId], references: [id], onDelete: Cascade)

  @@index([projectId, sessionId])
  @@index([sessionId])
  @@index([uploadVersionId])
}

model ArtifactMessageSnapshot {
  id                String            @id
  projectId         String
  sessionId         String
  rootFrameId       String
  agentFrameId      String
  messageBranchId   String
  terminalMessageId String
  state             String            @default("staging")
  storageKey        String
  checksum          String            @default("")
  messageCount      Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  versions          ArtifactVersion[]
  originSession     FileOriginSession @relation(fields: [projectId, sessionId], references: [projectId, sessionId], onDelete: Restrict)

  @@unique([projectId, sessionId, agentFrameId, messageBranchId, terminalMessageId])
  @@index([projectId, sessionId, state])
}

// One immutable generated Artifact save event. Evidence/content fields become immutable once the
// staging row is published; finalize only advances state and message ownership.
model ArtifactVersion {
  id                             String                   @id
  artifactId                     String
  versionNumber                  Int
  filename                       String
  originKind                     String                   @default("agent_generated")
  basedOnVersionId               String?
  storageTag                     String?
  storedFilename                 String?
  artifactRunId                  String?
  writeOperationId               String?                  @unique
  writeRequestChecksum           String?
  rootFrameId                    String?
  agentFrameId                   String?
  messageBranchId                String?
  runtimeSegmentId               String?
  promptMessageId                String?
  notebookSessionId              String?
  producerRunId                  String?
  producerRunIndex               Int?
  messageId                      String?
  messageSnapshotId              String?
  state                          String                   @default("staging")
  managedVisibleAt               DateTime?
  contentStorageKey              String                   @unique
  evidenceStorageKey             String?
  contentType                    String?
  sizeBytes                      BigInt
  checksum                       String
  evidenceJson                   String?
  evidenceChecksum               String?
  evidenceSchemaVersion          Int?
  executionSnapshotJson          String?
  executionSnapshotChecksum      String?
  executionSnapshotStorageKey    String?
  executionSnapshotSchemaVersion Int?
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  artifact                       ArtifactLineage          @relation("ArtifactLineageVersions", fields: [artifactId], references: [id], onDelete: Cascade)
  currentForLineage              ArtifactLineage?         @relation("ArtifactLineageCurrentVersion")
  basedOnVersion                 ArtifactVersion?         @relation("ArtifactVersionDerivations", fields: [artifactId, basedOnVersionId], references: [artifactId, id], onDelete: Restrict)
  derivedVersions                ArtifactVersion[]        @relation("ArtifactVersionDerivations")
  messageSnapshot                ArtifactMessageSnapshot? @relation(fields: [messageSnapshotId], references: [id], onDelete: SetNull)
  inputs                         ArtifactVersionInput[]   @relation("ProducedArtifactInputs")
  sourceInputs                   ArtifactVersionInput[]   @relation("ArtifactVersionSourceInputs")

  @@unique([artifactId, versionNumber])
  @@unique([artifactId, id])
  @@index([artifactId, createdAt])
  @@index([artifactRunId, state])
  @@index([rootFrameId, agentFrameId, messageBranchId, promptMessageId])
  @@index([messageId])
  @@index([messageSnapshotId])
}

// Recovery journal for cross-resource text edit publication. Staging operations do not allocate a
// content version number and are invisible to normal version readers.
model ManagedFileVersionWriteOperation {
  operationId           String   @id
  source                String
  projectId             String
  sourceFileId          String
  basedOnVersionId      String
  expectedHeadVersionId String
  state                 String   @default("staging")
  storageTag            String
  storedFilename        String
  contentStorageKey     String   @unique
  checksum              String
  sizeBytes             BigInt
  textFormatJson        String
  resultVersionId       String?  @unique
  errorCode             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([source, sourceFileId, state])
  @@index([projectId, state, createdAt])
}

model ArtifactVersionInput {
  id                      String            @id
  artifactVersionId       String
  ordinal                 Int
  inputFileVersionId      String
  sourceKind              String
  sourceFileId            String
  sourceArtifactVersionId String?
  sourceUploadVersionId   String?
  sourceVersionNumber     Int?
  sourceCreatedAt         DateTime?
  sourceProjectId         String
  sourceSessionId         String
  filename                String
  contentType             String?
  sizeBytes               BigInt
  checksum                String
  storageKey              String
  strongestAssociation    String
  artifactVersion         ArtifactVersion   @relation("ProducedArtifactInputs", fields: [artifactVersionId], references: [id], onDelete: Cascade)
  sourceArtifactVersion   ArtifactVersion?  @relation("ArtifactVersionSourceInputs", fields: [sourceArtifactVersionId], references: [id], onDelete: Restrict)
  sourceUploadVersion     UploadVersion?    @relation("UploadVersionSourceInputs", fields: [sourceUploadVersionId], references: [id], onDelete: Restrict)
  sourceOrigin            FileOriginSession @relation(fields: [sourceProjectId, sourceSessionId], references: [projectId, sessionId], onDelete: Restrict)

  @@unique([artifactVersionId, sourceKind, inputFileVersionId])
  @@unique([artifactVersionId, ordinal])
  @@index([sourceKind, inputFileVersionId])
  @@index([sourceArtifactVersionId])
  @@index([sourceUploadVersionId])
  @@index([sourceProjectId, sourceSessionId])
}

model ReviewFindingDisposition {
  id                        String   @id
  sourceFindingId           String
  causeReviewId             String?
  sequence                  Int
  trigger                   String
  outcome                   String
  note                      String?
  assessedArtifactVersionId String?
  assessmentSnapshot        String?
  createdAt                 DateTime @default(now())
  sourceFinding             Finding  @relation(fields: [sourceFindingId], references: [id], onDelete: Cascade)
  causeReview               Review?  @relation(fields: [causeReviewId], references: [id], onDelete: Restrict)

  @@unique([sourceFindingId, sequence])
  @@index([causeReviewId, createdAt])
  @@index([assessedArtifactVersionId])
}

model ReviewScopeSnapshot {
  id                 String   @id
  projectId          String
  sessionId          String
  reviewId           String   @unique
  scopeTurnMessageId String
  state              String   @default("staging")
  snapshotJson       String
  checksum           String
  storageKey         String
  schemaVersion      Int      @default(1)
  blockCount         Int
  createdAt          DateTime @default(now())
  review             Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([projectId, sessionId, state])
}

// A remote compute job submitted via host.compute.create(id).submit_job(). Tracks the full
// lifecycle from submission and dispatch through execution, harvest, notification, and analysis.
// Security: free-form execution data is encrypted when OS secure storage is available; commandHash
// remains plaintext for deduplication. Credentials use the separate ComputeCredential store.
model ComputeJob {
  id                       String                @id @default(cuid())
  providerId               String
  shape                    String
  sessionId                String
  projectId                String
  status                   String                @default("submitted")
  intent                   String
  command                  String
  commandHash              String
  // NULL marks historical plaintext rows; false marks disclosed plaintext fallback; true marks
  // rows whose free-form execution data must be decrypted through OS secure storage.
  sensitiveDataEncrypted   Boolean?
  environment              String?
  resourceRequest          String?
  inputManifest            String?
  // Trusted Notebook Run that submitted this Job. NULL for historical/non-Notebook Jobs.
  producerRunId            String?
  // Validated execution-file-evidence summary JSON. Full relations remain in the sidecar.
  fileEvidence             String?
  outputManifest           String?
  harvestConfig            String?
  timeoutSeconds           Int?
  remoteWorkdir            String?
  remoteHandle             String?
  remoteCleanupDisposition String                @default("pending")
  exitCode                 Int?
  stdoutTail               String?
  stderrTail               String?
  errorCode                String?
  // lastPollError: set when SSH connectivity fails during a poll tick (design.md §8 boundary 2).
  // The job status is NOT changed — this field surfaces the transient error to the UI.
  // Cleared on the next successful poll. retry_after_user_action is always true for this field.
  lastPollError            String?
  // harvestError: summary of a harvest_failed outcome; non-null means harvest completed with errors.
  harvestError             String?
  // leftOnRemote: JSON [{uri, size_mb, reason}] — files left on the remote side after harvest.
  leftOnRemote             String?
  // notifiedAt: set when the compute_done notification has been enqueued to the inbox.
  notifiedAt               DateTime?
  // notificationConsumedAt: set by wait_for_notification when the notification is consumed.
  notificationConsumedAt   DateTime?
  // Durable automatic-analysis delivery state. NULL preserves historical pending/consumed rows.
  analysisState            String?
  analysisMessageId        String?
  analysisUpdatedAt        DateTime?
  createdAt                DateTime              @default(now())
  submittedAt              DateTime?
  startedAt                DateTime?
  finishedAt               DateTime?
  harvestedAt              DateTime?
  operations               ComputeJobOperation[]

  @@index([providerId])
  @@index([sessionId])
  @@index([status])
}

// Durable lifecycle operations keep requested intent outside the closed ComputeJob execution
// status/error vocabulary. `eligibleAt = null` means an active operation is immediately ready.
// Kinds and settled outcomes are closed by SQLite checks and exhaustive TypeScript codecs.
model ComputeJobOperation {
  id             String     @id
  jobId          String
  kind           String
  phase          String     @default("active")
  outcome        String?
  revision       Int        @default(1)
  attemptCount   Int        @default(0)
  eligibleAt     DateTime?
  claimToken     String?
  claimExpiresAt DateTime?
  createdAt      DateTime   @default(now())
  settledAt      DateTime?
  updatedAt      DateTime   @updatedAt
  job            ComputeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, kind])
  @@index([kind, phase, eligibleAt, createdAt])
  @@index([kind, phase, claimExpiresAt])
}

// A registered remote SSH compute host. Stores an SSH alias and optional non-secret overrides;
// password ciphertext is isolated in ComputeCredential and private keys are never stored here.
model ComputeHost {
  id                     String             @id @default(cuid())
  providerId             String             @unique // "ssh:<alias>"
  displayName            String
  shape                  String             @default("direct_ssh") // direct_ssh | scheduler_cluster | bridge_runner
  sshAlias               String
  sshOverrides           String? // JSON: { user?, port?, identityFile? } — never credentials
  authenticationMode     String             @default("ssh_config")
  authenticationRevision Int                @default(1)
  lastVerifiedAt         DateTime?
  scratchRoot            String?
  scratchPinned          Boolean            @default(false)
  concurrencyLimit       Int? // Per-host running-job ceiling; null uses the default ceiling of 10
  probeResult            String? // JSON snapshot from the latest connection probe
  detailsDoc             String             @default("") // markdown notes, <= 32768 chars
  detailsUpdatedAt       DateTime?
  detailsUpdatedBy       String? // user | agent
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  credential             ComputeCredential?
}

// Main-process-only password ciphertext. The renderer has no query path to this record.
model ComputeCredential {
  computeHostId String      @id
  ciphertext    Bytes
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  computeHost   ComputeHost @relation(fields: [computeHostId], references: [id], onDelete: Cascade)
}

// Makes a retried local create command return the already-created Host instead of duplicating it.
model ComputeAuthOperation {
  id                 String   @id
  providerId         String
  operationKind      String
  requestFingerprint String
  resultRevision     Int
  createdAt          DateTime @default(now())

  @@index([providerId])
}

// A local folder the user explicitly granted the app access to ("Grant folder access"). `path` is
// the realpath'd absolute folder and is unique, so re-granting a folder updates its access in place.
// `access` is 'ro' | 'rw'. Legacy installs import settings.json's grantedLocalRoots on first use (see
// src/main/local-fs/granted-roots-repository.ts); production never writes the settings field again.
model GrantedLocalRoot {
  id        String   @id
  path      String   @unique
  name      String
  access    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User-defined cross-resource labels plus application-owned built-ins such as Favorites. System
// labels derive their localized presentation from systemKey; custom labels persist their display
// name and fixed-palette visual keys. nameKey is an internal comparison key and never crosses IPC.
model Tag {
  id          String          @id @default(cuid())
  systemKey   String?         @unique
  name        String?
  nameKey     String?         @unique
  iconKey     String?
  colorKey    String?
  sortOrder   Int             @unique @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  assignments TagAssignment[]
}

// resourceType is intentionally a registry-backed string rather than a Prisma enum so later
// resource adapters can be added without rebuilding this table. V1 validates the three catalog
// resource types at the application boundary.
model TagAssignment {
  tagId        String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())
  tag          Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, resourceType, resourceId])
  @@index([resourceType, resourceId])
}

// Memory categories are profile-global, while entries may additionally belong to one Project.
// Agent provenance stays main-process only; renderer views omit sourceSessionId and sourceAgentId.
model MemorySettings {
  id        String   @id
  enabled   Boolean  @default(false)
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemoryCategory {
  id         String        @id @default(cuid())
  systemKey  String?       @unique
  name       String?
  nameKey    String?       @unique
  guidance   String        @default("")
  autoRecall Boolean       @default(false)
  revision   Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  entries    MemoryEntry[]
}

model MemoryEntry {
  id              String          @id @default(cuid())
  categoryId      String?
  projectId       String?
  content         String
  contentKey      String
  origin          String
  sourceSessionId String?
  sourceAgentId   String?
  revision        Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        MemoryCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, contentKey])
  @@index([categoryId, updatedAt])
  @@index([projectId, updatedAt])
}
